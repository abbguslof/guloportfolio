# ~/.bashrc - gulo interactive terminal configuration
export PS1="\[\033[01;32m\]visitor@playground\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "
export EDITOR="nvim"
export SWIM_POOL="Valhallabadet 50m"

alias swim="echo 'Dyk i! Valhallabadet kl 06:00, 400m insim redo.'"
alias study="echo 'Kompilerar operativsystem... tentan godkänd!'"
alias sleep="echo 'Error: 404 Sleep Not Found under tentavecka'"
alias mc="docker compose -f ~/homelab/docker-compose.yml up -d"
