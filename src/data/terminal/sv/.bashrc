# ~/.bashrc - gulo interaktiv terminalkonfiguration
export PS1="\[\033[01;32m\]visitor@playground\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "
export EDITOR="nvim"
export SWIM_POOL="Åbybadet & GoCo"

alias study="school"
alias education="school"
alias swim="cat swim.md"
alias proxmox="echo 'Proxmox VE-kluster: Alla noder mår prima och är online.'"
alias mc="echo 'PaperMC / Velocity-kluster kör med stabila 20.0 TPS.'"
alias sleep="echo 'Error: 404 Sleep Not Found under tentavecka'"
