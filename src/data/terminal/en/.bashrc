# ~/.bashrc - gulo interactive terminal configuration
export PS1="\[\033[01;32m\]visitor@playground\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "
export EDITOR="nvim"
export SWIM_CLUB="MASS & Growth Objective"

alias study="school"
alias education="school"
alias swim="cat swim.md"
alias proxmox="echo 'Proxmox VE cluster: All nodes healthy and operational.'"
alias mc="echo 'PaperMC / Velocity cluster running smooth at 20.0 TPS.'"
alias sleep="echo 'Error: 404 Sleep Not Found during exam week'"
