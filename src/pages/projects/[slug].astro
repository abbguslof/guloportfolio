---
// src/pages/projects/[slug].astro - Projektsida med fullständig dokumentation & länkade resurser
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InteractiveTerminal from '../../components/InteractiveTerminal.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { getGroupedProjects } from '../../utils/projects';

export async function getStaticPaths() {
  const grouped = await getGroupedProjects();
  return grouped.map((item) => ({
    params: { slug: item.slug },
    props: { projectEn: item.en, projectSv: item.sv, slug: item.slug },
  }));
}

const { projectEn, projectSv, slug } = Astro.props;
const { Content: ContentEn } = await render(projectEn);
const { Content: ContentSv } = projectSv ? await render(projectSv) : { Content: null };

// Linked downloads from collection (matched by clean slug e.g. mc-cluster)
const allDownloads = await getCollection('downloads');
const linkedDownloads = allDownloads.filter((d) => (d.data.relatedProjects || []).includes(slug));

// Status styling
const statusColors: Record<string, string> = {
  ACTIVE: 'text-[#10b981] border-[#10b981]/40',
  COMPLETED: 'text-[#38bdf8] border-[#38bdf8]/40',
  WIP: 'text-[#f59e0b] border-[#f59e0b]/40',
  MAINTAINED: 'text-[#a78bfa] border-[#a78bfa]/40',
  ARCHIVED: 'text-[#8b949e] border-[#8b949e]/40',
};
---

<Layout 
  titleEn={`${projectEn.data.title} // gulo`}
  titleSv={`${projectSv ? projectSv.data.title : projectEn.data.title} // gulo`}
  descriptionEn={projectEn.data.description}
  descriptionSv={projectSv ? projectSv.data.description : projectEn.data.description}
>
  <Header />

  <!-- Global terminal on subpages (opens on header button click) -->
  <InteractiveTerminal isSubpage={true} />

  <main id="main-content" tabindex="-1" class="w-full py-4 space-y-8 outline-none">
    <!-- Back button -->
    <div class="mb-5 sm:mb-8">
      <a 
        href="/projects" 
        class="inline-flex items-center gap-1.5 text-xs font-mono text-[#8b949e] hover:text-[#10b981] transition-colors px-3 py-1.5 min-h-[34px] sm:min-h-auto rounded bg-[#161b22] border border-[#30363d]"
      >
        <span data-i18n="projects_back_btn">← [~/projects]</span>
      </a>
    </div>

    <!-- Project Header -->
    <header class="pb-5 sm:pb-6 mb-6 sm:mb-8 border-b border-[#30363d]">
      <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
        <div class="flex items-center gap-2 flex-wrap">
          <span 
            class="text-xs font-mono uppercase px-2 py-0.5 rounded bg-[#161b22] border border-[#30363d] text-[#8b949e]"
            data-i18n={`projects_cat_${projectEn.data.category.toLowerCase()}`}
          >
            {projectEn.data.category}
          </span>
          <span class={`text-xs font-mono font-bold px-2 py-0.5 rounded bg-[#161b22] border ${statusColors[projectEn.data.status] || 'text-[#10b981]'}`}>
            [{projectEn.data.status}]
          </span>
        </div>

        {(projectEn.data.pdfUrl || projectSv?.data?.pdfUrl) && (
          <a 
            href={projectEn.data.pdfUrl || projectSv?.data?.pdfUrl}
            download={projectEn.data.pdfName || projectSv?.data?.pdfName || `${slug}.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold px-2.5 py-1.5 min-h-[32px] rounded bg-[#161b22] border border-[#10b981]/50 text-[#10b981] hover:bg-[#10b981]/15 hover:border-[#10b981] transition-all ml-auto shadow-sm group"
            title={projectEn.data.pdfName || projectSv?.data?.pdfName || 'Download Project PDF'}
          >
            <span class="text-xs group-hover:translate-y-0.5 transition-transform">↓</span>
            <span>PDF</span>
            {(projectEn.data.pdfName || projectSv?.data?.pdfName) && (
              <span class="text-[10px] text-[#8b949e] hidden sm:inline">({projectEn.data.pdfName || projectSv?.data?.pdfName})</span>
            )}
            <span class="text-[10px] text-[#8b949e]">↗</span>
          </a>
        )}
      </div>

      <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-[#e6edf3] tracking-tight mb-3 break-words">
        <span class="lang-en-only">{projectEn.data.title}</span>
        <span class="lang-sv-only">{projectSv.data.title}</span>
      </h1>

      <p class="text-xs sm:text-sm text-[#8b949e] leading-relaxed border-l-2 border-[#38bdf8] pl-3 mb-5 sm:mb-6">
        <span class="lang-en-only">{projectEn.data.description}</span>
        <span class="lang-sv-only">{projectSv.data.description}</span>
      </p>

      <!-- Tech tags & Links -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 pt-2">
        <div class="flex flex-wrap gap-1.5">
          {projectEn.data.tech.map((t) => (
            <span class="text-[11px] sm:text-xs font-mono text-[#8b949e] bg-[#161b22] px-2 py-0.5 rounded border border-[#30363d]">
              #{t}
            </span>
          ))}
        </div>

        <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs font-mono">
          {(projectEn.data.pdfUrl || projectSv?.data?.pdfUrl) && (
            <a 
              href={projectEn.data.pdfUrl || projectSv?.data?.pdfUrl}
              download={projectEn.data.pdfName || projectSv?.data?.pdfName || `${slug}.pdf`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 min-h-[34px] sm:min-h-auto rounded bg-[#161b22] border border-[#10b981]/50 text-[#10b981] hover:border-[#10b981] hover:text-[#e6edf3] transition-all flex items-center gap-1.5"
            >
              <span>↓</span>
              <span>PDF spec</span>
              <span class="text-[10px]">↗</span>
            </a>
          )}
          {projectEn.data.repoUrl && (
            <a 
              href={projectEn.data.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 min-h-[34px] sm:min-h-auto rounded bg-[#161b22] border border-[#30363d] text-[#38bdf8] hover:border-[#38bdf8] hover:text-[#e6edf3] transition-all flex items-center gap-1.5"
            >
              <span data-i18n="projects_source_code">Source code</span>
              <span class="text-[10px]">↗</span>
            </a>
          )}
          {projectEn.data.liveUrl && (
            <a 
              href={projectEn.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 min-h-[34px] sm:min-h-auto rounded bg-[#161b22] border border-[#30363d] text-[#10b981] hover:border-[#10b981] hover:text-[#e6edf3] transition-all flex items-center gap-1.5"
            >
              <span data-i18n="projects_live_demo">Live demo</span>
              <span class="text-[10px]">↗</span>
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Project Body (Markdown Content) -->
    <article class="prose prose-invert max-w-none text-[#e6edf3] text-sm leading-relaxed 
      prose-headings:text-[#e6edf3] prose-headings:font-bold prose-headings:font-mono
      prose-h2:text-lg prose-h2:border-b prose-h2:border-[#30363d] prose-h2:pb-2 prose-h2:mt-8
      prose-h3:text-base prose-h3:text-[#38bdf8]
      prose-p:text-[#c9d1d9] prose-p:leading-relaxed
      prose-blockquote:border-l-[#10b981] prose-blockquote:text-[#8b949e] prose-blockquote:italic
      prose-a:text-[#38bdf8] prose-a:underline hover:prose-a:text-[#10b981]">
      <div class="lang-en-only">
        {ContentEn && <ContentEn />}
      </div>
      <div class="lang-sv-only">
        {ContentSv ? <ContentSv /> : (ContentEn && <ContentEn />)}
      </div>
    </article>

    <!-- Attached Downloads if applicable -->
    {linkedDownloads.length > 0 && (
      <div class="mt-12 p-4 rounded-lg bg-[#161b22] border border-[#30363d] font-mono">
        <div class="text-xs font-bold text-[#10b981] mb-2 flex items-center gap-2">
          <span>↓</span>
          <span data-i18n="projects_downloads_title">DOWNLOADABLE RESOURCES LINKED TO THIS PROJECT:</span>
        </div>
        <div class="space-y-2 pt-2 border-t border-[#30363d]/60">
          {linkedDownloads.map((dl) => (
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs pt-1">
              <div>
                <span class="font-semibold text-[#e6edf3]">{dl.data.name}</span>
                <span class="text-[#8b949e] ml-2">({dl.data.size})</span>
              </div>
              <a 
                href={dl.data.fileUrl} 
                download={dl.data.filename}
                class="px-3 py-1 rounded bg-[#0d1117] border border-[#30363d] text-[#10b981] hover:border-[#10b981] transition-all text-xs text-center"
              >
                [Download {dl.data.filename} ↓]
              </a>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Return Nav -->
    <div class="mt-12 pt-6 border-t border-[#30363d] flex flex-wrap sm:flex-nowrap items-center justify-between gap-3 text-xs font-mono">
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 sm:gap-4">
        <a href="/projects" class="text-[#8b949e] hover:text-[#10b981] transition-colors">
          <span data-i18n="projects_back_all">[← Return to all projects]</span>
        </a>
        <a href="/" class="text-[#8b949e] hover:text-[#10b981] transition-colors">
          <span data-i18n="projects_back_home">[Back to the cockpit]</span>
        </a>
      </div>
      <span class="text-[#8b949e] hidden sm:inline">slug: {slug}</span>
    </div>
  </main>

  <Footer />
</Layout>

