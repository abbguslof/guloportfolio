---
// src/pages/projects/[slug].astro - Projektsida med fullständig dokumentation & länkade resurser
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InteractiveTerminal from '../../components/InteractiveTerminal.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Status styling
const statusColors: Record<string, string> = {
  ACTIVE: 'text-[#10b981] border-[#10b981]/40',
  COMPLETED: 'text-[#38bdf8] border-[#38bdf8]/40',
  WIP: 'text-[#f59e0b] border-[#f59e0b]/40',
  MAINTAINED: 'text-[#a78bfa] border-[#a78bfa]/40',
  ARCHIVED: 'text-[#8b949e] border-[#8b949e]/40',
};
---

<Layout 
  title={`${project.data.title} // gulo`}
  description={project.data.description}
>
  <Header />

  <!-- Global terminal on subpages (opens on header button click) -->
  <InteractiveTerminal isSubpage={true} />

  <main class="w-full py-4 space-y-8">
    <!-- Back button -->
    <div class="mb-8">
      <a 
        href="/projects" 
        class="inline-flex items-center gap-1.5 text-xs font-mono text-[#8b949e] hover:text-[#10b981] transition-colors px-2.5 py-1 rounded bg-[#161b22] border border-[#30363d]"
      >
        <span data-i18n="projects_back_btn">← [~/projects]</span>
      </a>
    </div>

    <!-- Project Header -->
    <header class="pb-6 mb-8 border-b border-[#30363d]">
      <div class="flex items-center gap-2 mb-3">
        <span 
          class="text-xs font-mono uppercase px-2 py-0.5 rounded bg-[#161b22] border border-[#30363d] text-[#8b949e]"
          data-i18n={`projects_cat_${project.data.category.toLowerCase()}`}
        >
          {project.data.category}
        </span>
        <span class={`text-xs font-mono font-bold px-2 py-0.5 rounded bg-[#161b22] border ${statusColors[project.data.status] || 'text-[#10b981]'}`}>
          [{project.data.status}]
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold text-[#e6edf3] tracking-tight mb-3">
        {project.data.title}
      </h1>

      <p class="text-sm text-[#8b949e] leading-relaxed border-l-2 border-[#38bdf8] pl-3 mb-6">
        {project.data.description}
      </p>

      <!-- Tech tags & Links -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
        <div class="flex flex-wrap gap-1.5">
          {project.data.tech.map((t) => (
            <span class="text-xs font-mono text-[#8b949e] bg-[#161b22] px-2 py-0.5 rounded border border-[#30363d]">
              #{t}
            </span>
          ))}
        </div>

        <div class="flex items-center gap-3 text-xs font-mono">
          {project.data.repoUrl && (
            <a 
              href={project.data.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded bg-[#161b22] border border-[#30363d] text-[#38bdf8] hover:border-[#38bdf8] hover:text-[#e6edf3] transition-all flex items-center gap-1.5"
            >
              <span data-i18n="projects_source_code">Source code</span>
              <span class="text-[10px]">↗</span>
            </a>
          )}
          {project.data.liveUrl && (
            <a 
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded bg-[#161b22] border border-[#30363d] text-[#10b981] hover:border-[#10b981] hover:text-[#e6edf3] transition-all flex items-center gap-1.5"
            >
              <span data-i18n="projects_live_demo">Live demo</span>
              <span class="text-[10px]">↗</span>
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Project Body (Markdown Content) -->
    <article class="prose prose-invert max-w-none text-[#e6edf3] text-sm leading-relaxed 
      prose-headings:text-[#e6edf3] prose-headings:font-bold prose-headings:font-mono
      prose-h2:text-lg prose-h2:border-b prose-h2:border-[#30363d] prose-h2:pb-2 prose-h2:mt-8
      prose-h3:text-base prose-h3:text-[#38bdf8]
      prose-p:text-[#c9d1d9] prose-p:leading-relaxed">
      <Content />
    </article>

    <!-- Attached Downloads if applicable -->
    {project.data.category === 'Minecraft' && (
      <div class="mt-12 p-4 rounded-lg bg-[#161b22] border border-[#30363d]">
        <div class="text-xs font-mono font-bold text-[#10b981] mb-2" data-i18n="projects_downloads_title">
          DOWNLOADABLE RESOURCES LINKED TO THIS PROJECT:
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <div>
            <span class="font-semibold text-[#e6edf3]">Fabric Performance Pack 1.20.4</span>
            <span class="text-[#8b949e] ml-2">(4.8 MB zip)</span>
          </div>
          <a 
            href="/downloads/fabric-1.20.4-optimized.zip" 
            download="fabric-1.20.4-optimized.zip"
            class="px-3 py-1 rounded bg-[#0d1117] border border-[#30363d] text-[#10b981] hover:border-[#10b981] transition-all text-xs text-center"
            data-i18n="projects_download_pack"
          >
            [Download pack ↓]
          </a>
        </div>
      </div>
    )}

    <!-- Return Nav -->
    <div class="mt-12 pt-6 border-t border-[#30363d] flex items-center justify-between text-xs font-mono">
      <div class="flex items-center gap-4">
        <a href="/projects" class="text-[#8b949e] hover:text-[#10b981] transition-colors">
          <span data-i18n="projects_back_all">[← Return to all projects]</span>
        </a>
        <a href="/" class="text-[#8b949e] hover:text-[#10b981] transition-colors">
          <span data-i18n="projects_back_home">[Back to the cockpit]</span>
        </a>
      </div>
      <span class="text-[#8b949e]">slug: {project.id}</span>
    </div>
  </main>

  <Footer />
</Layout>
