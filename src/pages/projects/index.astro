---
// src/pages/projects/index.astro - Fullständig Portfolio- & Projektöversikt
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InteractiveTerminal from '../../components/InteractiveTerminal.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);

// Samla alla kategorier
const categories = ['Alla', 'School', 'Homelab', 'Minecraft'];
---

<Layout 
  title="Projekt & Portfolio // gulo" 
  description="Portfolio över systemprogrammering, Chalmers Datateknik, Minecraft-infrastruktur och homelab."
>
  <Header />

  <!-- Global terminal on subpages (opens on header button click) -->
  <InteractiveTerminal isSubpage={true} />

  <main class="w-full py-4 space-y-10">
    <!-- Breadcrumb & Top Header -->
    <div class="border-b border-[#30363d] pb-6">
      <div class="flex items-center gap-2 text-xs font-mono text-[#8b949e] mb-3">
        <a href="/" class="hover:text-[#10b981] transition-colors">[~/hem]</a>
        <span>/</span>
        <span class="text-[#e6edf3]">projekt</span>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold font-mono text-[#e6edf3] tracking-tight">
            Projekt, Homelab &amp; Kod
          </h1>
          <p class="text-xs sm:text-sm text-[#8b949e] mt-1 font-mono">
            Tekniska djupdykningar, laborationer från Chalmers och självhostad infrastruktur.
          </p>
        </div>

        <div class="flex items-center gap-3 text-xs font-mono text-[#8b949e]">
          <span class="px-2.5 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#10b981] font-mono text-xs">
            <span id="project-count-badge">{sortedProjects.length}</span> projekt tillgängliga
          </span>
        </div>
      </div>

      <!-- Search & Filters Bar -->
      <div class="mt-6 pt-4 border-t border-[#30363d]/60 space-y-4">
        <!-- Live Search Bar -->
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-xs text-[#8b949e]">
            <span>grep:</span>
          </div>
          <input 
            type="text" 
            id="project-search-input"
            placeholder="Sök på projektnamn, teknologi, kategori eller beskrivning (t.ex. 'rust', 'c', 'minecraft')..." 
            class="w-full bg-[#161b22] text-[#e6edf3] text-xs pl-16 pr-4 py-2 rounded-lg border border-[#30363d] focus:outline-none focus:border-[#10b981] placeholder-[#8b949e]/60 font-mono transition-colors"
          />
        </div>

        <!-- Category Filter Tabs -->
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class="text-[#8b949e] text-[11px] mr-1">Kategori:</span>
          <button 
            type="button" 
            class="proj-filter-btn active px-3 py-1 rounded bg-[#10b981] text-[#0d1117] font-semibold border border-[#10b981] transition-all cursor-pointer"
            data-category="all"
          >
            [Alla]
          </button>
          <button 
            type="button" 
            class="proj-filter-btn px-3 py-1 rounded bg-[#161b22] text-[#8b949e] border border-[#30363d] hover:text-[#e6edf3] transition-all cursor-pointer"
            data-category="school"
          >
            [Chalmers / Skola]
          </button>
          <button 
            type="button" 
            class="proj-filter-btn px-3 py-1 rounded bg-[#161b22] text-[#8b949e] border border-[#30363d] hover:text-[#e6edf3] transition-all cursor-pointer"
            data-category="minecraft"
          >
            [Minecraft]
          </button>
          <button 
            type="button" 
            class="proj-filter-btn px-3 py-1 rounded bg-[#161b22] text-[#8b949e] border border-[#30363d] hover:text-[#e6edf3] transition-all cursor-pointer"
            data-category="homelab"
          >
            [Homelab / Linux]
          </button>
        </div>
      </div>
    </div>

    <!-- Portfolio Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
      {sortedProjects.map((project) => (
        <div 
          class="project-item" 
          data-cat={project.data.category.toLowerCase()}
          data-title={project.data.title.toLowerCase()}
          data-desc={project.data.description.toLowerCase()}
          data-tech={(project.data.tech || []).join(' ').toLowerCase()}
        >
          <ProjectCard 
            title={project.data.title}
            description={project.data.description}
            status={project.data.status}
            category={project.data.category}
            tech={project.data.tech}
            repoUrl={project.data.repoUrl}
            liveUrl={project.data.liveUrl}
            slug={project.id}
          />
        </div>
      ))}
    </div>

    <div id="no-projects-msg" class="py-12 text-center text-xs font-mono text-[#8b949e] hidden">
      Inga projekt matchar din sökning eller det valda filtret.
    </div>

    <!-- Bottom return navigation -->
    <div class="pt-8 border-t border-[#30363d] flex items-center justify-between text-xs font-mono text-[#8b949e]">
      <a href="/" class="hover:text-[#10b981] transition-colors flex items-center gap-1.5">
        <span>←</span>
        <span>[Tillbaka till cockpit]</span>
      </a>
      <span>gulo // portfolio matrix</span>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function initProjectFilters() {
    const btns = document.querySelectorAll('.proj-filter-btn');
    const items = Array.from(document.querySelectorAll<HTMLElement>('.project-item'));
    const searchInput = document.getElementById('project-search-input') as HTMLInputElement | null;
    const noMsg = document.getElementById('no-projects-msg');
    const countBadge = document.getElementById('project-count-badge');

    let currentCat = 'all';
    let searchQuery = '';

    function filterProjects() {
      let visibleCount = 0;
      items.forEach((item) => {
        const cat = item.getAttribute('data-cat') || '';
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-desc') || '';
        const tech = item.getAttribute('data-tech') || '';

        const catMatches = currentCat === 'all' || cat === currentCat;
        const searchMatches = 
          !searchQuery || 
          title.includes(searchQuery) || 
          desc.includes(searchQuery) || 
          tech.includes(searchQuery) ||
          cat.includes(searchQuery);

        const isMatch = catMatches && searchMatches;
        item.style.display = isMatch ? '' : 'none';
        if (isMatch) visibleCount++;
      });

      if (noMsg) noMsg.classList.toggle('hidden', visibleCount > 0);
      if (countBadge) countBadge.textContent = String(visibleCount);
    }

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCat = btn.getAttribute('data-category') || 'all';

        btns.forEach((b) => {
          b.classList.remove('bg-[#10b981]', 'text-[#0d1117]', 'font-semibold', 'border-[#10b981]');
          b.classList.add('bg-[#161b22]', 'text-[#8b949e]', 'border-[#30363d]');
        });

        btn.classList.remove('bg-[#161b22]', 'text-[#8b949e]', 'border-[#30363d]');
        btn.classList.add('bg-[#10b981]', 'text-[#0d1117]', 'font-semibold', 'border-[#10b981]');

        filterProjects();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = (searchInput.value || '').trim().toLowerCase();
      filterProjects();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectFilters);
  } else {
    initProjectFilters();
  }
</script>
