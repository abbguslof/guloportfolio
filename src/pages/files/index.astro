---
// src/pages/files/index.astro - Dedikerad Fildelnings- och Resurshub
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InteractiveTerminal from '../../components/InteractiveTerminal.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const rawDownloads = await getCollection('downloads');
const downloads = rawDownloads.map((d) => ({
  id: d.id,
  ...d.data,
}));

// Hämta projekt och tankar för att kunna visa vilka inlägg som länkar till respektive fil
const projects = await getCollection('projects');
const thoughts = await getCollection('thoughts');

const projectMap = new Map();
for (const p of projects) {
  const slug = p.id.replace(/^(en|sv)\//, '');
  const isSv = p.id.startsWith('sv/');
  if (!projectMap.has(slug)) {
    projectMap.set(slug, { slug, titleEn: p.data.title, titleSv: p.data.title });
  }
  const entry = projectMap.get(slug);
  if (isSv) entry.titleSv = p.data.title;
  else entry.titleEn = p.data.title;
}
const thoughtMap = new Map(thoughts.map((t) => [t.id, { title: t.data.title, slug: t.id }]));

// Samla alla unika kategorier
const categories = ['Alla', ...Array.from(new Set(downloads.map((d) => d.category)))];
---

<Layout 
  titleEn="File Sharing & Resources // gulo" 
  titleSv="Fildelning & Resurser // gulo"
  descriptionEn="Downloadable scripts, resume, Minecraft server packages, dotfiles, and configurations with usage guides."
  descriptionSv="Nedladdningsbara skript, CV, Minecraft-serverpaket, dotfiles och konfigurationer med användarguider."
>
  <Header />

  <!-- Global terminal container on subpages (starts hidden, opens via header) -->
  <InteractiveTerminal isSubpage={true} />

  <main id="main-content" tabindex="-1" class="w-full py-4 space-y-8 font-mono outline-none">
    <!-- Breadcrumb & Top Header -->
    <div class="border-b border-[#30363d] pb-6">
      <div class="flex items-center gap-2 text-xs text-[#8b949e] mb-3">
        <a href="/" class="hover:text-[#10b981] transition-colors" data-i18n="files_breadcrumb_home">[~/home]</a>
        <span>/</span>
        <span class="text-[#e6edf3]" data-i18n="files_breadcrumb_current">files</span>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4">
        <div>
          <h1 class="text-xl sm:text-3xl font-bold text-[#e6edf3] tracking-tight" data-i18n="files_title">
            File Sharing &amp; Resources
          </h1>
          <p class="text-xs sm:text-sm text-[#8b949e] mt-1" data-i18n="files_subtitle">
            Optimized modpacks, Linux scripts, resume, and dotfiles. Click any resource for usage guide and linked projects.
          </p>
        </div>

        <div class="flex items-center gap-3 text-xs text-[#8b949e] self-start sm:self-auto">
          <span class="px-2.5 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#10b981]">
            <span id="file-count-badge">{downloads.length}</span> <span data-i18n="files_count_suffix">files available</span>
          </span>
        </div>
      </div>

      <!-- Search & Filters Bar -->
      <div class="mt-5 sm:mt-6 pt-4 border-t border-[#30363d]/60 space-y-3.5 sm:space-y-4">
        <!-- Live Search Bar -->
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none gap-1.5 text-xs font-mono text-[#8b949e]">
            <svg class="w-4 h-4 text-[#10b981] flex-shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.5 4.5 0 1 0-9 0 4.5 4.5 0 0 0 9 0Z"></path>
            </svg>
            <span class="font-semibold text-[#8b949e]">grep:</span>
          </div>
          <input 
            type="text" 
            id="file-search-input"
            data-i18n-placeholder="files_search_placeholder"
            placeholder="Search filename, description, category, or tag..." 
            class="w-full bg-[#161b22] text-[#e6edf3] text-xs pl-[82px] sm:pl-20 pr-4 py-2 min-h-[38px] sm:min-h-auto rounded-lg border border-[#30363d] focus:outline-none focus:border-[#10b981] placeholder-[#8b949e]/60 font-mono transition-colors"
          />
        </div>

        <!-- Controls: Category Filter & Sorting -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4 text-xs">
          <!-- Categories -->
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2" id="file-categories">
            <span class="text-[#8b949e] text-[11px] mr-1" data-i18n="files_filter_category">Category:</span>
            {categories.map((cat, i) => (
              <button 
                type="button" 
                class={`file-cat-btn px-3 py-1.5 sm:py-1 min-h-[34px] sm:min-h-auto rounded border transition-all cursor-pointer flex items-center ${
                  i === 0 
                    ? 'active bg-[#10b981] text-[#0d1117] font-semibold border-[#10b981]' 
                    : 'bg-[#161b22] text-[#8b949e] border-[#30363d] hover:text-[#e6edf3]'
                }`}
                data-cat={i === 0 ? 'all' : cat.toLowerCase()}
              >
                {i === 0 ? <span data-i18n="files_filter_all">[{cat === 'Alla' ? 'All' : cat}]</span> : `[${cat}]`}
              </button>
            ))}
          </div>

          <!-- Sorting -->
          <div class="flex items-center gap-2 self-start sm:self-auto">
            <span class="text-[#8b949e] text-[11px]" data-i18n="files_sort_label">Sort:</span>
            <select 
              id="file-sort-select" 
              class="bg-[#161b22] text-[#e6edf3] text-xs px-3 py-1.5 sm:py-1 min-h-[34px] sm:min-h-auto rounded border border-[#30363d] focus:outline-none focus:border-[#10b981] cursor-pointer font-mono"
            >
              <option value="newest" data-i18n="files_sort_newest">Recently updated</option>
              <option value="name" data-i18n="files_sort_name_asc">Name (A-Z)</option>
              <option value="size" data-i18n="files_sort_size_desc">File size</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Files List -->
    <div class="space-y-4" id="files-container">
      {downloads.map((item) => {
        const itemRelatedProjects = (item.relatedProjects || [])
          .map((id) => projectMap.get(id))
          .filter(Boolean);
        const itemRelatedThoughts = (item.relatedThoughts || [])
          .map((id) => thoughtMap.get(id))
          .filter(Boolean);

        return (
          <article 
            class="file-card rounded-lg bg-[#161b22] border border-[#30363d] hover:border-[#484f58] transition-all overflow-hidden"
            data-category={item.category.toLowerCase()}
            data-name={item.name.toLowerCase()}
            data-filename={item.filename.toLowerCase()}
            data-desc={item.description.toLowerCase()}
            data-tags={(item.tags || []).join(' ').toLowerCase()}
            data-date={item.updatedAt}
            data-size={item.size}
            id={`file-${item.id}`}
          >
            <!-- Card Main Row (Clickable for instant details, accessible via Tab/Enter) -->
            <div 
              class="file-card-header p-3.5 sm:p-5 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 sm:gap-4 cursor-pointer hover:bg-[#1c2128]/50 transition-colors"
              tabindex="0"
              role="button"
              aria-expanded="false"
              aria-label={`Details for ${item.name}`}
            >
              <div class="space-y-2 flex-1 min-w-0">
                <div class="flex items-center flex-wrap gap-2">
                  <span class="text-[11px] font-bold text-[#10b981] px-1.5 py-0.5 rounded bg-[#0d1117] border border-[#10b981]/40">
                    [{item.category}]
                  </span>
                  <span class="text-sm sm:text-base font-semibold text-[#e6edf3] group-hover:text-[#38bdf8] transition-colors">
                    {item.name}
                  </span>
                  <span class="text-xs text-[#8b949e]">({item.filename})</span>
                </div>

                <p class="text-xs sm:text-sm text-[#8b949e] leading-relaxed">
                  {item.description}
                </p>

                <!-- Metadata Row -->
                <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 pt-1 text-[11px] text-[#8b949e]">
                  <span><span data-i18n="files_size_label">Size:</span> <strong class="text-[#e6edf3]">{item.size}</strong></span>
                  <span>•</span>
                  <span><span data-i18n="files_updated_label">Updated:</span> <strong class="text-[#e6edf3]">{item.updatedAt}</strong></span>
                  {item.tags && item.tags.length > 0 && (
                    <>
                      <span>•</span>
                      <div class="flex items-center gap-1.5 flex-wrap">
                        {item.tags.map((t) => (
                          <span class="text-[10px] px-1 rounded bg-[#0d1117] border border-[#30363d] text-[#8b949e]">
                            #{t}
                          </span>
                        ))}
                      </div>
                    </>
                  )}
                </div>
              </div>

              <!-- Action buttons: side-by-side on mobile, stacked on desktop -->
              <div class="flex items-center sm:flex-col gap-2 w-full sm:w-auto shrink-0 mt-1 sm:mt-0">
                <a 
                  href={item.fileUrl}
                  download={item.filename}
                  class="file-download-btn flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:py-1.5 rounded bg-[#0d1117] border border-[#30363d] text-xs font-mono font-medium text-[#10b981] hover:bg-[#10b981] hover:text-[#0d1117] hover:border-[#10b981] active:scale-95 transition-all cursor-pointer min-h-[38px] sm:min-h-auto sm:min-w-[110px]"
                  title={`Download ${item.filename}`}
                >
                  <span data-i18n="files_download_btn_text">[Download ↓]</span>
                </a>
                
                <button 
                  type="button" 
                  class="file-expand-toggle flex-1 sm:flex-none inline-flex items-center justify-center gap-1 px-3 py-2 sm:py-1.5 rounded bg-[#161b22] border border-[#30363d] text-xs text-[#8b949e] hover:text-[#e6edf3] hover:border-[#8b949e] active:scale-95 transition-all cursor-pointer min-h-[38px] sm:min-h-auto sm:min-w-[110px]"
                  aria-expanded="false"
                >
                  <span class="toggle-text" data-i18n="files_info_expand">[More info ▼]</span>
                </button>
              </div>
            </div>

            <!-- Expandable Information Drawer -->
            <div class="file-drawer hidden px-3.5 sm:px-5 pb-5 pt-3 border-t border-[#30363d]/60 bg-[#0d1117]/60 space-y-4 text-xs">
              <!-- Usage command / guide -->
              {item.usage && (
                <div class="space-y-1.5">
                  <div class="text-[11px] text-[#38bdf8] font-semibold flex items-center justify-between">
                    <span data-i18n="files_quick_guide_title">Quick Guide / How to run:</span>
                    <span class="text-[10px] text-[#8b949e]" data-i18n="files_terminal_cmd">Terminal command</span>
                  </div>
                  <div class="p-2.5 rounded bg-[#0d1117] border border-[#30363d] flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3">
                    <code class="text-[#10b981] text-xs break-all sm:break-normal overflow-x-auto">{item.usage}</code>
                    <button 
                      type="button" 
                      class="copy-cmd-btn self-start sm:self-auto shrink-0 px-2.5 py-1 min-h-[30px] sm:min-h-auto rounded bg-[#161b22] border border-[#30363d] text-[11px] sm:text-[10px] text-[#8b949e] hover:text-[#e6edf3] hover:border-[#10b981] active:scale-95 transition-colors cursor-pointer"
                      data-cmd={item.usage}
                      title="Copy command"
                    >
                      <span data-i18n="files_copy_cmd">copy</span>
                      <span class="cmd-copy-check text-[#10b981] hidden ml-1">✓</span>
                    </button>
                  </div>
                </div>
              )}

              <!-- Referenced in Projects & Thoughts -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
                <div>
                  <span class="text-[11px] text-[#a78bfa] font-semibold block mb-1" data-i18n="files_ref_projects">
                    Referenced in projects:
                  </span>
                  {itemRelatedProjects.length > 0 ? (
                    <ul class="space-y-1 text-xs">
                      {itemRelatedProjects.map((p) => (
                        <li>
                          <a 
                            href={`/projects/${p?.slug}`} 
                            class="text-[#e6edf3] hover:text-[#38bdf8] hover:underline flex items-center gap-1.5"
                          >
                            <span class="text-[#a78bfa]">#</span>
                            <span class="lang-en-only">{p?.titleEn}</span>
                            <span class="lang-sv-only">{p?.titleSv}</span>
                            <span class="text-[10px] text-[#8b949e]">→</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <span class="text-[#8b949e] text-[11px]" data-i18n="files_standalone">Standalone resource.</span>
                  )}
                </div>

                <div>
                  <span class="text-[11px] text-[#f59e0b] font-semibold block mb-1" data-i18n="files_ref_thoughts">
                    Referenced in notes / blog:
                  </span>
                  {itemRelatedThoughts.length > 0 ? (
                    <ul class="space-y-1 text-xs">
                      {itemRelatedThoughts.map((t) => (
                        <li>
                          <a 
                            href={`/thoughts/${t?.slug}`} 
                            class="text-[#e6edf3] hover:text-[#38bdf8] hover:underline flex items-center gap-1.5"
                          >
                            <span class="text-[#f59e0b]">#</span>
                            <span>{t?.title}</span>
                            <span class="text-[10px] text-[#8b949e]">→</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <span class="text-[#8b949e] text-[11px]" data-i18n="files_no_linked_thoughts">No linked articles yet.</span>
                  )}
                </div>
              </div>

              <!-- Integrity Checksum -->
              {item.checksum && (
                <div class="pt-2 border-t border-[#30363d]/40 flex flex-wrap items-center justify-between gap-2 text-[11px]">
                  <div class="flex items-center gap-2">
                    <span class="text-[#8b949e]" data-i18n="files_checksum_label">Integrity check (SHA-256):</span>
                    <code class="text-[#e6edf3] px-1.5 py-0.5 rounded bg-[#0d1117] border border-[#30363d]">
                      {item.checksum}
                    </code>
                  </div>
                  <button 
                    type="button" 
                    class="sha-copy-btn px-2 py-0.5 rounded bg-[#161b22] border border-[#30363d] text-[10px] text-[#8b949e] hover:text-[#10b981] hover:border-[#10b981] transition-colors cursor-pointer"
                    data-sha={item.checksum}
                  >
                    <span data-i18n="files_copy_hash">Copy hash</span>
                    <span class="copy-status ml-1 text-[#10b981] hidden">✓</span>
                  </button>
                </div>
              )}
            </div>
          </article>
        );
      })}

      <div id="no-files-msg" class="py-12 text-center text-xs text-[#8b949e] hidden" data-i18n="files_no_match">
        No files match your search or filter.
      </div>
    </div>

    <!-- Return Nav -->
    <div class="pt-8 border-t border-[#30363d] flex items-center justify-between text-xs text-[#8b949e]">
      <a href="/" class="hover:text-[#10b981] transition-colors flex items-center gap-1.5">
        <span>←</span>
        <span data-i18n="projects_back_home">[Back to the cockpit]</span>
      </a>
      <span class="hidden sm:inline">gulo // file archives</span>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function initFilesPage() {
    const catBtns = document.querySelectorAll('.file-cat-btn');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.file-card'));
    const sortSelect = document.getElementById('file-sort-select') as HTMLSelectElement | null;
    const searchInput = document.getElementById('file-search-input') as HTMLInputElement | null;
    const container = document.getElementById('files-container');
    const noMsg = document.getElementById('no-files-msg');
    const countBadge = document.getElementById('file-count-badge');

    let currentCat = 'all';
    let searchQuery = '';

    function parseSizeToBytes(str: string): number {
      const match = str.trim().match(/^([\d.]+)\s*([a-zA-Z]+)?$/);
      if (!match) return 0;
      const num = parseFloat(match[1]);
      const unit = (match[2] || '').toUpperCase();
      if (unit.startsWith('G')) return num * 1024 * 1024 * 1024;
      if (unit.startsWith('M')) return num * 1024 * 1024;
      if (unit.startsWith('K')) return num * 1024;
      return num;
    }

    function filterAndSort() {
      let visible = cards.filter((card) => {
        const cat = card.getAttribute('data-category') || '';
        const name = card.getAttribute('data-name') || '';
        const filename = card.getAttribute('data-filename') || '';
        const desc = card.getAttribute('data-desc') || '';
        const tags = card.getAttribute('data-tags') || '';

        const catMatches = currentCat === 'all' || currentCat === 'alla' || cat === currentCat;
        const searchMatches = 
          !searchQuery || 
          name.includes(searchQuery) || 
          filename.includes(searchQuery) || 
          desc.includes(searchQuery) || 
          tags.includes(searchQuery) ||
          cat.includes(searchQuery);

        const isMatch = catMatches && searchMatches;
        card.style.display = isMatch ? '' : 'none';
        return isMatch;
      });

      const sortMode = sortSelect?.value || 'newest';
      visible.sort((a, b) => {
        if (sortMode === 'name') {
          return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
        }
        if (sortMode === 'date' || sortMode === 'newest') {
          return (b.getAttribute('data-date') || '').localeCompare(a.getAttribute('data-date') || '');
        }
        if (sortMode === 'size') {
          return parseSizeToBytes(b.getAttribute('data-size') || '') - parseSizeToBytes(a.getAttribute('data-size') || '');
        }
        return 0;
      });

      visible.forEach((card) => container?.appendChild(card));
      if (noMsg) noMsg.classList.toggle('hidden', visible.length > 0);
      if (countBadge) countBadge.textContent = String(visible.length);
    }

    // Category button clicks
    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCat = btn.getAttribute('data-cat') || 'all';

        catBtns.forEach((b) => {
          b.classList.remove('bg-[#10b981]', 'text-[#0d1117]', 'font-semibold', 'border-[#10b981]');
          b.classList.add('bg-[#161b22]', 'text-[#8b949e]', 'border-[#30363d]');
        });

        btn.classList.remove('bg-[#161b22]', 'text-[#8b949e]', 'border-[#30363d]');
        btn.classList.add('bg-[#10b981]', 'text-[#0d1117]', 'font-semibold', 'border-[#10b981]');

        filterAndSort();
      });
    });

    // Real-time search filter
    searchInput?.addEventListener('input', () => {
      searchQuery = (searchInput.value || '').trim().toLowerCase();
      filterAndSort();
    });

    sortSelect?.addEventListener('change', filterAndSort);

    // Expand / collapse info drawer
    function toggleDrawer(card: HTMLElement | null) {
      if (!card) return;
      const drawer = card.querySelector('.file-drawer');
      const btn = card.querySelector('.file-expand-toggle');
      const header = card.querySelector('.file-card-header');
      const textSpan = card.querySelector('.toggle-text');
      if (!drawer) return;

      const isHidden = drawer.classList.contains('hidden');
      drawer.classList.toggle('hidden', !isHidden);
      btn?.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      header?.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      if (textSpan) {
        const isSv = (document.documentElement.lang || '').startsWith('sv');
        if (isHidden) {
          textSpan.textContent = isSv ? '[Dölj info ▲]' : '[Hide info ▲]';
        } else {
          textSpan.textContent = isSv ? '[Mer info ▼]' : '[More info ▼]';
        }
      }
    }

    // Synchronize language change on existing drawer toggle buttons
    window.addEventListener('lang-change', () => {
      filterAndSort();
      const isSv = (document.documentElement.lang || '').startsWith('sv');
      document.querySelectorAll('.file-card').forEach((card) => {
        const drawer = card.querySelector('.file-drawer');
        const textSpan = card.querySelector('.toggle-text');
        if (drawer && textSpan) {
          const isOpen = !drawer.classList.contains('hidden');
          textSpan.textContent = isOpen 
            ? (isSv ? '[Dölj info ▲]' : '[Hide info ▲]') 
            : (isSv ? '[Mer info ▼]' : '[More info ▼]');
        }
      });
    });

    // Expand / collapse info drawer when clicking toggle button or anywhere on card header
    document.querySelectorAll('.file-expand-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = btn.closest<HTMLElement>('.file-card');
        toggleDrawer(card);
      });
    });

    document.querySelectorAll('.file-card-header').forEach((header) => {
      const handleToggle = (e: Event) => {
        const target = e.target as HTMLElement;
        if (target.closest('.file-download-btn') || target.closest('a') || target.closest('button')) {
          return;
        }
        const card = header.closest<HTMLElement>('.file-card');
        toggleDrawer(card);
      };

      header.addEventListener('click', handleToggle);
      header.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          const target = ke.target as HTMLElement;
          if (target.closest('.file-download-btn') || target.closest('a') || target.closest('button')) {
            return;
          }
          ke.preventDefault();
          handleToggle(e);
        }
      });
    });

    // Auto-expand and scroll if URL has hash (e.g. #file-fabric-server-pack)
    if (window.location.hash) {
      const targetCard = document.querySelector<HTMLElement>(window.location.hash);
      if (targetCard) {
        toggleDrawer(targetCard);
        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        targetCard.classList.add('ring-2', 'ring-[#10b981]');
        setTimeout(() => targetCard.classList.remove('ring-2', 'ring-[#10b981]'), 3000);
      }
    }

    // Copy command helper
    document.querySelectorAll('.copy-cmd-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const cmd = btn.getAttribute('data-cmd');
        if (cmd) {
          navigator.clipboard.writeText(cmd).then(() => {
            const check = btn.querySelector('.cmd-copy-check');
            if (check) {
              check.classList.remove('hidden');
              setTimeout(() => check.classList.add('hidden'), 2000);
            }
          });
        }
      });
    });

    // Copy SHA
    document.querySelectorAll('.sha-copy-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const sha = btn.getAttribute('data-sha');
        if (sha) {
          navigator.clipboard.writeText(sha).then(() => {
            const status = btn.querySelector('.copy-status');
            if (status) {
              status.classList.remove('hidden');
              setTimeout(() => status.classList.add('hidden'), 2000);
            }
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilesPage);
  } else {
    initFilesPage();
  }
</script>
