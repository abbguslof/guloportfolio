---
// src/pages/files/index.astro - Dedikerad Fildelnings- och Resurshub
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InteractiveTerminal from '../../components/InteractiveTerminal.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const rawDownloads = await getCollection('downloads');
const downloads = rawDownloads.map((d) => ({
  id: d.id,
  ...d.data,
}));

// Samla alla unika kategorier
const categories = ['Alla', ...Array.from(new Set(downloads.map((d) => d.category)))];
---

<Layout 
  title="Fildelning & Resurser // gulo" 
  description="Nedladdningsbara Minecraft-serverpaket, backup-skript, konfigurationer och dotfiles."
>
  <Header />

  <!-- Global terminal container on subpages (starts hidden, opens via header) -->
  <InteractiveTerminal isSubpage={true} />

  <main class="w-full max-w-5xl mx-auto py-4 space-y-8 font-mono">
    <!-- Breadcrumb & Top Header -->
    <div class="border-b border-[#30363d] pb-6">
      <div class="flex items-center gap-2 text-xs text-[#8b949e] mb-3">
        <a href="/" class="hover:text-[#10b981] transition-colors">[~/hem]</a>
        <span>/</span>
        <span class="text-[#e6edf3]">filer</span>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-[#e6edf3] tracking-tight">
            Fildelning &amp; Resurser
          </h1>
          <p class="text-xs sm:text-sm text-[#8b949e] mt-1">
            Optimerade modpacks, automatiserade Linux-skript och dotfiles att ladda ner och dela med vänner.
          </p>
        </div>

        <div class="flex items-center gap-3 text-xs text-[#8b949e]">
          <span class="px-2.5 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#10b981]">
            {downloads.length} filer tillgängliga
          </span>
        </div>
      </div>

      <!-- Controls: Category Filter & Sorting -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-6 pt-4 border-t border-[#30363d]/60 text-xs">
        <!-- Categories -->
        <div class="flex flex-wrap items-center gap-2" id="file-categories">
          <span class="text-[#8b949e] text-[11px] mr-1">Kategori:</span>
          {categories.map((cat, i) => (
            <button 
              type="button" 
              class={`file-cat-btn px-2.5 py-1 rounded border transition-all cursor-pointer ${
                i === 0 
                  ? 'active bg-[#10b981] text-[#0d1117] font-semibold border-[#10b981]' 
                  : 'bg-[#161b22] text-[#8b949e] border-[#30363d] hover:text-[#e6edf3]'
              }`}
              data-cat={cat.toLowerCase()}
            >
              [{cat}]
            </button>
          ))}
        </div>

        <!-- Sorting -->
        <div class="flex items-center gap-2">
          <span class="text-[#8b949e] text-[11px]">Sortera:</span>
          <select 
            id="file-sort-select" 
            class="bg-[#161b22] text-[#e6edf3] text-xs px-2.5 py-1 rounded border border-[#30363d] focus:outline-none focus:border-[#10b981] cursor-pointer"
          >
            <option value="newest">Senast uppdaterad</option>
            <option value="name">Namn (A-Ö)</option>
            <option value="size">Filstorlek</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Files List -->
    <div class="space-y-3" id="files-container">
      {downloads.map((item) => (
        <div 
          class="file-card p-4 rounded-lg bg-[#161b22] border border-[#30363d] hover:border-[#484f58] transition-all flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
          data-category={item.category.toLowerCase()}
          data-name={item.name.toLowerCase()}
          data-date={item.updatedAt}
          data-size={item.size}
        >
          <div class="space-y-1.5 flex-1">
            <div class="flex items-center flex-wrap gap-2">
              <span class="text-[11px] font-bold text-[#10b981] px-1.5 py-0.5 rounded bg-[#0d1117] border border-[#10b981]/40">
                [{item.category}]
              </span>
              <a 
                href={item.fileUrl}
                download={item.filename}
                class="text-sm font-semibold text-[#e6edf3] hover:text-[#38bdf8] hover:underline transition-colors"
              >
                {item.name}
              </a>
              <span class="text-xs text-[#8b949e]">({item.filename})</span>
            </div>

            <p class="text-xs text-[#8b949e] leading-relaxed">
              {item.description}
            </p>

            <div class="flex flex-wrap items-center gap-3 pt-1 text-[11px] text-[#8b949e]">
              <span>Storlek: <strong class="text-[#e6edf3]">{item.size}</strong></span>
              <span>•</span>
              <span>Uppdaterad: {item.updatedAt}</span>
              {item.checksum && (
                <>
                  <span>•</span>
                  <button 
                    type="button" 
                    class="sha-copy-btn hover:text-[#10b981] transition-colors cursor-pointer"
                    data-sha={item.checksum}
                    title="Kopiera SHA-checksumma"
                  >
                    SHA: <code>{item.checksum}</code>
                    <span class="copy-status ml-1 text-[#10b981] hidden">✓</span>
                  </button>
                </>
              )}
            </div>
          </div>

          <div class="shrink-0 self-start sm:self-center">
            <a 
              href={item.fileUrl}
              download={item.filename}
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded bg-[#0d1117] border border-[#30363d] text-xs font-mono font-medium text-[#10b981] hover:bg-[#10b981] hover:text-[#0d1117] hover:border-[#10b981] transition-all cursor-pointer"
            >
              <span>[Ladda ner</span>
              <span class="text-[11px]">↓]</span>
            </a>
          </div>
        </div>
      ))}

      <div id="no-files-msg" class="py-12 text-center text-xs text-[#8b949e] hidden">
        Inga filer matchar det valda filtret.
      </div>
    </div>

    <!-- Return Nav -->
    <div class="pt-8 border-t border-[#30363d] flex items-center justify-between text-xs text-[#8b949e]">
      <a href="/" class="hover:text-[#10b981] transition-colors flex items-center gap-1.5">
        <span>←</span>
        <span>[Tillbaka till cockpit]</span>
      </a>
      <span>gulo // file archives</span>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function initFilesPage() {
    const catBtns = document.querySelectorAll('.file-cat-btn');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.file-card'));
    const sortSelect = document.getElementById('file-sort-select') as HTMLSelectElement | null;
    const container = document.getElementById('files-container');
    const noMsg = document.getElementById('no-files-msg');

    let currentCat = 'all';

    function filterAndSort() {
      let visible = cards.filter((card) => {
        const cat = card.getAttribute('data-category') || '';
        const matches = currentCat === 'all' || cat === currentCat;
        card.style.display = matches ? '' : 'none';
        return matches;
      });

      const sortMode = sortSelect?.value || 'newest';
      visible.sort((a, b) => {
        if (sortMode === 'name') {
          return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
        }
        if (sortMode === 'date' || sortMode === 'newest') {
          return (b.getAttribute('data-date') || '').localeCompare(a.getAttribute('data-date') || '');
        }
        if (sortMode === 'size') {
          return parseFloat(b.getAttribute('data-size') || '0') - parseFloat(a.getAttribute('data-size') || '0');
        }
        return 0;
      });

      visible.forEach((card) => container?.appendChild(card));
      if (noMsg) noMsg.classList.toggle('hidden', visible.length > 0);
    }

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCat = btn.getAttribute('data-cat') || 'all';

        catBtns.forEach((b) => {
          b.classList.remove('bg-[#10b981]', 'text-[#0d1117]', 'font-semibold', 'border-[#10b981]');
          b.classList.add('bg-[#161b22]', 'text-[#8b949e]', 'border-[#30363d]');
        });

        btn.classList.remove('bg-[#161b22]', 'text-[#8b949e]', 'border-[#30363d]');
        btn.classList.add('bg-[#10b981]', 'text-[#0d1117]', 'font-semibold', 'border-[#10b981]');

        filterAndSort();
      });
    });

    sortSelect?.addEventListener('change', filterAndSort);

    // Copy SHA
    document.querySelectorAll('.sha-copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const sha = btn.getAttribute('data-sha');
        if (sha) {
          navigator.clipboard.writeText(sha).then(() => {
            const status = btn.querySelector('.copy-status');
            if (status) {
              status.classList.remove('hidden');
              setTimeout(() => status.classList.add('hidden'), 2000);
            }
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilesPage);
  } else {
    initFilesPage();
  }
</script>
