---
// src/pages/thoughts/index.astro - Writing archive
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InteractiveTerminal from '../../components/InteractiveTerminal.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '../../utils/readingTime';

const thoughts = await getCollection('thoughts');
const sortedThoughts = thoughts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const categoryDefs = [
  { key: 'tanke', labelKey: 'thoughts_cat_tanke_badge', label: '[Thought]', className: 'cat-thought' },
  { key: 'guide', labelKey: 'thoughts_cat_guide_badge', label: '[Guide]', className: 'cat-guide' },
  { key: 'anteckning', labelKey: 'thoughts_cat_anteckning_badge', label: '[Note]', className: 'cat-note' },
  { key: 'idea', labelKey: 'thoughts_cat_idea_badge', label: '[Idea]', className: 'cat-idea' },
];

const normalizeCategory = (raw: string) => {
  if (raw === 'thought') return 'tanke';
  if (raw === 'note') return 'anteckning';
  if (raw === 'idé') return 'idea';
  return raw;
};

const counts = sortedThoughts.reduce<Record<string, number>>((acc, post) => {
  const key = normalizeCategory(post.data.category || 'tanke');
  acc[key] = (acc[key] || 0) + 1;
  return acc;
}, {});

const activeCategories = categoryDefs.filter((cat) => (counts[cat.key] || 0) > 0);

const allTags = Array.from(
  new Set(sortedThoughts.flatMap((post) => post.data.tags))
).sort();
---

<Layout
  titleEn="Writing"
  titleSv="Texter"
  descriptionEn="Notes on systems, hardware, Linux, and training."
  descriptionSv="Anteckningar om system, hårdvara, Linux och träning."
>
  <Header />

  <InteractiveTerminal isSubpage={true} />

  <main id="main-content" tabindex="-1" class="w-full py-4 space-y-8 outline-none" style="--page-accent:#f59e0b;">
    <div class="pb-5 border-b border-[#30363d]">
      <nav class="flex items-center gap-2 text-[11px] text-[#8b949e] mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#e6edf3] transition-colors" data-i18n="thoughts_breadcrumb_home">Home</a>
        <span aria-hidden="true">/</span>
        <span class="text-[#e6edf3]" data-i18n="thoughts_breadcrumb_current">Writing</span>
      </nav>

      <h1 class="text-2xl sm:text-3xl font-semibold text-[#e6edf3] tracking-tight">
        <span class="text-[#f59e0b] font-bold mr-1.5">#</span><span data-i18n="thoughts_title">Writing</span>
      </h1>
      <p class="mt-1 max-w-[60ch] font-serif text-[18px] leading-relaxed text-[#b0bac4]" data-i18n="thoughts_subtitle">
        Notes on systems, hardware, Linux, and training.
      </p>
      <p class="lang-sv-only mt-2 text-[11px] text-[#8b949e]" data-i18n="thoughts_archive_lang_note">
        (Articles and notes are published in English)
      </p>
    </div>

    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-2" id="category-cards-container">
        {activeCategories.map((cat) => (
          <button
            type="button"
            class={`cat-toggle-card ${cat.className} px-2.5 py-1.5 min-h-[32px] rounded border border-[#30363d] bg-[#161b22] text-[11px] cursor-pointer transition-colors select-none`}
            data-cat={cat.key}
            aria-pressed="false"
          >
            <span class="font-semibold cat-label" data-i18n={cat.labelKey}>{cat.label}</span>
            <span class="ml-1.5 text-[#8b949e]">{counts[cat.key]}</span>
          </button>
        ))}
        <button
          type="button"
          id="btn-reset-categories"
          class="hidden text-[11px] text-[#8b949e] hover:text-[#e6edf3] transition-colors px-1 py-1 cursor-pointer"
          data-i18n="thoughts_reset_filter"
        >
          Show all
        </button>
      </div>

      <label class="relative block">
        <span class="sr-only">Search writing</span>
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-[#8b949e]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.5 4.5 0 1 0-9 0 4.5 4.5 0 0 0 9 0Z"></path>
        </svg>
        <input
          type="text"
          id="thought-search-input"
          data-i18n-placeholder="thoughts_search_placeholder"
          placeholder="Search writing"
          class="w-full bg-[#161b22] text-[#e6edf3] text-xs pl-9 pr-4 py-2.5 min-h-[38px] rounded border border-[#30363d] focus:outline-none focus:border-[#10b981] placeholder-[#8b949e]/60 font-mono transition-colors"
        />
      </label>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-[11px]">
        <div class="flex flex-wrap items-center gap-1.5" id="blog-tag-bar">
          <span class="text-[#8b949e] mr-0.5" data-i18n="thoughts_tag_filter_label">Tags</span>
          <button
            type="button"
            class="tag-filter-btn px-2 py-1 min-h-[28px] rounded border border-[#30363d] bg-[#161b22] text-[#8b949e] hover:text-[#e6edf3] transition-colors cursor-pointer"
            data-tag="all"
            aria-pressed="true"
            data-i18n="thoughts_tag_all"
          >
            All
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              class="tag-filter-btn px-2 py-1 min-h-[28px] rounded border border-[#30363d] bg-[#161b22] text-[#8b949e] hover:text-[#e6edf3] transition-colors cursor-pointer"
              data-tag={tag.toLowerCase()}
            >
              {tag}
            </button>
          ))}
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <span class="text-[#8b949e]" data-i18n="thoughts_sort_label">Sort</span>
          <div class="inline-flex rounded border border-[#30363d] overflow-hidden" id="sort-controls">
            <button
              type="button"
              id="btn-sort-newest"
              class="sort-btn px-2.5 py-1 min-h-[28px] text-[#e6edf3] bg-[#1b212a] cursor-pointer transition-colors"
              data-order="desc"
              aria-pressed="true"
              data-i18n="thoughts_sort_newest"
            >
              Newest
            </button>
            <button
              type="button"
              id="btn-sort-oldest"
              class="sort-btn px-2.5 py-1 min-h-[28px] text-[#8b949e] bg-[#161b22] cursor-pointer transition-colors"
              data-order="asc"
              aria-pressed="false"
              data-i18n="thoughts_sort_oldest"
            >
              Oldest
            </button>
          </div>
        </div>
      </div>
    </div>

    {sortedThoughts.length > 0 ? (
      <div class="border-t border-[#30363d]" id="thoughts-list">
        {sortedThoughts.map((post) => {
          const formattedDate = post.data.pubDate.toISOString().slice(0, 10);
          const category = normalizeCategory(post.data.category || 'tanke');
          const cat = categoryDefs.find((c) => c.key === category) || categoryDefs[0];
          const timestamp = post.data.pubDate.getTime();
          const reading = calculateReadingTime(post.body || '');

          return (
            <article
              class={`thought-card ${cat.className} relative border-b border-[#30363d] px-2 sm:px-3 py-5 group`}
              data-category={category}
              data-tags={(post.data.tags || []).join(',').toLowerCase()}
              data-title={post.data.title.toLowerCase()}
              data-desc={(post.data.description || '').toLowerCase()}
              data-timestamp={timestamp}
            >
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-[#8b949e]">
                <a
                  href={`/thoughts?category=${cat.key}`}
                  class={`${cat.className} cat-label relative z-10 font-semibold hover:underline underline-offset-4`}
                  data-filter-category-link={cat.key}
                  data-i18n={cat.labelKey}
                >{cat.label}</a>
                <time datetime={formattedDate}>{formattedDate}</time>
                <span class="post-reading-time" data-reading-en={reading.textEn} data-reading-sv={reading.textSv}>
                  {reading.textEn}
                </span>
                <div class="flex flex-wrap items-center gap-1.5 sm:ml-auto">
                  {(post.data.tags || []).map((tag) => (
                    <a
                      href={`/thoughts?tag=${encodeURIComponent(tag.toLowerCase())}`}
                      class="relative z-10 text-[10px] text-[#8b949e] bg-[#161b22] border border-[#30363d] px-1.5 py-0.5 rounded hover:text-[#e6edf3] hover:border-[#484f58] transition-colors"
                      data-filter-tag-link={tag.toLowerCase()}
                    >{tag}</a>
                  ))}
                  {post.data.pdfUrl && (
                    <span class="text-[10px] text-[#4fbf8b] border border-[#4fbf8b]/40 px-1.5 py-0.5 rounded" title={post.data.pdfName || 'Companion PDF'}>
                      PDF
                    </span>
                  )}
                </div>
              </div>

              <h2 class="mt-2 text-base sm:text-lg font-semibold text-[#e6edf3]">
                <a href={`/thoughts/${post.id}`} class="text-[#e6edf3] hover:text-[var(--cat)] hover:underline underline-offset-4 transition-colors focus-visible:outline-none">
                  <span class="absolute inset-0" aria-hidden="true"></span>
                  {post.data.title}
                </a>
              </h2>

              {post.data.description && (
                <p class="mt-1 max-w-[62ch] font-serif text-[16px] leading-relaxed text-[#b0bac4]">
                  {post.data.description}
                </p>
              )}
            </article>
          );
        })}

        <p id="no-articles-msg" class="py-10 text-sm text-[#8b949e] hidden" data-i18n="thoughts_no_match">
          Nothing matches that search.
        </p>
      </div>
    ) : (
      <p class="py-10 text-sm text-[#8b949e]" data-i18n="thoughts_empty_desc">
        No writing published yet.
      </p>
    )}

    <div class="pt-6 border-t border-[#30363d] flex items-center justify-between text-xs text-[#8b949e]">
      <a href="/" class="hover:text-[#e6edf3] transition-colors" data-i18n="thoughts_back_home">Back home</a>
      <span class="select-none font-mono" aria-hidden="true">:wq</span>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function initWritingArchive() {
    const toggleCards = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-toggle-card'));
    const btnReset = document.getElementById('btn-reset-categories');
    const tagBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn'));
    const searchInput = document.getElementById('thought-search-input') as HTMLInputElement | null;
    const listContainer = document.getElementById('thoughts-list');
    const items = Array.from(document.querySelectorAll<HTMLElement>('.thought-card'));
    const noMsg = document.getElementById('no-articles-msg');
    const btnSortNewest = document.getElementById('btn-sort-newest');
    const btnSortOldest = document.getElementById('btn-sort-oldest');
    const filterCategoryLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-filter-category-link]'));
    const filterTagLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-filter-tag-link]'));

    const selectedCategories = new Set<string>();
    const categoryCount = toggleCards.length;

    let currentTag = 'all';
    let searchQuery = '';
    let currentSort = 'desc';

    function isFiltered() {
      return selectedCategories.size > 0 && selectedCategories.size < categoryCount;
    }

    function updateFilterVisuals() {
      if (btnReset) btnReset.classList.toggle('hidden', !isFiltered());
      toggleCards.forEach((card) => {
        const cat = card.getAttribute('data-cat') || '';
        card.setAttribute('aria-pressed', selectedCategories.has(cat) ? 'true' : 'false');
      });
    }

    function applyFilterAndSort() {
      const filtered = isFiltered();
      let visibleCount = 0;

      items.forEach((item) => {
        const cat = item.getAttribute('data-category') || '';
        const tags = (item.getAttribute('data-tags') || '').split(',');
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-desc') || '';

        const catMatches = !filtered || selectedCategories.has(cat);
        const tagMatches = currentTag === 'all' || tags.includes(currentTag);
        const searchMatches =
          !searchQuery ||
          title.includes(searchQuery) ||
          desc.includes(searchQuery) ||
          cat.includes(searchQuery) ||
          tags.some((t) => t.includes(searchQuery));

        const isMatch = catMatches && tagMatches && searchMatches;
        item.style.display = isMatch ? '' : 'none';
        if (isMatch) visibleCount++;
      });

      if (listContainer) {
        const sortedItems = [...items].sort((a, b) => {
          const tA = Number(a.getAttribute('data-timestamp') || 0);
          const tB = Number(b.getAttribute('data-timestamp') || 0);
          return currentSort === 'desc' ? tB - tA : tA - tB;
        });

        sortedItems.forEach((el) => listContainer.appendChild(el));
        if (noMsg) listContainer.appendChild(noMsg);
      }

      if (noMsg) noMsg.classList.toggle('hidden', visibleCount > 0);
    }

    function syncUrl() {
      const params = new URLSearchParams(window.location.search);
      const cats = Array.from(selectedCategories);
      if (cats.length > 0 && cats.length < categoryCount) {
        params.set('category', cats.join(','));
      } else {
        params.delete('category');
      }
      if (currentTag !== 'all') {
        params.set('tag', currentTag);
      } else {
        params.delete('tag');
      }
      const query = params.toString();
      history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
    }

    toggleCards.forEach((card) => {
      card.addEventListener('click', () => {
        const cat = card.getAttribute('data-cat') || '';
        if (selectedCategories.has(cat)) {
          selectedCategories.delete(cat);
        } else {
          selectedCategories.add(cat);
        }
        updateFilterVisuals();
        applyFilterAndSort();
        syncUrl();
      });
    });

    btnReset?.addEventListener('click', () => {
      const resetHadFocus = document.activeElement === btnReset;
      selectedCategories.clear();
      updateFilterVisuals();
      applyFilterAndSort();
      syncUrl();
      if (resetHadFocus) toggleCards[0]?.focus();
    });

    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentTag = btn.getAttribute('data-tag') || 'all';
        tagBtns.forEach((b) => {
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });
        applyFilterAndSort();
        syncUrl();
      });
    });

    filterCategoryLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const cat = link.getAttribute('data-filter-category-link') || '';
        if (!cat) return;
        selectedCategories.clear();
        selectedCategories.add(cat);
        updateFilterVisuals();
        applyFilterAndSort();
        syncUrl();
        const firstVisible = items.find((item) => item.style.display !== 'none');
        const target = firstVisible?.querySelector<HTMLAnchorElement>('h2 a') ?? searchInput ?? toggleCards[0];
        target?.focus();
      });
    });

    filterTagLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const tag = link.getAttribute('data-filter-tag-link') || 'all';
        currentTag = tag;
        tagBtns.forEach((b) => {
          b.setAttribute('aria-pressed', b.getAttribute('data-tag') === tag ? 'true' : 'false');
        });
        applyFilterAndSort();
        syncUrl();
        const firstVisible = items.find((item) => item.style.display !== 'none');
        const target = firstVisible?.querySelector<HTMLAnchorElement>('h2 a') ?? searchInput ?? tagBtns[0];
        target?.focus();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = (searchInput.value || '').trim().toLowerCase();
      applyFilterAndSort();
    });

    function setSort(order: 'desc' | 'asc') {
      currentSort = order;
      btnSortNewest?.setAttribute('aria-pressed', order === 'desc' ? 'true' : 'false');
      btnSortOldest?.setAttribute('aria-pressed', order === 'asc' ? 'true' : 'false');
      applyFilterAndSort();
    }

    btnSortNewest?.addEventListener('click', () => setSort('desc'));
    btnSortOldest?.addEventListener('click', () => setSort('asc'));

    function updateReadingTimes() {
      const isSv = (document.documentElement.lang || '').startsWith('sv');
      document.querySelectorAll<HTMLElement>('.post-reading-time').forEach((el) => {
        const text = isSv ? el.getAttribute('data-reading-sv') : el.getAttribute('data-reading-en');
        if (text) el.textContent = text;
      });
    }

    const initialParams = new URLSearchParams(window.location.search);
    const initialCategory = initialParams.get('category');
    if (initialCategory) {
      initialCategory.split(',').map((value) => value.trim()).filter(Boolean).forEach((cat) => {
        if (toggleCards.some((card) => card.getAttribute('data-cat') === cat)) {
          selectedCategories.add(cat);
        }
      });
    }
    const initialTag = initialParams.get('tag');
    if (initialTag) {
      const tag = initialTag.toLowerCase();
      const tagButton = tagBtns.find((button) => button.getAttribute('data-tag') === tag);
      if (tagButton) {
        currentTag = tag;
        tagBtns.forEach((button) => {
          button.setAttribute('aria-pressed', button === tagButton ? 'true' : 'false');
        });
      }
    }
    updateFilterVisuals();
    applyFilterAndSort();

    updateReadingTimes();

    window.addEventListener('lang-change', () => {
      updateReadingTimes();
      applyFilterAndSort();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWritingArchive);
  } else {
    initWritingArchive();
  }
</script>
