---
// src/pages/thoughts/index.astro - Fullständig Blogg-, Tanke- & Anteckningsarkiv
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InteractiveTerminal from '../../components/InteractiveTerminal.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '../../utils/readingTime';

const thoughts = await getCollection('thoughts');
const sortedThoughts = thoughts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Räkna antal per kategori
const countTankar = sortedThoughts.filter((t) => t.data.category === 'tanke' || t.data.category === 'thought').length;
const countGuider = sortedThoughts.filter((t) => t.data.category === 'guide').length;
const countAnteckningar = sortedThoughts.filter((t) => t.data.category === 'anteckning' || t.data.category === 'note').length;

const allTags = Array.from(
  new Set(sortedThoughts.flatMap((post) => post.data.tags))
).sort();
---

<Layout 
  titleEn="Thoughts, Guides & Notes // gulo" 
  titleSv="Tankar, Guider & Anteckningar // gulo"
  descriptionEn="Personal notes from Chalmers Computer Science & Engineering, competitive swimming, Minecraft homelab, and C/Linux system programming."
  descriptionSv="Anteckningar från Chalmers Datateknik, tävlingssimning, Minecraft-homelab och systemprogrammering i C/Linux."
>
  <Header />

  <!-- Global terminal on subpages (opens on header button click) -->
  <InteractiveTerminal isSubpage={true} />

  <main id="main-content" tabindex="-1" class="w-full py-4 space-y-8 outline-none">
    <!-- Breadcrumb & Top Header -->
    <div class="border-b border-[#30363d] pb-6">
      <div class="flex items-center gap-2 text-xs font-mono text-[#8b949e] mb-3">
        <a href="/" class="hover:text-[#10b981] transition-colors" data-i18n="thoughts_breadcrumb_home">[~/home]</a>
        <span>/</span>
        <span class="text-[#e6edf3]" data-i18n="thoughts_breadcrumb_current">thoughts</span>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4">
        <div>
          <h1 class="text-xl sm:text-3xl font-bold font-mono text-[#e6edf3] tracking-tight" data-i18n="thoughts_title">
            Thoughts, Guides &amp; Notes
          </h1>
          <p class="text-xs sm:text-sm text-[#8b949e] mt-1 font-mono" data-i18n="thoughts_subtitle">
            A text-first digital garden. Click one or more cards below to filter categories.
          </p>
          <p class="lang-sv-only text-[11px] text-[#f59e0b] mt-1 font-mono flex items-center gap-1.5" data-i18n="thoughts_archive_lang_note">
            (Inläggen i arkivet publiceras enbart på engelska)
          </p>
        </div>

        <!-- Antal tillgängliga inlägg -->
        <div class="flex items-center gap-3 text-xs font-mono self-start sm:self-auto">
          <span class="px-2.5 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#10b981] font-mono text-xs">
            <span id="thought-count-badge">{sortedThoughts.length}</span> <span data-i18n="thoughts_count_badge_suffix">posts available</span>
          </span>
        </div>
      </div>

      <!-- Interactive Multi-Select Category Cards -->
      <div class="mt-5 sm:mt-6 pt-4 sm:pt-5 border-t border-[#30363d]/60 space-y-3">
        <div class="flex items-center justify-between text-xs font-mono">
          <span class="text-[#8b949e] text-[11px] uppercase tracking-wider font-semibold" data-i18n="thoughts_filter_instructions">
            Select categories to display:
          </span>
          <button 
            type="button" 
            id="btn-reset-categories" 
            class="hidden text-[11px] text-[#38bdf8] hover:text-[#10b981] hover:underline cursor-pointer transition-colors"
            data-i18n="thoughts_reset_filter"
          >
            [Show all categories]
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono" id="category-cards-container">
          <!-- Card 1: TANKE -->
          <button 
            type="button" 
            class="cat-toggle-card text-left p-3 sm:p-3.5 rounded-lg bg-[#161b22] border border-[#30363d] hover:border-[#f59e0b]/80 active:scale-[0.99] transition-all cursor-pointer group flex flex-col justify-between gap-2.5 select-none"
            data-cat="tanke"
            aria-pressed="false"
          >
            <div class="flex items-center justify-between w-full">
              <span class="text-[#f59e0b] font-bold tracking-wide" data-i18n="thoughts_cat_tanke_badge">[THOUGHT]</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#8b949e] cat-count">
                {countTankar} <span data-i18n="thoughts_count_suffix">posts</span>
              </span>
            </div>
            <p class="text-[#8b949e] text-[11px] leading-relaxed group-hover:text-[#e6edf3] transition-colors" data-i18n="thoughts_cat_tanke_desc">
              Deeper reflections, personal philosophy on swimming, studies, and engineering.
            </p>
            <div class="flex items-center justify-between text-[10px] text-[#8b949e] pt-1.5 border-t border-[#30363d]/40 w-full">
              <span class="cat-status-text" data-i18n="thoughts_card_click_to_filter">Click to filter</span>
              <span class="cat-indicator-dot w-2 h-2 rounded-full border border-[#8b949e]"></span>
            </div>
          </button>

          <!-- Card 2: GUIDE -->
          <button 
            type="button" 
            class="cat-toggle-card text-left p-3 sm:p-3.5 rounded-lg bg-[#161b22] border border-[#30363d] hover:border-[#38bdf8]/80 active:scale-[0.99] transition-all cursor-pointer group flex flex-col justify-between gap-2.5 select-none"
            data-cat="guide"
            aria-pressed="false"
          >
            <div class="flex items-center justify-between w-full">
              <span class="text-[#38bdf8] font-bold tracking-wide" data-i18n="thoughts_cat_guide_badge">[GUIDE]</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#8b949e] cat-count">
                {countGuider} <span data-i18n="thoughts_count_suffix">posts</span>
              </span>
            </div>
            <p class="text-[#8b949e] text-[11px] leading-relaxed group-hover:text-[#e6edf3] transition-colors" data-i18n="thoughts_cat_guide_desc">
              Practical tutorials, server configurations, and lab walkthroughs.
            </p>
            <div class="flex items-center justify-between text-[10px] text-[#8b949e] pt-1.5 border-t border-[#30363d]/40 w-full">
              <span class="cat-status-text" data-i18n="thoughts_card_click_to_filter">Click to filter</span>
              <span class="cat-indicator-dot w-2 h-2 rounded-full border border-[#8b949e]"></span>
            </div>
          </button>

          <!-- Card 3: ANTECKNING -->
          <button 
            type="button" 
            class="cat-toggle-card text-left p-3 sm:p-3.5 rounded-lg bg-[#161b22] border border-[#30363d] hover:border-[#10b981]/80 active:scale-[0.99] transition-all cursor-pointer group flex flex-col justify-between gap-2.5 select-none"
            data-cat="anteckning"
            aria-pressed="false"
          >
            <div class="flex items-center justify-between w-full">
              <span class="text-[#10b981] font-bold tracking-wide" data-i18n="thoughts_cat_anteckning_badge">[NOTE]</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#8b949e] cat-count">
                {countAnteckningar} <span data-i18n="thoughts_count_suffix">posts</span>
              </span>
            </div>
            <p class="text-[#8b949e] text-[11px] leading-relaxed group-hover:text-[#e6edf3] transition-colors" data-i18n="thoughts_cat_anteckning_desc">
              Quick observations, cheat-sheets, and debugging logs.
            </p>
            <div class="flex items-center justify-between text-[10px] text-[#8b949e] pt-1.5 border-t border-[#30363d]/40 w-full">
              <span class="cat-status-text" data-i18n="thoughts_card_click_to_filter">Click to filter</span>
              <span class="cat-indicator-dot w-2 h-2 rounded-full border border-[#8b949e]"></span>
            </div>
          </button>
        </div>

        <!-- Live Search Input -->
        <div class="relative pt-2">
          <div class="absolute inset-y-0 left-0 pl-3 pt-2 flex items-center pointer-events-none gap-1.5 text-xs font-mono text-[#8b949e]">
            <svg class="w-4 h-4 text-[#10b981] flex-shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.5 4.5 0 1 0-9 0 4.5 4.5 0 0 0 9 0Z"></path>
            </svg>
            <span class="font-semibold text-[#8b949e]">grep:</span>
          </div>
          <input 
            type="text" 
            id="thought-search-input"
            data-i18n-placeholder="thoughts_search_placeholder"
            placeholder="Search thoughts, tags, or content..." 
            class="w-full bg-[#161b22] text-[#e6edf3] text-xs pl-16 sm:pl-20 pr-4 py-2 min-h-[38px] sm:min-h-auto rounded-lg border border-[#30363d] focus:outline-none focus:border-[#10b981] placeholder-[#8b949e]/60 font-mono transition-colors"
          />
        </div>

        <!-- Tag Filters & Sortering -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs font-mono pt-1">
          <!-- Tag Filters -->
          <div class="flex flex-wrap items-center gap-1.5" id="blog-tag-bar">
            <span class="text-[#8b949e] text-[11px] mr-1" data-i18n="thoughts_tag_filter_label">Tag filter:</span>
            <button 
              type="button" 
              class="tag-filter-btn active px-2.5 py-1 min-h-[30px] sm:min-h-auto rounded bg-[#10b981] text-[#0d1117] font-semibold text-[11px] border border-[#10b981] transition-all cursor-pointer flex items-center"
              data-tag="all"
              data-i18n="thoughts_tag_all"
            >
              All
            </button>
            {allTags.map((tag) => (
              <button 
                type="button" 
                class="tag-filter-btn px-2.5 py-1 min-h-[30px] sm:min-h-auto rounded bg-[#161b22] text-[#8b949e] text-[11px] border border-[#30363d] hover:text-[#e6edf3] transition-all cursor-pointer flex items-center"
                data-tag={tag.toLowerCase()}
              >
                #{tag}
              </button>
            ))}
          </div>

          <!-- Sortering flyttad hit till höger om taggarna -->
          <div class="flex items-center gap-2 flex-shrink-0 self-start sm:self-auto">
            <span class="text-[#8b949e] text-[11px]" data-i18n="thoughts_sort_label">Sort:</span>
            <div class="inline-flex rounded-lg p-0.5 bg-[#0d1117] border border-[#30363d]" id="sort-controls">
              <button 
                type="button" 
                id="btn-sort-newest" 
                class="sort-btn active px-3 py-1.5 min-h-[32px] sm:min-h-auto rounded text-[11px] font-semibold bg-[#161b22] text-[#e6edf3] border border-[#30363d] cursor-pointer transition-all flex items-center"
                data-order="desc"
                data-i18n-title="thoughts_sort_newest_title"
                title="Sort by newest publication date first"
              >
                <span data-i18n="thoughts_sort_newest">Newest ↓</span>
              </button>
              <button 
                type="button" 
                id="btn-sort-oldest" 
                class="sort-btn px-3 py-1.5 min-h-[32px] sm:min-h-auto rounded text-[11px] text-[#8b949e] hover:text-[#e6edf3] cursor-pointer transition-all flex items-center"
                data-order="asc"
                data-i18n-title="thoughts_sort_oldest_title"
                title="Sort by oldest publication date first"
              >
                <span data-i18n="thoughts_sort_oldest">Oldest ↑</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Articles Digital Garden / Log List -->
    <div class="space-y-4" id="thoughts-list">
      {sortedThoughts.map((post) => {
        const formattedDate = post.data.pubDate.toISOString().slice(0, 10);
        const rawCategory = post.data.category || 'tanke';
        const category = (rawCategory === 'thought') ? 'tanke' : ((rawCategory === 'note') ? 'anteckning' : ((rawCategory === 'idé') ? 'idea' : rawCategory));
        const timestamp = post.data.pubDate.getTime();
        const reading = calculateReadingTime(post.body || '');

        // Dynamisk badge-styling och hover-färger per kategori
        let catBadgeClass = 'text-[#f59e0b] border-[#f59e0b]/40 bg-[#f59e0b]/10';
        let catBadgeKey = 'thoughts_cat_tanke_badge';
        let catLabel = '[THOUGHT]';
        let catCardHoverBorder = 'hover:border-[#f59e0b]/80';
        let catHoverText = 'group-hover:text-[#f59e0b]';
        let catQuoteBorder = 'group-hover:border-[#f59e0b]';

        if (category === 'guide') {
          catBadgeClass = 'text-[#38bdf8] border-[#38bdf8]/40 bg-[#38bdf8]/10';
          catBadgeKey = 'thoughts_cat_guide_badge';
          catLabel = '[GUIDE]';
          catCardHoverBorder = 'hover:border-[#38bdf8]/80';
          catHoverText = 'group-hover:text-[#38bdf8]';
          catQuoteBorder = 'group-hover:border-[#38bdf8]';
        } else if (category === 'anteckning') {
          catBadgeClass = 'text-[#10b981] border-[#10b981]/40 bg-[#10b981]/10';
          catBadgeKey = 'thoughts_cat_anteckning_badge';
          catLabel = '[NOTE]';
          catCardHoverBorder = 'hover:border-[#10b981]/80';
          catHoverText = 'group-hover:text-[#10b981]';
          catQuoteBorder = 'group-hover:border-[#10b981]';
        } else if (category === 'idea') {
          catBadgeClass = 'text-[#a78bfa] border-[#a78bfa]/40 bg-[#a78bfa]/10';
          catBadgeKey = 'thoughts_cat_idea_badge';
          catLabel = '[IDEA]';
          catCardHoverBorder = 'hover:border-[#a78bfa]/80';
          catHoverText = 'group-hover:text-[#a78bfa]';
          catQuoteBorder = 'group-hover:border-[#a78bfa]';
        }

        return (
          <article 
            class={`thought-card rounded-lg bg-[#161b22] border border-[#30363d] ${catCardHoverBorder} transition-all p-5 space-y-3 group`}
            data-category={category}
            data-tags={(post.data.tags || []).join(',').toLowerCase()}
            data-title={post.data.title.toLowerCase()}
            data-desc={(post.data.description || '').toLowerCase()}
            data-timestamp={timestamp}
          >
            <!-- Meta row -->
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-[#8b949e]">
              <div class="flex items-center gap-2">
                <span class={`text-[11px] font-bold px-2 py-0.5 rounded border ${catBadgeClass}`} data-i18n={catBadgeKey}>
                  {catLabel}
                </span>
                <span class="text-xs text-[#8b949e]">
                  {formattedDate}
                </span>
                <span class="text-[#30363d]">•</span>
                <span 
                  class="text-[11px] text-[#8b949e] post-reading-time" 
                  data-reading-en={reading.textEn}
                  data-reading-sv={reading.textSv}
                >
                  {reading.textEn}
                </span>
              </div>

              <!-- Tags -->
              <div class="flex items-center gap-1.5 flex-wrap">
                {(post.data.tags || []).map((tag) => (
                  <span class={`text-[10px] px-1.5 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#8b949e] ${catHoverText} transition-colors`}>
                    #{tag}
                  </span>
                ))}
                {post.data.pdfUrl && (
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-[#10b981]/10 border border-[#10b981]/40 text-[#10b981] font-mono flex items-center gap-0.5 font-semibold" title={post.data.pdfName || 'Companion PDF available'}>
                    <span>↓</span>
                    <span>PDF</span>
                  </span>
                )}
              </div>
            </div>

            <!-- Title -->
            <h2 class={`text-base sm:text-lg font-bold text-[#e6edf3] ${catHoverText} transition-colors`}>
              <a href={`/thoughts/${post.id}`} class="hover:underline flex items-center justify-between gap-2">
                <span>{post.data.title}</span>
                <span class={`text-xs text-[#8b949e] ${catHoverText} group-hover:translate-x-1 transition-all shrink-0 font-mono`} data-i18n="thoughts_read_more">
                  read →
                </span>
              </a>
            </h2>

            <!-- Editorial Excerpt Quote -->
            {post.data.description && (
              <blockquote class={`text-xs sm:text-sm text-[#8b949e] border-l-2 border-[#30363d] ${catQuoteBorder} pl-3.5 italic leading-relaxed py-0.5 font-mono transition-colors`}>
                "{post.data.description}"
              </blockquote>
            )}

            <!-- Footer link -->
            <div class="pt-2 border-t border-[#30363d]/40 flex items-center justify-between text-xs font-mono">
              <a 
                href={`/thoughts/${post.id}`} 
                class={`hover:underline flex items-center gap-1 ${catHoverText} text-[#8b949e] transition-colors`}
              >
                <span data-i18n="thoughts_open_full">[Open full text →]</span>
              </a>
              <span class="text-[11px] text-[#8b949e]">slug: {post.id}</span>
            </div>
          </article>
        );
      })}

      <div id="no-articles-msg" class="py-12 text-center text-xs font-mono text-[#8b949e] hidden" data-i18n="thoughts_no_match">
        No notes or articles match your search or filter.
      </div>
    </div>

    <!-- Bottom Return Nav -->
    <div class="pt-8 border-t border-[#30363d] flex items-center justify-between text-xs font-mono text-[#8b949e]">
      <a href="/" class="hover:text-[#10b981] transition-colors flex items-center gap-1.5">
        <span>←</span>
        <span data-i18n="thoughts_back_home">[Back to the cockpit]</span>
      </a>
      <span>gulo // thoughts archive</span>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function initBlogSystem() {
    const toggleCards = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-toggle-card'));
    const btnReset = document.getElementById('btn-reset-categories');
    const tagBtns = document.querySelectorAll('.tag-filter-btn');
    const searchInput = document.getElementById('thought-search-input') as HTMLInputElement | null;
    const listContainer = document.getElementById('thoughts-list');
    const items = Array.from(document.querySelectorAll<HTMLElement>('.thought-card'));
    const noMsg = document.getElementById('no-articles-msg');
    const countBadge = document.getElementById('thought-count-badge');
    const btnSortNewest = document.getElementById('btn-sort-newest');
    const btnSortOldest = document.getElementById('btn-sort-oldest');

    // Mängd av aktivt valda kategorier: Set<'tanke' | 'guide' | 'anteckning'>
    // Regel: 0 valda = visa alla. 3 valda = visa alla. 1 eller 2 valda = visa bara de valda!
    const selectedCategories = new Set<string>();

    let currentTag = 'all';
    let searchQuery = '';
    let currentSort = 'desc'; // 'desc' = nyast först, 'asc' = äldst först

    function updateCardVisuals() {
      const isFiltered = selectedCategories.size > 0 && selectedCategories.size < 3;
      if (btnReset) {
        btnReset.classList.toggle('hidden', !isFiltered);
      }

      const isSv = (document.documentElement.lang || '').startsWith('sv');
      const defaultText = isSv ? 'Klicka för att filtrera' : 'Click to filter';
      const activeText = isSv ? 'Aktivt filter ✓' : 'Active filter ✓';

      toggleCards.forEach((card) => {
        const cat = card.getAttribute('data-cat') || '';
        const isSelected = selectedCategories.has(cat);
        card.setAttribute('aria-pressed', isSelected ? 'true' : 'false');

        const dot = card.querySelector('.cat-indicator-dot');
        const statusText = card.querySelector('.cat-status-text');

        // Återställ basklasser
        card.classList.remove(
          'ring-1', 'ring-[#f59e0b]', 'border-[#f59e0b]', 'bg-[#f59e0b]/10',
          'ring-[#38bdf8]', 'border-[#38bdf8]', 'bg-[#38bdf8]/10',
          'ring-[#10b981]', 'border-[#10b981]', 'bg-[#10b981]/10'
        );
        card.classList.add('bg-[#161b22]', 'border-[#30363d]');

        if (dot) {
          dot.classList.remove('bg-[#f59e0b]', 'border-[#f59e0b]', 'bg-[#38bdf8]', 'border-[#38bdf8]', 'bg-[#10b981]', 'border-[#10b981]');
          dot.classList.add('border-[#8b949e]');
        }
        if (statusText) {
          statusText.classList.remove('text-[#f59e0b]', 'text-[#38bdf8]', 'text-[#10b981]', 'font-semibold');
          statusText.textContent = defaultText;
        }

        if (isSelected) {
          card.classList.remove('bg-[#161b22]', 'border-[#30363d]');
          if (cat === 'tanke') {
            card.classList.add('ring-1', 'ring-[#f59e0b]', 'border-[#f59e0b]', 'bg-[#f59e0b]/10');
            if (dot) { dot.classList.remove('border-[#8b949e]'); dot.classList.add('bg-[#f59e0b]', 'border-[#f59e0b]'); }
            if (statusText) { statusText.classList.add('text-[#f59e0b]', 'font-semibold'); statusText.textContent = activeText; }
          } else if (cat === 'guide') {
            card.classList.add('ring-1', 'ring-[#38bdf8]', 'border-[#38bdf8]', 'bg-[#38bdf8]/10');
            if (dot) { dot.classList.remove('border-[#8b949e]'); dot.classList.add('bg-[#38bdf8]', 'border-[#38bdf8]'); }
            if (statusText) { statusText.classList.add('text-[#38bdf8]', 'font-semibold'); statusText.textContent = activeText; }
          } else if (cat === 'anteckning') {
            card.classList.add('ring-1', 'ring-[#10b981]', 'border-[#10b981]', 'bg-[#10b981]/10');
            if (dot) { dot.classList.remove('border-[#8b949e]'); dot.classList.add('bg-[#10b981]', 'border-[#10b981]'); }
            if (statusText) { statusText.classList.add('text-[#10b981]', 'font-semibold'); statusText.textContent = activeText; }
          }
        }
      });
    }

    function applyFilterAndSort() {
      const isFiltered = selectedCategories.size > 0 && selectedCategories.size < 3;

      let visibleCount = 0;
      items.forEach((item) => {
        const cat = item.getAttribute('data-category') || '';
        const tags = (item.getAttribute('data-tags') || '').split(',');
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-desc') || '';

        // Kategori-match: om 0 eller 3 är valda visas alla. Om 1 eller 2 valda visas endast de.
        const catMatches = !isFiltered || selectedCategories.has(cat);
        const tagMatches = currentTag === 'all' || tags.includes(currentTag);
        const searchMatches = 
          !searchQuery || 
          title.includes(searchQuery) || 
          desc.includes(searchQuery) || 
          cat.includes(searchQuery) ||
          tags.some((t) => t.includes(searchQuery));

        const isMatch = catMatches && tagMatches && searchMatches;
        item.style.display = isMatch ? '' : 'none';
        if (isMatch) visibleCount++;
      });

      // Sortera i DOM
      if (listContainer) {
        const sortedItems = [...items].sort((a, b) => {
          const tA = Number(a.getAttribute('data-timestamp') || 0);
          const tB = Number(b.getAttribute('data-timestamp') || 0);
          return currentSort === 'desc' ? tB - tA : tA - tB;
        });

        sortedItems.forEach((el) => {
          listContainer.appendChild(el);
        });

        // Säkerställ att no-articles-msg ligger sist i listan
        if (noMsg) listContainer.appendChild(noMsg);
      }

      if (noMsg) noMsg.classList.toggle('hidden', visibleCount > 0);
      if (countBadge) countBadge.textContent = String(visibleCount);
    }

    // Klick på interaktiva kategori-kort
    toggleCards.forEach((card) => {
      card.addEventListener('click', () => {
        const cat = card.getAttribute('data-cat') || '';
        if (selectedCategories.has(cat)) {
          selectedCategories.delete(cat);
        } else {
          selectedCategories.add(cat);
        }
        updateCardVisuals();
        applyFilterAndSort();
      });
    });

    // Återställ till alla kategorier
    btnReset?.addEventListener('click', () => {
      selectedCategories.clear();
      updateCardVisuals();
      applyFilterAndSort();
    });

    // Tagg-knappar
    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentTag = btn.getAttribute('data-tag') || 'all';

        tagBtns.forEach((b) => {
          b.classList.remove('bg-[#10b981]', 'text-[#0d1117]', 'font-semibold', 'border-[#10b981]');
          b.classList.add('bg-[#161b22]', 'text-[#8b949e]', 'border-[#30363d]');
        });

        btn.classList.remove('bg-[#161b22]', 'text-[#8b949e]', 'border-[#30363d]');
        btn.classList.add('bg-[#10b981]', 'text-[#0d1117]', 'font-semibold', 'border-[#10b981]');

        applyFilterAndSort();
      });
    });

    // Live sökning
    searchInput?.addEventListener('input', () => {
      searchQuery = (searchInput.value || '').trim().toLowerCase();
      applyFilterAndSort();
    });

    // Datum-sortering
    btnSortNewest?.addEventListener('click', () => {
      if (currentSort === 'desc') return;
      currentSort = 'desc';
      btnSortNewest.classList.add('active', 'bg-[#161b22]', 'text-[#e6edf3]', 'border', 'border-[#30363d]', 'font-semibold');
      btnSortNewest.classList.remove('text-[#8b949e]');
      btnSortOldest?.classList.remove('active', 'bg-[#161b22]', 'text-[#e6edf3]', 'border', 'border-[#30363d]', 'font-semibold');
      btnSortOldest?.classList.add('text-[#8b949e]');
      applyFilterAndSort();
    });

    btnSortOldest?.addEventListener('click', () => {
      if (currentSort === 'asc') return;
      currentSort = 'asc';
      btnSortOldest.classList.add('active', 'bg-[#161b22]', 'text-[#e6edf3]', 'border', 'border-[#30363d]', 'font-semibold');
      btnSortOldest.classList.remove('text-[#8b949e]');
      btnSortNewest?.classList.remove('active', 'bg-[#161b22]', 'text-[#e6edf3]', 'border', 'border-[#30363d]', 'font-semibold');
      btnSortNewest?.classList.add('text-[#8b949e]');
      applyFilterAndSort();
    });

    function updateReadingTimes() {
      const isSv = (document.documentElement.lang || '').startsWith('sv') || localStorage.getItem('site_lang') === 'sv';
      document.querySelectorAll<HTMLElement>('.post-reading-time').forEach((el) => {
        const text = isSv ? el.getAttribute('data-reading-sv') : el.getAttribute('data-reading-en');
        if (text) el.textContent = text;
      });
    }

    updateReadingTimes();

    // Reactive update on language change
    window.addEventListener('lang-change', () => {
      updateCardVisuals();
      updateReadingTimes();
      applyFilterAndSort();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogSystem);
  } else {
    initBlogSystem();
  }
</script>
