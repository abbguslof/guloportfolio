---
// src/pages/thoughts/[slug].astro - Fullskärmsläsning av tanke/inlägg med länkade nedladdningar
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InteractiveTerminal from '../../components/InteractiveTerminal.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const thoughts = await getCollection('thoughts');
  return thoughts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toISOString().slice(0, 10);
const wordCount = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
const category = post.data.category || 'tanke';

// Dynamically retrieve downloads linked to this post
const allDownloads = await getCollection('downloads');
const linkedDownloads = allDownloads.filter((d) => 
  (d.data.relatedThoughts || []).includes(post.id) ||
  ((d.data.tags || []).length > 0 && post.data.tags.some(t => (d.data.tags || []).map(x => x.toLowerCase()).includes(t.toLowerCase())))
);

let catBadgeClass = 'text-[#f59e0b] border-[#f59e0b]/40 bg-[#f59e0b]/10';
let catBorderClass = 'border-[#f59e0b]';
let catBadgeKey = 'thoughts_cat_tanke_badge';
let catLabel = '[THOUGHT]';
if (category === 'guide') {
  catBadgeClass = 'text-[#38bdf8] border-[#38bdf8]/40 bg-[#38bdf8]/10';
  catBorderClass = 'border-[#38bdf8]';
  catBadgeKey = 'thoughts_cat_guide_badge';
  catLabel = '[GUIDE]';
} else if (category === 'anteckning' || category === 'note') {
  catBadgeClass = 'text-[#10b981] border-[#10b981]/40 bg-[#10b981]/10';
  catBorderClass = 'border-[#10b981]';
  catBadgeKey = 'thoughts_cat_anteckning_badge';
  catLabel = '[NOTE]';
} else if (category === 'idea' || category === 'idé') {
  catBadgeClass = 'text-[#a78bfa] border-[#a78bfa]/40 bg-[#a78bfa]/10';
  catBorderClass = 'border-[#a78bfa]';
  catBadgeKey = 'thoughts_cat_idea_badge';
  catLabel = '[IDEA]';
}
---

<Layout 
  title={`${post.data.title} // gulo`}
  description={post.data.description || post.data.title}
>
  <Header />

  <!-- Global terminal on subpages (opens on header button click) -->
  <InteractiveTerminal isSubpage={true} />

  <main id="main-content" tabindex="-1" class="w-full py-4 space-y-8 outline-none">
    <!-- Back button & Tags row -->
    <div class="mb-5 sm:mb-8 flex flex-wrap items-center justify-between gap-2.5">
      <a 
        href="/thoughts" 
        class="inline-flex items-center gap-1.5 text-xs font-mono text-[#8b949e] hover:text-[#10b981] transition-colors px-3 py-1.5 min-h-[34px] sm:min-h-auto rounded bg-[#161b22] border border-[#30363d]"
      >
        <span data-i18n="thoughts_back_btn">← [~/thoughts]</span>
      </a>

      <div class="flex items-center gap-1.5 flex-wrap">
        {post.data.tags.map((tag) => (
          <a 
            href={`/thoughts`}
            class="text-[11px] font-mono text-[#38bdf8] bg-[#161b22] px-2 py-1 min-h-[28px] sm:min-h-auto rounded border border-[#30363d] hover:border-[#38bdf8] transition-colors flex items-center"
          >
            [{tag}]
          </a>
        ))}
      </div>
    </div>

    <!-- Article Header -->
    <header class="pb-5 sm:pb-6 mb-6 sm:mb-8 border-b border-[#30363d]">
      <div class="flex items-center justify-between gap-3 text-xs font-mono text-[#8b949e] mb-3 flex-wrap">
        <div class="flex items-center gap-2 flex-wrap">
          <span class={`text-[11px] font-bold px-2 py-0.5 rounded border ${catBadgeClass}`} data-i18n={catBadgeKey}>
            {catLabel}
          </span>
          <time datetime={formattedDate} class="text-[11px] sm:text-xs">{formattedDate}</time>
          <span>•</span>
          <span class="text-[11px] sm:text-xs">
            <span class="lang-en-only">{wordCount} words</span>
            <span class="lang-sv-only">{wordCount} ord</span>
          </span>
        </div>

        {post.data.pdfUrl && (
          <a 
            href={post.data.pdfUrl}
            download={post.data.pdfName || `${post.id}.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold px-2.5 py-1.5 min-h-[32px] rounded bg-[#161b22] border border-[#10b981]/50 text-[#10b981] hover:bg-[#10b981]/15 hover:border-[#10b981] transition-all ml-auto shadow-sm group"
            title={post.data.pdfName || 'Download companion PDF'}
          >
            <span class="text-xs group-hover:translate-y-0.5 transition-transform">↓</span>
            <span>PDF</span>
            {post.data.pdfName && (
              <span class="text-[10px] text-[#8b949e] hidden sm:inline">({post.data.pdfName})</span>
            )}
            <span class="text-[10px] text-[#8b949e]">↗</span>
          </a>
        )}
      </div>

      <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-[#e6edf3] tracking-tight leading-snug break-words">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class={`text-xs sm:text-sm text-[#8b949e] mt-3 leading-relaxed border-l-2 ${catBorderClass} pl-3`}>
          {post.data.description}
        </p>
      )}
    </header>

    <!-- Compact Language notice: Only displayed for Swedish users viewing English thoughts -->
    <aside 
      id="thought-lang-notice"
      class="lang-sv-only mb-6 px-3 py-1.5 rounded bg-[#161b22] border border-[#f59e0b]/30 text-xs font-mono text-[#8b949e] flex items-center justify-between gap-3 shadow-sm transition-all"
      role="note"
      aria-label="Språknotis"
    >
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-[10px] font-bold text-[#f59e0b] px-1.5 py-0.5 rounded bg-[#f59e0b]/10 border border-[#f59e0b]/30 shrink-0">
          EN
        </span>
        <span class="text-[11px] text-[#8b949e] truncate" data-i18n="thoughts_lang_notice_compact">
          Tankar, guider och anteckningar publiceras bara på engelska.
        </span>
      </div>

      <button 
        type="button" 
        id="btn-dismiss-thought-notice"
        class="text-[#8b949e] hover:text-[#e6edf3] px-1 rounded hover:bg-[#30363d]/50 transition-colors cursor-pointer text-xs shrink-0 select-none leading-none"
        title="Dölj notisen"
        aria-label="Dölj notis"
      >
        ✕
      </button>
    </aside>

    <!-- Article Body with Markdown Rendering -->
    <article class="prose prose-invert max-w-none text-[#e6edf3] text-sm leading-relaxed 
      prose-headings:text-[#e6edf3] prose-headings:font-bold prose-headings:font-mono
      prose-h2:text-lg prose-h2:border-b prose-h2:border-[#30363d] prose-h2:pb-2 prose-h2:mt-8
      prose-h3:text-base prose-h3:text-[#38bdf8]
      prose-p:text-[#c9d1d9] prose-p:leading-relaxed
      prose-blockquote:border-l-[#10b981] prose-blockquote:text-[#8b949e] prose-blockquote:italic
      prose-a:text-[#38bdf8] prose-a:underline hover:prose-a:text-[#10b981]">
      <Content />
    </article>

    <!-- Attached Downloads / Resources linked directly to this post -->
    {linkedDownloads.length > 0 && (
      <div class="mt-12 p-4 rounded-lg bg-[#161b22] border border-[#30363d] font-mono">
        <div class="text-xs font-bold text-[#10b981] mb-2 flex items-center gap-2">
          <span>↓</span>
          <span data-i18n="thoughts_downloads_title">DOWNLOADABLE RESOURCES LINKED TO THIS POST:</span>
        </div>
        <div class="space-y-2 pt-2 border-t border-[#30363d]/60">
          {linkedDownloads.map((dl) => (
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs pt-1">
              <div>
                <span class="text-[#e6edf3] font-semibold">{dl.data.name}</span>
                <span class="text-[#8b949e] ml-2">({dl.data.size})</span>
              </div>
              <a 
                href={dl.data.fileUrl} 
                download={dl.data.filename}
                class="px-3 py-1 rounded bg-[#0d1117] border border-[#30363d] text-[#10b981] hover:border-[#10b981] transition-all text-xs text-center"
              >
                [Download {dl.data.filename} ↓]
              </a>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Bottom return navigation -->
    <div class="mt-12 pt-6 border-t border-[#30363d] flex flex-wrap sm:flex-nowrap items-center justify-between gap-3 text-xs font-mono">
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 sm:gap-4">
        <a 
          href="/thoughts" 
          class="text-[#8b949e] hover:text-[#10b981] transition-colors"
        >
          <span data-i18n="thoughts_back_overview">[← Return to overview]</span>
        </a>
        <a 
          href="/" 
          class="text-[#8b949e] hover:text-[#10b981] transition-colors"
        >
          <span data-i18n="thoughts_back_home">[Back to the cockpit]</span>
        </a>
      </div>
      <span class="text-[#8b949e] hidden sm:inline">
        slug: {post.id}
      </span>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function setupThoughtPage() {
    const notice = document.getElementById('thought-lang-notice');
    const dismissBtn = document.getElementById('btn-dismiss-thought-notice');

    if (sessionStorage.getItem('dismissed_thought_lang_notice') === 'true') {
      notice?.classList.add('hidden');
    }

    dismissBtn?.addEventListener('click', () => {
      notice?.classList.add('hidden');
      sessionStorage.setItem('dismissed_thought_lang_notice', 'true');
    });

  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupThoughtPage);
  } else {
    setupThoughtPage();
  }
</script>
