---
// src/pages/index.astro - Huvudsida: Cockpit & Playground
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import InteractiveTerminal from '../components/InteractiveTerminal.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ThoughtRow from '../components/ThoughtRow.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

// Hämta projekt
const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
// Utvalda projekt för startsidan
const featuredProjects = sortedProjects.filter((p) => p.data.featured);
const displayProjects = featuredProjects.length > 0 ? featuredProjects : sortedProjects.slice(0, 2);

// Hämta tankar & anteckningar (sorterade efter nyast först, max 5 för startsidan)
const thoughts = await getCollection('thoughts');
const sortedThoughts = thoughts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latestThoughts = sortedThoughts.slice(0, 5);
---

<Layout 
  title="gulo // digital garden & playground" 
  description="Personal cockpit, portfolio and file archive. Chalmers Datateknik, swimming, Minecraft homelab and systems programming."
>
  <!-- Header -->
  <Header />

  <main class="w-full space-y-16">
    <!-- 1. Hero: Interactive Terminal (Med Chafa-porträtt, fungerande fönsterknappar & Bash) -->
    <InteractiveTerminal isSubpage={false} />

    <!-- 2. Utvalda Projekt & Homelab (Portfolio Showcase) -->
    <section id="projects" class="w-full" aria-labelledby="projects-heading">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 mb-6 border-b border-[#30363d] gap-2">
        <div class="flex items-center gap-2">
          <span class="text-[#a78bfa] font-bold">#</span>
          <h2 id="projects-heading" class="text-sm font-semibold tracking-wider uppercase text-[#e6edf3]" data-i18n="home_hero_projects_title">
            Featured Projects &amp; Homelab
          </h2>
        </div>

        <div class="flex items-center gap-3 text-xs font-mono">
          <a 
            href="/projects" 
            class="text-[#38bdf8] hover:text-[#e6edf3] hover:underline transition-colors flex items-center gap-1"
            data-i18n="home_hero_projects_view_all"
            data-i18n-count={sortedProjects.length}
          >
            [View full portfolio ({sortedProjects.length}) →]
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {displayProjects.map((project) => (
          <ProjectCard 
            title={project.data.title}
            description={project.data.description}
            status={project.data.status}
            category={project.data.category}
            tech={project.data.tech}
            repoUrl={project.data.repoUrl}
            liveUrl={project.data.liveUrl}
            slug={project.id}
          />
        ))}
      </div>
    </section>

    <!-- 3. Senaste Tankar, Guider & Anteckningar (Max 5 poster med kategori, datum & utdrag) -->
    <section id="thoughts" class="w-full" aria-labelledby="thoughts-heading">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 mb-5 border-b border-[#30363d] gap-2">
        <div class="flex items-center gap-2">
          <span class="text-[#f59e0b] font-bold">#</span>
          <h2 id="thoughts-heading" class="text-sm font-semibold tracking-wider uppercase text-[#e6edf3]" data-i18n="home_hero_thoughts_title">
            Latest Thoughts, Guides &amp; Notes
          </h2>
        </div>

        <div class="flex items-center gap-3 text-xs font-mono">
          <a 
            href="/thoughts" 
            class="text-[#38bdf8] hover:text-[#e6edf3] hover:underline transition-colors flex items-center gap-1"
            data-i18n="home_hero_thoughts_view_all"
            data-i18n-count={sortedThoughts.length}
          >
            [Full blog archive ({sortedThoughts.length}) →]
          </a>
        </div>
      </div>

      <!-- Articles list container with rich rows -->
      <div class="rounded-lg bg-[#161b22] border border-[#30363d] p-3 divide-y divide-[#30363d]/40">
        {latestThoughts.map((post) => (
          <ThoughtRow 
            title={post.data.title}
            slug={post.id}
            pubDate={post.data.pubDate}
            category={post.data.category}
            description={post.data.description}
            tags={post.data.tags}
          />
        ))}
      </div>

      <!-- Bottom link to full archive -->
      <div class="mt-4 text-center">
        <a 
          href="/thoughts" 
          class="inline-flex items-center gap-2 text-xs font-mono text-[#8b949e] hover:text-[#10b981] px-4 py-2 rounded-lg bg-[#161b22] border border-[#30363d] hover:border-[#10b981] transition-all"
          data-i18n="home_hero_thoughts_bottom_btn"
          data-i18n-count={sortedThoughts.length}
        >
          View all thoughts, guides and notes in the archive ({sortedThoughts.length} posts) →
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <Footer />
</Layout>
