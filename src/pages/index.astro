---
// src/pages/index.astro - Huvudsida: Cockpit & Playground
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import InteractiveTerminal from '../components/InteractiveTerminal.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ThoughtRow from '../components/ThoughtRow.astro';
import CollapsibleDownloads from '../components/CollapsibleDownloads.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

// Hämta projekt
const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
// Utvalda projekt för startsidan (markerade som featured: true, eller de 2 högst prioriterade)
const featuredProjects = sortedProjects.filter((p) => p.data.featured);
const displayProjects = featuredProjects.length > 0 ? featuredProjects : sortedProjects.slice(0, 2);

// Hämta tankar/inlägg
const thoughts = await getCollection('thoughts');
const sortedThoughts = thoughts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Hämta alla nedladdningar
const rawDownloads = await getCollection('downloads');
const allDownloads = rawDownloads.map((d) => ({
  id: d.id,
  ...d.data,
}));
// Utvalda filer för startsidan (markerade som featured: true, eller de 4 första)
const featuredDownloads = allDownloads.filter((d) => d.featured);
const displayDownloads = featuredDownloads.length > 0 ? featuredDownloads : allDownloads.slice(0, 4);
---

<Layout 
  title="gulo // digital garden & playground" 
  description="Personlig playground, portfolio och filarkiv. Chalmers Datateknik, simning, Minecraft homelab och systemprogrammering."
>
  <!-- Header -->
  <Header />

  <main class="w-full space-y-16">
    <!-- 1. Hero: Interactive Terminal (Med Chafa-porträtt, fungerande fönsterknappar & Bash) -->
    <InteractiveTerminal isSubpage={false} />

    <!-- 2. Utvalda Projekt & Homelab (Portfolio Showcase) -->
    <section id="projects" class="w-full" aria-labelledby="projects-heading">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 mb-6 border-b border-[#30363d] gap-2">
        <div class="flex items-center gap-2">
          <span class="text-[#a78bfa] font-bold">#</span>
          <h2 id="projects-heading" class="text-sm font-semibold tracking-wider uppercase text-[#e6edf3]">
            Utvalda Projekt &amp; Homelab
          </h2>
        </div>

        <div class="flex items-center gap-3 text-xs font-mono">
          <a 
            href="/projects" 
            class="text-[#38bdf8] hover:text-[#e6edf3] hover:underline transition-colors flex items-center gap-1"
          >
            <span>[Se hela portfolion ({sortedProjects.length})</span>
            <span class="text-[10px]">→]</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {displayProjects.map((project) => (
          <ProjectCard 
            title={project.data.title}
            description={project.data.description}
            status={project.data.status}
            category={project.data.category}
            tech={project.data.tech}
            repoUrl={project.data.repoUrl}
            liveUrl={project.data.liveUrl}
            slug={project.id}
          />
        ))}
      </div>
    </section>

    <!-- 3. Senaste Tankar & Blogginlägg (Ren lista med länk till /thoughts) -->
    <section id="thoughts" class="w-full" aria-labelledby="thoughts-heading">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 mb-5 border-b border-[#30363d] gap-2">
        <div class="flex items-center gap-2">
          <span class="text-[#f59e0b] font-bold">#</span>
          <h2 id="thoughts-heading" class="text-sm font-semibold tracking-wider uppercase text-[#e6edf3]">
            Senaste Tankar &amp; Anteckningar
          </h2>
        </div>

        <div class="flex items-center gap-3 text-xs font-mono">
          <a 
            href="/thoughts" 
            class="text-[#38bdf8] hover:text-[#e6edf3] hover:underline transition-colors flex items-center gap-1"
          >
            <span>[Hela bloggarkivet ({sortedThoughts.length})</span>
            <span class="text-[10px]">→]</span>
          </a>
        </div>
      </div>

      <!-- Articles list container -->
      <div class="rounded-lg bg-[#161b22] border border-[#30363d] px-4 py-1 divide-y divide-[#30363d]/40">
        {sortedThoughts.slice(0, 5).map((post) => (
          <ThoughtRow 
            title={post.data.title}
            slug={post.id}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>

    <!-- 4. Fildelning & Resurser (Utfällbar inline bullet-lista, stängd by default, med sortering) -->
    <CollapsibleDownloads downloads={displayDownloads} totalCount={allDownloads.length} />
  </main>

  <!-- Footer -->
  <Footer />
</Layout>
