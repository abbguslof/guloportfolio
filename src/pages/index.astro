---
// src/pages/index.astro - Home
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import InteractiveTerminal from '../components/InteractiveTerminal.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ThoughtRow from '../components/ThoughtRow.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getGroupedProjects } from '../utils/projects';

const sortedProjects = await getGroupedProjects();
const featuredProjects = sortedProjects.filter((p) => p.en.data.featured);
const displayProjects = featuredProjects.length > 0 ? featuredProjects : sortedProjects.slice(0, 2);

const thoughts = await getCollection('thoughts');
const sortedThoughts = thoughts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latestThoughts = sortedThoughts.slice(0, 5);
---

<Layout
  titleEn="Gustav Löfqvist"
  titleSv="Gustav Löfqvist"
  descriptionEn="Gustav Löfqvist studies computer science at Chalmers, swims sprint freestyle, and runs a homelab in Gothenburg."
  descriptionSv="Gustav Löfqvist läser datateknik på Chalmers, simmar sprint och driver ett homelab i Göteborg."
>
  <Header />

  <main id="main-content" tabindex="-1" class="w-full space-y-12 sm:space-y-16 outline-none">
    <InteractiveTerminal isSubpage={false} />

    {displayProjects.length > 0 && (
      <section id="projects" class="w-full" aria-labelledby="projects-heading">
        <div class="flex items-baseline justify-between gap-4 pb-2 mb-5 border-b border-[#30363d]">
          <h2 id="projects-heading" class="text-base font-semibold text-[#e6edf3]">
            <span class="text-[#a78bfa] font-bold mr-1.5">#</span><a href="/projects" class="hover:underline underline-offset-4 transition-colors" data-i18n="home_hero_projects_title">Projects</a>
          </h2>
          <a
            href="/projects"
            class="text-xs text-[#8b949e] hover:text-[#e6edf3] transition-colors"
            data-i18n="home_hero_projects_view_all"
          >
            All projects
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
          {displayProjects.map((project) => (
            <ProjectCard
              titleEn={project.en.data.title}
              titleSv={project.sv.data.title}
              descEn={project.en.data.description}
              descSv={project.sv.data.description}
              status={project.en.data.status}
              category={project.en.data.category}
              tech={project.en.data.tech}
              repoUrl={project.en.data.repoUrl}
              liveUrl={project.en.data.liveUrl}
              slug={project.slug}
            />
          ))}
        </div>
      </section>
    )}

    <section id="thoughts" class="w-full" aria-labelledby="thoughts-heading">
      <div class="flex items-baseline justify-between gap-4 pb-2 mb-4 border-b border-[#30363d]">
        <h2 id="thoughts-heading" class="text-base font-semibold text-[#e6edf3]">
          <span class="text-[#f59e0b] font-bold mr-1.5">#</span><a href="/thoughts" class="hover:underline underline-offset-4 transition-colors" data-i18n="home_hero_thoughts_title">Writing</a>
        </h2>
        <a
          href="/thoughts"
          class="text-xs text-[#8b949e] hover:text-[#e6edf3] transition-colors"
          data-i18n="home_hero_thoughts_view_all"
        >
          All writing
        </a>
      </div>

      <p class="lang-sv-only mb-3 text-[11px] text-[#8b949e]" data-i18n="thoughts_archive_lang_note">
        (Texterna publiceras på engelska)
      </p>

      {latestThoughts.length > 0 ? (
        <div class="border-y border-[#30363d] divide-y divide-[#30363d]/60">
          {latestThoughts.map((post) => (
            <ThoughtRow
              title={post.data.title}
              slug={post.id}
              pubDate={post.data.pubDate}
              category={post.data.category}
              description={post.data.description}
              tags={post.data.tags}
            />
          ))}
        </div>
      ) : (
        <p class="py-6 text-sm text-[#8b949e]">
          No writing published yet.
        </p>
      )}
    </section>
  </main>

  <Footer />
</Layout>
