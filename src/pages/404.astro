---
// src/pages/404.astro - Cockpit TUI 404 Page with Interactive Terminal
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import InteractiveTerminal from '../components/InteractiveTerminal.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  titleEn="Page not found"
  titleSv="Sidan hittades inte"
  descriptionEn="That page does not exist. Go home, or browse projects, writing, and files."
  descriptionSv="Den sidan finns inte. Gå hem eller bläddra bland projekt, texter och filer."
>
  <Header />

  <main id="main-content" tabindex="-1" class="w-full py-4 space-y-6 font-mono outline-none">
    <!-- Breadcrumb -->
    <div class="border-b border-[#30363d] pb-4">
      <div class="flex items-center gap-2 text-xs text-[#8b949e]">
        <a href="/" class="hover:text-[#e6edf3] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#f85149]">404</span>
      </div>
    </div>

    <!-- Full Interactive Terminal in 404 Mode -->
    <InteractiveTerminal isSubpage={false} is404={true} />
  </main>

  <Footer />
</Layout>
