---
// src/pages/404.astro - Cockpit TUI 404 Page with Interactive Terminal
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import InteractiveTerminal from '../components/InteractiveTerminal.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  titleEn="404: Command Not Found // gulo" 
  titleSv="404: Kommandot hittades inte // gulo"
  descriptionEn="The requested route does not exist on this station. Return to the cockpit or explore projects, thoughts and files."
  descriptionSv="Den efterfrågade adressen finns inte på denna station. Återvänd till cockpiten eller utforska projekt, tankar och filer."
>
  <Header />

  <main id="main-content" tabindex="-1" class="w-full py-4 space-y-6 font-mono outline-none">
    <!-- Breadcrumb -->
    <div class="border-b border-[#30363d] pb-4">
      <div class="flex items-center gap-2 text-xs text-[#8b949e]">
        <a href="/" class="hover:text-[#10b981] transition-colors" data-i18n="projects_breadcrumb_home">[~/home]</a>
        <span>/</span>
        <span class="text-[#f85149]">404</span>
      </div>
    </div>

    <!-- Full Interactive Terminal in 404 Mode -->
    <InteractiveTerminal isSubpage={false} is404={true} />
  </main>

  <Footer />
</Layout>
