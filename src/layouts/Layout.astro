---
import '../styles/global.css';
import AmbientBackground from '../components/AmbientBackground.astro';

interface Props {
  title?: string;
  titleEn?: string;
  titleSv?: string;
  description?: string;
  descriptionEn?: string;
  descriptionSv?: string;
}

const {
  title = "gulo // digital garden & playground",
  titleEn,
  titleSv,
  description = "Personal cockpit, portfolio and file archive. Chalmers Datateknik, swimming, homelab and systems programming.",
  descriptionEn,
  descriptionSv,
} = Astro.props;

const finalTitleEn = titleEn || title;
const finalTitleSv = titleSv || titleEn || title;
const finalDescEn = descriptionEn || description;
const finalDescSv = descriptionSv || descriptionEn || description;
---

<!doctype html>
<html lang="en" class="bg-[#0d1117] text-[#e6edf3]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Favicon & Touch Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Security & Hardening -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self';" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- SEO & Metadata with Instant Pre-Hydration Bilingual Sync -->
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? 'https://gulo.se')} />
    <title data-title-en={finalTitleEn} data-title-sv={finalTitleSv}>{finalTitleEn}</title>
    <meta name="description" content={finalDescEn} data-desc-en={finalDescEn} data-desc-sv={finalDescSv} />
    <meta name="theme-color" content="#0d1117" />
    <meta property="og:title" content={finalTitleEn} />
    <meta property="og:description" content={finalDescEn} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? 'https://gulo.se')} />

    <!-- Pre-hydration language detection & metadata synchronization (defaults to 'en') -->
    <script is:inline>
      (function() {
        var lang = localStorage.getItem('site_lang') || 'en';
        document.documentElement.lang = lang;
        document.documentElement.setAttribute('data-lang', lang);
        var titleEl = document.querySelector('title');
        if (titleEl) {
          var t = titleEl.getAttribute('data-title-' + lang);
          if (t) document.title = t;
        }
        var descEl = document.querySelector('meta[name="description"]');
        if (descEl) {
          var d = descEl.getAttribute('data-desc-' + lang);
          if (d) descEl.setAttribute('content', d);
        }
      })();
    </script>
  </head>
  <body class="min-h-[100dvh] bg-[#0d1117] text-[#e6edf3] font-mono selection:bg-[#2ea043] selection:text-[#0d1117] antialiased">
    <!-- Accessible skip link for keyboard navigation -->
    <a 
      href="#main-content" 
      id="skip-link"
      data-i18n="nav_skip_content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-1.5 focus:rounded focus:bg-[#10b981] focus:text-[#0d1117] focus:font-bold focus:shadow-lg focus:outline-none text-xs"
    >
      Skip to content
    </a>
    <!-- Living, ultra-subtle cockpit ambient background -->
    <AmbientBackground />

    <div class="relative z-10 min-h-[100dvh] flex flex-col justify-between max-w-6xl w-full mx-auto px-3.5 sm:px-6 py-4 sm:py-6 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))]">
      <slot />
    </div>

    <!-- Client-side i18n, keyboard navigation & code block utilities -->
    <script>
      import '../scripts/i18n-client';
      import { initKeyboardNav } from '../scripts/keyboard-nav';

      initKeyboardNav();

      function setupCodeCopyButtons() {
        document.querySelectorAll('pre').forEach((pre) => {
          if (pre.closest('#terminal-window') || pre.closest('#ambient-bg-container')) return;
          if (pre.querySelector('.code-copy-btn')) return;

          const btn = document.createElement('button');
          btn.className = 'code-copy-btn';
          btn.type = 'button';
          btn.setAttribute('aria-label', 'Copy code snippet');
          btn.innerHTML = '<span>copy</span>';

          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const codeEl = pre.querySelector('code');
            const textToCopy = (codeEl ? codeEl.innerText : pre.innerText).replace(/\n?copy$/, '').trim();
            try {
              await navigator.clipboard.writeText(textToCopy);
              btn.innerHTML = '<span class="text-[#10b981] font-bold">✓ copied</span>';
              setTimeout(() => {
                btn.innerHTML = '<span>copy</span>';
              }, 2000);
            } catch (err) {
              btn.innerHTML = '<span class="text-[#f85149]">err</span>';
            }
          });

          pre.style.position = 'relative';
          pre.appendChild(btn);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupCodeCopyButtons);
      } else {
        setupCodeCopyButtons();
      }
      document.addEventListener('astro:page-load', setupCodeCopyButtons);
    </script>
  </body>
</html>
