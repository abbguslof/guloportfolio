---
// CollapsibleDownloads.astro - Utfällbar bullet-lista för fildelning (Stängd by default, med sortering och länk till /files)
interface DownloadItem {
  id?: string;
  name: string;
  filename: string;
  size: string;
  category: string;
  fileUrl: string;
  description: string;
  updatedAt: string;
  checksum?: string;
}

interface Props {
  downloads: DownloadItem[];
  totalCount?: number;
}

const { downloads, totalCount = downloads.length } = Astro.props;
---

<section id="files" class="w-full pt-4" aria-labelledby="files-heading">
  <div class="rounded-lg bg-[#161b22] border border-[#30363d] overflow-hidden font-mono text-xs">
    <!-- Collapsible Details Element (Stängd by default!) -->
    <details class="group select-none" id="downloads-details">
      <!-- Summary Toggle Header -->
      <summary class="flex items-center justify-between p-4 cursor-pointer hover:bg-[#1f242c] transition-colors focus:outline-none">
        <div class="flex items-center gap-2">
          <span class="text-[#10b981] font-bold group-open:rotate-90 transition-transform duration-150 inline-block">
            ▶
          </span>
          <h2 id="files-heading" class="text-xs sm:text-sm font-bold text-[#e6edf3] tracking-wide uppercase">
            Fildelning &amp; Resurser
          </h2>
          <span class="text-[11px] text-[#8b949e]">
            {totalCount > downloads.length ? `(${downloads.length} utvalda // ${totalCount} i arkivet)` : `(${downloads.length} nedladdningar)`}
          </span>
        </div>
        <div class="flex items-center gap-3">
          <a 
            href="/files" 
            class="text-[11px] text-[#38bdf8] hover:underline hidden sm:inline"
            onclick="event.stopPropagation();"
          >
            [Öppna arkivsidan →]
          </a>
          <span class="text-[11px] text-[#10b981] group-open:hidden">
            [Visa lista ↓]
          </span>
          <span class="text-[11px] text-[#8b949e] hidden group-open:inline">
            [Dölj lista ↑]
          </span>
        </div>
      </summary>

      <!-- Unfolded Content: Clean Bullet List with Sorting -->
      <div class="px-5 pb-5 pt-3 border-t border-[#30363d]/60 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs">
          <p class="text-[#8b949e] leading-relaxed">
            Nedladdningsbara skript, modpacks och serverkonfigurationer.
          </p>

          <!-- Inline Sort Controls -->
          <div class="flex items-center gap-2 text-[11px] text-[#8b949e] shrink-0">
            <span>Sortera:</span>
            <button type="button" class="home-sort-btn active text-[#10b981] underline cursor-pointer" data-sort="date">
              Nyast
            </button>
            <span>•</span>
            <button type="button" class="home-sort-btn text-[#8b949e] hover:text-[#e6edf3] cursor-pointer" data-sort="name">
              Namn
            </button>
            <span>•</span>
            <button type="button" class="home-sort-btn text-[#8b949e] hover:text-[#e6edf3] cursor-pointer" data-sort="size">
              Storlek
            </button>
          </div>
        </div>

        <ul class="space-y-3 select-text" id="home-downloads-list">
          {downloads.map((item) => (
            <li 
              class="home-download-item p-3.5 rounded bg-[#0d1117] border border-[#30363d] hover:border-[#484f58] transition-colors flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
              data-name={item.name.toLowerCase()}
              data-date={item.updatedAt}
              data-size={item.size}
            >
              <div class="space-y-1">
                <div class="flex items-center flex-wrap gap-2">
                  <span class="text-[#10b981] font-bold">• [{item.category}]</span>
                  <a 
                    href={item.fileUrl}
                    download={item.filename}
                    class="font-semibold text-[#e6edf3] hover:text-[#38bdf8] hover:underline transition-colors"
                  >
                    {item.name}
                  </a>
                  <span class="text-[11px] text-[#8b949e]">({item.filename})</span>
                </div>

                <p class="text-[11px] text-[#8b949e] leading-relaxed">
                  {item.description}
                </p>

                <div class="flex flex-wrap items-center gap-2 text-[10px] text-[#8b949e] pt-1">
                  <span>Storlek: <strong class="text-[#e6edf3]">{item.size}</strong></span>
                  <span>•</span>
                  <span>Uppdaterad: {item.updatedAt}</span>
                  {item.checksum && (
                    <>
                      <span>•</span>
                      <button 
                        type="button" 
                        class="sha-copy-btn hover:text-[#10b981] transition-colors cursor-pointer"
                        data-sha={item.checksum}
                        title="Kopiera SHA-checksumma"
                      >
                        SHA: <code>{item.checksum}</code>
                        <span class="copy-indicator ml-1 text-[#10b981] hidden">✓</span>
                      </button>
                    </>
                  )}
                </div>
              </div>

              <!-- Action buttons -->
              <div class="flex items-center gap-2 shrink-0 self-start sm:self-center">
                {item.id && (
                  <a 
                    href={`/files#file-${item.id}`}
                    class="inline-flex items-center px-2.5 py-1.5 rounded bg-[#161b22] border border-[#30363d] text-xs font-mono text-[#8b949e] hover:text-[#e6edf3] hover:border-[#8b949e] transition-all cursor-pointer"
                    title={`Läs mer om ${item.name} och se kommandon`}
                  >
                    <span>[Info]</span>
                  </a>
                )}
                <a 
                  href={item.fileUrl}
                  download={item.filename}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#161b22] border border-[#30363d] text-xs font-mono font-medium text-[#10b981] hover:bg-[#10b981] hover:text-[#0d1117] hover:border-[#10b981] transition-all cursor-pointer"
                  aria-label={`Ladda ner ${item.name}`}
                >
                  <span>[Ladda ner</span>
                  <span class="text-[10px]">↓]</span>
                </a>
              </div>
            </li>
          ))}
        </ul>

        <div class="pt-3 border-t border-[#30363d]/40 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <span class="text-[11px] text-[#8b949e]">
            Visar {downloads.length} utvalda resurser. Fler finns i det kompletta filarkivet.
          </span>
          <a href="/files" class="text-xs text-[#38bdf8] hover:text-[#e6edf3] hover:underline flex items-center gap-1 font-semibold self-start sm:self-auto">
            <span>[Se hela filarkivet ({totalCount})</span>
            <span class="text-[10px]">→]</span>
          </a>
        </div>
      </div>
    </details>
  </div>
</section>

<script>
  // Sorting for home downloads list
  function initHomeDownloads() {
    const list = document.getElementById('home-downloads-list');
    const sortBtns = document.querySelectorAll('.home-sort-btn');
    if (!list) return;

    sortBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const mode = btn.getAttribute('data-sort');

        sortBtns.forEach((b) => {
          b.classList.remove('active', 'text-[#10b981]', 'underline');
          b.classList.add('text-[#8b949e]');
        });
        btn.classList.add('active', 'text-[#10b981]', 'underline');
        btn.classList.remove('text-[#8b949e]');

        const items = Array.from(list.querySelectorAll<HTMLElement>('.home-download-item'));
        items.sort((a, b) => {
          if (mode === 'name') {
            return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
          }
          if (mode === 'date') {
            return (b.getAttribute('data-date') || '').localeCompare(a.getAttribute('data-date') || '');
          }
          if (mode === 'size') {
            return parseFloat(b.getAttribute('data-size') || '0') - parseFloat(a.getAttribute('data-size') || '0');
          }
          return 0;
        });

        items.forEach((item) => list.appendChild(item));
      });
    });

    // Copy SHA
    document.querySelectorAll('.sha-copy-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const sha = btn.getAttribute('data-sha');
        if (sha) {
          navigator.clipboard.writeText(sha).then(() => {
            const ind = btn.querySelector('.copy-indicator');
            if (ind) {
              ind.classList.remove('hidden');
              setTimeout(() => ind.classList.add('hidden'), 2000);
            }
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHomeDownloads);
  } else {
    initHomeDownloads();
  }
</script>
