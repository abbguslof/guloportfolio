---
// CollapsibleDownloads.astro - Utfällbar bullet-lista för fildelning (Ingen popup!)
interface DownloadItem {
  id?: string;
  name: string;
  filename: string;
  size: string;
  category: string;
  fileUrl: string;
  description: string;
  updatedAt: string;
  checksum?: string;
}

interface Props {
  downloads: DownloadItem[];
}

const { downloads } = Astro.props;
---

<section id="files" class="w-full pt-4" aria-labelledby="files-heading">
  <div class="rounded-lg bg-[#161b22] border border-[#30363d] overflow-hidden font-mono text-xs">
    <!-- Collapsible Details Element -->
    <details class="group select-none" open>
      <!-- Summary Toggle Header -->
      <summary class="flex items-center justify-between p-4 cursor-pointer hover:bg-[#1f242c] transition-colors focus:outline-none">
        <div class="flex items-center gap-2">
          <span class="text-[#10b981] font-bold group-open:rotate-90 transition-transform duration-150 inline-block">
            ▶
          </span>
          <h2 id="files-heading" class="text-xs sm:text-sm font-bold text-[#e6edf3] tracking-wide uppercase">
            Fildelning &amp; Resurser
          </h2>
          <span class="text-[11px] text-[#8b949e]">
            ({downloads.length} nedladdningar)
          </span>
        </div>
        <span class="text-[11px] text-[#38bdf8] group-open:hidden">
          [Visa lista ↓]
        </span>
        <span class="text-[11px] text-[#8b949e] hidden group-open:inline">
          [Dölj lista ↑]
        </span>
      </summary>

      <!-- Unfolded Content: Clean Bullet List -->
      <div class="px-5 pb-5 pt-2 border-t border-[#30363d]/60 space-y-4">
        <p class="text-xs text-[#8b949e] leading-relaxed">
          Nedladdningsbara skript, modpacks och serverkonfigurationer för mina vänner och besökare.
        </p>

        <ul class="space-y-3 select-text">
          {downloads.map((item) => (
            <li class="p-3 rounded bg-[#0d1117] border border-[#30363d] hover:border-[#484f58] transition-colors flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <div class="space-y-1">
                <div class="flex items-center flex-wrap gap-2">
                  <span class="text-[#10b981] font-bold">• [{item.category}]</span>
                  <a 
                    href={item.fileUrl}
                    download={item.filename}
                    class="font-semibold text-[#e6edf3] hover:text-[#38bdf8] hover:underline transition-colors"
                  >
                    {item.name}
                  </a>
                  <span class="text-[11px] text-[#8b949e]">({item.filename})</span>
                </div>

                <p class="text-[11px] text-[#8b949e] leading-relaxed">
                  {item.description}
                </p>

                <div class="flex flex-wrap items-center gap-2 text-[10px] text-[#8b949e] pt-1">
                  <span>Storlek: <strong class="text-[#e6edf3]">{item.size}</strong></span>
                  <span>•</span>
                  <span>Uppdaterad: {item.updatedAt}</span>
                  {item.checksum && (
                    <>
                      <span>•</span>
                      <button 
                        type="button" 
                        class="sha-copy-btn hover:text-[#10b981] transition-colors cursor-pointer"
                        data-sha={item.checksum}
                        title="Kopiera SHA-checksumma"
                      >
                        SHA: <code>{item.checksum}</code>
                        <span class="copy-indicator ml-1 text-[#10b981] hidden">✓</span>
                      </button>
                    </>
                  )}
                </div>
              </div>

              <!-- Direct Download Trigger -->
              <div class="shrink-0 self-start sm:self-center">
                <a 
                  href={item.fileUrl}
                  download={item.filename}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#161b22] border border-[#30363d] text-xs font-mono font-medium text-[#10b981] hover:bg-[#10b981] hover:text-[#0d1117] hover:border-[#10b981] transition-all cursor-pointer"
                  aria-label={`Ladda ner ${item.name}`}
                >
                  <span>[Ladda ner</span>
                  <span class="text-[10px]">↓]</span>
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </details>
  </div>
</section>

<script>
  // Copy SHA in Collapsible list
  document.querySelectorAll('.sha-copy-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const sha = btn.getAttribute('data-sha');
      if (sha) {
        navigator.clipboard.writeText(sha).then(() => {
          const ind = btn.querySelector('.copy-indicator');
          if (ind) {
            ind.classList.remove('hidden');
            setTimeout(() => ind.classList.add('hidden'), 2000);
          }
        });
      }
    });
  });
</script>
