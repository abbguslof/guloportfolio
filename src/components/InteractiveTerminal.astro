      ls: (args) => {
        let targetDir = getCurrentDir();
        const flags = args.filter(a => a.startsWith('-'));
        const nonFlags = args.filter(a => !a.startsWith('-'));

        const showAll = flags.some(f => f.includes('a'));
        const isLong = flags.some(f => f.includes('l'));

        if (nonFlags[0]) {
          const target = nonFlags[0].replace(/\/$/, '');
          const node = target === '~' ? fileSystem : targetDir.children[target];
          if (!node) {
            return `<div class="text-[#f85149]">ls: kan inte komma åt '${escapeHtml(nonFlags[0])}': Ingen sådan fil eller katalog</div>`;
          }
          if (node.type === 'file') {
            return `<div class="text-[#e6edf3]">${escapeHtml(target)} (${node.size})</div>`;
          }
          targetDir = node as DirNode;
        }

        let entries = Object.entries(targetDir.children);
        if (!showAll) {
          entries = entries.filter(([name]) => !name.startsWith('.'));
        }

        if (entries.length === 0) return `<div class="text-[#8b949e]">Katalogen är tom.</div>`;

        if (isLong) {
          let rows = '';
          if (showAll) {
            rows += `
              <div class="grid grid-cols-[100px_70px_1fr] gap-2">
                <span class="text-[#8b949e]">drwxr-xr-x</span>
                <span class="text-[#8b949e] text-right">4.0 KB</span>
                <span class="text-[#38bdf8] font-bold">.</span>
              </div>
              <div class="grid grid-cols-[100px_70px_1fr] gap-2">
                <span class="text-[#8b949e]">drwxr-xr-x</span>
                <span class="text-[#8b949e] text-right">4.0 KB</span>
                <span class="text-[#38bdf8] font-bold">..</span>
              </div>
            `;
          }
          rows += entries.map(([name, node]) => {
            const isDir = node.type === 'dir';
            const perm = isDir ? 'drwxr-xr-x' : (name.startsWith('.') ? '-rw-------' : '-rw-r--r--');
            const size = isDir ? '4.0 KB' : node.size;
            const color = isDir ? 'text-[#38bdf8] font-bold' : (name.startsWith('.') ? 'text-[#a78bfa]' : 'text-[#e6edf3]');
            return `<div class="grid grid-cols-[100px_70px_1fr] gap-2">
              <span class="text-[#8b949e]">${perm}</span>
              <span class="text-[#8b949e] text-right">${size}</span>
              <span class="${color}">${escapeHtml(name)}${isDir ? '/' : ''}</span>
            </div>`;
          }).join('');
          return `<div class="font-mono text-xs space-y-1">${rows}</div>`;
        }

        let prefix = '';
        if (showAll) {
          prefix = `<span class="text-[#38bdf8] font-bold">.</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-[#38bdf8] font-bold">..</span>&nbsp;&nbsp;&nbsp;&nbsp;`;
        }

        const pills = entries.map(([name, node]) => {
          if (node.type === 'dir') {
            return `<span class="text-[#38bdf8] font-bold">${escapeHtml(name)}/</span>`;
          }
          if (name.startsWith('.')) {
            return `<span class="text-[#a78bfa]">${escapeHtml(name)}</span>`;
          }
          return `<span class="text-[#e6edf3]">${escapeHtml(name)}</span>`;
        }).join('&nbsp;&nbsp;&nbsp;&nbsp;');

        return `<div class="flex flex-wrap gap-x-6 gap-y-1 text-xs sm:text-sm font-mono">${prefix}${pills}</div>`;
      },

      cd: (args) => {
        const dest = args[0] ? args[0].trim() : '~';
        if (dest === '~' || dest === '') {
          currentPath = [];
          updateTitle();
          return;
        }
        if (dest === '.') return;

        const targetSegments = resolvePath(currentPath, dest);
        const node = resolveNode(targetSegments);

        if (node) {
          if (node.type === 'dir') {
            currentPath = targetSegments;
            updateTitle();
          } else {
            return `<div class="text-[#f85149]">cd: '${escapeHtml(dest)}': Inte en katalog</div>`;
          }
        } else {
          return `<div class="text-[#f85149]">cd: '${escapeHtml(dest)}': Ingen sådan fil eller katalog</div>`;
        }
      },

      pwd: () => `<div class="text-[#8b949e]">/home/gulo${currentPath.length > 0 ? '/' + currentPath.join('/') : ''}</div>`,

      cat: (args) => {
        if (!args[0]) return `<div class="text-[#f85149]">Användning: cat &lt;filnamn&gt;</div>`;
        const filename = args[0].trim();
        const targetSegments = resolvePath(currentPath, filename);
        let node = resolveNode(targetSegments);

        if (!node && currentPath.length > 0 && fileSystem.children[filename]) {
          node = fileSystem.children[filename];
        }

        if (!node) return `<div class="text-[#f85149]">cat: ${escapeHtml(filename)}: Ingen sådan fil</div>`;
        if (node.type === 'dir') return `<div class="text-[#f85149]">cat: ${escapeHtml(filename)}: Är en katalog.</div>`;

        return `
<div class="p-3 rounded bg-[#0d1117] border border-[#30363d] text-xs text-[#e6edf3] whitespace-pre-wrap leading-relaxed font-mono">
${escapeHtml(node.content)}
</div>`;
      },

      grep: (args) => {
        if (!args[0]) return `<div class="text-[#f85149]">Användning: grep &lt;sökord&gt; [fil]</div>`;
        const query = args[0].toLowerCase();
        const targetFile = args[1];
        const current = getCurrentDir();

        let matches: string[] = [];

        function scanFile(name: string, f: FileNode) {
          const lines = f.content.split('\n');
          lines.forEach((line, idx) => {
            if (line.toLowerCase().includes(query)) {
              matches.push(`<span class="text-[#38bdf8]">${escapeHtml(name)}:${idx + 1}:</span> ${escapeHtml(line)}`);
            }
          });
        }

        if (targetFile) {
          const targetSegments = resolvePath(currentPath, targetFile);
          const node = resolveNode(targetSegments);
          if (!node || node.type !== 'file') return `<div class="text-[#f85149]">grep: ${escapeHtml(targetFile)}: Ingen sådan fil</div>`;
          scanFile(targetFile, node as FileNode);
        } else {
          for (const [name, node] of Object.entries(current.children)) {
            if (node.type === 'file') scanFile(name, node);
          }
        }

        if (matches.length === 0) return `<div class="text-[#8b949e]">Inga träffar för '${escapeHtml(query)}'.</div>`;
        return `<div class="text-xs space-y-1 font-mono">${matches.join('<br/>')}</div>`;
      },

      open: (args) => {
        const rawTarget = args[0] ? args[0].trim() : '.';
        const target = rawTarget.toLowerCase().replace(/\/$/, '').replace(/\.md$/, '');

        // 1. "open" eller "open ." -> öppnar katalogen användaren befinner sig i!
        if (target === '.' || target === '') {
          if (currentPath.length === 0) {
            navigateWithCli('/', `<div class="text-[#10b981]">Öppnar startsidan /...</div>`);
            return;
          }
          const folder = currentPath[0];
          navigateWithCli(`/${folder}`, `<div class="text-[#10b981]">Öppnar mappen /${escapeHtml(folder)} på webben...</div>`);
          return;
        }

        if (target === '..' || target === '~') {
          navigateWithCli('/', `<div class="text-[#10b981]">Öppnar hemkatalogen / på webben...</div>`);
          return;
        }

        // 2. Leta upp via resolvePath (hanterar ../, ./, underkataloger)
        const targetSegments = resolvePath(currentPath, rawTarget);
        const resolvedNode = resolveNode(targetSegments);

        if (resolvedNode) {
          if (resolvedNode.type === 'dir') {
            const dirUrl = targetSegments.length === 0 ? '/' : `/${targetSegments.join('/')}`;
            navigateWithCli(dirUrl, `<div class="text-[#10b981]">Öppnar ${escapeHtml(dirUrl)} på webben...</div>`);
            return;
          } else if (resolvedNode.type === 'file' && resolvedNode.actionUrl) {
            navigateWithCli(resolvedNode.actionUrl, `<div class="text-[#10b981]">Öppnar ${escapeHtml(rawTarget)} (${escapeHtml(resolvedNode.actionUrl)})...</div>`);
            return;
          }
        }

        // Kontrollera om target matchar en fil med actionUrl i nuvarande katalog
        const current = getCurrentDir();
        if (current.children[rawTarget] && current.children[rawTarget].type === 'file') {
          const f = current.children[rawTarget] as FileNode;
          if (f.actionUrl) {
            navigateWithCli(f.actionUrl, `<div class="text-[#10b981]">Öppnar ${escapeHtml(rawTarget)} (${escapeHtml(f.actionUrl)})...</div>`);
            return;
          }
        }

        // Normalisera bort ledande ../, ./, /, ~/ för sektionsgenvägar
        const cleanTarget = target.replace(/^(\.\.\/|\.\/|\/|~\/)+/, '');

        // 3. Sök i alla kända underkataloger i virtuella filsystemet
        for (const [dirName, dirNode] of Object.entries(fileSystem.children)) {
          if (dirNode.type === 'dir') {
            for (const [fname, node] of Object.entries(dirNode.children)) {
              if (node.type === 'file') {
                const baseFname = fname.toLowerCase().replace(/\.md$/, '');
                if (cleanTarget === baseFname || cleanTarget === fname.toLowerCase() || baseFname.includes(cleanTarget) || cleanTarget.includes(baseFname)) {
                  if (node.actionUrl) {
                    navigateWithCli(node.actionUrl, `<div class="text-[#38bdf8]">Öppnar ${escapeHtml(fname)} (${escapeHtml(node.actionUrl)})...</div>`);
                    return;
                  }
                }
              }
            }
          }
        }

        // 4. Snabbgenvägar till sektioner
        if (cleanTarget === 'projects' || cleanTarget === 'projekt') {
          navigateWithCli('/projects', `<div class="text-[#10b981]">Navigerar till /projects...</div>`);
          return;
        }
        if (cleanTarget === 'thoughts' || cleanTarget === 'tankar' || cleanTarget === 'blog' || cleanTarget === 'blogg' || cleanTarget === 'anteckningar') {
          navigateWithCli('/thoughts', `<div class="text-[#10b981]">Navigerar till /thoughts...</div>`);
          return;
        }
        if (cleanTarget === 'files' || cleanTarget === 'filer' || cleanTarget === 'downloads') {
          navigateWithCli('/files', `<div class="text-[#10b981]">Navigerar till /files...</div>`);
          return;
        }

        // 5. Direktladdningar
        if (cleanTarget.includes('fabric')) {
          window.location.href = '/downloads/fabric-1.20.4-optimized.zip';
          return `<div class="text-[#10b981]">Laddar ner fabric-1.20.4-optimized.zip...</div>`;
        }
        if (cleanTarget.includes('backup')) {
          window.location.href = '/downloads/backup-world.sh';
          return `<div class="text-[#10b981]">Laddar ner backup-world.sh...</div>`;
        }
        if (cleanTarget.includes('cv') || cleanTarget.includes('resume')) {
          window.location.href = '/downloads/cv-gulo-datateknik.pdf';
          return `<div class="text-[#10b981]">Laddar ner cv-gulo-datateknik.pdf...</div>`;
        }
        if (cleanTarget.includes('dotfiles') || cleanTarget.includes('nvim')) {
          window.location.href = '/downloads/nvim-dotfiles.tar.gz';
          return `<div class="text-[#10b981]">Laddar ner nvim-dotfiles.tar.gz...</div>`;
        }

        return `<div class="text-[#f85149]">Känner inte igen '${escapeHtml(rawTarget)}'. Skriv 'help' eller 'ls'.</div>`;
      },

      projects: () => {
        navigateWithCli('/projects', `<div class="text-[#a78bfa]">Öppnar /projects (Portfolio)...</div>`);
        return;
      },

      thoughts: () => {
        navigateWithCli('/thoughts', `<div class="text-[#f59e0b]">Öppnar /thoughts (Blogg & Anteckningar)...</div>`);
        return;
      },

      files: () => {
        navigateWithCli('/files', `<div class="text-[#10b981]">Öppnar /files...</div>`);
        return;
      },

      fastfetch: () => {
        let cfg: any = null;
        const node = fileSystem.children['fastfetch.json'];
        if (node && node.type === 'file' && node.content) {
          try { cfg = JSON.parse(node.content); } catch (e) {}
        }
        const user = cfg?.user || 'gulo';
        const host = cfg?.host || 'chalmers-station';
        const badge = cfg?.badge || 'CHALMERS // D-24';
        const specs = cfg?.specs || [
          { key: 'OS', value: 'Debian GNU/Linux 12 (bookworm) x86_64', color: 'sky' },
          { key: 'Host', value: 'chalmers-workstation', color: 'sky' },
          { key: 'Kernel', value: 'Linux 6.12.8-zen1', color: 'sky' },
          { key: 'Uptime', value: '42 dagar, 8 timmar, 14 min', color: 'sky' },
          { key: 'Shell', value: 'zsh 5.9 / bash 5.2 • kitty', color: 'sky' },
          { key: 'Editor', value: 'Neovim v0.10.2 (Lua dotfiles)', color: 'sky' },
          { key: 'Utbildning', value: 'Civilingenjör Datateknik @ Chalmers (Åk 2)', color: 'emerald' },
          { key: 'Simning', value: 'Valhallabadet (5-6 pass/v, frisim/fjäril)', color: 'emerald' },
          { key: 'Homelab', value: 'PaperMC SMP-kluster, Docker, Velocity', color: 'emerald' },
          { key: 'Status', value: '[● ONLINE] Tentavecka & serverdrift', color: 'amber' }
        ];

        const specRows = specs.map((s: any) => {
          const colClass = s.color === 'emerald' ? 'text-[#10b981]' : s.color === 'amber' ? 'text-[#f59e0b]' : 'text-[#38bdf8]';
          return `<div><span class="${colClass} font-semibold">${escapeHtml(s.key)}:</span> ${escapeHtml(s.value)}</div>`;
        }).join('');

        return `
<div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 p-3 rounded bg-[#0d1117] border border-[#30363d] my-1 font-mono text-xs">
  <div class="shrink-0 select-none text-[11px] leading-[1.2] text-center">
    <pre class="leading-tight text-center text-[#10b981]">
<span class="text-[#38bdf8]">     /\\_____/\\     </span>
<span class="text-[#38bdf8]">    /</span>  <span class="text-[#e6edf3] font-bold">o</span>   <span class="text-[#e6edf3] font-bold">o</span>  <span class="text-[#38bdf8]">\    </span>
<span class="text-[#10b981]">   (</span> <span class="text-[#38bdf8]">==</span>  <span class="text-[#10b981] font-bold">^</span>  <span class="text-[#38bdf8]">==</span> <span class="text-[#10b981]">)   </span>
<span class="text-[#10b981]">    )</span>   <span class="text-[#e6edf3] font-bold">GULO</span>  <span class="text-[#10b981]">)    </span>
<span class="text-[#10b981]">   (</span>  <span class="text-[#38bdf8]">[D-24]</span>   <span class="text-[#10b981]">)   </span>
<span class="text-[#10b981]">  (</span> <span class="text-[#38bdf8]">(  )</span>   <span class="text-[#38bdf8]">(  )</span> <span class="text-[#10b981]">)  </span>
<span class="text-[#38bdf8]"> (__(__)___(__)__) </span>
    </pre>
    <div class="text-[10px] font-bold text-[#10b981] mt-1">${escapeHtml(badge)}</div>
  </div>
  <div class="flex-1 space-y-1 text-xs">
    <div><span class="text-[#10b981] font-bold">${escapeHtml(user)}</span><span class="text-[#8b949e]">@</span><span class="text-[#38bdf8] font-bold">${escapeHtml(host)}</span></div>
    <div class="text-[#30363d]">--------------------------------------</div>
    ${specRows}
  </div>
</div>`;
      },

      tldr: () => `
<div class="p-3 rounded bg-[#0d1117] border border-[#30363d] space-y-1.5 font-mono text-xs text-[#e6edf3]">
  <div class="text-[#10b981] font-bold border-b border-[#30363d] pb-1">⚡ TL;DR // GULO COCKPIT</div>
  <div><span class="text-[#38bdf8] font-semibold">Vem:</span> Civilingenjörsstudent i Datateknik (Chalmers D-24) &amp; tävlingssimmare.</div>
  <div><span class="text-[#38bdf8] font-semibold">Simning:</span> Valhallabadet 50m (frisim/fjäril). Bästa botemedlet mot skärmtrötthet.</div>
  <div><span class="text-[#38bdf8] font-semibold">Homelab:</span> Eget 20.0 TPS PaperMC SMP-kluster med Velocity, Docker &amp; Debian 12.</div>
  <div><span class="text-[#38bdf8] font-semibold">Filer:</span> CV, Neovim dotfiles, Fabric modpack och backup-skript tillgängliga på <code class="text-[#10b981]">/files</code>.</div>
  <div><span class="text-[#38bdf8] font-semibold">Kommandon:</span> <code class="text-[#10b981]">projects</code>, <code class="text-[#10b981]">thoughts</code>, <code class="text-[#10b981]">files</code>, <code class="text-[#10b981]">school</code>, <code class="text-[#10b981]">swim</code>, <code class="text-[#10b981]">ls -la</code>.</div>
</div>`,

      // Easter egg aliases defined in .bashrc
      study: () => `<div class="text-[#10b981] font-mono">Kompilerar operativsystem för RISC-V... Tentan godkänd med beröm! 💯</div>`,
      sleep: () => `<div class="text-[#f85149] font-mono">Error 404: Sleep Not Found under tentavecka på Chalmers. Fyller på kaffekoppen... ☕</div>`,
      mc: () => `<div class="text-[#10b981] font-mono">Docker SMP-kluster startat på port 25565. 20.0 TPS garanterat. 🟩</div>`,
      alias: () => `
<div class="text-xs space-y-1 font-mono text-[#8b949e]">
  <div><span class="text-[#38bdf8]">alias swim</span>='echo "Dyk i! Valhallabadet kl 06:00, 400m insim redo."'</div>
  <div><span class="text-[#38bdf8]">alias study</span>='echo "Kompilerar operativsystem... tentan godkänd!"'</div>
  <div><span class="text-[#38bdf8]">alias sleep</span>='echo "Error: 404 Sleep Not Found under tentavecka"'</div>
  <div><span class="text-[#38bdf8]">alias mc</span>='docker compose -f ~/homelab/docker-compose.yml up -d'</div>
</div>`,

      clear: () => {
        history.innerHTML = '';
        sessionStorage.removeItem('terminal_history_html');
        sessionStorage.removeItem('terminal_nav_scroll_y');
        return;
      },

      date: () => `<div class="text-[#8b949e]">${new Date().toLocaleString('sv-SE')} (Europe/Stockholm)</div>`,
      uptime: () => `<div class="text-[#10b981]">Uptime: 42 dagar, 8 timmar, load: 0.18, 0.22, 0.35</div>`,
      exit: () => { userCloseWindow(); return; },
      close: () => { userCloseWindow(); return; }
    };

    commands['chalmers'] = commands['school'];
    commands['dir'] = commands['ls'];
    commands['neofetch'] = commands['fastfetch'];
    commands['fetch'] = commands['fastfetch'];

    // Smidiga alias för whoami
    commands['whoisgulo'] = commands['whoami'];
    commands['whoamgulo'] = commands['whoami'];
    commands['gulo'] = commands['whoami'];
    commands['whois'] = commands['whoami'];
    commands['who'] = commands['whoami'];

    // Smidiga alias för contact (Discord, phone, number, kontakt, socials, mail, email)
    commands['discord'] = commands['contact'];
    commands['phone'] = commands['contact'];
    commands['number'] = commands['contact'];
    commands['kontakt'] = commands['contact'];
    commands['socials'] = commands['contact'];
    commands['social'] = commands['contact'];
    commands['email'] = commands['contact'];
    commands['mail'] = commands['contact'];

    function execute(rawCmd: string) {
      const cleanCmd = rawCmd.trim();
      if (!cleanCmd) return;

      cmdHistory.push(cleanCmd);
      historyIndex = cmdHistory.length;

      // Render prompt execution line
      const cmdRow = document.createElement('div');
      cmdRow.className = 'flex items-center gap-2 text-xs sm:text-sm font-semibold text-[#8b949e] pt-1';
      cmdRow.innerHTML = `
        <span class="text-[#10b981]">visitor@playground</span><span class="text-[#8b949e]">:</span><span class="text-[#38bdf8]">${escapeHtml(getCwdLabel())}</span><span class="text-[#e6edf3]">$</span>
        <span class="text-[#e6edf3]">${escapeHtml(cleanCmd)}</span>
      `;
      history.appendChild(cmdRow);

      const parts = cleanCmd.split(' ').filter(Boolean);
      const main = parts[0].toLowerCase();
      const args = parts.slice(1);

      if (commands[main]) {
        const res = commands[main](args);
        if (res) {
          const resBox = document.createElement('div');
          resBox.className = 'text-xs pl-3 border-l border-[#30363d] my-1';
          resBox.innerHTML = res;
          history.appendChild(resBox);
        }
      } else {
        const errBox = document.createElement('div');
        errBox.className = 'text-xs text-[#f85149] pl-3 border-l border-[#f85149]/40 my-1';
        errBox.innerHTML = `Kommando hittades inte: '${escapeHtml(cleanCmd)}'. Skriv <span class="text-[#10b981] font-bold">help</span> för hjälplista.`;
        history.appendChild(errBox);
      }

      input.value = '';
      input.focus({ preventScroll: true });
      if (termBody) {
        termBody.scrollTop = termBody.scrollHeight;
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      execute(input.value);
    });

    // ==========================================
    // 3. ROBUST TAB COMPLETION, CTRL+C & HISTORY
    // ==========================================
    input.addEventListener('keydown', (e) => {
      // Ctrl+C för att avbryta påbörjat kommando som i bash
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'c') {
        const sel = window.getSelection()?.toString();
        if (sel && sel.length > 0) return; // Tillåt vanlig textkopiering

        e.preventDefault();
        const currentCmd = input.value;
        const cancelRow = document.createElement('div');
        cancelRow.className = 'flex items-center gap-2 text-xs sm:text-sm font-semibold text-[#8b949e] pt-1 font-mono';
        cancelRow.innerHTML = `
          <span class="text-[#10b981]">visitor@playground</span><span class="text-[#8b949e]">:</span><span class="text-[#38bdf8]">${escapeHtml(getCwdLabel())}</span><span class="text-[#e6edf3]">$</span>
          <span class="text-[#e6edf3]">${escapeHtml(currentCmd)}</span><span class="text-[#f85149] font-bold ml-1">^C</span>
        `;
        history.appendChild(cancelRow);
        input.value = '';
        historyIndex = cmdHistory.length;
        history.scrollTop = history.scrollHeight;
        return;
      }

      // Ctrl+L för att rensa historik som i bash (Terminal redo-raden bevaras ovanför)
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'l') {
        e.preventDefault();
        history.innerHTML = '';
        sessionStorage.removeItem('terminal_history_html');
        sessionStorage.removeItem('terminal_nav_scroll_y');
        input.value = '';
        return;
      }

      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (cmdHistory.length > 0 && historyIndex > 0) {
          historyIndex--;
          input.value = cmdHistory[historyIndex];
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex < cmdHistory.length - 1) {
          historyIndex++;
          input.value = cmdHistory[historyIndex];
        } else {
          historyIndex = cmdHistory.length;
          input.value = '';
        }
      } else if (e.key === 'Tab') {
        e.preventDefault();
        e.stopPropagation();

        const currentVal = input.value;
        const tokens = currentVal.split(' ');
        const lastToken = tokens[tokens.length - 1] || '';

        // If typing first token -> autocomplete command names
        if (tokens.length <= 1) {
          const cmdList = [
            'help', 'school', 'swim', 'whoami', 'contact', 'discord', 'phone', 'number', 'kontakt',
            'ls', 'cd', 'cat', 'pwd', 'grep', 'open', 'projects', 'thoughts', 'files', 'clear', 
            'date', 'uptime', 'fastfetch', 'neofetch', 'fetch', 'tldr', 'study', 'sleep', 'mc', 
            'alias', 'whoisgulo', 'gulo', 'exit'
          ];
          const matches = cmdList.filter(c => c.startsWith(lastToken.toLowerCase()));

          if (matches.length === 1) {
            input.value = matches[0] + ' ';
          } else if (matches.length > 1) {
            // Förhindra duplikation vid upprepade Tab-tryck!
            const lastChild = history.lastElementChild;
            if (lastChild && lastChild.classList.contains('tab-hint-row')) {
              return;
            }
            const hint = document.createElement('div');
            hint.className = 'tab-hint-row text-xs text-[#38bdf8] pl-3 my-1 font-mono';
            hint.textContent = matches.join('   ');
            history.appendChild(hint);
          }
          return;
        }

        // If typing second token or later -> autocomplete filesystem nodes, flags or open targets
        const mainCmd = tokens[0].toLowerCase();
        let availableItems: string[] = [];

        if (mainCmd === 'ls' && lastToken.startsWith('-')) {
          availableItems = ['-a', '-l', '-la', '-al'];
          const matches = availableItems.filter(item => item.toLowerCase().startsWith(lastToken.toLowerCase()));
          if (matches.length === 1) {
            tokens[tokens.length - 1] = matches[0];
            input.value = tokens.join(' ');
          }
          return;
        }

        // Dela upp lastToken i katalogprefix (dirPrefix) och sökterm (basePrefix)
        // Exempel: "../p" -> dirPrefix: "../", basePrefix: "p"
        // Exempel: "../projects/" -> dirPrefix: "../projects/", basePrefix: ""
        // Exempel: "c" -> dirPrefix: "", basePrefix: "c"
        const lastSlashIdx = lastToken.lastIndexOf('/');
        let dirPrefix = '';
        let basePrefix = lastToken;

        if (lastSlashIdx !== -1) {
          dirPrefix = lastToken.slice(0, lastSlashIdx + 1);
          basePrefix = lastToken.slice(lastSlashIdx + 1);
        }

        // Slå upp målkatalog baserat på dirPrefix
        const targetDirSegments = dirPrefix ? resolvePath(currentPath, dirPrefix) : currentPath;
        const targetDirNode = resolveNode(targetDirSegments);

        if (targetDirNode && targetDirNode.type === 'dir') {
          for (const [name, node] of Object.entries(targetDirNode.children)) {
            // Dölj punkt-filer om inte användaren aktivt startade med '.'
            if (name.startsWith('.') && !basePrefix.startsWith('.')) continue;

            if (mainCmd === 'cd') {
              if (node.type === 'dir') {
                availableItems.push(`${name}/`);
              }
            } else {
              availableItems.push(node.type === 'dir' ? `${name}/` : name);
            }
          }

          // Om vi är i en underkatalog och användaren inte redan skrivit ../
          if (targetDirSegments.length > 0 && !dirPrefix.endsWith('../')) {
            availableItems.push('../');
          }
        }

        // Om kommandot är 'open' och användaren inte angett specifik sökväg med slash:
        // Erbjuda också standardsektioner och alla dynamiska slugs
        if (mainCmd === 'open' && !dirPrefix) {
          const openTargets = ['projects', 'thoughts', 'files'];
          openTargets.forEach(t => {
            if (!availableItems.includes(t) && !availableItems.includes(`${t}/`)) {
              availableItems.push(t);
            }
          });

          for (const [dirName, dirNode] of Object.entries(fileSystem.children)) {
            if (dirNode.type === 'dir') {
              for (const fname of Object.keys(dirNode.children)) {
                const baseFname = fname.replace(/\.md$/, '');
                if (!availableItems.includes(baseFname)) {
                  availableItems.push(baseFname);
                }
              }
            }
          }
        }

        const matches = availableItems.filter(item => item.toLowerCase().startsWith(basePrefix.toLowerCase()));

        if (matches.length === 1) {
          tokens[tokens.length - 1] = dirPrefix + matches[0];
          input.value = tokens.join(' ');
        } else if (matches.length > 1) {
          // Förhindra duplikation vid upprepade Tab-tryck!
          const lastChild = history.lastElementChild;
          if (lastChild && lastChild.classList.contains('tab-hint-row')) {
            return;
          }
          const hint = document.createElement('div');
          hint.className = 'tab-hint-row text-xs text-[#38bdf8] pl-3 my-1 font-mono';
          hint.textContent = matches.map(m => dirPrefix + m).join('   ');
          history.appendChild(hint);
          if (termBody) {
            termBody.scrollTop = termBody.scrollHeight;
          }
        }
      }
    });

    function escapeHtml(str: string) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerminalEngine);
  } else {
    initTerminalEngine();
  }
</script>

