  <!-- Blixtsnabb synk-script för att eliminera split-sekund flimmer vid sidnavigering -->
  <script is:inline>
    (function() {
      try {
        var sec = document.getElementById('terminal-section');
        var win = document.getElementById('terminal-window');
        var card = document.getElementById('terminal-closed-card');
        if (!sec) return;

        // Om sidan laddades om (refresh / F5 / Ctrl+R) -> rensa sparad historik
        var navEntries = performance.getEntriesByType && performance.getEntriesByType('navigation');
        var isReload = (navEntries && navEntries[0] && navEntries[0].type === 'reload') || 
                       (window.performance && window.performance.navigation && window.performance.navigation.type === 1);
        if (isReload) {
          sessionStorage.removeItem('terminal_history_html');
          sessionStorage.removeItem('terminal_cmd_history');
          sessionStorage.removeItem('terminal_body_scroll');
          sessionStorage.removeItem('terminal_nav_scroll_y');
          sessionStorage.removeItem('navigated_via_cli');
          sessionStorage.removeItem('terminal_cat_hint_dismissed');
        }

        var isSub = sec.getAttribute('data-is-subpage') === 'true';
        var is404 = sec.getAttribute('data-is-404') === 'true';
        var isPhone = window.innerWidth < 640;
        var viaCli = sessionStorage.getItem('navigated_via_cli') === 'true';
        var mobileOpened = sessionStorage.getItem('terminal_opened_on_mobile') === 'true';
        var closedByUser = sessionStorage.getItem('terminal_closed_by_user') === 'true';

        if (is404) {
          sec.classList.remove('hidden');
          if (closedByUser || (isPhone && !mobileOpened)) {
            if (win) win.classList.add('hidden');
            if (card) card.classList.remove('hidden');
          } else {
            if (win) win.classList.remove('hidden');
            if (card) card.classList.add('hidden');
          }
        } else if (viaCli) {
          sec.classList.remove('hidden');
          if (win) win.classList.remove('hidden');
          if (card) card.classList.add('hidden');

          var hist = document.getElementById('terminal-history');
          var savedH = sessionStorage.getItem('terminal_history_html');
          if (hist && savedH) {
            hist.innerHTML = savedH;
          }

          var body = document.getElementById('terminal-body');
          if (body) {
            body.scrollTop = body.scrollHeight;
          }

          var savedY = sessionStorage.getItem('terminal_nav_scroll_y');
          if (savedY !== null) {
            window.scrollTo(0, Number(savedY));
          }
        } else if (!isSub && isPhone && !mobileOpened) {
          sec.classList.remove('hidden');
          if (win) win.classList.add('hidden');
          if (card) card.classList.remove('hidden');
        } else if (!isSub && !closedByUser) {
          sec.classList.remove('hidden');
          if (win) win.classList.remove('hidden');
          if (card) card.classList.add('hidden');
        } else if (!isSub && closedByUser) {
          sec.classList.remove('hidden');
          if (win) win.classList.add('hidden');
          if (card) card.classList.remove('hidden');
        } else {
          sec.classList.add('hidden');
        }
      } catch (e) {}
    })();
  </script>
</section>

