---
// InteractiveTerminal.astro - Ergonomic TUI Terminal with snug Chafa portrait, global subpage support, and fixed window states
interface Props {
  isSubpage?: boolean;
}

const { isSubpage = false } = Astro.props;
---

<section 
  id="terminal-section" 
  class={`w-full ${isSubpage ? 'hidden mb-8' : 'mb-10'}`} 
  data-is-subpage={isSubpage ? 'true' : 'false'}
  aria-label="Interaktiv TUI Terminal"
>
  <!-- Static Human-Readable "About Me" Card (Only on homepage when terminal is closed via ✕) -->
  {!isSubpage && (
    <div 
      id="terminal-closed-card" 
      class="hidden mb-6 p-6 rounded-lg bg-[#161b22] border border-[#30363d] hover:border-[#10b981]/60 transition-all shadow-xl"
    >
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 mb-4 border-b border-[#30363d] gap-3">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-[#10b981] animate-pulse"></span>
          <h2 class="text-sm font-mono font-bold tracking-wider uppercase text-[#e6edf3]">
            Vem är gulo? // Om mig &amp; bakgrund
          </h2>
        </div>
        <button 
          type="button" 
          id="btn-reopen-terminal" 
          class="text-xs font-mono px-3 py-1.5 rounded bg-[#0d1117] border border-[#30363d] text-[#10b981] hover:border-[#10b981] hover:bg-[#10b981]/10 transition-all cursor-pointer flex items-center gap-2 self-start sm:self-auto"
        >
          <span>&gt;_</span>
          <span>Öppna terminalen igen</span>
        </button>
      </div>

      <!-- Structured Biography -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm font-mono">
        <div class="space-y-3">
          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5">Chalmers Tekniska Högskola</span>
            <p class="text-[#e6edf3] leading-relaxed">
              Läser andra året på civilingenjörsprogrammet i <strong class="text-[#10b981]">Datateknik</strong>. Fokus på operativsystem, minneshantering, distribuerade system och lågnivå C/Rust.
            </p>
          </div>

          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5">Kapplöpningssimning</span>
            <p class="text-[#e6edf3] leading-relaxed">
              Aktiv simmare med hemmabassäng i Valhallabadet (5-6 pass/vecka). Simningen ger den mentala disciplinen och fokuset som krävs för att lösa komplexa problem.
            </p>
          </div>
        </div>

        <div class="space-y-3">
          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5">Homelab &amp; Servrar</span>
            <p class="text-[#e6edf3] leading-relaxed">
              Driftar ett eget Minecraft-kluster (PaperMC 1.20 SMP) på Debian 12 med isolerade Docker-containers, automatiserade zstd-backuper och WireGuard VPN.
            </p>
          </div>

          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5">Kreativt, Foto &amp; Gaming</span>
            <p class="text-[#e6edf3] leading-relaxed">
              Fotograferar analogt på 35mm film, bygger Neovim dotfiles i Lua, spelar co-op och meckar med Linux-miljöer (Arch + Hyprland).
            </p>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Terminal Window Container -->
  <div 
    id="terminal-window" 
    class="rounded-lg border border-[#30363d] bg-[#161b22] shadow-2xl transition-all duration-200 overflow-hidden"
  >
    <!-- Window Title Bar with FUNCTIONING Controls -->
    <div 
      id="terminal-titlebar"
      class="flex items-center justify-between px-4 py-2.5 bg-[#0d1117] border-b border-[#30363d] select-none cursor-pointer"
      title="Klicka var som helst på listen för att fälla ut om minimerad, eller dubbelklicka för fullskärm"
    >
      <!-- Real Interactive Window Action Buttons -->
      <div class="flex items-center space-x-2">
        <button 
          type="button" 
          id="btn-win-close" 
          class="w-3.5 h-3.5 rounded-full bg-[#f85149] hover:brightness-125 transition-all flex items-center justify-center text-[9px] font-bold text-[#0d1117] group cursor-pointer" 
          title="Stäng terminalen"
          aria-label="Stäng terminal"
        >
          <span class="opacity-0 group-hover:opacity-100 transition-opacity leading-none">✕</span>
        </button>
        <button 
          type="button" 
          id="btn-win-minimize" 
          class="w-3.5 h-3.5 rounded-full bg-[#f59e0b] hover:brightness-125 transition-all flex items-center justify-center text-[9px] font-bold text-[#0d1117] group cursor-pointer" 
          title="Minimera fönstret"
          aria-label="Minimera terminal"
        >
          <span class="opacity-0 group-hover:opacity-100 transition-opacity leading-none">−</span>
        </button>
        <button 
          type="button" 
          id="btn-win-maximize" 
          class="w-3.5 h-3.5 rounded-full bg-[#2ea043] hover:brightness-125 transition-all flex items-center justify-center text-[9px] font-bold text-[#0d1117] group cursor-pointer" 
          title="Maximera till fullskärm (stängs med Esc)"
          aria-label="Maximera terminal"
        >
          <span class="opacity-0 group-hover:opacity-100 transition-opacity leading-none">+</span>
        </button>
      </div>

      <!-- Window Title & Path -->
      <div class="text-xs text-[#8b949e] font-mono tracking-wide flex items-center gap-2">
        <span id="window-title-text" class="text-[#e6edf3]">bash — gulo@playground: ~</span>
        <span id="window-status-pill" class="text-[10px] text-[#f59e0b] bg-[#0d1117] px-2 py-0.5 rounded border border-[#30363d] hidden">
          MINIMERAD (klicka för att öppna)
        </span>
      </div>

      <!-- Terminal details -->
      <div class="text-[11px] font-mono text-[#8b949e] hidden sm:flex items-center gap-2">
        <span id="fullscreen-hint" class="text-[#10b981] hidden">[Esc för att avsluta fullskärm]</span>
        <span class="text-[#38bdf8]">tty1</span>
        <span>•</span>
        <span>utf-8</span>
      </div>
    </div>

    <!-- Terminal Collapsible Body -->
    <div id="terminal-body" class="p-4 sm:p-5 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto transition-all">
      <!-- High-Density TUI Fastfetch Cockpit (Eliminates all dead space and negative voids) -->
      <div class="flex flex-col sm:flex-row items-stretch gap-4 pb-4 border-b border-[#30363d]/80">
        <!-- Chafa Dithered CRT Terminal Identity Card (Fixed snug width, matched height) -->
        <div class="shrink-0 flex flex-col justify-between w-full sm:w-44 md:w-48 bg-[#0d1117] p-2.5 rounded border border-[#30363d] shadow-sm">
          <div>
            <!-- Panel header -->
            <div class="flex items-center justify-between pb-1.5 mb-2 border-b border-[#30363d] text-[10px] text-[#8b949e]">
              <span class="text-[#10b981] font-bold">~/.face.six</span>
              <span class="text-[9px] px-1 py-0.5 rounded bg-[#161b22] border border-[#30363d] text-[#38bdf8]">CHAFA</span>
            </div>

            <!-- CRT Scanline Portrait -->
            <div class="relative w-full aspect-square rounded border border-[#30363d] overflow-hidden group shadow-inner bg-[#161b22]">
              <img 
                src="/images/avatar.jpg" 
                alt="gulo — dev & swimmer avatar" 
                class="w-full h-full object-cover grayscale contrast-125 brightness-95 group-hover:grayscale-0 group-hover:brightness-105 transition-all duration-300"
              />
              <!-- CRT phosphor scanline effect -->
              <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-transparent via-emerald-500/5 to-transparent opacity-60 mix-blend-overlay"></div>
            </div>
          </div>

          <!-- Identity metadata block directly below avatar (Zero empty space) -->
          <div class="mt-2 pt-2 border-t border-[#30363d] space-y-1 text-[10px] text-[#8b949e]">
            <div class="flex items-center justify-between">
              <span>IDENT:</span>
              <span class="text-[#e6edf3] font-semibold">gulo // 0x47</span>
            </div>
            <div class="flex items-center justify-between">
              <span>HOST:</span>
              <span class="text-[#38bdf8]">chalmers-d24</span>
            </div>
            <div class="flex items-center justify-between">
              <span>SWIM:</span>
              <span class="text-[#10b981]">valhalla 50m</span>
            </div>
            <!-- Terminal 6-color ANSI palette test bar -->
            <div class="flex items-center justify-between pt-1 gap-1" title="Terminal 16-color test">
              <span class="h-2 flex-1 rounded-xs bg-[#f85149]"></span>
              <span class="h-2 flex-1 rounded-xs bg-[#10b981]"></span>
              <span class="h-2 flex-1 rounded-xs bg-[#f59e0b]"></span>
              <span class="h-2 flex-1 rounded-xs bg-[#38bdf8]"></span>
              <span class="h-2 flex-1 rounded-xs bg-[#a78bfa]"></span>
              <span class="h-2 flex-1 rounded-xs bg-[#e6edf3]"></span>
            </div>
          </div>
        </div>

        <!-- Balanced Two-Column Specification Pane (Fills horizontal space cleanly) -->
        <div class="flex-1 min-w-0 flex flex-col justify-between space-y-2.5">
          <!-- Top bar: User & Machine -->
          <div class="pb-1.5 border-b border-[#30363d] flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-[#10b981] font-bold text-sm">gulo</span>
              <span class="text-[#8b949e]">@</span>
              <span class="text-[#38bdf8] font-bold text-sm">chalmers-station</span>
              <span class="text-[10px] px-1.5 py-0.2 rounded bg-[#0d1117] border border-[#30363d] text-[#8b949e]">Debian 12</span>
            </div>
            <div class="flex items-center gap-2 text-[11px] text-[#8b949e]">
              <span>Göteborg, Sverige</span>
              <span>•</span>
              <span class="text-[#10b981] font-medium flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-pulse"></span>
                ONLINE
              </span>
            </div>
          </div>

          <!-- Two-Column High-Density Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2 text-xs">
            <!-- Column 1: Profil, Studier & Simning -->
            <div class="space-y-1.5">
              <div class="text-[10px] uppercase font-bold text-[#38bdf8] tracking-wider pb-0.5 border-b border-[#30363d]/40">
                [PROFIL &amp; STUDIER]
              </div>
              <div class="grid grid-cols-[90px_1fr] gap-x-1.5 items-baseline">
                <span class="text-[#8b949e] font-medium">Utbildning:</span>
                <span class="text-[#e6edf3]">Civilingenjör Datateknik @ Chalmers (Åk 2)</span>
              </div>
              <div class="grid grid-cols-[90px_1fr] gap-x-1.5 items-baseline">
                <span class="text-[#8b949e] font-medium">Fokus:</span>
                <span class="text-[#e6edf3]">OS, distribuerade system, C/Rust</span>
              </div>
              <div class="grid grid-cols-[90px_1fr] gap-x-1.5 items-baseline">
                <span class="text-[#8b949e] font-medium">Simning:</span>
                <span class="text-[#e6edf3]">Valhallabadet • 5-6 pass/v (frisim/fjäril)</span>
              </div>
              <div class="grid grid-cols-[90px_1fr] gap-x-1.5 items-baseline">
                <span class="text-[#8b949e] font-medium">Foto:</span>
                <span class="text-[#e6edf3]">Analog 35mm film &amp; mörkrum</span>
              </div>
            </div>

            <!-- Column 2: System, Homelab & Miljö -->
            <div class="space-y-1.5">
              <div class="text-[10px] uppercase font-bold text-[#a78bfa] tracking-wider pb-0.5 border-b border-[#30363d]/40">
                [SYSTEM &amp; HOMELAB]
              </div>
              <div class="grid grid-cols-[90px_1fr] gap-x-1.5 items-baseline">
                <span class="text-[#8b949e] font-medium">Homelab:</span>
                <span class="text-[#e6edf3]">PaperMC SMP-kluster, Docker, Velocity</span>
              </div>
              <div class="grid grid-cols-[90px_1fr] gap-x-1.5 items-baseline">
                <span class="text-[#8b949e] font-medium">OS/Kernel:</span>
                <span class="text-[#e6edf3]">Debian 12 / Arch • Linux 6.12-zen</span>
              </div>
              <div class="grid grid-cols-[90px_1fr] gap-x-1.5 items-baseline">
                <span class="text-[#8b949e] font-medium">Verktyg:</span>
                <span class="text-[#e6edf3]">Neovim (Lua), Kitty, Git, Zsh</span>
              </div>
              <div class="grid grid-cols-[90px_1fr] gap-x-1.5 items-baseline">
                <span class="text-[#8b949e] font-medium">Nätverk:</span>
                <span class="text-[#e6edf3]">WireGuard VPN, Cloudflare Tunnel</span>
              </div>
            </div>
          </div>

          <!-- Bottom Telemetry & Status Bar (Spans full width) -->
          <div class="pt-2 border-t border-[#30363d]/60 flex flex-wrap items-center justify-between gap-3 text-[11px]">
            <div class="flex items-center gap-2 text-[#10b981]">
              <span class="w-2 h-2 rounded-full bg-[#10b981] animate-ping"></span>
              <span class="font-medium">Status: Tentavecka @ Chalmers, bassängpass &amp; serverdrift</span>
            </div>
            <div class="flex items-center gap-3 text-[#8b949e]">
              <span>UPTIME: <strong class="text-[#e6edf3]">42d 8h</strong></span>
              <span>•</span>
              <span>MEM: <strong class="text-[#e6edf3]">3.8G / 16G</strong></span>
              <span>•</span>
              <span>LOAD: <strong class="text-[#e6edf3]">0.18</strong></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Terminal Output History -->
      <div id="terminal-history" class="pt-3 space-y-2.5" aria-live="polite">
        <div class="text-[#8b949e] text-xs">
          Terminal redo. Skriv <code class="text-[#10b981] font-bold">help</code> för kommandolista (<code class="text-[#38bdf8]">school</code>, <code class="text-[#38bdf8]">swim</code>, <code class="text-[#38bdf8]">ls</code>, <code class="text-[#38bdf8]">cd</code>, <code class="text-[#38bdf8]">cat</code>, <code class="text-[#38bdf8]">open</code>). Tryck <code class="text-[#10b981]">Tab</code> för att auto-komplettera.
        </div>
      </div>

      <!-- Active Interactive Prompt Row -->
      <form id="terminal-form" class="mt-3 flex items-center gap-2 pt-2 border-t border-[#30363d]/40">
        <label id="terminal-prompt-label" for="terminal-input" class="text-xs sm:text-sm text-[#10b981] font-semibold whitespace-nowrap select-none flex items-center gap-1">
          <span>visitor@playground</span><span class="text-[#8b949e]">:</span><span id="prompt-cwd" class="text-[#38bdf8]">~</span><span class="text-[#e6edf3]">$</span>
        </label>
        <input 
          id="terminal-input" 
          type="text" 
          autocomplete="off" 
          autocorrect="off" 
          autocapitalize="off" 
          spellcheck="false" 
          class="flex-1 bg-transparent border-none text-[#e6edf3] text-xs sm:text-sm focus:outline-none focus:ring-0 p-0 font-mono caret-[#10b981]"
          placeholder="skriv 'help', 'school', 'swim', 'cat about.txt'..."
        />
        <button type="submit" class="sr-only">Kör kommando</button>
      </form>
    </div>
  </div>
</section>

<script>
  function initTerminalEngine() {
    const termSection = document.getElementById('terminal-section');
    const termWindow = document.getElementById('terminal-window');
    const termBody = document.getElementById('terminal-body');
    const closedCard = document.getElementById('terminal-closed-card');
    const reopenBtn = document.getElementById('btn-reopen-terminal');
    const titleBar = document.getElementById('terminal-titlebar');
    const titleText = document.getElementById('window-title-text');
    const statusPill = document.getElementById('window-status-pill');
    const fullscreenHint = document.getElementById('fullscreen-hint');

    const btnClose = document.getElementById('btn-win-close');
    const btnMinimize = document.getElementById('btn-win-minimize');
    const btnMaximize = document.getElementById('btn-win-maximize');

    const form = document.getElementById('terminal-form') as HTMLFormElement | null;
    const input = document.getElementById('terminal-input') as HTMLInputElement | null;
    const history = document.getElementById('terminal-history') as HTMLDivElement | null;
    const promptCwd = document.getElementById('prompt-cwd');

    if (!termSection || !termWindow || !termBody || !form || !input || !history) return;

    const isSubpage = termSection.getAttribute('data-is-subpage') === 'true';

    let isMinimized = false;
    let isMaximized = false;

    // Stäng (✕)
    function closeWindow() {
      if (isMaximized) unmaximize();
      if (isMinimized) unminimize();

      if (isSubpage) {
        termSection.classList.add('hidden');
      } else {
        termWindow.classList.add('hidden');
        closedCard?.classList.remove('hidden');
      }
    }

    // Återställ fönstret
    function restoreWindow() {
      termSection.classList.remove('hidden');
      termWindow.classList.remove('hidden');
      closedCard?.classList.add('hidden');
      if (isMinimized) unminimize();
      input.focus();
    }

    // Unmaximize helper
    function unmaximize() {
      isMaximized = false;
      document.body.classList.remove('overflow-hidden');
      termWindow.classList.remove('fixed', 'inset-3', 'z-50', 'ring-2', 'ring-[#10b981]', 'h-[calc(100vh-1.5rem)]', 'flex', 'flex-col');
      termBody.classList.remove('flex-1', 'overflow-y-auto');
      fullscreenHint?.classList.add('hidden');
      updateTitle();
    }

    // Maximize helper
    function applyMaximize() {
      if (isMinimized) unminimize();
      isMaximized = true;
      document.body.classList.add('overflow-hidden');
      termWindow.classList.add('fixed', 'inset-3', 'z-50', 'ring-2', 'ring-[#10b981]', 'h-[calc(100vh-1.5rem)]', 'flex', 'flex-col');
      termBody.classList.add('flex-1', 'overflow-y-auto');
      fullscreenHint?.classList.remove('hidden');
      if (titleText) titleText.textContent = `bash — gulo@playground: ${getCwdLabel()} [MAXIMERAD FULLSKÄRM]`;
      input.focus();
    }

    function toggleMaximize() {
      if (isMaximized) {
        unmaximize();
      } else {
        applyMaximize();
      }
    }

    // Unminimize helper
    function unminimize() {
      isMinimized = false;
      termBody.classList.remove('hidden');
      statusPill?.classList.add('hidden');
      updateTitle();
      input.focus();
    }

    // Minimize helper
    function applyMinimize() {
      if (isMaximized) unmaximize(); // Exit fullscreen before minimizing so page is visible!
      isMinimized = true;
      termBody.classList.add('hidden');
      statusPill?.classList.remove('hidden');
      if (titleText) titleText.textContent = 'bash — gulo@playground: ~ (klicka var som helst för att öppna)';
    }

    function toggleMinimize() {
      if (isMinimized) {
        unminimize();
      } else {
        applyMinimize();
      }
    }

    btnClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeWindow();
    });

    btnMinimize?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMinimize();
    });

    btnMaximize?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMaximize();
    });

    // Klicka var som helst på namnlisten när minimerad -> återställ!
    titleBar?.addEventListener('click', (e) => {
      if (isMinimized) {
        unminimize();
      }
    });

    titleBar?.addEventListener('dblclick', toggleMaximize);
    reopenBtn?.addEventListener('click', restoreWindow);

    // Lyssna på header-knappen oavsett sida
    window.addEventListener('restore-terminal', () => {
      restoreWindow();
      termSection.scrollIntoView({ behavior: 'smooth' });
    });

    // Escape stänger fullskärm
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMaximized) {
        e.preventDefault();
        unmaximize();
      }
      if ((e.ctrlKey || e.metaKey) && e.key === '`') {
        e.preventDefault();
        if (termSection.classList.contains('hidden') || termWindow.classList.contains('hidden')) {
          restoreWindow();
        } else {
          toggleMinimize();
        }
      }
    });

    // ==========================================
    // 2. VIRTUAL FILESYSTEM & BASH ENGINE
    // ==========================================
    type FileNode = {
      type: 'file';
      size: string;
      description: string;
      content: string;
      actionUrl?: string;
    };

    type DirNode = {
      type: 'dir';
      children: Record<string, FileNode | DirNode>;
    };

    const fileSystem: DirNode = {
      type: 'dir',
      children: {
        'projects': {
          type: 'dir',
          children: {
            'mc-cluster.md': {
              type: 'file',
              size: '1.4 KB',
              description: 'PaperMC Homelab Cluster & Proxy',
              content: `# PaperMC Homelab Cluster & Proxy\nStatus: [ACTIVE] | Kategori: Minecraft\nTech: Docker, Linux/Debian, Java 21, Velocity, Spark\n\nEtt självhostat Minecraft-nätverk optimerat för 20.0 TPS.\nLäs hela projektet på webben: open mc-cluster`,
              actionUrl: '/projects/mc-cluster',
            },
            'chalmers-sys-sched.md': {
              type: 'file',
              size: '1.2 KB',
              description: 'Preemptive CPU-schemaläggare (Chalmers D)',
              content: `# Preemptive CPU-schemaläggare (Chalmers D)\nStatus: [COMPLETED] | Kategori: Skola / Datateknik\nTech: Rust, C, RISC-V, Operating Systems\n\nSimulering av round-robin och flernivå prioritetsschemaläggning för RISC-V.\nLäs hela projektet på webben: open chalmers-sys-sched`,
              actionUrl: '/projects/chalmers-sys-sched',
            }
          }
        },
        'thoughts': {
          type: 'dir',
          children: {
            'chalmers-simning-kod.md': {
              type: 'file',
              size: '2.1 KB',
              description: 'Från 50m bassängen till tentaveckan på Chalmers',
              content: `Från 50m bassängen till tentaveckan på Chalmers\n\n"Det finns en märklig parallell mellan att simma 4000 meter i Valhallabadet och att felsöka ett komplext minnesläckage i C...\nLäs artikeln: open chalmers-simning-kod`,
              actionUrl: '/thoughts/chalmers-simning-kod',
            },
            'mc-jvm-flags.md': {
              type: 'file',
              size: '1.8 KB',
              description: 'Optimerade JVM-flaggor för PaperMC 1.20',
              content: `Optimerade JVM-flaggor för PaperMC 1.20\n\nHur jag konfigurerade Aikar's flags och G1GC för stabil 20 TPS under hög belastning.\nLäs artikeln: open mc-jvm-flags`,
              actionUrl: '/thoughts/mc-jvm-flags',
            }
          }
        },
        'files': {
          type: 'dir',
          children: {
            'fabric-1.20.4-optimized.zip': {
              type: 'file',
              size: '4.8 MB',
              description: 'Fabric Performance Pack 1.20.4',
              content: `Binary zip archive: Fabric Performance Pack med Lithium, FerriteCore och Spark.\nLadda ner: open fabric-1.20.4-optimized.zip`,
              actionUrl: '/downloads/fabric-1.20.4-optimized.zip',
            },
            'backup-world.sh': {
              type: 'file',
              size: '2.8 KB',
              description: 'Automated World Backup & Prune Script',
              content: `#!/usr/bin/env bash\n# Automated World Backup Script\ntar --zstd -cf "$BACKUP_FILE" world\nfind "$BACKUP_DIR" -name "world_*.tar.zst" -mtime +14 -delete`,
              actionUrl: '/downloads/backup-world.sh',
            }
          }
        },
        'about.txt': {
          type: 'file',
          size: '340 B',
          description: 'Om mig och mina intressen',
          content: `Vem är gulo?\n- Utbildning: Civilingenjör Datateknik @ Chalmers Tekniska Högskola (Åk 2)\n- Sport: Kapplöpningssimmare (Valhallabadet, 50m frisim & fjäril)\n- Tech: Homelab, Linux, Rust, C, Docker, Minecraft-servrar\n- Fritid: Analogt fotografi (35mm film), Gaming, Dotfiles`,
        },
        'chalmers.txt': {
          type: 'file',
          size: '280 B',
          description: 'Aktuell status på Chalmers Datateknik',
          content: `Chalmers Tekniska Högskola — Datateknik D-24\nAktuella kurser: Operativsystem, Datorarkitektur, Datakommunikation.\nLaborationer i EDIT-huset: Schemaläggare i C, kontextbyten och minnesmodeller.`,
        },
        'swim.txt': {
          type: 'file',
          size: '250 B',
          description: 'Simträning och passlogg',
          content: `Simning & Fysik:\nBassäng: Valhallabadet 50m\nFokus: Uthållighet och teknik i frisim & fjärilsim.\nPass: 5-6 dagar i veckan. Bästa botemedlet mot fastkörda algoritmer.`,
        }
      }
    };

    let currentPath: string[] = [];
    let cmdHistory: string[] = [];
    let historyIndex = -1;

    function getCwdLabel(): string {
      return currentPath.length === 0 ? '~' : `~/${currentPath.join('/')}`;
    }

    function updateTitle() {
      if (titleText && !isMinimized) {
        titleText.textContent = `bash — gulo@playground: ${getCwdLabel()}${isMaximized ? ' [MAXIMERAD FULLSKÄRM]' : ''}`;
      }
      if (promptCwd) {
        promptCwd.textContent = getCwdLabel();
      }
    }

    function resolveNode(pathArr: string[]): DirNode | FileNode | null {
      let current: DirNode | FileNode = fileSystem;
      for (const seg of pathArr) {
        if (current.type !== 'dir') return null;
        if (!current.children[seg]) return null;
        current = current.children[seg];
      }
      return current;
    }

    function getCurrentDir(): DirNode {
      return resolveNode(currentPath) as DirNode;
    }

    // Commands dictionary
    const commands: Record<string, (args: string[]) => string | void> = {
      help: () => `
<div class="text-[#e6edf3] space-y-2 font-mono">
  <div class="text-[#10b981] font-bold border-b border-[#30363d] pb-1">BASH KOMMANDOTOLK // TILLGÄNGLIGA KOMMANDON</div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-xs">
    <div>
      <div class="text-[#38bdf8] font-bold mb-1">Information &amp; Studier:</div>
      <div><span class="text-[#10b981] font-semibold">school / chalmers</span> : Skriver ut Chalmers-studier &amp; kurser</div>
      <div><span class="text-[#10b981] font-semibold">swim</span> : Skriver ut simningspass &amp; tider</div>
      <div><span class="text-[#10b981] font-semibold">whoami</span> : Personlig bakgrund &amp; profil</div>
      <div><span class="text-[#10b981] font-semibold">contact</span> : GitHub, mail &amp; Discord</div>
    </div>
    <div>
      <div class="text-[#f59e0b] font-bold mb-1">Navigering &amp; Webbsidor:</div>
      <div><span class="text-[#10b981] font-semibold">open &lt;mål&gt;</span> : Öppna projekt, artikel, fil eller sektion</div>
      <div><span class="text-[#10b981] font-semibold">projects</span> : Gå till /projects (Portfolio)</div>
      <div><span class="text-[#10b981] font-semibold">thoughts</span> : Gå till /thoughts (Blogg)</div>
      <div><span class="text-[#10b981] font-semibold">files</span> : Gå till /files (Filarkiv)</div>
    </div>
    <div>
      <div class="text-[#a78bfa] font-bold mb-1">Filsystem &amp; Bash:</div>
      <div><span class="text-[#10b981] font-semibold">ls [-la]</span> : Lista filer &amp; mappar</div>
      <div><span class="text-[#10b981] font-semibold">cd &lt;katalog&gt;</span> : Byt mapp (cd .., cd ~, cd projects)</div>
      <div><span class="text-[#10b981] font-semibold">pwd</span> : Visa nuvarande arbetskatalog</div>
      <div><span class="text-[#10b981] font-semibold">cat &lt;fil&gt;</span> : Skriv ut filens innehåll</div>
      <div><span class="text-[#10b981] font-semibold">grep &lt;ord&gt; [fil]</span> : Sök text i filer</div>
    </div>
    <div>
      <div class="text-[#8b949e] font-bold mb-1">Fönster &amp; Verktyg:</div>
      <div><span class="text-[#10b981] font-semibold">clear (Ctrl+L)</span> : Rensa terminalen</div>
      <div><span class="text-[#10b981] font-semibold">date / uptime</span> : Systemstatus &amp; drifttid</div>
      <div><span class="text-[#10b981] font-semibold">exit / close</span> : Stäng terminalen</div>
    </div>
  </div>
  <div class="text-[11px] text-[#8b949e] pt-1 border-t border-[#30363d]/40">
    Tryck <kbd class="text-[#10b981]">Tab</kbd> för att komplettera kommandon och filnamn.
  </div>
</div>`,

      school: () => `
<div class="text-[#e6edf3] space-y-1 text-xs font-mono p-3 rounded bg-[#0d1117] border border-[#30363d]">
  <div class="text-[#38bdf8] font-bold border-b border-[#30363d] pb-1">
    CHALMERS TEKNISKA HÖGSKOLA — CIVILINGENJÖR DATATEKNIK (D-24)
  </div>
  <div><span class="text-[#8b949e]">Status:</span> Årskurs 2 / Civilingenjör</div>
  <div><span class="text-[#8b949e]">Campus:</span> Johanneberg, Göteborg (EDIT-huset)</div>
  <div><span class="text-[#8b949e]">Aktuella kurser:</span> Operativsystem, Datorarkitektur, Datakommunikation, Algoritmer</div>
  <div><span class="text-[#8b949e]">Laborationer:</span> Flertrådade schemaläggare i C, kontextbyten för RISC-V, minneshantering</div>
  <div class="text-[#10b981] pt-1">Skriv <code class="text-[#e6edf3]">open chalmers-sys-sched</code> för att läsa projektet, eller <code class="text-[#e6edf3]">projects</code> för portfolion.</div>
</div>`,

      swim: () => `
<div class="text-[#e6edf3] space-y-1 text-xs font-mono p-3 rounded bg-[#0d1117] border border-[#30363d]">
  <div class="text-[#38bdf8] font-bold border-b border-[#30363d] pb-1">
    🏊 KAPPLÖPNINGSSIMNING // VALHALLABADET
  </div>
  <div><span class="text-[#8b949e]">Bassäng:</span> Valhallabadet, Göteborg (50m)</div>
  <div><span class="text-[#8b949e]">Pass:</span> 5-6 dagar/vecka</div>
  <div><span class="text-[#8b949e]">Huvudgrenar:</span> 50m och 100m frisim &amp; fjärilsim</div>
  <div><span class="text-[#8b949e]">Filosofi:</span> Den bästa motvikten till skärmtid och fastkörda algoritmer.</div>
  <div class="text-[#10b981] pt-1">Läs min artikel med kommandot: <code class="text-[#e6edf3]">open chalmers-simning-kod</code></div>
</div>`,

      whoami: () => `
<div class="text-[#e6edf3] space-y-1 text-xs font-mono p-3 rounded bg-[#0d1117] border border-[#30363d]">
  <div class="text-[#10b981] font-bold border-b border-[#30363d] pb-1">gulo // Chalmersstudent, simmare &amp; utvecklare</div>
  <div><span class="text-[#8b949e]">Studier:</span> Datateknik på Chalmers Tekniska Högskola (Göteborg).</div>
  <div><span class="text-[#8b949e]">Fysik:</span> Tävlingssimmare i frisim och fjäril.</div>
  <div><span class="text-[#8b949e]">Intressen:</span> Självhostade servrar, Linux-tuning, Minecraft, analog fotografi (35mm) och dotfiles.</div>
</div>`,

      ls: (args) => {
        let targetDir = getCurrentDir();
        if (args[0] && !args[0].startsWith('-')) {
          const target = args[0].replace(/\/$/, '');
          const node = target === '~' ? fileSystem : targetDir.children[target];
          if (!node) {
            return `<div class="text-[#f85149]">ls: kan inte komma åt '${escapeHtml(args[0])}': Ingen sådan fil eller katalog</div>`;
          }
          if (node.type === 'file') {
            return `<div class="text-[#e6edf3]">${escapeHtml(target)} (${node.size})</div>`;
          }
          targetDir = node as DirNode;
        }

        const entries = Object.entries(targetDir.children);
        if (entries.length === 0) return `<div class="text-[#8b949e]">Katalogen är tom.</div>`;

        const isLong = args.includes('-l') || args.includes('-la');
        if (isLong) {
          const rows = entries.map(([name, node]) => {
            const isDir = node.type === 'dir';
            const perm = isDir ? 'drwxr-xr-x' : '-rw-r--r--';
            const size = isDir ? '4.0 KB' : node.size;
            const color = isDir ? 'text-[#38bdf8] font-bold' : 'text-[#e6edf3]';
            return `<div class="grid grid-cols-[100px_70px_1fr] gap-2">
              <span class="text-[#8b949e]">${perm}</span>
              <span class="text-[#8b949e] text-right">${size}</span>
              <span class="${color}">${escapeHtml(name)}${isDir ? '/' : ''}</span>
            </div>`;
          }).join('');
          return `<div class="font-mono text-xs space-y-1">${rows}</div>`;
        }

        const pills = entries.map(([name, node]) => {
          if (node.type === 'dir') {
            return `<span class="text-[#38bdf8] font-bold">${escapeHtml(name)}/</span>`;
          }
          return `<span class="text-[#e6edf3]">${escapeHtml(name)}</span>`;
        }).join('&nbsp;&nbsp;&nbsp;&nbsp;');

        return `<div class="flex flex-wrap gap-x-6 gap-y-1 text-xs sm:text-sm">${pills}</div>`;
      },

      cd: (args) => {
        const dest = args[0] ? args[0].replace(/\/$/, '') : '~';
        if (dest === '~' || dest === '') {
          currentPath = [];
          updateTitle();
          return;
        }
        if (dest === '..') {
          if (currentPath.length > 0) currentPath.pop();
          updateTitle();
          return;
        }
        if (dest === '.') return;

        const current = getCurrentDir();
        if (current.children[dest]) {
          if (current.children[dest].type === 'dir') {
            currentPath.push(dest);
            updateTitle();
          } else {
            return `<div class="text-[#f85149]">cd: '${escapeHtml(dest)}': Inte en katalog</div>`;
          }
        } else {
          return `<div class="text-[#f85149]">cd: '${escapeHtml(dest)}': Ingen sådan fil eller katalog</div>`;
        }
      },

      pwd: () => `<div class="text-[#8b949e]">/home/visitor${currentPath.length > 0 ? '/' + currentPath.join('/') : ''}</div>`,

      cat: (args) => {
        if (!args[0]) return `<div class="text-[#f85149]">Användning: cat &lt;filnamn&gt;</div>`;
        const filename = args[0];
        const current = getCurrentDir();

        let node = current.children[filename];
        if (!node && currentPath.length > 0 && fileSystem.children[filename]) {
          node = fileSystem.children[filename];
        }

        if (!node) return `<div class="text-[#f85149]">cat: ${escapeHtml(filename)}: Ingen sådan fil</div>`;
        if (node.type === 'dir') return `<div class="text-[#f85149]">cat: ${escapeHtml(filename)}: Är en katalog.</div>`;

        return `
<div class="p-3 rounded bg-[#0d1117] border border-[#30363d] text-xs text-[#e6edf3] whitespace-pre-wrap leading-relaxed font-mono">
${escapeHtml(node.content)}
</div>`;
      },

      grep: (args) => {
        if (!args[0]) return `<div class="text-[#f85149]">Användning: grep &lt;sökord&gt; [fil]</div>`;
        const query = args[0].toLowerCase();
        const targetFile = args[1];
        const current = getCurrentDir();

        let matches: string[] = [];

        function scanFile(name: string, f: FileNode) {
          const lines = f.content.split('\n');
          lines.forEach((line, idx) => {
            if (line.toLowerCase().includes(query)) {
              matches.push(`<span class="text-[#38bdf8]">${escapeHtml(name)}:${idx + 1}:</span> ${escapeHtml(line)}`);
            }
          });
        }

        if (targetFile) {
          const node = current.children[targetFile];
          if (!node || node.type !== 'file') return `<div class="text-[#f85149]">grep: ${escapeHtml(targetFile)}: Ingen sådan fil</div>`;
          scanFile(targetFile, node);
        } else {
          for (const [name, node] of Object.entries(current.children)) {
            if (node.type === 'file') scanFile(name, node);
          }
        }

        if (matches.length === 0) return `<div class="text-[#8b949e]">Inga träffar för '${escapeHtml(query)}'.</div>`;
        return `<div class="text-xs space-y-1 font-mono">${matches.join('<br/>')}</div>`;
      },

      open: (args) => {
        if (!args[0]) return `<div class="text-[#f85149]">Användning: open &lt;artikel/projekt/fil/sektion&gt;</div>`;
        const target = args[0].toLowerCase().replace(/\.md$/, '').replace(/\.html$/, '');

        // 1. Projects
        if (target.includes('mc-cluster') || target === 'cluster') {
          window.location.href = '/projects/mc-cluster';
          return `<div class="text-[#38bdf8]">Navigerar till /projects/mc-cluster...</div>`;
        }
        if (target.includes('sched') || target.includes('chalmers-sys')) {
          window.location.href = '/projects/chalmers-sys-sched';
          return `<div class="text-[#38bdf8]">Navigerar till /projects/chalmers-sys-sched...</div>`;
        }
        if (target === 'projects' || target === 'projekt') {
          window.location.href = '/projects';
          return `<div class="text-[#10b981]">Navigerar till /projects...</div>`;
        }

        // 2. Thoughts
        if (target.includes('simning') || target.includes('chalmers-simning')) {
          window.location.href = '/thoughts/chalmers-simning-kod';
          return `<div class="text-[#38bdf8]">Navigerar till /thoughts/chalmers-simning-kod...</div>`;
        }
        if (target.includes('jvm') || target.includes('mc-jvm-flags') || target.includes('flags')) {
          window.location.href = '/thoughts/mc-jvm-flags';
          return `<div class="text-[#38bdf8]">Navigerar till /thoughts/mc-jvm-flags...</div>`;
        }
        if (target === 'thoughts' || target === 'tankar' || target === 'blog' || target === 'blogg') {
          window.location.href = '/thoughts';
          return `<div class="text-[#10b981]">Navigerar till /thoughts...</div>`;
        }

        // 3. Files downloads / section
        if (target === 'files' || target === 'filer' || target === 'downloads') {
          window.location.href = '/files';
          return `<div class="text-[#10b981]">Navigerar till /files...</div>`;
        }
        if (target.includes('fabric')) {
          window.location.href = '/downloads/fabric-1.20.4-optimized.zip';
          return `<div class="text-[#10b981]">Laddar ner fabric-1.20.4-optimized.zip...</div>`;
        }
        if (target.includes('backup')) {
          window.location.href = '/downloads/backup-world.sh';
          return `<div class="text-[#10b981]">Laddar ner backup-world.sh...</div>`;
        }

        return `<div class="text-[#f85149]">Känner inte igen '${escapeHtml(target)}'. Skriv 'help' eller 'ls'.</div>`;
      },

      projects: () => {
        window.location.href = '/projects';
        return `<div class="text-[#a78bfa]">Öppnar /projects (Portfolio)...</div>`;
      },

      thoughts: () => {
        window.location.href = '/thoughts';
        return `<div class="text-[#f59e0b]">Öppnar /thoughts (Blogg)...</div>`;
      },

      files: () => {
        window.location.href = '/files';
        return `<div class="text-[#10b981]">Öppnar /files...</div>`;
      },

      clear: () => {
        history.innerHTML = '';
        return;
      },

      date: () => `<div class="text-[#8b949e]">${new Date().toLocaleString('sv-SE')} (Europe/Stockholm)</div>`,
      uptime: () => `<div class="text-[#10b981]">Uptime: 42 dagar, 8 timmar, load: 0.18, 0.22, 0.35</div>`,
      exit: () => { closeWindow(); return; },
      close: () => { closeWindow(); return; }
    };

    commands['chalmers'] = commands['school'];
    commands['dir'] = commands['ls'];

    function execute(rawCmd: string) {
      const cleanCmd = rawCmd.trim();
      if (!cleanCmd) return;

      cmdHistory.push(cleanCmd);
      historyIndex = cmdHistory.length;

      // Render prompt execution line
      const cmdRow = document.createElement('div');
      cmdRow.className = 'flex items-center gap-2 text-xs sm:text-sm font-semibold text-[#8b949e] pt-1';
      cmdRow.innerHTML = `
        <span class="text-[#10b981]">visitor@playground</span><span class="text-[#8b949e]">:</span><span class="text-[#38bdf8]">${escapeHtml(getCwdLabel())}</span><span class="text-[#e6edf3]">$</span>
        <span class="text-[#e6edf3]">${escapeHtml(cleanCmd)}</span>
      `;
      history.appendChild(cmdRow);

      const parts = cleanCmd.split(' ').filter(Boolean);
      const main = parts[0].toLowerCase();
      const args = parts.slice(1);

      if (commands[main]) {
        const res = commands[main](args);
        if (res) {
          const resBox = document.createElement('div');
          resBox.className = 'text-xs pl-3 border-l border-[#30363d] my-1';
          resBox.innerHTML = res;
          history.appendChild(resBox);
        }
      } else {
        const errBox = document.createElement('div');
        errBox.className = 'text-xs text-[#f85149] pl-3 border-l border-[#f85149]/40 my-1';
        errBox.innerHTML = `Kommando hittades inte: '${escapeHtml(cleanCmd)}'. Skriv <span class="text-[#10b981] font-bold">help</span> för hjälplista.`;
        history.appendChild(errBox);
      }

      input.value = '';
      input.focus();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      execute(input.value);
    });

    // ==========================================
    // 3. ROBUST TAB COMPLETION & HISTORY
    // ==========================================
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (cmdHistory.length > 0 && historyIndex > 0) {
          historyIndex--;
          input.value = cmdHistory[historyIndex];
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex < cmdHistory.length - 1) {
          historyIndex++;
          input.value = cmdHistory[historyIndex];
        } else {
          historyIndex = cmdHistory.length;
          input.value = '';
        }
      } else if (e.key === 'Tab') {
        e.preventDefault();
        e.stopPropagation();

        const currentVal = input.value;
        const tokens = currentVal.split(' ');
        const lastToken = tokens[tokens.length - 1] || '';

        // If typing first token -> autocomplete command names
        if (tokens.length <= 1) {
          const cmdList = ['help', 'school', 'swim', 'whoami', 'ls', 'cd', 'cat', 'pwd', 'grep', 'open', 'projects', 'thoughts', 'files', 'clear', 'date', 'uptime', 'exit'];
          const matches = cmdList.filter(c => c.startsWith(lastToken.toLowerCase()));

          if (matches.length === 1) {
            input.value = matches[0] + ' ';
          } else if (matches.length > 1) {
            const hint = document.createElement('div');
            hint.className = 'text-xs text-[#38bdf8] pl-3 my-1';
            hint.textContent = matches.join('   ');
            history.appendChild(hint);
          }
          return;
        }

        // If typing second token -> autocomplete filesystem nodes or open targets
        const currentDir = getCurrentDir();
        const availableItems = Object.entries(currentDir.children).map(([name, node]) => {
          return node.type === 'dir' ? `${name}/` : name;
        });

        if (currentPath.length > 0) availableItems.push('..');

        const matches = availableItems.filter(item => item.toLowerCase().startsWith(lastToken.toLowerCase()));

        if (matches.length === 1) {
          tokens[tokens.length - 1] = matches[0];
          input.value = tokens.join(' ');
        } else if (matches.length > 1) {
          const hint = document.createElement('div');
          hint.className = 'text-xs text-[#38bdf8] pl-3 my-1';
          hint.textContent = matches.join('   ');
          history.appendChild(hint);
        }
      } else if (e.ctrlKey && e.key.toLowerCase() === 'l') {
        e.preventDefault();
        history.innerHTML = '';
      }
    });

    function escapeHtml(str: string) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerminalEngine);
  } else {
    initTerminalEngine();
  }
</script>
