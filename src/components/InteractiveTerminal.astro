---
import { getCollection } from 'astro:content';
import { getActiveStatus } from '../data/status';
import { calculateUptime } from '../data/telemetry';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  isSubpage?: boolean;
  is404?: boolean;
}

const { isSubpage = false, is404 = false } = Astro.props;
const currentActiveStatus = getActiveStatus();
const stationUptime = calculateUptime();

// 1. Läs statiska terminalfiler uppdelade i en/ och sv/ mappar
const terminalDir = path.join(process.cwd(), 'src/data/terminal');
const terminalEnDir = path.join(terminalDir, 'en');
const terminalSvDir = path.join(terminalDir, 'sv');

function readStaticFiles(dir: string): Record<string, { size: string; description: string; content: string }> {
  const files: Record<string, { size: string; description: string; content: string }> = {};
  if (fs.existsSync(dir)) {
    const entries = fs.readdirSync(dir);
    for (const f of entries) {
      const fullPath = path.join(dir, f);
      const stat = fs.statSync(fullPath);
      if (stat.isFile()) {
        const content = fs.readFileSync(fullPath, 'utf-8');
        const sizeStr = stat.size < 1024 ? `${stat.size} B` : `${(stat.size / 1024).toFixed(1)} KB`;
        files[f] = {
          size: sizeStr,
          description: f,
          content,
        };
      }
    }
  }
  return files;
}

const staticFilesEn = readStaticFiles(terminalEnDir);
const staticFilesSv = readStaticFiles(terminalSvDir);

// Läs konfigurerad fastfetch-data för EN och SV
let fastfetchDataEn: any = {
  user: 'gulo',
  host: 'chalmers-station',
  badge: 'CHALMERS // D-24',
  tagline: 'swimmer • sysdev',
  specs: [
    { key: 'Author', value: 'Gustav Löfqvist (gulo)', color: 'emerald' },
    { key: 'OS', value: 'Omarchy (Arch Linux + Hyprland)', color: 'sky' },
    { key: 'Host', value: 'chalmers-station', color: 'sky' },
    { key: 'Kernel', value: 'Linux 6.12.8-zen1', color: 'sky' },
    { key: 'Uptime', value: '42 days, 8 hours, 14 mins', color: 'sky' },
    { key: 'Shell', value: 'bash 5.2 / zsh 5.9 • alacritty', color: 'sky' },
    { key: 'Editor', value: 'Neovim', color: 'sky' },
    { key: 'Education', value: 'M.Sc. Computer Science & Eng @ Chalmers (EDIT, Year 2)', color: 'emerald' },
    { key: 'Swimming', value: 'MASS & Growth Objective // Åbybadet & GoCo (Sprint free/fly)', color: 'emerald' },
    { key: 'Homelab', value: 'Proxmox VE, Raspberry Pi, Web & MC clusters', color: 'emerald' },
    { key: 'Status', value: '[ONLINE] Studying & Sprint training', color: 'amber', online: true }
  ]
};

if (staticFilesEn['fastfetch.json']) {
  try {
    fastfetchDataEn = JSON.parse(staticFilesEn['fastfetch.json'].content);
  } catch (e) {}
}

let fastfetchDataSv: any = {
  user: 'gulo',
  host: 'chalmers-station',
  badge: 'CHALMERS // D-24',
  tagline: 'simmare • sysdev',
  specs: [
    { key: 'Skapare', value: 'Gustav Löfqvist (gulo)', color: 'emerald' },
    { key: 'OS', value: 'Omarchy (Arch Linux + Hyprland)', color: 'sky' },
    { key: 'Host', value: 'chalmers-station', color: 'sky' },
    { key: 'Kernel', value: 'Linux 6.12.8-zen1', color: 'sky' },
    { key: 'Uptime', value: '42 dagar, 8 timmar, 14 min', color: 'sky' },
    { key: 'Shell', value: 'bash 5.2 / zsh 5.9 • alacritty', color: 'sky' },
    { key: 'Editor', value: 'Neovim', color: 'sky' },
    { key: 'Utbildning', value: 'Civilingenjör Datateknik @ Chalmers (EDIT, Åk 2)', color: 'emerald' },
    { key: 'Simning', value: 'MASS & Growth Objective // Åbybadet & GoCo (Sprint frisim/fjäril)', color: 'emerald' },
    { key: 'Homelab', value: 'Proxmox VE, Raspberry Pi, Webb & MC-kluster', color: 'emerald' },
    { key: 'Status', value: '[ONLINE] Studier & Sprintträning', color: 'amber', online: true }
  ]
};

if (staticFilesSv['fastfetch.json']) {
  try {
    fastfetchDataSv = JSON.parse(staticFilesSv['fastfetch.json'].content);
  } catch (e) {}
}

// Inject live calculated uptime and current active status into fastfetch specs
if (Array.isArray(fastfetchDataEn?.specs)) {
  fastfetchDataEn.specs = fastfetchDataEn.specs.map((item: any) => {
    if (item.key === 'Uptime') return { ...item, value: stationUptime.formattedEn };
    if (item.key === 'Status') return { ...item, value: currentActiveStatus.badge.en.replace(/\[●\s*/g, '['), color: currentActiveStatus.activeEvent ? 'amber' : 'emerald' };
    return item;
  });
}

if (Array.isArray(fastfetchDataSv?.specs)) {
  fastfetchDataSv.specs = fastfetchDataSv.specs.map((item: any) => {
    if (item.key === 'Uptime' || item.key === 'Drifttid') return { ...item, value: stationUptime.formattedSv };
    if (item.key === 'Status') return { ...item, value: currentActiveStatus.badge.sv.replace(/\[●\s*/g, '['), color: currentActiveStatus.activeEvent ? 'amber' : 'emerald' };
    return item;
  });
}

// 2. Läs dynamiska projekt (sammanfattning för terminal cat, separat EN och SV)
const rawProjects = await getCollection('projects');
const projectMap = new Map<string, { en?: any; sv?: any }>();
for (const p of rawProjects) {
  const slug = p.id.replace(/^(en|sv)\//, '');
  const isSv = p.id.startsWith('sv/');
  if (!projectMap.has(slug)) projectMap.set(slug, {});
  const entry = projectMap.get(slug)!;
  if (isSv) entry.sv = p;
  else entry.en = p;
}

const projectNodesEn: Record<string, any> = {};
const projectNodesSv: Record<string, any> = {};

for (const [slug, pair] of projectMap.entries()) {
  const pEn = pair.en || pair.sv;
  const pSv = pair.sv || pair.en;

  if (pEn) {
    projectNodesEn[`${slug}.md`] = {
      type: 'file',
      size: '1.4 KB',
      description: pEn.data.description,
      content: `# ${pEn.data.title}\nStatus: [${pEn.data.status}] | Category: ${pEn.data.category}\nTech: ${(pEn.data.tech || []).join(', ')}\n\n${pEn.data.description}\n\nView on web: open ${slug}${pEn.data.pdfUrl ? `\nDownload Project PDF: wget ${pEn.data.pdfName || `${slug}.pdf`}` : ''}`,
      actionUrl: `/projects/${slug}`,
    };
    if (pEn.data.pdfUrl) {
      const pdfFilename = (pEn.data.pdfName && pEn.data.pdfName.toLowerCase().endsWith('.pdf')) ? pEn.data.pdfName : `${slug}.pdf`;
      projectNodesEn[pdfFilename] = {
        type: 'file',
        size: 'PDF spec',
        description: `Project Document (PDF): ${pEn.data.title}`,
        content: `[Project PDF Specification]\nTitle: ${pEn.data.title}\nSource: ${pEn.data.pdfUrl}\nDownload to disk with: wget ${pdfFilename}`,
        actionUrl: pEn.data.pdfUrl,
        isPdf: true,
      };
    }
  }

  if (pSv) {
    projectNodesSv[`${slug}.md`] = {
      type: 'file',
      size: '1.4 KB',
      description: pSv.data.description,
      content: `# ${pSv.data.title}\nStatus: [${pSv.data.status}] | Kategori: ${pSv.data.category}\nTeknologier: ${(pSv.data.tech || []).join(', ')}\n\n${pSv.data.description}\n\nÖppna på webben: open ${slug}${(pSv.data.pdfUrl || pEn?.data?.pdfUrl) ? `\nLadda ned projekt-PDF: wget ${pSv.data.pdfName || pEn?.data?.pdfName || `${slug}.pdf`}` : ''}`,
      actionUrl: `/projects/${slug}`,
    };
    const pdfUrlSv = pSv.data.pdfUrl || pEn?.data.pdfUrl;
    if (pdfUrlSv) {
      const pdfFilename = (pSv.data.pdfName && pSv.data.pdfName.toLowerCase().endsWith('.pdf')) ? pSv.data.pdfName : ((pEn?.data?.pdfName && pEn.data.pdfName.toLowerCase().endsWith('.pdf')) ? pEn.data.pdfName : `${slug}.pdf`);
      projectNodesSv[pdfFilename] = {
        type: 'file',
        size: 'PDF spec',
        description: `Projektdokument (PDF): ${pSv.data.title}`,
        content: `[Projektspecifikation PDF]\nTitel: ${pSv.data.title}\nKälla: ${pdfUrlSv}\nLadda ned till disk med: wget ${pdfFilename}`,
        actionUrl: pdfUrlSv,
        isPdf: true,
      };
    }
  }
}

// 3. Läs dynamiska tankar & blogginlägg
const rawThoughts = await getCollection('thoughts');
const thoughtNodes: Record<string, any> = {};
for (const t of rawThoughts) {
  const dateStr = t.data.pubDate ? new Date(t.data.pubDate).toISOString().split('T')[0] : '2026';
  const catLabel = (t.data.category || 'tanke').toUpperCase();
  const preview = `[${catLabel}] ${t.data.title}\nDate: ${dateStr} | Category: ${t.data.category || 'tanke'} | Tags: ${(t.data.tags || []).join(', ')}\n\n"${t.data.description}"\n\nRead full post: open ${t.id}${t.data.pdfUrl ? `\nCompanion PDF: wget ${t.data.pdfName || `${t.id}.pdf`}` : ''}`;
  thoughtNodes[`${t.id}.md`] = {
    type: 'file',
    size: '1.8 KB',
    description: t.data.description,
    content: preview,
    actionUrl: `/thoughts/${t.id}`,
  };

  // Only create virtual PDF node IF pdfUrl is explicitly defined!
  if (t.data.pdfUrl) {
    const pdfFilename = (t.data.pdfName && t.data.pdfName.toLowerCase().endsWith('.pdf')) ? t.data.pdfName : `${t.id}.pdf`;
    thoughtNodes[pdfFilename] = {
      type: 'file',
      size: 'PDF doc',
      description: `Companion PDF: ${t.data.title}`,
      content: `[Companion PDF Document]\nTitle: ${t.data.title}\nSource: ${t.data.pdfUrl}\nDownload to disk with: wget ${pdfFilename}`,
      actionUrl: t.data.pdfUrl,
      isPdf: true,
    };
  }
}

// 4. Läs dynamiska nedladdningsbara filer
const rawDownloads = await getCollection('downloads');
const downloadNodes: Record<string, any> = {};
for (const d of rawDownloads) {
  const preview = `${d.data.name} (${d.data.filename})\nSize: ${d.data.size} | Category: ${d.data.category}\n${d.data.description}\n\nQuick command: ${d.data.usage || 'curl -O ' + d.data.fileUrl}\nDownload directly: open ${d.data.filename}`;
  downloadNodes[d.data.filename] = {
    type: 'file',
    size: d.data.size,
    description: d.data.description,
    content: preview,
    actionUrl: d.data.fileUrl,
  };
}

// Slutliga virtuella filsystemstrukturer för EN och SV
const dynamicFileSystemEn = {
  type: 'dir',
  children: {
    projects: {
      type: 'dir',
      children: projectNodesEn,
    },
    thoughts: {
      type: 'dir',
      children: thoughtNodes,
    },
    files: {
      type: 'dir',
      children: downloadNodes,
    },
    ...Object.fromEntries(
      Object.entries(staticFilesEn).map(([fname, data]) => [
        fname,
        {
          type: 'file',
          size: data.size,
          description: data.description,
          content: data.content,
        }
      ])
    )
  }
};

const dynamicFileSystemSv = {
  type: 'dir',
  children: {
    projects: {
      type: 'dir',
      children: projectNodesSv,
    },
    thoughts: {
      type: 'dir',
      children: thoughtNodes,
    },
    files: {
      type: 'dir',
      children: downloadNodes,
    },
    ...Object.fromEntries(
      Object.entries(staticFilesSv).map(([fname, data]) => [
        fname,
        {
          type: 'file',
          size: data.size,
          description: data.description,
          content: data.content,
        }
      ])
    )
  }
};
---

<section 
  id="terminal-section" 
  class={`w-full ${isSubpage ? 'hidden mb-8' : 'mb-10'}`} 
  data-is-subpage={isSubpage ? 'true' : 'false'}
  data-is-404={is404 ? 'true' : 'false'}
  aria-label="Interactive TUI Terminal"
>
  <!-- Embedded dynamic filesystem data for EN and SV -->
  <script id="terminal-fs-en" type="application/json" set:html={JSON.stringify(dynamicFileSystemEn)} />
  <script id="terminal-fs-sv" type="application/json" set:html={JSON.stringify(dynamicFileSystemSv)} />
  <script id="terminal-fastfetch-en" type="application/json" set:html={JSON.stringify(fastfetchDataEn)} />
  <script id="terminal-fastfetch-sv" type="application/json" set:html={JSON.stringify(fastfetchDataSv)} />

  <!-- 404 Fallback Closed Card vs Homepage About Me Card -->
  {is404 ? (
    <div 
      id="terminal-closed-card" 
      class="hidden mb-6 p-6 rounded-lg bg-[#161b22] border border-[#f85149]/60 shadow-xl font-mono space-y-4"
    >
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-[#30363d] gap-3">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-[#f85149] animate-pulse"></span>
          <h2 class="text-sm font-bold tracking-wider uppercase text-[#e6edf3]" data-i18n="not_found_status">
            HTTP 404 // COMMAND_NOT_FOUND
          </h2>
        </div>
        <button 
          type="button" 
          id="btn-reopen-terminal" 
          class="hidden sm:flex text-xs px-3 py-1.5 rounded bg-[#0d1117] border border-[#30363d] text-[#10b981] hover:border-[#10b981] hover:bg-[#10b981]/10 transition-all cursor-pointer items-center gap-2 self-start sm:self-auto"
        >
          <span>&gt;_</span>
          <span data-i18n="term_reopen_btn">Open terminal</span>
        </button>
      </div>

      <div class="p-4 rounded bg-[#0d1117] border border-[#30363d] space-y-2">
        <div class="flex items-center gap-2 text-[#e6edf3] font-bold text-xs">
          <span class="text-[#f59e0b]">⚠</span>
          <span data-i18n="not_found_title">Route Not Found in Playground</span>
        </div>
        <p class="text-[#8b949e] text-xs leading-relaxed" data-i18n="not_found_desc">
          The requested path does not exist on this station. It might have been moved, renamed, or never compiled.
        </p>
      </div>

      <div class="pt-2">
        <div class="text-[11px] text-[#8b949e] mb-2 uppercase tracking-wider font-semibold">
          SUGGESTED DISCOVERY VECTORS:
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <a href="/" class="p-3 rounded bg-[#0d1117] border border-[#30363d] hover:border-[#10b981] hover:bg-[#1f242c] text-[#10b981] hover:text-[#e6edf3] transition-all flex items-center justify-between group">
            <span data-i18n="not_found_back_cockpit">[← Back to Cockpit]</span>
            <span class="text-[#8b949e] group-hover:text-[#10b981]">~</span>
          </a>
          <a href="/projects" class="p-3 rounded bg-[#0d1117] border border-[#30363d] hover:border-[#a78bfa] hover:bg-[#1f242c] text-[#a78bfa] hover:text-[#e6edf3] transition-all flex items-center justify-between group">
            <span data-i18n="not_found_browse_projects">[Explore Projects →]</span>
            <span class="text-[#8b949e] group-hover:text-[#a78bfa]">~/projects</span>
          </a>
          <a href="/thoughts" class="p-3 rounded bg-[#0d1117] border border-[#30363d] hover:border-[#f59e0b] hover:bg-[#1f242c] text-[#f59e0b] hover:text-[#e6edf3] transition-all flex items-center justify-between group">
            <span data-i18n="not_found_read_thoughts">[Read Blog &amp; Notes →]</span>
            <span class="text-[#8b949e] group-hover:text-[#f59e0b]">~/thoughts</span>
          </a>
          <a href="/files" class="p-3 rounded bg-[#0d1117] border border-[#30363d] hover:border-[#38bdf8] hover:bg-[#1f242c] text-[#38bdf8] hover:text-[#e6edf3] transition-all flex items-center justify-between group">
            <span data-i18n="not_found_download_files">[Download Archives →]</span>
            <span class="text-[#8b949e] group-hover:text-[#38bdf8]">~/files</span>
          </a>
        </div>
      </div>
    </div>
  ) : !isSubpage ? (
    <>
      <script is:inline>
        (function() {
          var navEntries = performance.getEntriesByType && performance.getEntriesByType('navigation');
          var isReload = (navEntries && navEntries[0] && navEntries[0].type === 'reload') || 
                         (window.performance && window.performance.navigation && window.performance.navigation.type === 1);
          if (isReload) {
            sessionStorage.removeItem('terminal_history_html');
            sessionStorage.removeItem('terminal_cmd_history');
            sessionStorage.removeItem('terminal_body_scroll');
            sessionStorage.removeItem('terminal_nav_scroll_y');
            sessionStorage.removeItem('navigated_via_cli');
            sessionStorage.removeItem('terminal_cat_hint_dismissed');
            sessionStorage.removeItem('gulo_boot_intro_played');
            sessionStorage.removeItem('terminal_closed_by_user');
            sessionStorage.removeItem('terminal_opened_on_mobile');
          }

          var isPhone = window.innerWidth < 640;
          var isClosed = sessionStorage.getItem('terminal_closed_by_user') === 'true';
          var viaCli = sessionStorage.getItem('navigated_via_cli') === 'true';
          var mobileOpened = sessionStorage.getItem('terminal_opened_on_mobile') === 'true';
          if ((isPhone && !viaCli && !mobileOpened) || (isClosed && !viaCli)) {
            var c = document.getElementById('terminal-closed-card');
            var w = document.getElementById('terminal-window');
            if (c) c.classList.remove('hidden');
            if (w) w.classList.add('hidden');
          }
        })();
      </script>
      <div 
        id="terminal-closed-card" 
        class="hidden mb-6 p-4 sm:p-6 rounded-lg bg-[#161b22] border border-[#30363d] hover:border-[#10b981]/60 hover:bg-[#1f242c] transition-all shadow-xl"
      >
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 sm:pb-4 mb-3 sm:mb-4 border-b border-[#30363d] gap-3">
        <div class="flex items-center gap-3">
          <span id="closed-card-dot" class="w-2.5 h-2.5 rounded-full bg-[#10b981] animate-pulse"></span>
          <h2 class="text-xs sm:text-sm font-mono font-bold tracking-wider uppercase text-[#e6edf3]" id="closed-card-title" data-i18n="term_closed_title">
            Who is gulo? // About me &amp; background
          </h2>
        </div>
        <button 
          type="button" 
          id="btn-reopen-terminal" 
          class="hidden sm:flex text-xs font-mono px-3.5 py-1.5 rounded bg-[#0d1117] border border-[#30363d] text-[#10b981] hover:border-[#10b981] hover:bg-[#10b981]/15 active:scale-95 transition-all cursor-pointer items-center gap-2 self-start sm:self-auto shadow-sm"
        >
          <span>&gt;_</span>
          <span id="closed-card-reopen-text" data-i18n="term_reopen_btn">Open terminal</span>
        </button>
      </div>

      <!-- Structured Biography with bilingual support -->
      <div id="closed-card-content" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 text-xs sm:text-sm font-mono">
        <div class="space-y-3">
          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5" data-i18n="term_card_chalmers_title">Chalmers University of Technology</span>
            <p class="text-[#e6edf3] leading-relaxed" data-i18n="term_card_chalmers_desc">
              Second-year student in the M.Sc. in Computer Science &amp; Engineering program. Accepted RIU elite athlete student at the EDIT building. Focusing on systems architecture, algorithms, and development.
            </p>
          </div>

          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5" data-i18n="term_card_swim_title">Competitive Swimming</span>
            <p class="text-[#e6edf3] leading-relaxed" data-i18n="term_card_swim_desc">
              Competitive sprint swimmer for MASS and Growth Objective (Åbybadet &amp; GoCo, 5+ swim &amp; 3 gym sessions/week). 50m &amp; 100m freestyle and butterfly sprint specialist.
            </p>
          </div>
        </div>

        <div class="space-y-3">
          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5" data-i18n="term_card_homelab_title">Homelab &amp; Infrastructure</span>
            <p class="text-[#e6edf3] leading-relaxed" data-i18n="term_card_homelab_desc">
              Dedicated Proxmox VE server and Raspberry Pi cluster. Deploying websites, Minecraft clusters, and internal services.
            </p>
          </div>

          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5" data-i18n="term_card_creative_title">Creative, Outdoors &amp; Media</span>
            <p class="text-[#e6edf3] leading-relaxed" data-i18n="term_card_creative_desc">
              Outdoors enthusiast (hiking, climbing, cycling, discgolf, golf), photo and video production with Sony ZV-E10, and tweaking Omarchy (Arch + Hyprland).
            </p>
          </div>
        </div>
      </div>

      <!-- Subtle read-more indicator below closed card -->
      <div class="mt-4 sm:mt-5 pt-3 border-t border-[#30363d]/40 flex items-center justify-center gap-2 text-xs font-mono text-[#8b949e]">
        <span class="inline-block animate-bounce text-[#10b981]">↓</span>
        <span data-i18n="term_more_below">scroll for projects &amp; articles</span>
        <span class="inline-block animate-bounce text-[#10b981]">↓</span>
      </div>
    </div>
    </>
  ) : null}

  <!-- Terminal Window Container -->
  <div 
    id="terminal-window" 
    class="relative rounded-lg border border-[#30363d] bg-[#161b22] shadow-2xl transition-all duration-200 overflow-hidden flex flex-col max-h-[min(880px,78dvh)]"
  >
    <!-- Window Title Bar with Interactive Controls -->
    <div 
      id="terminal-titlebar"
      class="flex items-center justify-between px-3 sm:px-4 py-2 sm:py-2.5 bg-[#161b22] hover:bg-[#1f242c]/70 border-b border-[#30363d] select-none cursor-pointer shrink-0 transition-colors"
      title="Click titlebar to expand if minimized, or double click for fullscreen"
      data-i18n-title="term_titlebar_hint"
    >
      <!-- Real Interactive Window Action Buttons with comfortable mobile touch hit areas -->
      <div class="flex items-center space-x-1 sm:space-x-2">
        <button 
          type="button" 
          id="btn-win-close" 
          tabindex="-1"
          class="w-6 h-6 sm:w-3.5 sm:h-3.5 rounded-full flex items-center justify-center cursor-pointer group p-0 shrink-0" 
          title="Close terminal"
          data-i18n-title="term_btn_close_title"
          aria-label="Close terminal"
        >
          <span class="w-3.5 h-3.5 rounded-full bg-[#f85149] hover:brightness-125 transition-all flex items-center justify-center text-[9px] font-bold text-[#0d1117]">
            <span class="opacity-40 group-hover:opacity-100 transition-opacity leading-none text-[#0d1117]">✕</span>
          </span>
        </button>
        <button 
          type="button" 
          id="btn-win-minimize" 
          tabindex="-1"
          class="w-6 h-6 sm:w-3.5 sm:h-3.5 rounded-full flex items-center justify-center cursor-pointer group p-0 shrink-0" 
          title="Minimize window"
          data-i18n-title="term_btn_min_title"
          aria-label="Minimize terminal"
        >
          <span class="w-3.5 h-3.5 rounded-full bg-[#f59e0b] hover:brightness-125 transition-all flex items-center justify-center text-[9px] font-bold text-[#0d1117]">
