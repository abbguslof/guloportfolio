---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  isSubpage?: boolean;
}

const { isSubpage = false } = Astro.props;

// 1. Läs statiska terminalfiler uppdelade i en/ och sv/ mappar
const terminalDir = path.join(process.cwd(), 'src/data/terminal');
const terminalEnDir = path.join(terminalDir, 'en');
const terminalSvDir = path.join(terminalDir, 'sv');

function readStaticFiles(dir: string): Record<string, { size: string; description: string; content: string }> {
  const files: Record<string, { size: string; description: string; content: string }> = {};
  if (fs.existsSync(dir)) {
    const entries = fs.readdirSync(dir);
    for (const f of entries) {
      const fullPath = path.join(dir, f);
      const stat = fs.statSync(fullPath);
      if (stat.isFile()) {
        const content = fs.readFileSync(fullPath, 'utf-8');
        const sizeStr = stat.size < 1024 ? `${stat.size} B` : `${(stat.size / 1024).toFixed(1)} KB`;
        files[f] = {
          size: sizeStr,
          description: f,
          content,
        };
      }
    }
  }
  return files;
}

const staticFilesEn = readStaticFiles(terminalEnDir);
const staticFilesSv = readStaticFiles(terminalSvDir);

// Läs konfigurerad fastfetch-data för EN och SV
let fastfetchDataEn: any = {
  user: 'gulo',
  host: 'chalmers-station',
  badge: 'CHALMERS // D-24',
  tagline: 'swimmer • sysdev',
  specs: [
    { key: 'OS', value: 'Debian GNU/Linux 12 (bookworm) x86_64', color: 'sky' },
    { key: 'Host', value: 'chalmers-workstation', color: 'sky' },
    { key: 'Kernel', value: 'Linux 6.12.8-zen1', color: 'sky' },
    { key: 'Uptime', value: '42 days, 8 hours, 14 mins', color: 'sky' },
    { key: 'Shell', value: 'zsh 5.9 / bash 5.2 • kitty', color: 'sky' },
    { key: 'Editor', value: 'Neovim v0.10.2 (Lua dotfiles)', color: 'sky' },
    { key: 'Education', value: 'M.Sc. Computer Science & Eng @ Chalmers (Year 2)', color: 'emerald' },
    { key: 'Swimming', value: 'Valhallabadet (5-6 sessions/wk, freestyle/fly)', color: 'emerald' },
    { key: 'Homelab', value: 'PaperMC SMP cluster, Docker, Velocity', color: 'emerald' },
    { key: 'Status', value: '[● ONLINE] Exam week & server ops', color: 'amber', online: true }
  ]
};

if (staticFilesEn['fastfetch.json']) {
  try {
    fastfetchDataEn = JSON.parse(staticFilesEn['fastfetch.json'].content);
  } catch (e) {}
}

let fastfetchDataSv: any = {
  user: 'gulo',
  host: 'chalmers-station',
  badge: 'CHALMERS // D-24',
  tagline: 'simmare • sysdev',
  specs: [
    { key: 'OS', value: 'Debian GNU/Linux 12 (bookworm) x86_64', color: 'sky' },
    { key: 'Host', value: 'chalmers-workstation', color: 'sky' },
    { key: 'Kernel', value: 'Linux 6.12.8-zen1', color: 'sky' },
    { key: 'Uptime', value: '42 dagar, 8 timmar, 14 min', color: 'sky' },
    { key: 'Shell', value: 'zsh 5.9 / bash 5.2 • kitty', color: 'sky' },
    { key: 'Editor', value: 'Neovim v0.10.2 (Lua dotfiles)', color: 'sky' },
    { key: 'Utbildning', value: 'Civilingenjör Datateknik @ Chalmers (Åk 2)', color: 'emerald' },
    { key: 'Simning', value: 'Valhallabadet (5-6 pass/v, frisim/fjäril)', color: 'emerald' },
    { key: 'Homelab', value: 'PaperMC SMP-kluster, Docker, Velocity', color: 'emerald' },
    { key: 'Status', value: '[● ONLINE] Tentavecka & serverdrift', color: 'amber', online: true }
  ]
};

if (staticFilesSv['fastfetch.json']) {
  try {
    fastfetchDataSv = JSON.parse(staticFilesSv['fastfetch.json'].content);
  } catch (e) {}
}

// 2. Läs dynamiska projekt (sammanfattning för terminal cat)
const rawProjects = await getCollection('projects');
const projectNodes: Record<string, any> = {};
for (const p of rawProjects) {
  const preview = `# ${p.data.title}\nStatus: [${p.data.status}] | Category: ${p.data.category}\nTech: ${(p.data.tech || []).join(', ')}\n\n${p.data.description}\n\nView on web: open ${p.id}`;
  projectNodes[`${p.id}.md`] = {
    type: 'file',
    size: '1.4 KB',
    description: p.data.description,
    content: preview,
    actionUrl: `/projects/${p.id}`,
  };
}

// 3. Läs dynamiska tankar & blogginlägg
const rawThoughts = await getCollection('thoughts');
const thoughtNodes: Record<string, any> = {};
for (const t of rawThoughts) {
  const dateStr = t.data.pubDate ? new Date(t.data.pubDate).toISOString().split('T')[0] : '2026';
  const catLabel = (t.data.category || 'tanke').toUpperCase();
  const preview = `[${catLabel}] ${t.data.title}\nDate: ${dateStr} | Category: ${t.data.category || 'tanke'} | Tags: ${(t.data.tags || []).join(', ')}\n\n"${t.data.description}"\n\nRead full post: open ${t.id}`;
  thoughtNodes[`${t.id}.md`] = {
    type: 'file',
    size: '1.8 KB',
    description: t.data.description,
    content: preview,
    actionUrl: `/thoughts/${t.id}`,
  };
}

// 4. Läs dynamiska nedladdningsbara filer
const rawDownloads = await getCollection('downloads');
const downloadNodes: Record<string, any> = {};
for (const d of rawDownloads) {
  const preview = `${d.data.name} (${d.data.filename})\nSize: ${d.data.size} | Category: ${d.data.category}\n${d.data.description}\n\nQuick command: ${d.data.usage || 'curl -O ' + d.data.fileUrl}\nDownload directly: open ${d.data.filename}`;
  downloadNodes[d.data.filename] = {
    type: 'file',
    size: d.data.size,
    description: d.data.description,
    content: preview,
    actionUrl: d.data.fileUrl,
  };
}

// Slutliga virtuella filsystemstrukturer för EN och SV
const dynamicFileSystemEn = {
  type: 'dir',
  children: {
    projects: {
      type: 'dir',
      children: projectNodes,
    },
    thoughts: {
      type: 'dir',
      children: thoughtNodes,
    },
    files: {
      type: 'dir',
      children: downloadNodes,
    },
    ...Object.fromEntries(
      Object.entries(staticFilesEn).map(([fname, data]) => [
        fname,
        {
          type: 'file',
          size: data.size,
          description: data.description,
          content: data.content,
        }
      ])
    )
  }
};

const dynamicFileSystemSv = {
  type: 'dir',
  children: {
    projects: {
      type: 'dir',
      children: projectNodes,
    },
    thoughts: {
      type: 'dir',
      children: thoughtNodes,
    },
    files: {
      type: 'dir',
      children: downloadNodes,
    },
    ...Object.fromEntries(
      Object.entries(staticFilesSv).map(([fname, data]) => [
        fname,
        {
          type: 'file',
          size: data.size,
          description: data.description,
          content: data.content,
        }
      ])
    )
  }
};
---

<section 
  id="terminal-section" 
  class={`w-full ${isSubpage ? 'hidden mb-8' : 'mb-10'}`} 
  data-is-subpage={isSubpage ? 'true' : 'false'}
  aria-label="Interactive TUI Terminal"
>
  <!-- Embedded dynamic filesystem data for EN and SV -->
  <script id="terminal-fs-en" type="application/json" set:html={JSON.stringify(dynamicFileSystemEn)} />
  <script id="terminal-fs-sv" type="application/json" set:html={JSON.stringify(dynamicFileSystemSv)} />
  <script id="terminal-fastfetch-en" type="application/json" set:html={JSON.stringify(fastfetchDataEn)} />
  <script id="terminal-fastfetch-sv" type="application/json" set:html={JSON.stringify(fastfetchDataSv)} />

  <!-- Static Human-Readable "About Me" Card (Only on homepage when terminal is closed via ✕, or by default on mobile phones) -->
  {!isSubpage && (
    <>
      <script is:inline>
        (function() {
          var isMobile = window.innerWidth < 1024;
          var isClosed = sessionStorage.getItem('terminal_closed_by_user') === 'true';
          var viaCli = sessionStorage.getItem('navigated_via_cli') === 'true';
          if ((isMobile || isClosed) && !viaCli) {
            var c = document.getElementById('terminal-closed-card');
            var w = document.getElementById('terminal-window');
            if (c) c.classList.remove('hidden');
            if (w) w.classList.add('hidden');
          }
        })();
      </script>
      <div 
        id="terminal-closed-card" 
        class="hidden mb-6 p-6 rounded-lg bg-[#161b22] border border-[#30363d] hover:border-[#10b981]/60 transition-all shadow-xl"
      >
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 mb-4 border-b border-[#30363d] gap-3">
        <div class="flex items-center gap-3">
          <span class="w-2.5 h-2.5 rounded-full bg-[#10b981] animate-pulse"></span>
          <h2 class="text-sm font-mono font-bold tracking-wider uppercase text-[#e6edf3]" id="closed-card-title" data-i18n="term_closed_title">
            Who is gulo? // About me &amp; background
          </h2>
        </div>
        <button 
          type="button" 
          id="btn-reopen-terminal" 
          class="text-xs font-mono px-3 py-1.5 rounded bg-[#0d1117] border border-[#30363d] text-[#10b981] hover:border-[#10b981] hover:bg-[#10b981]/10 transition-all cursor-pointer flex items-center gap-2 self-start sm:self-auto"
        >
          <span>&gt;_</span>
          <span id="closed-card-reopen-text" data-i18n="term_reopen_btn">Open terminal again</span>
        </button>
      </div>

      <!-- Structured Biography with bilingual support -->
      <div id="closed-card-content" class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm font-mono">
        <div class="space-y-3">
          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5" data-i18n="term_card_chalmers_title">Chalmers University of Technology</span>
            <p class="text-[#e6edf3] leading-relaxed" data-i18n="term_card_chalmers_desc">
              Second-year student in the M.Sc. in Computer Science &amp; Engineering program. Focused on operating systems, memory safety, distributed systems, and low-level C/Rust.
            </p>
          </div>

          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5" data-i18n="term_card_swim_title">Competitive Swimming</span>
            <p class="text-[#e6edf3] leading-relaxed" data-i18n="term_card_swim_desc">
              Active competitive swimmer training at Valhallabadet (5-6 sessions/week). Swimming provides the mental discipline and focus needed to solve difficult technical challenges.
            </p>
          </div>
        </div>

        <div class="space-y-3">
          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5" data-i18n="term_card_homelab_title">Homelab &amp; Infrastructure</span>
            <p class="text-[#e6edf3] leading-relaxed" data-i18n="term_card_homelab_desc">
              Running a dedicated Minecraft cluster (PaperMC 1.20 SMP) on Debian 12 with isolated Docker containers, automated zstd backups, and WireGuard VPN.
            </p>
          </div>

          <div>
            <span class="text-[#38bdf8] font-semibold block mb-0.5" data-i18n="term_card_creative_title">Creative, 35mm Film &amp; Dotfiles</span>
            <p class="text-[#e6edf3] leading-relaxed" data-i18n="term_card_creative_desc">
              Shooting analog 35mm photography, building Neovim dotfiles in Lua, playing co-op games, and tweaking Linux environments (Arch + Hyprland).
            </p>
          </div>
        </div>
      </div>
    </div>
    </>
  )}

  <!-- Terminal Window Container -->
  <div 
    id="terminal-window" 
    class="rounded-lg border border-[#30363d] bg-[#161b22] shadow-2xl transition-all duration-200 overflow-hidden flex flex-col max-h-[min(880px,78vh)]"
  >
    <!-- Window Title Bar with Interactive Controls -->
    <div 
      id="terminal-titlebar"
      class="flex items-center justify-between px-4 py-2.5 bg-[#0d1117] border-b border-[#30363d] select-none cursor-pointer shrink-0"
      title="Click titlebar to expand if minimized, or double click for fullscreen"
      data-i18n-title="term_titlebar_hint"
    >
      <!-- Real Interactive Window Action Buttons -->
      <div class="flex items-center space-x-2">
        <button 
          type="button" 
          id="btn-win-close" 
          class="w-3.5 h-3.5 rounded-full bg-[#f85149] hover:brightness-125 transition-all flex items-center justify-center text-[9px] font-bold text-[#0d1117] group cursor-pointer" 
          title="Close terminal"
          data-i18n-title="term_btn_close_title"
          aria-label="Close terminal"
        >
          <span class="opacity-0 group-hover:opacity-100 transition-opacity leading-none">✕</span>
        </button>
        <button 
          type="button" 
          id="btn-win-minimize" 
          class="w-3.5 h-3.5 rounded-full bg-[#f59e0b] hover:brightness-125 transition-all flex items-center justify-center text-[9px] font-bold text-[#0d1117] group cursor-pointer" 
          title="Minimize window"
          data-i18n-title="term_btn_min_title"
          aria-label="Minimize terminal"
        >
          <span class="opacity-0 group-hover:opacity-100 transition-opacity leading-none">−</span>
        </button>
        <button 
          type="button" 
          id="btn-win-maximize" 
          class="w-3.5 h-3.5 rounded-full bg-[#2ea043] hover:brightness-125 transition-all flex items-center justify-center text-[9px] font-bold text-[#0d1117] group cursor-pointer" 
          title="Maximize to fullscreen (press Esc to close)"
          data-i18n-title="term_btn_max_title"
          aria-label="Maximize terminal"
        >
          <span class="opacity-0 group-hover:opacity-100 transition-opacity leading-none">+</span>
        </button>
      </div>

      <!-- Window Title & Path -->
      <div class="text-xs text-[#8b949e] font-mono tracking-wide flex items-center gap-2">
        <span id="window-title-text" class="text-[#e6edf3]">bash — gulo@playground: ~</span>
        <span id="window-status-pill" class="text-[10px] text-[#f59e0b] bg-[#0d1117] px-2 py-0.5 rounded border border-[#30363d] hidden" data-i18n="term_minimized_pill">
          MINIMIZED (click to open)
        </span>
      </div>

      <!-- Terminal details -->
      <div class="text-[11px] font-mono text-[#8b949e] hidden sm:flex items-center gap-2">
        <span id="fullscreen-hint" class="text-[#10b981] hidden" data-i18n="term_fullscreen_hint">[Esc to exit fullscreen]</span>
        <span class="text-[#38bdf8]">tty1</span>
        <span>•</span>
        <span>utf-8</span>
      </div>
    </div>

    <!-- Terminal Collapsible Body -->
    <div id="terminal-body" class="p-4 sm:p-5 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto overflow-y-auto flex-1 transition-all">
      <!-- Fastfetch Layout -->
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 pb-5 border-b border-[#30363d]/80">
        <!-- Fastfetch ASCII Emblem (Left column) -->
        <div class="shrink-0 select-none font-mono text-[11px] sm:text-xs leading-[1.2] p-3 rounded bg-[#0d1117] border border-[#30363d]/80 flex flex-col justify-center items-center text-center">
          <pre class="leading-tight text-center font-mono">
<span class="text-[#38bdf8]">     /\_____/\     </span>
<span class="text-[#38bdf8]">    /</span>  <span class="text-[#e6edf3] font-bold">o</span>   <span class="text-[#e6edf3] font-bold">o</span>  <span class="text-[#38bdf8]">\    </span>
<span class="text-[#10b981]">   (</span> <span class="text-[#38bdf8]">==</span>  <span class="text-[#10b981] font-bold">^</span>  <span class="text-[#38bdf8]">==</span> <span class="text-[#10b981]">)   </span>
<span class="text-[#10b981]">    )</span>   <span class="text-[#e6edf3] font-bold">GULO</span>  <span class="text-[#10b981]">)    </span>
<span class="text-[#10b981]">   (</span>  <span class="text-[#38bdf8]">[D-24]</span>   <span class="text-[#10b981]">)   </span>
<span class="text-[#10b981]">  (</span> <span class="text-[#38bdf8]">(  )</span>   <span class="text-[#38bdf8]">(  )</span> <span class="text-[#10b981]">)  </span>
<span class="text-[#38bdf8]"> (__(__)___(__)__) </span>
          </pre>
          <div id="fastfetch-badge" class="mt-2 text-[10px] font-bold text-[#10b981] tracking-wider uppercase">
            {fastfetchDataEn.badge || 'CHALMERS // D-24'}
          </div>
          <div id="fastfetch-tagline" class="text-[9px] text-[#8b949e]">
            {fastfetchDataEn.tagline || 'swimmer • sysdev'}
          </div>
        </div>

        <!-- Fastfetch Specs (Right column) -->
        <div class="flex-1 min-w-0 space-y-1 text-xs sm:text-sm">
          <!-- Fastfetch Header: user@host -->
          <div>
            <span id="fastfetch-user" class="text-[#10b981] font-bold">{fastfetchDataEn.user || 'gulo'}</span><span class="text-[#8b949e]">@</span><span id="fastfetch-host" class="text-[#38bdf8] font-bold">{fastfetchDataEn.host || 'chalmers-station'}</span>
            <div class="text-[#30363d] select-none tracking-tighter leading-none mt-0.5">
              ---------------------------------------------------
            </div>
          </div>

          <!-- Specs list -->
          <div class="space-y-1 pt-1 text-xs" id="fastfetch-specs-list">
            {fastfetchDataEn.specs.map((item: any) => {
              const colorClass = item.color === 'emerald' ? 'text-[#10b981]' : item.color === 'amber' ? 'text-[#f59e0b]' : 'text-[#38bdf8]';
              return (
                <div class="grid grid-cols-[100px_1fr] sm:grid-cols-[110px_1fr] gap-x-2 fastfetch-spec-row">
                  <span class={`${colorClass} font-semibold spec-key-label`}>{item.key}:</span>
                  {item.online ? (
                    <span class="text-[#10b981] font-medium flex items-center gap-1.5 spec-val-label">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-ping"></span>
                      {item.value}
                    </span>
                  ) : (
                    <span class="text-[#e6edf3] spec-val-label">{item.value}</span>
                  )}
                </div>
              );
            })}
          </div>

          <!-- Terminal 8-color test palette bar -->
          <div class="pt-2 flex items-center gap-1.5" title="Terminal 8-color test palette">
            <span class="w-4 h-2.5 rounded-xs bg-[#0d1117] border border-[#30363d]"></span>
            <span class="w-4 h-2.5 rounded-xs bg-[#f85149]"></span>
            <span class="w-4 h-2.5 rounded-xs bg-[#10b981]"></span>
            <span class="w-4 h-2.5 rounded-xs bg-[#f59e0b]"></span>
            <span class="w-4 h-2.5 rounded-xs bg-[#38bdf8]"></span>
            <span class="w-4 h-2.5 rounded-xs bg-[#a78bfa]"></span>
            <span class="w-4 h-2.5 rounded-xs bg-[#56d364]"></span>
            <span class="w-4 h-2.5 rounded-xs bg-[#e6edf3]"></span>
          </div>
        </div>
      </div>

      <!-- Terminal Ready Banner -->
      <div id="terminal-ready-banner" class="pt-3 text-[#8b949e] text-xs select-none">
        Terminal ready. Type <code class="text-[#10b981] font-bold">help</code> for command list (<code class="text-[#38bdf8]">school</code>, <code class="text-[#38bdf8]">swim</code>, <code class="text-[#38bdf8]">ls</code>, <code class="text-[#38bdf8]">cd</code>, <code class="text-[#38bdf8]">cat</code>, <code class="text-[#38bdf8]">open</code>). Press <code class="text-[#10b981]">Tab</code> to auto-complete.
      </div>

      <!-- Terminal Output History -->
      <div id="terminal-history" class="pt-2 space-y-2.5" aria-live="polite"></div>

      <!-- Active Interactive Prompt Row -->
      <form id="terminal-form" class="mt-3 flex items-center gap-2 pt-2 border-t border-[#30363d]/40">
        <label id="terminal-prompt-label" for="terminal-input" class="text-xs sm:text-sm text-[#10b981] font-semibold whitespace-nowrap select-none flex items-center gap-1">
          <span>visitor@playground</span><span class="text-[#8b949e]">:</span><span id="prompt-cwd" class="text-[#38bdf8]">~</span><span class="text-[#e6edf3]">$</span>
        </label>
        <input 
          id="terminal-input" 
          type="text" 
          autocomplete="off" 
          autocorrect="off" 
          autocapitalize="off" 
          spellcheck="false" 
          class="flex-1 bg-transparent border-none text-[#e6edf3] text-xs sm:text-sm focus:outline-none focus:ring-0 p-0 font-mono caret-[#10b981]"
          placeholder="type 'help', 'school', 'swim', 'cat whoami.md'..."
          data-i18n-placeholder="term_input_placeholder"
        />
        <button type="submit" class="sr-only">Run command</button>
      </form>
    </div>
  </div>

  <!-- Blixtsnabb synk-script för att eliminera split-sekund flimmer vid sidnavigering -->
  <script is:inline>
    (function() {
      try {
        var sec = document.getElementById('terminal-section');
        var win = document.getElementById('terminal-window');
        var card = document.getElementById('terminal-closed-card');
        if (!sec) return;

        // Om sidan laddades om (refresh / F5 / Ctrl+R) -> rensa sparad historik
        var navEntries = performance.getEntriesByType && performance.getEntriesByType('navigation');
        var isReload = (navEntries && navEntries[0] && navEntries[0].type === 'reload') || 
                       (window.performance && window.performance.navigation && window.performance.navigation.type === 1);
        if (isReload) {
          sessionStorage.removeItem('terminal_history_html');
          sessionStorage.removeItem('terminal_cmd_history');
          sessionStorage.removeItem('terminal_body_scroll');
          sessionStorage.removeItem('terminal_nav_scroll_y');
          sessionStorage.removeItem('navigated_via_cli');
        }

        var isSub = sec.getAttribute('data-is-subpage') === 'true';
        var isDesk = window.innerWidth >= 1024;
        var viaCli = sessionStorage.getItem('navigated_via_cli') === 'true';
        var closedByUser = sessionStorage.getItem('terminal_closed_by_user') === 'true';

        if (viaCli) {
          sec.classList.remove('hidden');
          if (win) win.classList.remove('hidden');
          if (card) card.classList.add('hidden');

          var hist = document.getElementById('terminal-history');
          var savedH = sessionStorage.getItem('terminal_history_html');
          if (hist && savedH) {
            hist.innerHTML = savedH;
          }

          var body = document.getElementById('terminal-body');
          if (body) {
            body.scrollTop = body.scrollHeight;
          }

          var savedY = sessionStorage.getItem('terminal_nav_scroll_y');
          if (savedY !== null) {
            window.scrollTo(0, Number(savedY));
          }
        } else if (!isSub && isDesk && !closedByUser) {
          sec.classList.remove('hidden');
          if (win) win.classList.remove('hidden');
          if (card) card.classList.add('hidden');
        } else if (!isSub && isDesk && closedByUser) {
          sec.classList.remove('hidden');
          if (win) win.classList.add('hidden');
          if (card) card.classList.remove('hidden');
        } else {
          sec.classList.add('hidden');
        }
      } catch (e) {}
    })();
  </script>
</section>

<script>
  function initTerminalEngine() {
    const termSection = document.getElementById('terminal-section');
    const termWindow = document.getElementById('terminal-window');
    const termBody = document.getElementById('terminal-body');
    const closedCard = document.getElementById('terminal-closed-card');
    const reopenBtn = document.getElementById('btn-reopen-terminal');
    const titleBar = document.getElementById('terminal-titlebar');
    const titleText = document.getElementById('window-title-text');
    const statusPill = document.getElementById('window-status-pill');
    const fullscreenHint = document.getElementById('fullscreen-hint');

    const btnClose = document.getElementById('btn-win-close');
    const btnMinimize = document.getElementById('btn-win-minimize');
    const btnMaximize = document.getElementById('btn-win-maximize');

    const form = document.getElementById('terminal-form') as HTMLFormElement | null;
    const input = document.getElementById('terminal-input') as HTMLInputElement | null;
    const history = document.getElementById('terminal-history') as HTMLDivElement | null;
    const promptCwd = document.getElementById('prompt-cwd');

    if (!termSection || !termWindow || !termBody || !form || !input || !history) return;

    const isSubpage = termSection.getAttribute('data-is-subpage') === 'true';

    let isMinimized = false;
    let isMaximized = false;

    function getSiteLang(): 'en' | 'sv' {
      if (typeof window === 'undefined') return 'en';
      return (localStorage.getItem('site_lang') as 'en' | 'sv') || 'en';
    }

    // ==========================================
    // 1. DYNAMIC VIRTUAL FILESYSTEM (EN / SV)
    // ==========================================
    type FileNode = {
      type: 'file';
      size: string;
      description: string;
      content: string;
      actionUrl?: string;
    };

    type DirNode = {
      type: 'dir';
      children: Record<string, FileNode | DirNode>;
    };

    function loadFileSystem(lang: 'en' | 'sv'): DirNode {
      const scriptEl = document.getElementById(`terminal-fs-${lang}`);
      if (scriptEl && scriptEl.textContent) {
        try {
          return JSON.parse(scriptEl.textContent);
        } catch (e) {}
      }
      return { type: 'dir', children: {} };
    }

    let activeLang: 'en' | 'sv' = getSiteLang();
    let fileSystem: DirNode = loadFileSystem(activeLang);

    // Fastfetch DOM updater when language toggles
    function updateFastfetchDOM(lang: 'en' | 'sv') {
      const scriptEl = document.getElementById(`terminal-fastfetch-${lang}`);
      if (!scriptEl || !scriptEl.textContent) return;
      try {
        const data = JSON.parse(scriptEl.textContent);
        const badgeEl = document.getElementById('fastfetch-badge');
        const taglineEl = document.getElementById('fastfetch-tagline');
        const userEl = document.getElementById('fastfetch-user');
        const hostEl = document.getElementById('fastfetch-host');
        const specsEl = document.getElementById('fastfetch-specs-list');

        if (badgeEl) badgeEl.textContent = data.badge || 'CHALMERS // D-24';
        if (taglineEl) taglineEl.textContent = data.tagline || (lang === 'sv' ? 'simmare • sysdev' : 'swimmer • sysdev');
        if (userEl) userEl.textContent = data.user || 'gulo';
        if (hostEl) hostEl.textContent = data.host || 'chalmers-station';

        if (specsEl && Array.isArray(data.specs)) {
          specsEl.innerHTML = data.specs.map((item: any) => {
            const colorClass = item.color === 'emerald' ? 'text-[#10b981]' : item.color === 'amber' ? 'text-[#f59e0b]' : 'text-[#38bdf8]';
            const onlineHtml = item.online
              ? `<span class="text-[#10b981] font-medium flex items-center gap-1.5 spec-val-label"><span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-ping"></span>${escapeHtml(item.value)}</span>`
              : `<span class="text-[#e6edf3] spec-val-label">${escapeHtml(item.value)}</span>`;

            return `
              <div class="grid grid-cols-[100px_1fr] sm:grid-cols-[110px_1fr] gap-x-2 fastfetch-spec-row">
                <span class="${colorClass} font-semibold spec-key-label">${escapeHtml(item.key)}:</span>
                ${onlineHtml}
              </div>
            `;
          }).join('');
        }
      } catch (e) {}
    }

    // Uppdatera fastfetch DOM och placeholder initialt om vi är i SV läge
    if (activeLang === 'sv') {
      updateFastfetchDOM('sv');
      if (input) {
        input.placeholder = "skriv 'help', 'school', 'swim', 'cat whoami.md'...";
      }
    }

    // Reagera på språkväxling direkt i terminalen!
    window.addEventListener('lang-change', (e: any) => {
      const newLang = (e.detail?.lang || getSiteLang()) as 'en' | 'sv';
      activeLang = newLang;
      fileSystem = loadFileSystem(newLang);
      updateFastfetchDOM(newLang);
      updateTitle();

      if (input) {
        input.placeholder = newLang === 'sv'
          ? "skriv 'help', 'school', 'swim', 'cat whoami.md'..."
          : "type 'help', 'school', 'swim', 'cat whoami.md'...";
      }

      const readyBanner = document.getElementById('terminal-ready-banner');
      if (readyBanner) {
        readyBanner.innerHTML = newLang === 'sv'
          ? `Terminal redo. Skriv <code class="text-[#10b981] font-bold">help</code> för kommandolista (<code class="text-[#38bdf8]">school</code>, <code class="text-[#38bdf8]">swim</code>, <code class="text-[#38bdf8]">ls</code>, <code class="text-[#38bdf8]">cd</code>, <code class="text-[#38bdf8]">cat</code>, <code class="text-[#38bdf8]">open</code>). Tryck <code class="text-[#10b981]">Tab</code> för att autokomplettera.`
          : `Terminal ready. Type <code class="text-[#10b981] font-bold">help</code> for command list (<code class="text-[#38bdf8]">school</code>, <code class="text-[#38bdf8]">swim</code>, <code class="text-[#38bdf8]">ls</code>, <code class="text-[#38bdf8]">cd</code>, <code class="text-[#38bdf8]">cat</code>, <code class="text-[#38bdf8]">open</code>). Press <code class="text-[#10b981]">Tab</code> to auto-complete.`;
      }
    });

    // Dölj fönstret internt
    function hideWindowInternal() {
      if (isMaximized) unmaximize(true);
      if (isMinimized) unminimize(true);
      if (isSubpage) {
        termSection.classList.add('hidden');
      } else {
        termSection.classList.remove('hidden');
        termWindow.classList.add('hidden');
        closedCard?.classList.remove('hidden');
      }
    }

    // Användarstängning via ✕-knappen eller 'exit' med animerad exit
    let isClosing = false;
    function userCloseWindow() {
      if (isClosing) return;
      isClosing = true;
      if (isMaximized) unmaximize(true);
      if (isMinimized) unminimize(true);
      sessionStorage.setItem('terminal_closed_by_user', 'true');
      sessionStorage.removeItem('navigated_via_cli');
      sessionStorage.removeItem('terminal_history_html');
      sessionStorage.removeItem('terminal_cmd_history');
      sessionStorage.removeItem('terminal_body_scroll');
      sessionStorage.removeItem('terminal_nav_scroll_y');

      termWindow.classList.remove('term-opening');
      termWindow.classList.add('term-closing');

      setTimeout(() => {
        termWindow.classList.remove('term-closing');
        if (isSubpage) {
          termSection.classList.add('hidden');
        } else {
          termSection.classList.remove('hidden');
          termWindow.classList.add('hidden');
          closedCard?.classList.remove('hidden');
        }
        isClosing = false;
      }, 160);
    }

    // Återställ och öppna fönstret med snärtig OS app-launch animation
    function restoreWindow(skipAnimation = false) {
      sessionStorage.removeItem('terminal_closed_by_user');
      termSection.classList.remove('hidden');
      termWindow.classList.remove('hidden', 'term-closing');
      closedCard?.classList.add('hidden');
      if (isMinimized) unminimize(true);
      updateTitle();

      if (!skipAnimation) {
        termWindow.classList.remove('term-opening');
        void termWindow.offsetWidth; // Force reflow för ren omstart av animation
        termWindow.classList.add('term-opening');
        setTimeout(() => {
          termWindow.classList.remove('term-opening');
        }, 240);
      }

      setTimeout(() => input.focus({ preventScroll: true }), 50);
    }

    // Växla synlighet (om öppen -> stäng; om stängd -> öppna)
    function toggleTerminalVisibility() {
      const isSectionHidden = termSection.classList.contains('hidden');
      const isWindowHidden = termWindow.classList.contains('hidden');
      const isClosed = isSubpage ? isSectionHidden : (isSectionHidden || isWindowHidden);

      if (isClosed || isClosing) {
        restoreWindow(false);
      } else {
        userCloseWindow();
      }
    }

    // Unmaximize helper
    function unmaximize(skipAnim = false) {
      isMaximized = false;
      document.body.classList.remove('overflow-hidden');
      termWindow.classList.remove('fixed', 'inset-3', 'z-50', 'ring-2', 'ring-[#10b981]', 'h-[calc(100vh-1.5rem)]');
      termWindow.classList.add('max-h-[min(880px,78vh)]', 'flex', 'flex-col');
      if (!skipAnim) {
        termWindow.classList.remove('term-maximizing');
        void termWindow.offsetWidth;
        termWindow.classList.add('term-maximizing');
        setTimeout(() => termWindow.classList.remove('term-maximizing'), 220);
      }
      fullscreenHint?.classList.add('hidden');
      updateTitle();
    }

    // Maximize helper
    function applyMaximize() {
      if (isMinimized) unminimize(true);
      isMaximized = true;
      document.body.classList.add('overflow-hidden');
      termWindow.classList.remove('max-h-[min(880px,78vh)]');
      termWindow.classList.add('fixed', 'inset-3', 'z-50', 'ring-2', 'ring-[#10b981]', 'h-[calc(100vh-1.5rem)]', 'flex', 'flex-col');
      termWindow.classList.remove('term-maximizing');
      void termWindow.offsetWidth;
      termWindow.classList.add('term-maximizing');
      fullscreenHint?.classList.remove('hidden');
      updateTitle();
      input.focus({ preventScroll: true });
      setTimeout(() => termWindow.classList.remove('term-maximizing'), 220);
    }

    function toggleMaximize() {
      if (isMaximized) {
        unmaximize();
      } else {
        applyMaximize();
      }
    }

    // Unminimize helper
    function unminimize(skipAnim = false) {
      isMinimized = false;
      termBody.classList.remove('is-minimized', 'hidden');
      statusPill?.classList.add('hidden');
      updateTitle();
      input.focus({ preventScroll: true });
    }

    // Minimize helper
    function applyMinimize() {
      if (isMaximized) unmaximize(true);
      isMinimized = true;
      termBody.classList.add('is-minimized');
      statusPill?.classList.remove('hidden');
      updateTitle();
    }

    function toggleMinimize() {
      if (isMinimized) {
        unminimize();
      } else {
        applyMinimize();
      }
    }

    btnClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      userCloseWindow();
    });

    btnMinimize?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMinimize();
    });

    btnMaximize?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMaximize();
    });

    // Klick på listen: enkeltryck = minimera/återställ, dubbeltryck = maximera
    let titleClickTimer: number | null = null;
    let lastTitleClickTime = 0;

    titleBar?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('#btn-win-close') || target.closest('#btn-win-minimize') || target.closest('#btn-win-maximize')) {
        return;
      }

      const now = Date.now();
      const timeDiff = now - lastTitleClickTime;
      lastTitleClickTime = now;

      // Om andra klicket kommer inom 280ms eller om e.detail >= 2 -> DUBBELKLICK!
      if (timeDiff < 280 || e.detail >= 2) {
        if (titleClickTimer !== null) {
          clearTimeout(titleClickTimer);
          titleClickTimer = null;
        }
        toggleMaximize();
      } else {
        // Enkelklick: vänta 260ms för att se om det blir ett dubbelklick innan minimering körs
        titleClickTimer = window.setTimeout(() => {
          titleClickTimer = null;
          toggleMinimize();
        }, 260);
      }
    });

    titleBar?.addEventListener('dblclick', (e) => {
      e.preventDefault();
      // Click-hanteraren ovan tar hand om dubbelklick för att undvika dubbla anrop
    });

    reopenBtn?.addEventListener('click', () => restoreWindow(false));

    // Lyssna på header-knappens växlings-event
    window.addEventListener('toggle-terminal', () => {
      toggleTerminalVisibility();
    });

    window.addEventListener('restore-terminal', () => {
      restoreWindow(false);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMaximized) {
        e.preventDefault();
        unmaximize();
      }
      if ((e.ctrlKey || e.metaKey) && e.key === '`') {
        e.preventDefault();
        toggleTerminalVisibility();
      }
    });

    // Klick på vanliga webblänkar rensar CLI-flaggan så terminalen är stängd by default på nästa sida
    document.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement)?.closest('a');
      if (anchor && anchor.href && anchor.origin === window.location.origin && !anchor.target) {
        sessionStorage.removeItem('navigated_via_cli');
        sessionStorage.removeItem('terminal_history_html');
        sessionStorage.removeItem('terminal_nav_scroll_y');
      }
    });

    // Startmapp synkad med aktuell sida
    const pathname = window.location.pathname.replace(/\/$/, '') || '/';
    let currentPath: string[] = [];
    if (pathname.startsWith('/projects')) {
      currentPath = ['projects'];
    } else if (pathname.startsWith('/thoughts')) {
      currentPath = ['thoughts'];
    } else if (pathname.startsWith('/files')) {
      currentPath = ['files'];
    } else {
      currentPath = [];
    }

    let cmdHistory: string[] = [];
    let historyIndex = -1;

    function getCwdLabel(): string {
      return currentPath.length === 0 ? '~' : `~/${currentPath.join('/')}`;
    }

    function updateTitle() {
      const lang = getSiteLang();
      const maxLabel = lang === 'sv' ? ' [MAXIMERAD FULLSKÄRM]' : ' [MAXIMIZED FULLSCREEN]';
      const minLabel = lang === 'sv' ? ' (klicka för att öppna)' : ' (click to open)';
      if (titleText && !isMinimized) {
        titleText.textContent = `bash — gulo@playground: ${getCwdLabel()}${isMaximized ? maxLabel : ''}`;
      } else if (titleText && isMinimized) {
        titleText.textContent = `bash — gulo@playground: ${getCwdLabel()}${minLabel}`;
      }
      if (promptCwd) {
        promptCwd.textContent = getCwdLabel();
      }
    }

    updateTitle();

    // Normalisera sökvägar för att förhindra falska dupliceringar
    function normalizePath(p: string): string {
      if (!p) return '/';
      let clean = p.split('?')[0].split('#')[0].trim();
      if (!clean.startsWith('/')) clean = '/' + clean;
      clean = clean.replace(/\/+$/, '') || '/';
      return clean;
    }

    // Helper för CLI navigation med historikbevarande och detektering av samma sida
    function navigateWithCli(url: string, messageHtml?: string): boolean {
      const isExternalOrFile = url.startsWith('http') || url.includes('/downloads/');
      const curPage = normalizePath(window.location.pathname);
      const targetPage = normalizePath(url);

      // Om användaren redan är på den sidan: skriv ut varning och avbryt!
      if (!isExternalOrFile && curPage === targetPage) {
        const lang = getSiteLang();
        const notice = lang === 'sv'
          ? `Du är redan på den här sidan (${targetPage})`
          : `Already on this page (${targetPage})`;
        if (history) {
          const resBox = document.createElement('div');
          resBox.className = 'text-xs pl-3 border-l border-[#f59e0b] my-1 font-mono text-[#f59e0b]';
          resBox.textContent = notice;
          history.appendChild(resBox);
        }
        if (termBody) {
          termBody.scrollTop = termBody.scrollHeight;
        }
        return false;
      }

      sessionStorage.setItem('navigated_via_cli', 'true');

      if (messageHtml && history) {
        const resBox = document.createElement('div');
        resBox.className = 'text-xs pl-3 border-l border-[#30363d] my-1 font-mono';
        resBox.innerHTML = messageHtml;
        history.appendChild(resBox);
      }

      if (history) {
        sessionStorage.setItem('terminal_history_html', history.innerHTML);
      }
      sessionStorage.setItem('terminal_cmd_history', JSON.stringify(cmdHistory));

      if (termBody) {
        termBody.scrollTop = termBody.scrollHeight;
        sessionStorage.setItem('terminal_body_scroll', 'bottom');
      }

      sessionStorage.setItem('terminal_nav_scroll_y', String(window.scrollY));

      window.location.href = url;
      return true;
    }

    // Render markdown cards (whoami.md, contact.md, school.md, swim.md)
    function renderMarkdownCard(rawMd: string): string {
      if (!rawMd) return '';
      const lines = rawMd.split('\n');
      let title = '';
      let items: { label: string; value: string }[] = [];
      let footer = '';
      let inFooter = false;

      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) continue;
        if (trimmed.startsWith('# ')) {
          title = trimmed.slice(2).trim();
        } else if (trimmed === '---') {
          inFooter = true;
        } else if (inFooter) {
          footer += (footer ? '<br/>' : '') + escapeHtml(trimmed);
        } else if (trimmed.startsWith('- ')) {
          const rest = trimmed.slice(2);
          const colonIdx = rest.indexOf(':');
          if (colonIdx !== -1) {
            const label = rest.slice(0, colonIdx).trim();
            const value = rest.slice(colonIdx + 1).trim();
            items.push({ label, value });
          } else {
            items.push({ label: '', value: rest });
          }
        }
      }

      function formatVal(v: string): string {
        return v.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, text, url) => {
          return `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" class="text-[#e6edf3] hover:underline hover:text-[#10b981]">${escapeHtml(text)}</a>`;
        });
      }

      let rows = items.map(it => {
        if (!it.label) return `<div>${formatVal(it.value)}</div>`;
        return `<div><span class="text-[#38bdf8] font-semibold">${escapeHtml(it.label)}:</span> <span class="text-[#e6edf3]">${formatVal(it.value)}</span></div>`;
      }).join('');

      return `
<div class="text-[#e6edf3] space-y-1.5 text-xs font-mono p-3 rounded bg-[#0d1117] border border-[#30363d]">
  ${title ? `<div class="text-[#10b981] font-bold border-b border-[#30363d] pb-1">${escapeHtml(title)}</div>` : ''}
  ${rows}
  ${footer ? `<div class="text-[#8b949e] text-[11px] pt-1.5 border-t border-[#30363d]/40">${footer}</div>` : ''}
</div>`;
    }

    // Visningsregler för dator vs mobil/tablet
    const isDesktop = window.innerWidth >= 1024;
    const navigatedViaCli = sessionStorage.getItem('navigated_via_cli') === 'true';
    const closedByUser = sessionStorage.getItem('terminal_closed_by_user') === 'true';

    if (navigatedViaCli) {
      const savedHtml = sessionStorage.getItem('terminal_history_html');
      if (savedHtml && history) {
        history.innerHTML = savedHtml;
      }

      const savedCmds = sessionStorage.getItem('terminal_cmd_history');
      if (savedCmds) {
        try {
          cmdHistory = JSON.parse(savedCmds);
          historyIndex = cmdHistory.length;
        } catch (e) {}
      }

      restoreWindow(true);

      const scrollToBottom = () => {
        if (termBody) {
          termBody.scrollTop = termBody.scrollHeight;
        }
      };
      scrollToBottom();
      requestAnimationFrame(scrollToBottom);
      setTimeout(scrollToBottom, 50);
      setTimeout(scrollToBottom, 150);
      setTimeout(scrollToBottom, 300);

      const savedWindowY = sessionStorage.getItem('terminal_nav_scroll_y');
      if (savedWindowY !== null) {
        window.scrollTo({ top: Number(savedWindowY), behavior: 'instant' });
      }
    } else if (!isSubpage && isDesktop && !closedByUser) {
      restoreWindow(true);
    } else if (!isSubpage) {
      // Startsidan på mobiler eller när terminalen stängts av användaren:
      // Terminalfönstret är dolt men "Vem är gulo?" är ALLTID synligt!
      termSection.classList.remove('hidden');
      termWindow.classList.add('hidden');
      closedCard?.classList.remove('hidden');
    } else {
      hideWindowInternal();
    }

    function resolvePath(basePath: string[], pathStr: string): string[] {
      if (!pathStr || pathStr === '.') return [...basePath];
      let segments: string[];
      if (pathStr.startsWith('/') || pathStr.startsWith('~')) {
        segments = [];
        pathStr = pathStr.replace(/^[~/]+/, '');
      } else {
        segments = [...basePath];
      }

      const parts = pathStr.split('/').filter(Boolean);
      for (const p of parts) {
        if (p === '.') {
          continue;
        } else if (p === '..') {
          if (segments.length > 0) {
            segments.pop();
          }
        } else {
          segments.push(p);
        }
      }
      return segments;
    }

    function resolveNode(pathArr: string[]): DirNode | FileNode | null {
      let current: DirNode | FileNode = fileSystem;
      for (const seg of pathArr) {
        if (current.type !== 'dir') return null;
        if (!current.children[seg]) return null;
        current = current.children[seg];
      }
      return current;
    }

    function getCurrentDir(): DirNode {
      return (resolveNode(currentPath) as DirNode) || fileSystem;
    }

    // Commands dictionary - fullständig flerspråkig terminalmotor
    const commands: Record<string, (args: string[]) => string | void> = {
      help: () => {
        const lang = getSiteLang();
        if (lang === 'sv') return `
<div class="text-[#e6edf3] space-y-2 font-mono">
  <div class="text-[#10b981] font-bold border-b border-[#30363d] pb-1">BASH KOMMANDOTOLK // TILLGÄNGLIGA KOMMANDON</div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-xs">
    <div>
      <div class="text-[#38bdf8] font-bold mb-1">Information &amp; Studier:</div>
      <div><span class="text-[#10b981] font-semibold">school / chalmers</span> : Skriver ut Chalmers-studier &amp; kurser</div>
      <div><span class="text-[#10b981] font-semibold">swim</span> : Skriver ut simningspass &amp; tider</div>
      <div><span class="text-[#10b981] font-semibold">whoami</span> : Personlig bakgrund &amp; profil</div>
      <div><span class="text-[#10b981] font-semibold">contact</span> : GitHub, mail &amp; Discord</div>
      <div><span class="text-[#10b981] font-semibold">fastfetch</span> : Systemöversikt &amp; status</div>
    </div>
    <div>
      <div class="text-[#f59e0b] font-bold mb-1">Navigering &amp; Webbsidor:</div>
      <div><span class="text-[#10b981] font-semibold">open &lt;mål&gt;</span> : Öppna projekt, artikel, fil eller sektion</div>
      <div><span class="text-[#10b981] font-semibold">projects</span> : Gå till /projects (Portfolio)</div>
      <div><span class="text-[#10b981] font-semibold">thoughts</span> : Gå till /thoughts (Blogg)</div>
      <div><span class="text-[#10b981] font-semibold">files</span> : Gå till /files (Filarkiv)</div>
    </div>
    <div>
      <div class="text-[#a78bfa] font-bold mb-1">Filsystem &amp; Bash:</div>
      <div><span class="text-[#10b981] font-semibold">ls [-la]</span> : Lista filer &amp; mappar</div>
      <div><span class="text-[#10b981] font-semibold">cd &lt;katalog&gt;</span> : Byt mapp (cd .., cd ~, cd ../projects)</div>
      <div><span class="text-[#10b981] font-semibold">pwd</span> : Visa nuvarande arbetskatalog</div>
      <div><span class="text-[#10b981] font-semibold">cat &lt;fil&gt;</span> : Skriv ut filens innehåll</div>
      <div><span class="text-[#10b981] font-semibold">grep &lt;ord&gt; [fil]</span> : Sök text i filer</div>
    </div>
    <div>
      <div class="text-[#8b949e] font-bold mb-1">Fönster &amp; Verktyg:</div>
