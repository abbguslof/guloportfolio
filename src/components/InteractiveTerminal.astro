---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  isSubpage?: boolean;
}

const { isSubpage = false } = Astro.props;

// 1. Läs statiska terminalfiler och easter eggs (.gitignore, .bashrc, .secret, about.txt, chalmers.txt, swim.txt)
const terminalDir = path.join(process.cwd(), 'src/data/terminal');
const staticFiles: Record<string, { size: string; description: string; content: string }> = {};

if (fs.existsSync(terminalDir)) {
  const fileEntries = fs.readdirSync(terminalDir);
  for (const f of fileEntries) {
    const fullPath = path.join(terminalDir, f);
    const stat = fs.statSync(fullPath);
    const content = fs.readFileSync(fullPath, 'utf-8');
    const sizeStr = stat.size < 1024 ? `${stat.size} B` : `${(stat.size / 1024).toFixed(1)} KB`;
    staticFiles[f] = {
      size: sizeStr,
      description: f,
      content,
    };
  }
}

// 2. Läs dynamiska projekt (konfigurerbar sammanfattning så att cat visar relevant info utan att dumpa hela filen)
const rawProjects = await getCollection('projects');
const projectNodes: Record<string, any> = {};
for (const p of rawProjects) {
  const preview = `# ${p.data.title}\nStatus: [${p.data.status}] | Kategori: ${p.data.category}\nTech: ${(p.data.tech || []).join(', ')}\n\n${p.data.description}\n\nLäs hela projektet på webben: open ${p.id}`;
  projectNodes[`${p.id}.md`] = {
    type: 'file',
    size: '1.4 KB',
    description: p.data.description,
    content: preview,
    actionUrl: `/projects/${p.id}`,
  };
}

// 3. Läs dynamiska tankar & blogginlägg
const rawThoughts = await getCollection('thoughts');
const thoughtNodes: Record<string, any> = {};
for (const t of rawThoughts) {
  const dateStr = t.data.pubDate ? new Date(t.data.pubDate).toISOString().split('T')[0] : '2026';
  const catLabel = (t.data.category || 'tanke').toUpperCase();
  const preview = `[${catLabel}] ${t.data.title}\nDatum: ${dateStr} | Kategori: ${t.data.category || 'tanke'} | Taggar: ${(t.data.tags || []).join(', ')}\n\n"${t.data.description}"\n\nLäs hela artikeln: open ${t.id}`;
  thoughtNodes[`${t.id}.md`] = {
    type: 'file',
    size: '1.8 KB',
    description: t.data.description,
    content: preview,
    actionUrl: `/thoughts/${t.id}`,
  };
}

// 4. Läs dynamiska nedladdningsbara filer
const rawDownloads = await getCollection('downloads');
const downloadNodes: Record<string, any> = {};
for (const d of rawDownloads) {
  const preview = `${d.data.name} (${d.data.filename})\nStorlek: ${d.data.size} | Kategori: ${d.data.category}\n${d.data.description}\n\nSnabbkommando: ${d.data.usage || 'curl -O ' + d.data.fileUrl}\nLadda ner direkt: open ${d.data.filename}`;
  downloadNodes[d.data.filename] = {
    type: 'file',
    size: d.data.size,
    description: d.data.description,
    content: preview,
    actionUrl: d.data.fileUrl,
  };
}

// Slutlig virtuell filsystemstruktur
const dynamicFileSystem = {
  type: 'dir',
  children: {
    projects: {
      type: 'dir',
      children: projectNodes,
    },
    thoughts: {
      type: 'dir',
      children: thoughtNodes,
    },
    files: {
      type: 'dir',
      children: downloadNodes,
    },
    ...Object.fromEntries(
      Object.entries(staticFiles).map(([fname, data]) => [
        fname,
        {
          type: 'file',
          size: data.size,
          description: data.description,
          content: data.content,
        }
      ])
    )
  }
};
---

