  import { getSiteLang } from '../scripts/terminal/i18n';
  import { isSiteOnline, setSiteOnline } from '../data/telemetry';
  import type { CommandContext, DirNode, FileNode, LangCode } from '../scripts/terminal/types';

  function initTerminalEngine() {
    const rawSection = document.getElementById('terminal-section');
    const rawWindow = document.getElementById('terminal-window');
    const rawBody = document.getElementById('terminal-body');
    const rawForm = document.getElementById('terminal-form');
    const rawInput = document.getElementById('terminal-input');
    const rawHistory = document.getElementById('terminal-history');

    if (!rawSection || !rawWindow || !rawBody || !rawForm || !rawInput || !rawHistory) return;

    const termSection = rawSection as HTMLElement;
    const termWindow = rawWindow as HTMLElement;
    const termBody = rawBody as HTMLElement;
    const form = rawForm as HTMLFormElement;
    const input = rawInput as HTMLInputElement;
    const history = rawHistory as HTMLDivElement;

    const closedCard = document.getElementById('terminal-closed-card');
    const reopenBtn = document.getElementById('btn-reopen-terminal');
    const titleBar = document.getElementById('terminal-titlebar');
    const titleText = document.getElementById('window-title-text');
    const statusPill = document.getElementById('window-status-pill');
    const fullscreenHint = document.getElementById('fullscreen-hint');
    const minimizedCatHint = document.getElementById('terminal-minimized-cat-hint');
    const btnClose = document.getElementById('btn-win-close');
    const btnMinimize = document.getElementById('btn-win-minimize');
    const btnMaximize = document.getElementById('btn-win-maximize');
    const promptCwd = document.getElementById('prompt-cwd');

    const isSubpage = termSection.getAttribute('data-is-subpage') === 'true';
    const is404 = termSection.getAttribute('data-is-404') === 'true';
    const viaCli = sessionStorage.getItem('navigated_via_cli') === 'true';

    let isMinimized = false;
    let isMaximized = false;
    let catHintTimer: number | null = null;
    const navEntries = performance.getEntriesByType && performance.getEntriesByType('navigation');
    const isReload = (navEntries && navEntries[0] && (navEntries[0] as PerformanceNavigationTiming).type === 'reload') || 
                     (window.performance && window.performance.navigation && window.performance.navigation.type === 1);
    if (isReload) {
      sessionStorage.removeItem('terminal_cat_hint_dismissed');
    }
    let catHintDismissed = sessionStorage.getItem('terminal_cat_hint_dismissed') === 'true';

    // ==========================================
    // 0. AUTHENTIC LINUX BOOT INTRO (ONCE PER VISIT, DESKTOP ONLY)
    // ==========================================
    // ==========================================
    // 0. AUTHENTIC LINUX BOOT INTRO (ONCE PER VISIT, DESKTOP ONLY)
    // ==========================================
    const BOOT_CONFIG = {
      storageKey: 'gulo_boot_intro_played',
      timings: {
        // Stage 1: Kernel cascade starts at 64ms and finishes at ~440ms + 140ms pause = 580ms (~8% faster)
        kernelHandoff: 580,
        // Handoff transition animation duration (ms)
        handoffAnimMs: 110,
        // Stage 2: Time centered Gustav splash stays on screen (ms) (2025ms, ~8% faster)
        splashDuration: 2025,
        // Stage 3: Snappy fade out into interactive shell (ms)
        exitFadeMs: 140,
      },
      i18n: {
        en: {
          prefix: "hi, i'm",
          sub: 'Computer Science & Engineering • Chalmers',
          baseText: 'launching terminal',
        },
        sv: {
          prefix: 'hej, jag är',
          sub: 'Civilingenjör Datateknik • Chalmers',
          baseText: 'startar terminalen',
        },
      },
    };

    let bootScreen = document.getElementById('terminal-boot-screen');
    let bootTimers: any[] = [];
    let bootKeyHandler: ((e: KeyboardEvent) => void) | null = null;
    let bootStartTimeout: any = null;
    let bootTypewriterTimer: any = null;
    let bootDotsTimer: any = null;

    function stopBootTypewriter() {
      if (bootStartTimeout) {
        clearTimeout(bootStartTimeout);
        bootStartTimeout = null;
      }
      if (bootTypewriterTimer) {
        clearInterval(bootTypewriterTimer);
        bootTypewriterTimer = null;
      }
      if (bootDotsTimer) {
        clearInterval(bootDotsTimer);
        bootDotsTimer = null;
      }
    }

    function startBootTypewriter(lang: 'en' | 'sv') {
      stopBootTypewriter();
      const statusEl = (bootScreen?.querySelector('#boot-status-text') as HTMLElement | null) || document.getElementById('boot-status-text');
      if (!statusEl) return;

      const conf = BOOT_CONFIG.i18n[lang] || BOOT_CONFIG.i18n.en;
      const baseText = conf.baseText;
      statusEl.textContent = '';
      let charIndex = 0;

      // Slight initial delay (~160ms) so user can take in the card before typing starts
      const initialDelayMs = 160;
      const charIntervalMs = 48; // Calibrated typing speed (smooth, readable, not rushed)
      const dotIntervalMs = 175; // Steady dot pace (~4-5 dots total before boot)

      bootStartTimeout = setTimeout(() => {
        bootTypewriterTimer = setInterval(() => {
          charIndex++;
          statusEl.textContent = baseText.slice(0, charIndex);
          if (charIndex >= baseText.length) {
            clearInterval(bootTypewriterTimer);
            bootTypewriterTimer = null;

            // Once base text is typed out, steadily append dots until terminal boots
            let dotCount = 0;
            bootDotsTimer = setInterval(() => {
              dotCount++;
              statusEl.textContent = baseText + '.'.repeat(dotCount);
            }, dotIntervalMs);
            bootTimers.push(bootDotsTimer);
          }
        }, charIntervalMs);
        bootTimers.push(bootTypewriterTimer);
      }, initialDelayMs);
      bootTimers.push(bootStartTimeout);
    }

    function clearBootTimers() {
      stopBootTypewriter();
      bootTimers.forEach(t => clearTimeout(t));
      bootTimers = [];
    }

    function dismissBootIntro(immediate = false) {
      clearBootTimers();
      if (bootKeyHandler) {
        window.removeEventListener('keydown', bootKeyHandler, { capture: true } as any);
        bootKeyHandler = null;
      }

      if (termBody) {
        termBody.style.visibility = 'visible';
        termBody.style.transition = immediate ? 'none' : `opacity ${BOOT_CONFIG.timings.exitFadeMs}ms ease-out`;
        termBody.style.opacity = '1';
      }
      if (!bootScreen) return;
      if (immediate) {
        bootScreen.style.display = 'none';
        bootScreen.style.opacity = '0';
        bootScreen.style.pointerEvents = 'none';
        // Delay input focus slightly (15ms) to ensure the key event has completely finished
        // so that the dismissal keystroke is never entered into the terminal prompt.
        setTimeout(() => {
          if (input) {
            input.value = '';
            input.focus({ preventScroll: true });
          }
        }, 15);
        return;
      }
      bootScreen.style.transition = `opacity ${BOOT_CONFIG.timings.exitFadeMs}ms ease-out`;
      bootScreen.style.opacity = '0';
      bootScreen.style.pointerEvents = 'none';
      const t = setTimeout(() => {
        if (bootScreen) bootScreen.style.display = 'none';
        if (input) {
          input.value = '';
          input.focus({ preventScroll: true });
        }
      }, BOOT_CONFIG.timings.exitFadeMs + 10);
      bootTimers.push(t);
    }

    function playBootIntro(force = false) {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isPhone = window.innerWidth < 640;

      if (isPhone || prefersReducedMotion) {
        sessionStorage.setItem(BOOT_CONFIG.storageKey, 'true');
        if (bootScreen) bootScreen.style.display = 'none';
        if (termBody) {
          termBody.style.visibility = 'visible';
          termBody.style.opacity = '1';
        }
        return;
      }

      const hasBootPlayed = sessionStorage.getItem(BOOT_CONFIG.storageKey) === 'true';
      if (!force && (hasBootPlayed || isSubpage || is404 || viaCli)) {
        sessionStorage.setItem(BOOT_CONFIG.storageKey, 'true');
        if (bootScreen) bootScreen.style.display = 'none';
        if (termBody) {
          termBody.style.visibility = 'visible';
          termBody.style.opacity = '1';
        }
        return;
      }

      sessionStorage.setItem(BOOT_CONFIG.storageKey, 'true');
      clearBootTimers();
      if (bootKeyHandler) {
        window.removeEventListener('keydown', bootKeyHandler, { capture: true } as any);
        bootKeyHandler = null;
      }

      // Ensure input is blurred and empty during boot intro
      if (input) {
        input.blur();
        input.value = '';
      }

      // Ensure window and section are open and visible (especially when rebooting on subpages like /thoughts)
      termSection.classList.remove('hidden');
      termWindow.classList.remove('hidden', 'term-closing');
      closedCard?.classList.add('hidden');
      if (isMinimized) unminimize(true);

      if (termBody) {
        termBody.style.visibility = 'hidden';
        termBody.style.opacity = '0';
        termBody.style.transition = 'none';
      }

      if (bootScreen) {
        // Clone node to cleanly restart all CSS keyframe animations from frame 0
        const cloned = bootScreen.cloneNode(true) as HTMLElement;
        bootScreen.parentNode?.replaceChild(cloned, bootScreen);
        bootScreen = cloned;

        // Reset stage states inside cloned node
        const stageKernel = bootScreen.querySelector('#boot-stage-kernel') as HTMLElement | null;
        const stageLogo = bootScreen.querySelector('#boot-stage-logo') as HTMLElement | null;
        if (stageKernel) {
          stageKernel.style.display = 'flex';
          stageKernel.classList.remove('boot-console-exit');
        }
        if (stageLogo) {
          stageLogo.style.display = 'none';
          stageLogo.classList.remove('boot-stage-logo-animate');
          const statusEl = stageLogo.querySelector('#boot-status-text');
          if (statusEl) statusEl.textContent = '';
        }

        updateBootLogoLang(getSiteLang());

        bootScreen.style.display = 'flex';
        bootScreen.style.opacity = '1';
        bootScreen.style.pointerEvents = 'auto';
        bootScreen.style.transition = 'none';

        // Stage 1 (Kernel) -> Mini Pause -> Console Exit Animation -> Stage 2 (Centered Splash)
        const t1 = setTimeout(() => {
          if (!stageKernel) return;
          stageKernel.classList.add('boot-console-exit');

          const t2 = setTimeout(() => {
            stageKernel.style.display = 'none';
            if (stageLogo) {
              stageLogo.style.display = 'flex';
              stageLogo.classList.add('boot-stage-logo-animate');
              startBootTypewriter(getSiteLang());
            }
          }, BOOT_CONFIG.timings.handoffAnimMs);
          bootTimers.push(t2);
        }, BOOT_CONFIG.timings.kernelHandoff);
        bootTimers.push(t1);

        // Stage 2 stays on screen for splashDuration (2025ms)
        const totalDuration = BOOT_CONFIG.timings.kernelHandoff + BOOT_CONFIG.timings.handoffAnimMs + BOOT_CONFIG.timings.splashDuration;
        const tDismiss = setTimeout(() => dismissBootIntro(false), totalDuration);
        bootTimers.push(tDismiss);

        // Immediate skip on any user input (click anywhere or any keypress)
        const tSkip = setTimeout(() => {
          if (!bootScreen || !document.body.contains(bootScreen)) return;

          bootScreen.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            dismissBootIntro(true);
          }, { once: true });

          bootKeyHandler = (e: KeyboardEvent) => {
            if (['Shift', 'Control', 'Alt', 'Meta'].includes(e.key)) return;
            // Prevent keystroke from reaching the terminal input or performing default browser actions
            e.preventDefault();
            e.stopPropagation();
            if (e.stopImmediatePropagation) e.stopImmediatePropagation();
            if (input) input.value = '';
            dismissBootIntro(true);
          };
          window.addEventListener('keydown', bootKeyHandler, { capture: true, once: true });
        }, 10);
        bootTimers.push(tSkip);
      }
    }

    // Run initial check
    playBootIntro(false);

    // Replay intro when user runs 'reset' / 'reboot' command on any page
    window.addEventListener('terminal-reboot', () => {
      playBootIntro(true);
    });

    // ==========================================
    // 1. DYNAMIC VIRTUAL FILESYSTEM (EN / SV)
    // ==========================================
    type FileNode = {
      type: 'file';
      size: string;
      description: string;
      content: string;
      actionUrl?: string;
    };

    type DirNode = {
      type: 'dir';
      children: Record<string, FileNode | DirNode>;
    };

    function loadFileSystem(lang: 'en' | 'sv'): DirNode {
      const scriptEl = document.getElementById(`terminal-fs-${lang}`);
      if (scriptEl && scriptEl.textContent) {
        try {
          return JSON.parse(scriptEl.textContent);
        } catch (e) {}
      }
      return { type: 'dir', children: {} };
    }

    let activeLang: 'en' | 'sv' = getSiteLang();
    let fileSystem: DirNode = loadFileSystem(activeLang);

    // Fastfetch DOM updater when language toggles or online state changes
    function updateFastfetchDOM(lang: 'en' | 'sv', isOnlineParam?: boolean) {
      const scriptEl = document.getElementById(`terminal-fastfetch-${lang}`);
      if (!scriptEl || !scriptEl.textContent) return;
      try {
        const data = JSON.parse(scriptEl.textContent);
        const badgeEl = document.getElementById('fastfetch-badge');
        const taglineEl = document.getElementById('fastfetch-tagline');
        const userEl = document.getElementById('fastfetch-user');
        const hostEl = document.getElementById('fastfetch-host');
        const specsEl = document.getElementById('fastfetch-specs-list');

        if (badgeEl) badgeEl.textContent = data.badge || 'CHALMERS // D-24';
        if (taglineEl) taglineEl.textContent = data.tagline || (lang === 'sv' ? 'simmare • sysdev' : 'swimmer • sysdev');
        if (userEl) userEl.textContent = data.user || 'gulo';
        if (hostEl) hostEl.textContent = data.host || 'chalmers-station';

        const isOnline = typeof isOnlineParam === 'boolean' 
          ? isOnlineParam 
          : isSiteOnline();

        if (specsEl && Array.isArray(data.specs)) {
          specsEl.innerHTML = data.specs.map((item: any) => {
            let itemKey = item.key;
            let itemVal = item.value;
            let itemColor = item.color;
            let isOnlineItem = item.online;

            const isStatusRow = (itemKey || '').toLowerCase() === 'status';

            if (isStatusRow) {
              if (!isOnline) {
                itemVal = lang === 'sv' ? '[OFFLINE] Ej ansluten till nätverk' : '[OFFLINE] Disconnected from network';
                isOnlineItem = false;
              } else {
                itemVal = (itemVal || '').replace(/\[●\s*/g, '[');
                isOnlineItem = true;
              }
            }

            let keyStyle = '';
            let valStyle = '';

            if (isStatusRow && !isOnline) {
              keyStyle = 'color: #f85149 !important;';
              valStyle = 'color: #f85149 !important;';
            } else if (itemColor === 'emerald') {
              keyStyle = 'color: #10b981;';
            } else if (itemColor === 'amber') {
              keyStyle = 'color: #f59e0b;';
            } else {
              keyStyle = 'color: #38bdf8;';
            }

            const onlineHtml = isOnlineItem
              ? `<span class="text-[#10b981] font-medium flex items-center gap-1.5 spec-val-label"><span class="w-1.5 h-1.5 rounded-full bg-[#10b981] animate-ping"></span>${escapeHtml(itemVal)}</span>`
              : (isStatusRow
                ? `<span class="font-medium flex items-center gap-1.5 spec-val-label" style="${valStyle}"><span class="w-1.5 h-1.5 rounded-full bg-[#f85149]" style="background-color: #f85149 !important;"></span>${escapeHtml(itemVal)}</span>`
                : `<span class="text-[#e6edf3] spec-val-label">${escapeHtml(itemVal)}</span>`);

            return `
              <div class="grid grid-cols-[100px_1fr] sm:grid-cols-[110px_1fr] gap-x-2 fastfetch-spec-row">
                <span class="font-semibold spec-key-label" style="${keyStyle}">${escapeHtml(itemKey)}:</span>
                ${onlineHtml}
              </div>
            `;
          }).join('');
        }
      } catch (e) {}
    }

    const closedCardDot = document.getElementById('closed-card-dot');
    function updateClosedCardDot(isOnline: boolean) {
      if (!closedCardDot) return;
      if (isOnline) {
        closedCardDot.className = 'w-2.5 h-2.5 rounded-full bg-[#10b981] animate-pulse is-online-bg';
        closedCardDot.style.setProperty('background-color', '#10b981', 'important');
        closedCardDot.style.setProperty('animation', '');
      } else {
        closedCardDot.className = 'w-2.5 h-2.5 rounded-full bg-[#f85149] is-offline-bg';
        closedCardDot.style.setProperty('background-color', '#f85149', 'important');
        closedCardDot.style.setProperty('animation', 'none', 'important');
      }
    }

    function updateBootLogoLang(lang: 'en' | 'sv') {
      const conf = BOOT_CONFIG.i18n[lang] || BOOT_CONFIG.i18n.en;
      const prefixEl = (bootScreen?.querySelector('#boot-prefix-text') as HTMLElement | null) || document.getElementById('boot-prefix-text');
      const subEl = (bootScreen?.querySelector('#boot-sub-text') as HTMLElement | null) || document.getElementById('boot-sub-text') || document.getElementById('boot-edu-text');
      if (prefixEl) prefixEl.textContent = conf.prefix;
      if (subEl) subEl.textContent = conf.sub;

      const stageLogo = bootScreen?.querySelector('#boot-stage-logo') as HTMLElement | null;
      if (stageLogo && stageLogo.style.display !== 'none') {
        startBootTypewriter(lang);
      }
    }

    // Uppdatera fastfetch DOM, closed card dot och placeholder initialt oavsett språk
    const initialIsOnline = isSiteOnline();
    updateFastfetchDOM(activeLang, initialIsOnline);
    updateClosedCardDot(initialIsOnline);
    updateBootLogoLang(activeLang);
    if (input) {
      input.placeholder = activeLang === 'sv'
        ? "skriv 'help', 'school', 'swim', 'cat whoami.md'..."
        : "type 'help', 'school', 'swim', 'cat whoami.md'...";
    }

    // Reagera på anslutningsstatusändring i terminalen omedelbart
    window.addEventListener('connection-state-change', ((e: CustomEvent) => {
      const isOnline = typeof e.detail?.isOnline === 'boolean' ? e.detail.isOnline : isSiteOnline();
      updateFastfetchDOM(activeLang, isOnline);
      updateClosedCardDot(isOnline);
    }) as EventListener);

    window.addEventListener('offline', () => {
      updateFastfetchDOM(activeLang, false);
      updateClosedCardDot(false);
    });

    window.addEventListener('online', () => {
      updateFastfetchDOM(activeLang, true);
      updateClosedCardDot(true);
    });

    // Reagera på språkväxling direkt i terminalen!
    window.addEventListener('lang-change', (e: any) => {
      const newLang = (e.detail?.lang || getSiteLang()) as 'en' | 'sv';
      activeLang = newLang;
      fileSystem = loadFileSystem(newLang);
      updateFastfetchDOM(newLang);
      updateBootLogoLang(newLang);
      updateTitle();

      if (input) {
        input.placeholder = newLang === 'sv'
          ? "skriv 'help', 'school', 'swim', 'cat whoami.md'..."
          : "type 'help', 'school', 'swim', 'cat whoami.md'...";
      }

      const readyBanner = document.getElementById('terminal-ready-banner');
      if (readyBanner) {
        readyBanner.innerHTML = newLang === 'sv'
          ? `Terminal redo. Skriv <code class="text-[#10b981] font-bold">help</code> för kommandolista (<code class="text-[#38bdf8]">school</code>, <code class="text-[#38bdf8]">swim</code>, <code class="text-[#38bdf8]">ls</code>, <code class="text-[#38bdf8]">cd</code>, <code class="text-[#38bdf8]">cat</code>, <code class="text-[#38bdf8]">open</code>). Tryck <code class="text-[#10b981]">Tab</code> för att autokomplettera.`
          : `Terminal ready. Type <code class="text-[#10b981] font-bold">help</code> for command list (<code class="text-[#38bdf8]">school</code>, <code class="text-[#38bdf8]">swim</code>, <code class="text-[#38bdf8]">ls</code>, <code class="text-[#38bdf8]">cd</code>, <code class="text-[#38bdf8]">cat</code>, <code class="text-[#38bdf8]">open</code>). Press <code class="text-[#10b981]">Tab</code> to auto-complete.`;
      }
    });

    // Dölj fönstret internt
    function hideWindowInternal() {
      if (isMaximized) unmaximize(true);
      if (isMinimized) unminimize(true);
      if (isSubpage) {
        termSection.classList.add('hidden');
      } else {
        termSection.classList.remove('hidden');
        termWindow.classList.add('hidden');
        closedCard?.classList.remove('hidden');
      }
    }

    // Användarstängning via ✕-knappen eller 'exit' med animerad exit
    let isClosing = false;
    function userCloseWindow() {
      if (isClosing) return;
      dismissBootIntro(true);
      isClosing = true;

      // Klick på kryss räknas som att kattnotisen inte ska behöva komma tillbaka under sessionen
      catHintDismissed = true;
      sessionStorage.setItem('terminal_cat_hint_dismissed', 'true');
      if (catHintTimer !== null) {
        clearTimeout(catHintTimer);
        catHintTimer = null;
      }
      minimizedCatHint?.classList.remove('cat-enter', 'cat-exit');
      minimizedCatHint?.classList.add('hidden');

      if (isMaximized) unmaximize(true);
      if (isMinimized) unminimize(true);
      sessionStorage.setItem('terminal_closed_by_user', 'true');
      sessionStorage.removeItem('terminal_opened_on_mobile');
      sessionStorage.removeItem('navigated_via_cli');
      sessionStorage.removeItem('terminal_history_html');
      sessionStorage.removeItem('terminal_cmd_history');
      sessionStorage.removeItem('terminal_body_scroll');
      sessionStorage.removeItem('terminal_nav_scroll_y');

      termWindow.classList.remove('term-opening');
      termWindow.classList.add('term-closing');

      if (isSubpage) {
        termSection.style.overflow = 'hidden';
        termSection.style.maxHeight = termSection.scrollHeight + 'px';
        termSection.style.transition = 'max-height 0.22s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.16s ease-out, margin-bottom 0.22s cubic-bezier(0.16, 1, 0.3, 1)';
        void termSection.offsetWidth;
        termSection.style.maxHeight = '0px';
        termSection.style.opacity = '0';
        termSection.style.marginBottom = '0px';

        setTimeout(() => {
          termWindow.classList.remove('term-closing');
          termSection.classList.add('hidden');
          termSection.style.maxHeight = '';
          termSection.style.opacity = '';
          termSection.style.marginBottom = '';
          termSection.style.overflow = '';
          termSection.style.transition = '';
          isClosing = false;
        }, 220);
      } else {
        setTimeout(() => {
          termWindow.classList.remove('term-closing');
          termSection.classList.remove('hidden');
          termWindow.classList.add('hidden');
          if (catHintTimer !== null) {
            clearTimeout(catHintTimer);
            catHintTimer = null;
          }
          minimizedCatHint?.classList.remove('cat-enter', 'cat-exit');
          minimizedCatHint?.classList.add('hidden');
          closedCard?.classList.remove('hidden');
          updateClosedCardDot(isSiteOnline());
          isClosing = false;
        }, 160);
      }
    }

    // Återställ och öppna fönstret med snärtig OS app-launch animation
    function restoreWindow(skipAnimation = false) {
      if (window.innerWidth < 640) {
        sessionStorage.setItem('terminal_opened_on_mobile', 'true');
      }
      sessionStorage.removeItem('terminal_closed_by_user');
      termSection.classList.remove('hidden');
      termWindow.classList.remove('hidden', 'term-closing');
      closedCard?.classList.add('hidden');
      if (catHintTimer !== null) {
        clearTimeout(catHintTimer);
        catHintTimer = null;
      }
      minimizedCatHint?.classList.remove('cat-enter', 'cat-exit');
      minimizedCatHint?.classList.add('hidden');
      if (isMinimized) unminimize(true);
      updateTitle();

      if (!skipAnimation) {
        if (isSubpage) {
          termSection.style.overflow = 'hidden';
          termSection.style.maxHeight = '0px';
          termSection.style.opacity = '0';
          termSection.style.transition = 'max-height 0.24s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.18s ease-in, margin-bottom 0.24s ease';
          void termSection.offsetWidth;
          const targetH = Math.min(880, window.innerHeight * 0.78);
          termSection.style.maxHeight = targetH + 'px';
          termSection.style.opacity = '1';
          setTimeout(() => {
            termSection.style.maxHeight = '';
            termSection.style.opacity = '';
            termSection.style.overflow = '';
            termSection.style.transition = '';
          }, 250);
        }

        termWindow.classList.remove('term-opening');
        void termWindow.offsetWidth; // Force reflow för ren omstart av animation
        termWindow.classList.add('term-opening');
        setTimeout(() => {
          termWindow.classList.remove('term-opening');
        }, 240);
      }

      setTimeout(() => input.focus({ preventScroll: true }), 50);
    }

    // Växla synlighet (om öppen -> stäng; om stängd -> öppna)
    function toggleTerminalVisibility() {
      const isSectionHidden = termSection.classList.contains('hidden');
      const isWindowHidden = termWindow.classList.contains('hidden');
      const isClosed = isSubpage ? isSectionHidden : (isSectionHidden || isWindowHidden);

      if (isClosed || isClosing) {
        restoreWindow(false);
      } else {
        userCloseWindow();
      }
    }

    // Unmaximize helper
    function unmaximize(skipAnim = false) {
      isMaximized = false;
      document.body.classList.remove('overflow-hidden');
      termWindow.classList.remove('fixed', 'inset-1.5', 'sm:inset-3', 'z-50', 'ring-2', 'ring-[#10b981]', 'h-[calc(100dvh-0.75rem)]', 'sm:h-[calc(100dvh-1.5rem)]');
      termWindow.classList.add('max-h-[min(880px,78dvh)]', 'flex', 'flex-col');
      if (!skipAnim) {
        termWindow.classList.remove('term-maximizing');
        void termWindow.offsetWidth;
        termWindow.classList.add('term-maximizing');
        setTimeout(() => termWindow.classList.remove('term-maximizing'), 220);
      }
      fullscreenHint?.classList.add('hidden');
      updateTitle();
    }

    // Maximize helper
    function applyMaximize() {
      if (isMinimized) unminimize(true);
      isMaximized = true;
      document.body.classList.add('overflow-hidden');
      termWindow.classList.remove('max-h-[min(880px,78dvh)]');
      termWindow.classList.add('fixed', 'inset-1.5', 'sm:inset-3', 'z-50', 'ring-2', 'ring-[#10b981]', 'h-[calc(100dvh-0.75rem)]', 'sm:h-[calc(100dvh-1.5rem)]', 'flex', 'flex-col');
      termWindow.classList.remove('term-maximizing');
      void termWindow.offsetWidth;
      termWindow.classList.add('term-maximizing');
      fullscreenHint?.classList.remove('hidden');
      updateTitle();
      input.focus({ preventScroll: true });
      setTimeout(() => termWindow.classList.remove('term-maximizing'), 220);
    }

    function toggleMaximize() {
      if (isMaximized) {
        unmaximize();
      } else {
        applyMaximize();
      }
    }

    // Unminimize helper
    function unminimize(skipAnim = false) {
      isMinimized = false;
      if (catHintTimer !== null) {
        clearTimeout(catHintTimer);
        catHintTimer = null;
      }
      minimizedCatHint?.classList.remove('cat-enter', 'cat-exit');
      minimizedCatHint?.classList.add('hidden');
      termBody.classList.remove('is-minimized', 'hidden');
      statusPill?.classList.add('hidden');
      closedCard?.classList.add('hidden');
      updateTitle();
      input.focus({ preventScroll: true });
    }

    // Minimize helper: delayed appearance (3s) if not previously dismissed
    function applyMinimize() {
      dismissBootIntro(true);
      if (isMaximized) unmaximize(true);
      isMinimized = true;
      termBody.classList.add('is-minimized');
      statusPill?.classList.remove('hidden');
      if (!isSubpage && !catHintDismissed) {
        closedCard?.classList.add('hidden');
        if (catHintTimer !== null) clearTimeout(catHintTimer);
        catHintTimer = window.setTimeout(() => {
          catHintTimer = null;
          if (isMinimized && !catHintDismissed) {
            minimizedCatHint?.classList.remove('hidden', 'cat-exit');
            minimizedCatHint?.classList.add('cat-enter');
          }
        }, 3000);
      }
      updateTitle();
    }

    function toggleMinimize() {
      if (isMinimized) {
        unminimize();
      } else {
        applyMinimize();
      }
    }

    minimizedCatHint?.addEventListener('click', (e) => {
      e.stopPropagation();
      catHintDismissed = true;
      sessionStorage.setItem('terminal_cat_hint_dismissed', 'true');
      if (catHintTimer !== null) {
        clearTimeout(catHintTimer);
        catHintTimer = null;
      }
      minimizedCatHint.classList.remove('cat-enter');
      minimizedCatHint.classList.add('cat-exit');
      setTimeout(() => {
        minimizedCatHint.classList.add('hidden');
        minimizedCatHint.classList.remove('cat-exit');
      }, 220);
    });

    btnClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      userCloseWindow();
    });

    btnMinimize?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMinimize();
    });

    btnMaximize?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMaximize();
    });

    // Klick på listen: enkeltryck = minimera/återställ, dubbeltryck = maximera
    let titleClickTimer: number | null = null;
    let lastTitleClickTime = 0;

    titleBar?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('#btn-win-close') || target.closest('#btn-win-minimize') || target.closest('#btn-win-maximize')) {
        return;
      }

      const now = Date.now();
      const timeDiff = now - lastTitleClickTime;
      lastTitleClickTime = now;

      // Om andra klicket kommer inom 280ms eller om e.detail >= 2 -> DUBBELKLICK!
      if (timeDiff < 280 || e.detail >= 2) {
        if (titleClickTimer !== null) {
          clearTimeout(titleClickTimer);
          titleClickTimer = null;
        }
        toggleMaximize();
      } else {
        // Enkelklick: vänta 260ms för att se om det blir ett dubbelklick innan minimering körs
        titleClickTimer = window.setTimeout(() => {
          titleClickTimer = null;
          toggleMinimize();
        }, 260);
      }
    });

    titleBar?.addEventListener('dblclick', (e) => {
      e.preventDefault();
      // Click-hanteraren ovan tar hand om dubbelklick för att undvika dubbla anrop
    });

    reopenBtn?.addEventListener('click', () => restoreWindow(false));

    // Lyssna på header-knappens växlings-event
    window.addEventListener('toggle-terminal', () => {
      toggleTerminalVisibility();
    });

    window.addEventListener('restore-terminal', () => {
      restoreWindow(false);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMaximized) {
        e.preventDefault();
        unmaximize();
      }
      if ((e.ctrlKey || e.metaKey) && e.key === '`') {
        e.preventDefault();
        toggleTerminalVisibility();
      }
    });

    // Klick på vanliga webblänkar rensar CLI-flaggan så terminalen är stängd by default på nästa sida
    document.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement)?.closest('a');
      if (anchor && anchor.href && anchor.origin === window.location.origin && !anchor.target) {
        sessionStorage.removeItem('navigated_via_cli');
        sessionStorage.removeItem('terminal_history_html');
        sessionStorage.removeItem('terminal_nav_scroll_y');
        sessionStorage.removeItem('terminal_opened_on_mobile');
      }
    });

    // Startmapp synkad med aktuell sida
    const pathname = window.location.pathname.replace(/\/$/, '') || '/';
    let currentPath: string[] = [];
    if (pathname.startsWith('/projects')) {
      currentPath = ['projects'];
    } else if (pathname.startsWith('/thoughts')) {
      currentPath = ['thoughts'];
    } else if (pathname.startsWith('/files')) {
      currentPath = ['files'];
    } else {
      currentPath = [];
    }

    let cmdHistory: string[] = [];
    let historyIndex = -1;

    function getCwdLabel(): string {
      return currentPath.length === 0 ? '~' : `~/${currentPath.join('/')}`;
    }

    function updateTitle() {
      const lang = getSiteLang();
      const maxLabel = lang === 'sv' ? ' [MAXIMERAD FULLSKÄRM]' : ' [MAXIMIZED FULLSCREEN]';
      const minLabel = lang === 'sv' ? ' (klicka för att öppna)' : ' (click to open)';
      if (is404) {
        if (titleText && !isMinimized) {
          titleText.textContent = `bash — 404: route_not_found${isMaximized ? maxLabel : ''}`;
        } else if (titleText && isMinimized) {
          titleText.textContent = `bash — 404: route_not_found${minLabel}`;
        }
      } else {
        if (titleText && !isMinimized) {
          titleText.textContent = `bash — gulo@playground: ${getCwdLabel()}${isMaximized ? maxLabel : ''}`;
        } else if (titleText && isMinimized) {
          titleText.textContent = `bash — gulo@playground: ${getCwdLabel()}${minLabel}`;
        }
      }
      if (promptCwd) {
        promptCwd.textContent = getCwdLabel();
      }
      if (statusPill) {
        statusPill.textContent = lang === 'sv'
          ? 'MINIMERAD (klicka för att expandera)'
          : 'MINIMIZED (click to expand)';
      }
    }

    updateTitle();

    // In 404 mode, seed the terminal history with the diagnostic block if empty
    if (is404 && (!history.hasChildNodes() || history.children.length === 0)) {
      const isSv = getSiteLang() === 'sv';
      const requestedPath = window.location.pathname;
      const errorCard = document.createElement('div');
      errorCard.className = 'space-y-3 pt-2';
      errorCard.innerHTML = `
        <div class="text-[#10b981] flex items-center gap-2">
          <span>visitor@playground</span><span class="text-[#8b949e]">:</span><span class="text-[#38bdf8]">~</span><span class="text-[#e6edf3]">$</span>
          <span class="text-[#e6edf3]">open ${escapeHtml(requestedPath)}</span>
        </div>
        <div class="p-4 rounded bg-[#0d1117] border border-[#f85149]/60 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[#f85149] font-bold text-xs">HTTP 404 // COMMAND_NOT_FOUND</span>
            <span class="text-[10px] text-[#f59e0b] px-1.5 py-0.5 rounded border border-[#f59e0b]/40">ERR_NOT_FOUND</span>
          </div>
          <div class="text-[#e6edf3]">
            <span class="text-[#f85149]">open:</span> ${isSv ? 'Kunde inte hitta eller öppna mål: ' : 'Cannot locate or open target: '}<code class="text-[#f85149] font-bold">${escapeHtml(requestedPath)}</code>
          </div>
          <p class="text-[#8b949e] text-xs leading-relaxed">
            ${isSv ? 'Sökvägen existerar inte på denna station. Den kan ha flyttats, döpts om eller aldrig kompilerats.' : 'The requested path does not exist on this station. It might have been moved, renamed, or never compiled.'}
          </p>
          <div class="pt-2 border-t border-[#30363d]/50 space-y-1.5">
            <div class="text-[10px] text-[#8b949e] uppercase tracking-wider font-semibold">
              ${isSv ? 'FÖRESLAGNA DISCOVERY-VEKTORER (KLICKA ELLER SKRIV):' : 'SUGGESTED DISCOVERY VECTORS (CLICK OR TYPE):'}
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
              <a href="/" class="p-2.5 rounded bg-[#161b22] border border-[#30363d] hover:border-[#10b981] text-[#10b981] transition-all flex items-center justify-between">
                <span>${isSv ? '[← Tillbaka till Cockpit]' : '[← Back to Cockpit]'}</span>
                <span class="text-[#8b949e]">~</span>
              </a>
              <a href="/projects" class="p-2.5 rounded bg-[#161b22] border border-[#30363d] hover:border-[#a78bfa] text-[#a78bfa] transition-all flex items-center justify-between">
                <span>${isSv ? '[Utforska projekt →]' : '[Explore Projects →]'}</span>
                <span class="text-[#8b949e]">~/projects</span>
              </a>
              <a href="/thoughts" class="p-2.5 rounded bg-[#161b22] border border-[#30363d] hover:border-[#f59e0b] text-[#f59e0b] transition-all flex items-center justify-between">
                <span>${isSv ? '[Läs blogg &amp; tankar →]' : '[Read Blog &amp; Notes →]'}</span>
                <span class="text-[#8b949e]">~/thoughts</span>
              </a>
              <a href="/files" class="p-2.5 rounded bg-[#161b22] border border-[#30363d] hover:border-[#38bdf8] text-[#38bdf8] transition-all flex items-center justify-between">
                <span>${isSv ? '[Ladda ned arkiv →]' : '[Download Archives →]'}</span>
                <span class="text-[#8b949e]">~/files</span>
              </a>
            </div>
          </div>
        </div>
      `;
      history.appendChild(errorCard);
      setTimeout(() => input.focus({ preventScroll: true }), 60);
    }

    // Normalisera sökvägar för att förhindra falska dupliceringar
    function normalizePath(p: string): string {
      if (!p) return '/';
      let clean = p.split('?')[0].split('#')[0].trim();
      if (!clean.startsWith('/')) clean = '/' + clean;
      clean = clean.replace(/\/+$/, '') || '/';
      return clean;
    }

    // Helper för CLI navigation med historikbevarande och detektering av samma sida
    function navigateWithCli(url: string, messageHtml?: string): boolean {
      const isExternalOrFile = url.startsWith('http') || url.includes('/downloads/');
      const curPage = normalizePath(window.location.pathname);
      const targetPage = normalizePath(url);

      // Om användaren redan är på den sidan: skriv ut varning och avbryt!
      if (!isExternalOrFile && curPage === targetPage) {
        const lang = getSiteLang();
        const notice = lang === 'sv'
          ? `Du är redan på den här sidan (${targetPage})`
          : `Already on this page (${targetPage})`;
        if (history) {
          const resBox = document.createElement('div');
          resBox.className = 'text-xs pl-3 border-l border-[#f59e0b] my-1 font-mono text-[#f59e0b]';
          resBox.textContent = notice;
          history.appendChild(resBox);
        }
        if (termBody) {
          termBody.scrollTop = termBody.scrollHeight;
        }
        return false;
      }

      sessionStorage.setItem('navigated_via_cli', 'true');

      if (messageHtml && history) {
        const resBox = document.createElement('div');
        resBox.className = 'text-xs pl-3 border-l border-[#30363d] my-1 font-mono';
        resBox.innerHTML = messageHtml;
        history.appendChild(resBox);
      }

      if (history) {
        sessionStorage.setItem('terminal_history_html', history.innerHTML);
      }
      sessionStorage.setItem('terminal_cmd_history', JSON.stringify(cmdHistory));

      if (termBody) {
        termBody.scrollTop = termBody.scrollHeight;
        sessionStorage.setItem('terminal_body_scroll', 'bottom');
      }

      sessionStorage.setItem('terminal_nav_scroll_y', String(window.scrollY));

      window.location.href = url;
      return true;
    }

    // Render markdown cards (whoami.md, contact.md, school.md, swim.md)
    function renderMarkdownCard(rawMd: string): string {
      if (!rawMd) return '';
      const lines = rawMd.split('\n');
      let title = '';
      let items: { label: string; value: string }[] = [];
      let footer = '';
      let inFooter = false;

      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) continue;
        if (trimmed.startsWith('# ')) {
          title = trimmed.slice(2).trim();
        } else if (trimmed === '---') {
          inFooter = true;
        } else if (inFooter) {
          footer += (footer ? '<br/>' : '') + escapeHtml(trimmed);
        } else if (trimmed.startsWith('- ')) {
          const rest = trimmed.slice(2);
          const colonIdx = rest.indexOf(':');
          if (colonIdx !== -1) {
            const label = rest.slice(0, colonIdx).trim();
            const value = rest.slice(colonIdx + 1).trim();
            items.push({ label, value });
          } else {
            items.push({ label: '', value: rest });
          }
        }
      }

      function formatVal(v: string): string {
        return v.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, text, url) => {
          return `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" class="text-[#e6edf3] hover:underline hover:text-[#10b981]">${escapeHtml(text)}</a>`;
        });
      }

      let rows = items.map(it => {
        if (!it.label) return `<div>${formatVal(it.value)}</div>`;
        return `<div><span class="text-[#38bdf8] font-semibold">${escapeHtml(it.label)}:</span> <span class="text-[#e6edf3]">${formatVal(it.value)}</span></div>`;
      }).join('');

      return `
<div class="text-[#e6edf3] space-y-1.5 text-xs font-mono p-3 rounded bg-[#0d1117] border border-[#30363d]">
  ${title ? `<div class="text-[#10b981] font-bold border-b border-[#30363d] pb-1">${escapeHtml(title)}</div>` : ''}
  ${rows}
  ${footer ? `<div class="text-[#8b949e] text-[11px] pt-1.5 border-t border-[#30363d]/40">${footer}</div>` : ''}
</div>`;
    }

    // Visningsregler för dator vs mobil/tablet
    const isDesktop = window.innerWidth >= 1024;
    const navigatedViaCli = sessionStorage.getItem('navigated_via_cli') === 'true';
    const closedByUser = sessionStorage.getItem('terminal_closed_by_user') === 'true';

    if (navigatedViaCli) {
      const savedHtml = sessionStorage.getItem('terminal_history_html');
      if (savedHtml && history) {
        history.innerHTML = savedHtml;
      }

      const savedCmds = sessionStorage.getItem('terminal_cmd_history');
      if (savedCmds) {
        try {
          cmdHistory = JSON.parse(savedCmds);
          historyIndex = cmdHistory.length;
        } catch (e) {}
      }

      restoreWindow(true);

      const scrollToBottom = () => {
        if (termBody) {
          termBody.scrollTop = termBody.scrollHeight;
        }
      };
      scrollToBottom();
      requestAnimationFrame(scrollToBottom);
      setTimeout(scrollToBottom, 50);
      setTimeout(scrollToBottom, 150);
      setTimeout(scrollToBottom, 300);

      const savedWindowY = sessionStorage.getItem('terminal_nav_scroll_y');
      if (savedWindowY !== null) {
        window.scrollTo({ top: Number(savedWindowY), behavior: 'instant' });
      }
    } else if (is404) {
      if (closedByUser) {
        termSection.classList.remove('hidden');
        termWindow.classList.add('hidden');
        closedCard?.classList.remove('hidden');
      } else {
        restoreWindow(true);
      }
    } else if (!isSubpage && isDesktop && !closedByUser) {
      restoreWindow(true);
    } else if (!isSubpage) {
      // Startsidan på mobiler eller när terminalen stängts av användaren:
      // Terminalfönstret är dolt men "Vem är gulo?" är ALLTID synligt!
      termSection.classList.remove('hidden');
      termWindow.classList.add('hidden');
      minimizedCatHint?.classList.add('hidden');
      closedCard?.classList.remove('hidden');
    } else {
      minimizedCatHint?.classList.add('hidden');
      hideWindowInternal();
    }

    function resolvePath(basePath: string[], pathStr: string): string[] {
      if (!pathStr || pathStr === '.') return [...basePath];
      let segments: string[];
      if (pathStr.startsWith('/') || pathStr.startsWith('~')) {
        segments = [];
        pathStr = pathStr.replace(/^[~/]+/, '');
      } else {
        segments = [...basePath];
      }

      const parts = pathStr.split('/').filter(Boolean);
      for (const p of parts) {
        if (p === '.') {
          continue;
        } else if (p === '..') {
          if (segments.length > 0) {
            segments.pop();
          }
        } else {
          segments.push(p);
        }
      }
      return segments;
    }

    function resolveNode(pathArr: string[]): DirNode | FileNode | null {
      let current: DirNode | FileNode = fileSystem;
      for (const seg of pathArr) {
        if (current.type !== 'dir') return null;
        if (!current.children[seg]) return null;
        current = current.children[seg];
      }
      return current;
    }

    function getCurrentDir(): DirNode {
      return (resolveNode(currentPath) as DirNode) || fileSystem;
    }

    const commandRegistry = getCommands();

    function execute(rawCmd: string) {
      const cleanCmd = rawCmd.trim();
      if (!cleanCmd) return;

      cmdHistory.push(cleanCmd);
      historyIndex = cmdHistory.length;
      try {
        sessionStorage.setItem('terminal_cmd_history', JSON.stringify(cmdHistory));
        (window as any).__terminal_cmd_history = cmdHistory;
      } catch (e) {}

      // Render prompt execution line
      const cmdRow = document.createElement('div');
      cmdRow.className = 'flex items-center gap-2 text-xs sm:text-sm font-semibold text-[#8b949e] pt-1 font-mono';
      cmdRow.innerHTML = `
        <span class="text-[#10b981]">visitor@playground</span><span class="text-[#8b949e]">:</span><span class="text-[#38bdf8]">${escapeHtml(getCwdLabel())}</span><span class="text-[#e6edf3]">$</span>
        <span class="text-[#e6edf3]">${escapeHtml(cleanCmd)}</span>
      `;
      history.appendChild(cmdRow);

      const parts = cleanCmd.split(' ').filter(Boolean);
      const main = parts[0].toLowerCase();
      const args = parts.slice(1);

      const ctx: CommandContext = {
        currentPath,
        fileSystem,
        lang: getSiteLang(),
        navigateWithCli,
        resolvePath,
        resolveNode,
        getCurrentDir,
        getCwdLabel,
        setCurrentPath: (newP: string[]) => {
          currentPath = newP;
          updateTitle();
        },
        renderMarkdownCard,
        escapeHtml,
        clearHistory: () => {
          history.innerHTML = '';
          cmdHistory = [];
          historyIndex = -1;
          sessionStorage.removeItem('terminal_history_html');
          sessionStorage.removeItem('terminal_cmd_history');
          sessionStorage.removeItem('terminal_nav_scroll_y');
        },
        exitTerminal: () => {
          userCloseWindow();
        }
      };

      if (commandRegistry[main]) {
        const res = commandRegistry[main](args, ctx);
        if (res) {
          const resBox = document.createElement('div');
          resBox.className = 'text-xs pl-3 border-l border-[#30363d] my-1 font-mono';
          resBox.innerHTML = res;
          history.appendChild(resBox);
        }
      } else if (cleanCmd === './helloworld.sh' || cleanCmd === 'helloworld.sh' || cleanCmd === './helloworld') {
        const res = commandRegistry['./helloworld.sh'](args, ctx);
        if (res) {
          const resBox = document.createElement('div');
          resBox.className = 'text-xs pl-3 border-l border-[#30363d] my-1 font-mono';
          resBox.innerHTML = res;
          history.appendChild(resBox);
        }
      } else {
        const errBox = document.createElement('div');
        errBox.className = 'text-xs text-[#f85149] pl-3 border-l border-[#f85149]/40 my-1 font-mono';
        const _errLang = getSiteLang();
        errBox.innerHTML = _errLang === 'sv'
          ? `Kommando hittades inte: '${escapeHtml(cleanCmd)}'. Skriv <span class="text-[#10b981] font-bold">help</span> för hjälplista (eller <span class="text-[#10b981]">help -e</span>).`
          : `Command not found: '${escapeHtml(cleanCmd)}'. Type <span class="text-[#10b981] font-bold">help</span> for available commands (or <span class="text-[#10b981]">help -e</span>).`;
        history.appendChild(errBox);
      }

      input.value = '';
      input.focus({ preventScroll: true });
      if (termBody) {
        termBody.scrollTop = termBody.scrollHeight;
        requestAnimationFrame(() => {
          if (termBody) termBody.scrollTop = termBody.scrollHeight;
        });
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      execute(input.value);
    });

    // Klick på Neovim :q [Exit] knapp stänger den virtuella editorn
    history.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const quitBtn = target?.closest('.nvim-quit-btn') as HTMLElement | null;
      if (quitBtn) {
        const sessionId = quitBtn.getAttribute('data-session');
        const container = sessionId ? document.getElementById(sessionId) : quitBtn.closest('.nvim-container');
        if (container) {
          container.remove();
          const exitMsg = document.createElement('div');
          exitMsg.className = 'text-xs text-[#10b981] pl-3 border-l border-[#10b981]/40 my-1 font-mono';
          const isSv = getSiteLang() === 'sv';
          exitMsg.innerHTML = isSv 
            ? `[nvim] Avslutade editorn. (Du lyckades ta dig ur vim! 🏆)`
            : `[nvim] Exited editor. (You successfully escaped vim! 🏆)`;
          history.appendChild(exitMsg);
          if (termBody) termBody.scrollTop = termBody.scrollHeight;
          if (input) input.focus();
        }
      }
    });

    // Clicking terminal empty space focuses the prompt input
    termBody.addEventListener('click', (e) => {
      const sel = window.getSelection();
      if (sel && sel.toString().length > 0) return;
      if ((e.target as HTMLElement).closest('a, button, input, textarea, select')) return;
      input.focus({ preventScroll: true });
    });

    // ==========================================
    // 3. ROBUST TAB COMPLETION, CTRL+C & SHORTCUTS
    // ==========================================
    input.addEventListener('keydown', (e) => {
      // Escape av-markerar terminalen (blur) så man kan tabba vidare till resten av sidan
      if (e.key === 'Escape') {
        (window as any).__lastBlurredElement = input;
        input.blur();
        return;
      }

      // Ctrl+C för att avbryta kommando
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'c') {
        const sel = window.getSelection()?.toString();
        if (sel && sel.length > 0) return;

        e.preventDefault();
        const currentCmd = input.value;
        const cancelRow = document.createElement('div');
        cancelRow.className = 'flex items-center gap-2 text-xs sm:text-sm font-semibold text-[#8b949e] pt-1 font-mono';
        cancelRow.innerHTML = `
          <span class="text-[#10b981]">visitor@playground</span><span class="text-[#8b949e]">:</span><span class="text-[#38bdf8]">${escapeHtml(getCwdLabel())}</span><span class="text-[#e6edf3]">$</span>
          <span class="text-[#e6edf3]">${escapeHtml(currentCmd)}</span><span class="text-[#f85149] font-bold ml-1">^C</span>
        `;
        history.appendChild(cancelRow);
        input.value = '';
        historyIndex = cmdHistory.length;
        if (termBody) {
          termBody.scrollTop = termBody.scrollHeight;
          requestAnimationFrame(() => {
            if (termBody) termBody.scrollTop = termBody.scrollHeight;
          });
        }
        return;
      }

      // Ctrl+L för att rensa
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'l') {
        e.preventDefault();
        history.innerHTML = '';
        sessionStorage.removeItem('terminal_history_html');
        sessionStorage.removeItem('terminal_nav_scroll_y');
        input.value = '';
        return;
      }

      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (cmdHistory.length > 0 && historyIndex > 0) {
          historyIndex--;
          input.value = cmdHistory[historyIndex];
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex < cmdHistory.length - 1) {
          historyIndex++;
          input.value = cmdHistory[historyIndex];
        } else {
          historyIndex = cmdHistory.length;
          input.value = '';
        }
      } else if (e.key === 'Tab') {
        e.preventDefault();
        e.stopPropagation();

        const currentVal = input.value;
        const tokens = currentVal.split(' ');
        const lastToken = tokens[tokens.length - 1] || '';

        // Tab på första ordet -> komplettera kommando
        if (tokens.length <= 1) {
          const cmdList = [
            'help', 'status', 'schedule', 'tentor', 'school', 'study', 'education', 'chalmers', 'swim', 'whoami', 'gustav', 'contact', 'discord', 'kontakt',
            'home', 'hem', 'main', 'cockpit', 'root',
            'bio', 'about', 'tldr', 'info', 'profil', 'profile',
            'cv', 'resume', 'recruit', 'stats', 'btop', 'htop',
            'proxmox', 'mc', 'minecraft', 'sleep', 'sova',
            'lang', 'language', 'sprak', 'språk', 'se', 'sv', 'swe', 'swedish', 'svenska', 'en', 'eng', 'english', 'engelska',
            'ls', 'cd', 'cat', 'nvim', 'vim', 'vi', 'pwd', 'grep', 'open', 
            'projects', 'project', 'thoughts', 'thought', 'blog', 'note', 'notes', 'guide', 'guides', 'files', 'clear', 
            'date', 'uptime', 'fastfetch', 'neofetch', 'fetch', 'uname', 'hostname', 'history',
            'git', 'calc', 'guess', './helloworld.sh', 'helloworld.sh', 'hello', 'tjena', 'hej', 'hejsan', 'halloj',
            'bg', 'exit', 'wget', 'dl', 'download',
            'reset', 'reboot', 'restart', 'factory-reset', 'defaults'
          ];
          const matches = cmdList.filter(c => c.startsWith(lastToken.toLowerCase()));

          if (matches.length === 1) {
            input.value = matches[0] + ' ';
          } else if (matches.length > 1) {
            const lastChild = history.lastElementChild;
            if (lastChild && lastChild.classList.contains('tab-hint-row')) {
              return;
            }
            const hint = document.createElement('div');
            hint.className = 'tab-hint-row text-xs text-[#38bdf8] pl-3 my-1 font-mono';
            hint.textContent = matches.join('   ');
            history.appendChild(hint);
          }
          return;
        }

        // Tab på argument -> komplettera sökvägar / filer / bakgrundsstilar / git / guess / wget / bio / lang
        const mainCmd = tokens[0].toLowerCase();
        let availableItems: string[] = [];

        if ((mainCmd === 'lang' || mainCmd === 'language' || mainCmd === 'sprak' || mainCmd === 'språk') && tokens.length === 2) {
          availableItems = ['en', 'se', 'sv', 'eng', 'swe', 'english', 'swedish', 'engelska', 'svenska'];
          const matches = availableItems.filter(item => item.toLowerCase().startsWith(lastToken.toLowerCase()));
          if (matches.length === 1) {
            tokens[tokens.length - 1] = matches[0];
            input.value = tokens.join(' ');
          }
          return;
        }

        if (mainCmd === 'bio' && tokens.length === 2) {
          availableItems = ['cv', 'resume', 'stats', 'btop'];
          const matches = availableItems.filter(item => item.toLowerCase().startsWith(lastToken.toLowerCase()));
          if (matches.length === 1) {
            tokens[tokens.length - 1] = matches[0];
            input.value = tokens.join(' ');
          }
          return;
        }

        if ((mainCmd === 'wget' || mainCmd === 'dl' || mainCmd === 'download') && tokens.length === 2) {
          const filesDir = fileSystem.children['files'];
          const thoughtsDir = fileSystem.children['thoughts'];
          const projectsDir = fileSystem.children['projects'];
          const currentDir = getCurrentDir();

          availableItems = [];

          if (filesDir && filesDir.type === 'dir') {
            availableItems.push(...Object.keys(filesDir.children));
          }
          if (thoughtsDir && thoughtsDir.type === 'dir') {
            availableItems.push(...Object.keys(thoughtsDir.children).filter(f => f.endsWith('.pdf')));
          }
          if (projectsDir && projectsDir.type === 'dir') {
            availableItems.push(...Object.keys(projectsDir.children).filter(f => f.endsWith('.pdf')));
          }
          if (currentDir && currentDir.type === 'dir') {
            availableItems.push(...Object.keys(currentDir.children).filter(f => 
              f.endsWith('.pdf') || f.endsWith('.zip') || f.endsWith('.sh') || f.endsWith('.gz') || f.endsWith('.tar.gz')
            ));
          }
          availableItems = Array.from(new Set(availableItems));
          const matches = availableItems.filter(item => item.toLowerCase().startsWith(lastToken.toLowerCase()));
          if (matches.length === 1) {
            tokens[tokens.length - 1] = matches[0];
            input.value = tokens.join(' ');
          } else if (matches.length > 1) {
            const lastChild = history.lastElementChild;
            if (lastChild && lastChild.classList.contains('tab-hint-row')) {
              return;
            }
            const hint = document.createElement('div');
            hint.className = 'tab-hint-row text-xs text-[#38bdf8] pl-3 my-1 font-mono';
            hint.textContent = matches.join('   ');
            history.appendChild(hint);
            if (termBody) {
              termBody.scrollTop = termBody.scrollHeight;
            }
          }
          return;
        }

        if (mainCmd === 'git' && tokens.length === 2) {
          availableItems = ['status', 'log', 'branch', 'diff', 'commit', 'push', 'pull', 'remote', 'clone', 'add', 'checkout'];
          const matches = availableItems.filter(item => item.toLowerCase().startsWith(lastToken.toLowerCase()));
          if (matches.length === 1) {
            tokens[tokens.length - 1] = matches[0];
            input.value = tokens.join(' ');
          } else if (matches.length > 1) {
            const lastChild = history.lastElementChild;
            if (lastChild && lastChild.classList.contains('tab-hint-row')) {
              return;
            }
            const hint = document.createElement('div');
            hint.className = 'tab-hint-row text-xs text-[#38bdf8] pl-3 my-1 font-mono';
            hint.textContent = matches.join('   ');
            history.appendChild(hint);
            if (termBody) {
              termBody.scrollTop = termBody.scrollHeight;
            }
          }
          return;
        }

        if (mainCmd === 'guess' && tokens.length === 2) {
          availableItems = ['reset', 'quit', '50'];
          const matches = availableItems.filter(item => item.toLowerCase().startsWith(lastToken.toLowerCase()));
          if (matches.length === 1) {
            tokens[tokens.length - 1] = matches[0];
            input.value = tokens.join(' ');
          }
          return;
        }

        if (mainCmd === 'help' && tokens.length === 2) {
          availableItems = ['--extended', '-e', '--all', '-a'];
          const matches = availableItems.filter(item => item.toLowerCase().startsWith(lastToken.toLowerCase()));
          if (matches.length === 1) {
            tokens[tokens.length - 1] = matches[0];
            input.value = tokens.join(' ');
          }
          return;
        }

        if ((mainCmd === 'bg' || mainCmd === 'background') && tokens.length === 2) {
          availableItems = ['standard', 'topo', 'dither', 'ascii', 'dots', 'pixel', 'shimmer', 'off', 'next', 'help', 'toggle'];
          const matches = availableItems.filter(item => item.toLowerCase().startsWith(lastToken.toLowerCase()));
          if (matches.length === 1) {
            tokens[tokens.length - 1] = matches[0];
            input.value = tokens.join(' ');
          } else if (matches.length > 1) {
            const lastChild = history.lastElementChild;
            if (lastChild && lastChild.classList.contains('tab-hint-row')) {
              return;
            }
            const hint = document.createElement('div');
            hint.className = 'tab-hint-row text-xs text-[#38bdf8] pl-3 my-1 font-mono';
            hint.textContent = matches.join('   ');
            history.appendChild(hint);
            if (termBody) {
              termBody.scrollTop = termBody.scrollHeight;
            }
          }
          return;
        }

        if (mainCmd === 'ls' && lastToken.startsWith('-')) {
          availableItems = ['-a', '-l', '-la', '-al'];
          const matches = availableItems.filter(item => item.toLowerCase().startsWith(lastToken.toLowerCase()));
          if (matches.length === 1) {
            tokens[tokens.length - 1] = matches[0];
            input.value = tokens.join(' ');
          }
          return;
        }

        const lastSlashIdx = lastToken.lastIndexOf('/');
        let dirPrefix = '';
        let basePrefix = lastToken;

        if (lastSlashIdx !== -1) {
          dirPrefix = lastToken.slice(0, lastSlashIdx + 1);
          basePrefix = lastToken.slice(lastSlashIdx + 1);
        }

        const targetDirSegments = dirPrefix ? resolvePath(currentPath, dirPrefix) : currentPath;
        const targetDirNode = resolveNode(targetDirSegments);

        if (targetDirNode && targetDirNode.type === 'dir') {
          for (const [name, node] of Object.entries(targetDirNode.children)) {
            if (name.startsWith('.') && !basePrefix.startsWith('.')) continue;

            if (mainCmd === 'cd') {
              if (node.type === 'dir') {
                availableItems.push(`${name}/`);
              }
            } else {
              availableItems.push(node.type === 'dir' ? `${name}/` : name);
            }
          }

          if (targetDirSegments.length > 0 && !dirPrefix.endsWith('../')) {
            availableItems.push('../');
          }
        }

        if (mainCmd === 'open' && !dirPrefix) {
          const openTargets = ['projects', 'thoughts', 'files'];
          openTargets.forEach(t => {
            if (!availableItems.includes(t) && !availableItems.includes(`${t}/`)) {
              availableItems.push(t);
            }
          });

          for (const [dirName, dirNode] of Object.entries(fileSystem.children)) {
            if (dirNode.type === 'dir') {
              for (const fname of Object.keys(dirNode.children)) {
                const baseFname = fname.replace(/\.md$/, '');
                if (!availableItems.includes(baseFname)) {
                  availableItems.push(baseFname);
                }
              }
            }
          }
        }

        const matches = availableItems.filter(item => item.toLowerCase().startsWith(basePrefix.toLowerCase()));

        if (matches.length === 1) {
          tokens[tokens.length - 1] = dirPrefix + matches[0];
          input.value = tokens.join(' ');
        } else if (matches.length > 1) {
          const lastChild = history.lastElementChild;
          if (lastChild && lastChild.classList.contains('tab-hint-row')) {
            return;
          }
          const hint = document.createElement('div');
          hint.className = 'tab-hint-row text-xs text-[#38bdf8] pl-3 my-1 font-mono';
          hint.textContent = matches.map(m => dirPrefix + m).join('   ');
          history.appendChild(hint);
          if (termBody) {
            termBody.scrollTop = termBody.scrollHeight;
            requestAnimationFrame(() => {
              if (termBody) termBody.scrollTop = termBody.scrollHeight;
            });
          }
        }
      }
    });

    function escapeHtml(str: string) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerminalEngine);
  } else {
    initTerminalEngine();
  }
</script>

