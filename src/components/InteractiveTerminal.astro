    function getCwdLabel(): string {
      return currentPath.length === 0 ? '~' : `~/${currentPath.join('/')}`;
    }

    function updateTitle() {
      if (titleText && !isMinimized) {
        titleText.textContent = `bash — gulo@playground: ${getCwdLabel()}${isMaximized ? ' [MAXIMERAD FULLSKÄRM]' : ''}`;
      }
      if (promptCwd) {
        promptCwd.textContent = getCwdLabel();
      }
    }

    updateTitle();

    // Persistens mellan sidbyten: Om terminalen var öppen tidigare, behåll den öppen!
    const wasOpen = sessionStorage.getItem('terminal_open');
    if (wasOpen === 'true') {
      restoreWindow();
    } else if (wasOpen === 'false' && !isSubpage) {
      closeWindow();
    }

    function resolveNode(pathArr: string[]): DirNode | FileNode | null {
      let current: DirNode | FileNode = fileSystem;
      for (const seg of pathArr) {
        if (current.type !== 'dir') return null;
        if (!current.children[seg]) return null;
        current = current.children[seg];
      }
      return current;
    }

    function getCurrentDir(): DirNode {
      return resolveNode(currentPath) as DirNode;
