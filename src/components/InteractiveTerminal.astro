---
// InteractiveTerminal.astro - Neofetch + Interactive Command Shell
---

<section id="about" class="w-full mb-12" aria-label="Terminal Hero">
  <!-- Terminal Window Container -->
  <div class="rounded-lg border border-[#30363d] bg-[#161b22] shadow-2xl overflow-hidden">
    <!-- Window Title Bar -->
    <div class="flex items-center justify-between px-4 py-2.5 bg-[#0d1117] border-b border-[#30363d] select-none">
      <div class="flex items-center space-x-2">
        <span class="w-3 h-3 rounded-full bg-[#f85149] inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-[#f59e0b] inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-[#2ea043] inline-block"></span>
      </div>
      <div class="text-xs text-[#8b949e] font-mono tracking-wide flex items-center gap-2">
        <span>bash — gulo@playground: ~</span>
      </div>
      <div class="text-[11px] text-[#8b949e] hidden sm:block">
        utf-8
      </div>
    </div>

    <!-- Terminal Body -->
    <div class="p-4 sm:p-6 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto">
      <!-- Neofetch Display -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 pb-6 border-b border-[#30363d]/60">
        <!-- ASCII Art Column -->
        <div class="md:col-span-4 text-[#10b981] select-none font-bold text-[11px] sm:text-xs leading-none flex items-center justify-center sm:justify-start">
          <pre class="overflow-hidden">
   __ _ _   _ _  ___  
  / _` | | | | |/ _ \ 
 | (_| | |_| | | (_) |
  \__, |\__,_|_|\___/ 
  |___/  chalmers.d   
   <span class="text-[#38bdf8]">▲</span> <span class="text-[#a78bfa]">~</span> <span class="text-[#f59e0b]">≈</span> <span class="text-[#10b981]">●</span> <span class="text-[#e6edf3]">sys.tui</span>
          </pre>
        </div>

        <!-- Info / Specs Column -->
        <div class="md:col-span-8 space-y-1.5 text-xs sm:text-sm">
          <div class="pb-1">
            <span class="text-[#10b981] font-bold">gulo</span><span class="text-[#8b949e]">@</span><span class="text-[#38bdf8] font-bold">chalmers-box</span>
            <div class="text-[#30363d] select-none">---------------------------------</div>
          </div>

          <div class="grid grid-cols-[105px_1fr] gap-x-2">
            <span class="text-[#8b949e]">Program:</span>
            <span class="text-[#e6edf3] font-medium">Datateknik @ Chalmers Tekniska Högskola</span>
          </div>

          <div class="grid grid-cols-[105px_1fr] gap-x-2">
            <span class="text-[#8b949e]">Sport / Fysik:</span>
            <span class="text-[#38bdf8]">Simmare (Kapplöpningssimning & uthållighet)</span>
          </div>

          <div class="grid grid-cols-[105px_1fr] gap-x-2">
            <span class="text-[#8b949e]">Fokus / Intresse:</span>
            <span class="text-[#e6edf3]">Systemprogrammering, Homelab, Minecraft-servrar, Dotfiles</span>
          </div>

          <div class="grid grid-cols-[105px_1fr] gap-x-2">
            <span class="text-[#8b949e]">Kärna / OS:</span>
            <span class="text-[#8b949e]">Linux 6.12 x86_64 / Arch + Debian Servers</span>
          </div>

          <div class="grid grid-cols-[105px_1fr] gap-x-2">
            <span class="text-[#8b949e]">Aktuell status:</span>
            <span class="text-[#10b981] flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#10b981] animate-ping"></span>
              [● ONLINE] Tentaperiod, bassängpass & serverdrift
            </span>
          </div>

          <!-- Color palette swatches (TUI signature) -->
          <div class="pt-2 flex items-center space-x-1.5" aria-hidden="true">
            <span class="w-3.5 h-3.5 rounded-sm bg-[#0d1117] border border-[#30363d]"></span>
            <span class="w-3.5 h-3.5 rounded-sm bg-[#161b22] border border-[#30363d]"></span>
            <span class="w-3.5 h-3.5 rounded-sm bg-[#f85149]"></span>
            <span class="w-3.5 h-3.5 rounded-sm bg-[#2ea043]"></span>
            <span class="w-3.5 h-3.5 rounded-sm bg-[#f59e0b]"></span>
            <span class="w-3.5 h-3.5 rounded-sm bg-[#38bdf8]"></span>
            <span class="w-3.5 h-3.5 rounded-sm bg-[#a78bfa]"></span>
            <span class="w-3.5 h-3.5 rounded-sm bg-[#e6edf3]"></span>
          </div>
        </div>
      </div>

      <!-- Terminal Output History -->
      <div id="terminal-history" class="pt-4 space-y-3" aria-live="polite">
        <div class="text-[#8b949e] text-xs">
          Välkommen till min digitala trädgård & playground. Skriv <code class="text-[#10b981] font-bold">help</code> för att se kommandon, eller navigera via sidan nedanför.
        </div>
      </div>

      <!-- Active Prompt Row -->
      <form id="terminal-form" class="mt-3 flex items-center gap-2 pt-2 border-t border-[#30363d]/40">
        <label for="terminal-input" class="text-xs sm:text-sm text-[#10b981] font-semibold whitespace-nowrap select-none flex items-center gap-1">
          <span>visitor@playground</span><span class="text-[#8b949e]">:</span><span class="text-[#38bdf8]">~</span><span class="text-[#e6edf3]">$</span>
        </label>
        <input 
          id="terminal-input" 
          type="text" 
          autocomplete="off" 
          autocorrect="off" 
          autocapitalize="off" 
          spellcheck="false" 
          class="flex-1 bg-transparent border-none text-[#e6edf3] text-xs sm:text-sm focus:outline-none focus:ring-0 p-0 font-mono caret-[#10b981]"
          placeholder="skriv 'help' eller klicka nedan..."
        />
        <button type="submit" class="sr-only">Kör kommando</button>
      </form>

      <!-- Quick Command Buttons (Helpful on mobile and desktop) -->
      <div class="mt-4 flex flex-wrap items-center gap-1.5 text-[11px] text-[#8b949e]">
        <span class="mr-1 select-none">Snabbkommandon:</span>
        <button type="button" class="term-quick-btn px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#10b981] hover:border-[#10b981] hover:text-[#e6edf3] transition-all" data-cmd="help">
          help
        </button>
        <button type="button" class="term-quick-btn px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#38bdf8] hover:border-[#38bdf8] hover:text-[#e6edf3] transition-all" data-cmd="projects">
          projects
        </button>
        <button type="button" class="term-quick-btn px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#f59e0b] hover:border-[#f59e0b] hover:text-[#e6edf3] transition-all" data-cmd="thoughts">
          thoughts
        </button>
        <button type="button" class="term-quick-btn px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#a78bfa] hover:border-[#a78bfa] hover:text-[#e6edf3] transition-all" data-cmd="files">
          files
        </button>
        <button type="button" class="term-quick-btn px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#e6edf3] hover:border-[#e6edf3] transition-all" data-cmd="school">
          school
        </button>
        <button type="button" class="term-quick-btn px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#38bdf8] hover:border-[#38bdf8] hover:text-[#e6edf3] transition-all" data-cmd="swim">
          swim
        </button>
        <button type="button" class="term-quick-btn px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#f85149] hover:border-[#f85149] hover:text-[#e6edf3] transition-all" data-cmd="clear">
          clear
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // Vanilla JS terminal logic - zero framework overhead
  function initTerminal() {
    const form = document.getElementById('terminal-form') as HTMLFormElement | null;
    const input = document.getElementById('terminal-input') as HTMLInputElement | null;
    const history = document.getElementById('terminal-history') as HTMLDivElement | null;
    const quickBtns = document.querySelectorAll('.term-quick-btn');

    if (!form || !input || !history) return;

    let cmdHistory: string[] = [];
    let historyIndex = -1;

    const commands: Record<string, () => string | void> = {
      help: () => `
<div class="text-[#e6edf3] space-y-1">
  <div class="text-[#10b981] font-bold">Tillgängliga kommandon:</div>
  <div class="grid grid-cols-[110px_1fr] gap-x-2 text-xs">
    <span class="text-[#38bdf8]">projects</span><span>Rullar ner till projekt & homelab</span>
    <span class="text-[#38bdf8]">thoughts</span><span>Rullar ner till artiklar & tankar</span>
    <span class="text-[#38bdf8]">files</span><span>Rullar ner till filarkiv & nedladdningar</span>
    <span class="text-[#38bdf8]">school</span><span>Visar aktuell status för Chalmers Datateknik</span>
    <span class="text-[#38bdf8]">swim</span><span>Simträningsstatistik och tankar från bassängen</span>
    <span class="text-[#38bdf8]">whoami</span><span>Vem är gulo? Bakgrund och personlighet</span>
    <span class="text-[#38bdf8]">contact</span><span>Kontaktvägar och sociala länkar</span>
    <span class="text-[#38bdf8]">uptime</span><span>Visar systemtid och status</span>
    <span class="text-[#38bdf8]">clear</span><span>Rensar terminalfönstret</span>
  </div>
</div>`,

      projects: () => {
        const el = document.getElementById('projects');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
        return `<div class="text-[#38bdf8]">Navigerar till [~/projekt]...</div>`;
      },

      thoughts: () => {
        const el = document.getElementById('thoughts');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
        return `<div class="text-[#f59e0b]">Navigerar till [~/tankar]...</div>`;
      },

      files: () => {
        const el = document.getElementById('files');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
        return `<div class="text-[#a78bfa]">Navigerar till [~/filer]...</div>`;
      },

      downloads: () => {
        const el = document.getElementById('files');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
        return `<div class="text-[#a78bfa]">Navigerar till filarkivet...</div>`;
      },

      school: () => {
        const el = document.getElementById('now');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
        return `
<div class="text-[#e6edf3] space-y-1">
  <div class="text-[#38bdf8] font-bold">Chalmers Tekniska Högskola — Datateknik (Civilingenjör)</div>
  <div class="text-[#8b949e]">Aktuellt fokus: Operativsystem, distribuerade system, C/Rust & algoritmer.</div>
</div>`;
      },

      now: () => {
        const el = document.getElementById('now');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
        return `<div class="text-[#10b981]">Navigerar till 'Just nu'-sektionen...</div>`;
      },

      swim: () => `
<div class="text-[#e6edf3] space-y-1">
  <div class="text-[#38bdf8] font-bold">🏊 Simning & Uthållighet</div>
  <div class="text-[#8b949e]">Hemmabassäng: Valhallabadet, Göteborg.</div>
  <div>Träning: 4-6 pass/vecka (frisim & fjärilsim). Bästa sättet att rensa huvudet från minnesläckor i C!</div>
</div>`,

      whoami: () => `
<div class="text-[#e6edf3] space-y-1">
  <div class="text-[#10b981] font-bold">gulo — Chalmersstudent, simmare och utvecklare</div>
  <div class="text-[#8b949e]">Gillar självhostade servrar, Linux-tuning, Minecraft, fotografering och att bygga saker från grunden.</div>
</div>`,

      uptime: () => {
        return `<div class="text-[#8b949e]">System uptime: 42 dagar, 14 timmar, 22 minuter (load: 0.28, 0.32, 0.40)</div>`;
      },

      contact: () => `
<div class="text-[#e6edf3] space-y-1">
  <div class="text-[#10b981] font-bold">Kontakt & Profiler:</div>
  <div class="text-xs">
    <div>• GitHub: <a href="https://github.com" target="_blank" class="text-[#38bdf8] underline">github.com</a></div>
    <div>• Email: <span class="text-[#f59e0b]">kontakt@chalmers-box.local</span></div>
    <div>• Discord: <span class="text-[#a78bfa]">gulo#0001</span></div>
  </div>
</div>`,

      clear: () => {
        history.innerHTML = '';
        return;
      }
    };

    function execute(rawCmd: string) {
      const cleanCmd = rawCmd.trim();
      if (!cleanCmd) return;

      cmdHistory.push(cleanCmd);
      historyIndex = cmdHistory.length;

      // Render user command row
      const cmdRow = document.createElement('div');
      cmdRow.className = 'flex items-center gap-2 text-xs sm:text-sm font-semibold text-[#8b949e]';
      cmdRow.innerHTML = `
        <span class="text-[#10b981]">visitor@playground</span><span class="text-[#8b949e]">:</span><span class="text-[#38bdf8]">~</span><span class="text-[#e6edf3]">$</span>
        <span class="text-[#e6edf3]">${escapeHtml(cleanCmd)}</span>
      `;
      history.appendChild(cmdRow);

      const parts = cleanCmd.split(' ');
      const main = parts[0].toLowerCase();

      // Check cat command
      if (main === 'cat') {
        const target = parts[1];
        const resBox = document.createElement('div');
        resBox.className = 'text-xs text-[#8b949e] pl-4 border-l border-[#30363d]';
        if (target === 'about.txt' || target === 'whoami.txt') {
          resBox.innerHTML = `Chalmers Datateknik-student med passion för system, simning och homelab.`;
        } else if (target === 'backup-world.sh') {
          resBox.innerHTML = `Se full fil i sektionen [~/filer] nedanför.`;
        } else {
          resBox.innerHTML = `cat: ${escapeHtml(target || '')}: Ingen sådan fil i arbetskatalogen.`;
        }
        history.appendChild(resBox);
      } else if (commands[main]) {
        const res = commands[main]();
        if (res) {
          const resBox = document.createElement('div');
          resBox.className = 'text-xs pl-4 border-l border-[#30363d] text-[#8b949e]';
          resBox.innerHTML = res;
          history.appendChild(resBox);
        }
      } else {
        const errBox = document.createElement('div');
        errBox.className = 'text-xs text-[#f85149] pl-4 border-l border-[#f85149]/40';
        errBox.innerHTML = `Kommando hittades inte: '${escapeHtml(cleanCmd)}'. Skriv <span class="text-[#10b981] font-bold">help</span> för lista.`;
        history.appendChild(errBox);
      }

      // Keep scrolled
      input.value = '';
      input.focus();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      execute(input.value);
    });

    // History navigation with arrow keys
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (cmdHistory.length > 0 && historyIndex > 0) {
          historyIndex--;
          input.value = cmdHistory[historyIndex];
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex < cmdHistory.length - 1) {
          historyIndex++;
          input.value = cmdHistory[historyIndex];
        } else {
          historyIndex = cmdHistory.length;
          input.value = '';
        }
      }
    });

    // Quick buttons
    quickBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cmd = btn.getAttribute('data-cmd');
        if (cmd) {
          execute(cmd);
        }
      });
    });

    function escapeHtml(str: string) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerminal);
  } else {
    initTerminal();
  }
</script>
