---
// Footer.astro - TUI System Diagnostics & Social Network Matrix
---

<footer class="mt-16 pt-8 pb-12 border-t border-[#30363d] text-xs font-mono text-[#8b949e]">
  <div class="space-y-6">
    <!-- Status Diagnostic Grid -->
    <div class="p-4 rounded-lg bg-[#161b22] border border-[#30363d] space-y-3">
      <div class="flex items-center justify-between pb-2 border-b border-[#30363d]/60 text-[11px]">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
          <span class="text-[#e6edf3] font-semibold">SYSTEM DIAGNOSTICS & TELEMETRY</span>
        </div>
        <span class="text-[#10b981]">ALL_SYSTEMS_NOMINAL</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-[11px]">
        <div>
          <span class="block text-[#8b949e]">LOCATION:</span>
          <span class="text-[#e6edf3]">Göteborg, SE (Chalmers)</span>
        </div>
        <div>
          <span class="block text-[#8b949e]">NETWORK PING:</span>
          <span class="text-[#38bdf8]">~12ms (SUNET fiber)</span>
        </div>
        <div>
          <span class="block text-[#8b949e]">ENGINE:</span>
          <span class="text-[#a78bfa]">Astro 7 (SSG) + TUI</span>
        </div>
        <div>
          <span class="block text-[#8b949e]">HOST UPTIME:</span>
          <span class="text-[#10b981]">99.98% / 42d 8h</span>
        </div>
      </div>
    </div>

    <!-- Navigation & Social Links -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-2">
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <a 
          href="https://github.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[#e6edf3] hover:underline transition-colors flex items-center gap-1"
        >
          <span>github</span><span class="text-[10px]">↗</span>
        </a>
        <a 
          href="mailto:gulo@example.com" 
          class="hover:text-[#e6edf3] hover:underline transition-colors flex items-center gap-1"
        >
          <span>email</span><span class="text-[10px]">↗</span>
        </a>
        <a 
          href="https://discord.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[#e6edf3] hover:underline transition-colors flex items-center gap-1"
        >
          <span>discord</span><span class="text-[10px]">↗</span>
        </a>
        <a 
          href="https://chalmers.se" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[#38bdf8] hover:underline transition-colors flex items-center gap-1"
        >
          <span>chalmers.se</span><span class="text-[10px]">↗</span>
        </a>
        <button 
          type="button" 
          id="footer-files-trigger" 
          class="text-[#38bdf8] hover:text-[#e6edf3] hover:underline transition-colors flex items-center gap-1 cursor-pointer"
        >
          <span>filer &amp; resurser</span><span class="text-[10px]">↓</span>
        </button>
      </div>

      <div class="text-[11px] text-[#8b949e]">
        <span>copyleft // built for curiosity & playground</span>
      </div>
    </div>
  </div>
</footer>

<script>
  document.getElementById('footer-files-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-files-modal'));
  });
</script>
