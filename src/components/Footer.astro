---
// Footer.astro - Site footer
const year = new Date().getFullYear();
---

<footer class="mt-14 sm:mt-20 pt-6 pb-10 sm:pb-12 border-t border-[#30363d] text-xs text-[#8b949e]">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5">
    <div class="space-y-1.5">
      <p class="text-[#e6edf3]">Gustav Löfqvist</p>
      <p>
        Gothenburg, <time id="footer-clock" datetime="">--:--</time>
      </p>
      <p class="text-[11px]" data-i18n="footer_built">Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-[#8b949e] underline decoration-[#30363d] underline-offset-2 hover:text-[#e6edf3] hover:decoration-[#8b949e]">Astro</a>. The source is on <a href="https://github.com/abbguslof" target="_blank" rel="noopener noreferrer" class="text-[#8b949e] underline decoration-[#30363d] underline-offset-2 hover:text-[#e6edf3] hover:decoration-[#8b949e]">GitHub</a>.</p>
    </div>

    <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] sm:text-xs" aria-label="Footer navigation">
      <a href="/#about" id="footer-about-link" class="hover:text-[#e6edf3] transition-colors" data-i18n="footer_link_about">about</a>
      <a href="/projects" class="hover:text-[#e6edf3] transition-colors" data-i18n="footer_link_portfolio">projects</a>
      <a href="/thoughts" class="hover:text-[#e6edf3] transition-colors" data-i18n="footer_link_blog">writing</a>
      <a href="/files" class="hover:text-[#e6edf3] transition-colors" data-i18n="footer_link_files">files</a>
      <a href="https://github.com/abbguslof" target="_blank" rel="noopener noreferrer" class="hover:text-[#e6edf3] transition-colors">github<span class="text-[9px]">↗</span></a>
      <a href="mailto:gurra@gulo.se" class="hover:text-[#e6edf3] transition-colors">email</a>
      <a href="https://chalmers.se" target="_blank" rel="noopener noreferrer" class="hover:text-[#e6edf3] transition-colors">chalmers.se<span class="text-[9px]">↗</span></a>
    </nav>
  </div>

  <div class="mt-5 pt-3 border-t border-[#30363d]/60 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1.5 text-[10px] text-[#8b949e]/70">
    <span>© {year} Gustav Löfqvist</span>
    <span data-i18n="footer_build" data-i18n-count={new Date().toISOString().slice(0, 10)}>Last build: {new Date().toISOString().slice(0, 10)}</span>
  </div>
</footer>

<script>
  const aboutLink = document.getElementById('footer-about-link');
  aboutLink?.addEventListener('click', (event) => {
    if (window.location.pathname === '/' || window.location.pathname === '') {
      event.preventDefault();
      if (window.location.hash !== '#about') {
        history.replaceState(null, '', '#about');
      }
      window.dispatchEvent(new HashChangeEvent('hashchange'));
    }
  });

  const clock = document.getElementById('footer-clock');
  if (clock) {
    const formatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/Stockholm',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const tick = () => {
      const now = new Date();
      clock.textContent = formatter.format(now);
      clock.setAttribute('datetime', now.toISOString());
    };
    tick();
    window.setInterval(tick, 30000);
  }
</script>
