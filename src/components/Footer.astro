---
// Footer.astro - TUI System Diagnostics & Social Network Matrix
---

<footer class="mt-16 pt-8 pb-12 border-t border-[#30363d] text-xs font-mono text-[#8b949e]">
  <div class="space-y-6">
    <!-- Status Diagnostic Grid -->
    <div class="p-4 rounded-lg bg-[#161b22] border border-[#30363d] space-y-3">
      <div class="flex items-center justify-between pb-2 border-b border-[#30363d]/60 text-[11px]">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#10b981] animate-pulse"></span>
          <span class="text-[#e6edf3] font-semibold" data-i18n="footer_diagnostics">SYSTEM DIAGNOSTICS &amp; TELEMETRY</span>
        </div>
        <span class="text-[#10b981]" data-i18n="footer_nominal">ALL_SYSTEMS_NOMINAL</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-[11px]">
        <div>
          <span class="block text-[#8b949e]" data-i18n="footer_location_label">LOCATION:</span>
          <span class="text-[#e6edf3]" data-i18n="footer_location_val">Gothenburg, SE (Chalmers)</span>
        </div>
        <div>
          <span class="block text-[#8b949e]" data-i18n="footer_ping_label">NETWORK PING:</span>
          <span class="text-[#38bdf8]" data-i18n="footer_ping_val">~12ms (SUNET fiber)</span>
        </div>
        <div>
          <span class="block text-[#8b949e]" data-i18n="footer_engine_label">ENGINE:</span>
          <span class="text-[#a78bfa]" data-i18n="footer_engine_val">Astro 7 (SSG) + TUI</span>
        </div>
        <div>
          <span class="block text-[#8b949e]" data-i18n="footer_uptime_label">HOST UPTIME:</span>
          <span class="text-[#10b981]" data-i18n="footer_uptime_val">99.98% / 42 days, 8 hrs</span>
        </div>
      </div>
    </div>

    <!-- Navigation & Social Links -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-2">
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <a 
          href="/projects" 
          class="hover:text-[#e6edf3] hover:underline transition-colors"
          data-i18n="footer_link_portfolio"
        >
          [portfolio]
        </a>
        <a 
          href="/thoughts" 
          class="hover:text-[#e6edf3] hover:underline transition-colors"
          data-i18n="footer_link_blog"
        >
          [blog]
        </a>
        <a 
          href="/files" 
          class="hover:text-[#e6edf3] hover:underline transition-colors"
          data-i18n="footer_link_files"
        >
          [files]
        </a>
        <a 
          href="https://github.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[#e6edf3] hover:underline transition-colors flex items-center gap-1"
        >
          <span>github</span><span class="text-[10px]">↗</span>
        </a>
        <a 
          href="mailto:gulo@example.com" 
          class="hover:text-[#e6edf3] hover:underline transition-colors flex items-center gap-1"
        >
          <span>email</span><span class="text-[10px]">↗</span>
        </a>
        <a 
          href="https://chalmers.se" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[#38bdf8] hover:underline transition-colors flex items-center gap-1"
        >
          <span>chalmers.se</span><span class="text-[10px]">↗</span>
        </a>
      </div>

      <div class="text-[11px] text-[#8b949e]">
        <span data-i18n="footer_copyleft">copyleft // built for curiosity &amp; playground</span>
      </div>
    </div>
  </div>
</footer>
