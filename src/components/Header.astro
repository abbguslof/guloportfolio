---
// Header.astro - Site navigation
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isProjects = currentPath.startsWith('/projects');
const isThoughts = currentPath.startsWith('/thoughts');
const isFiles = currentPath.startsWith('/files');
---

<!-- Placeholder in normal flow so the fixed header causes no layout shift -->
<div class="h-14 sm:h-16 w-full mb-4 sm:mb-8 select-none pointer-events-none" aria-hidden="true"></div>

<header id="site-header" class="fixed top-0 left-0 right-0 w-full z-50 pointer-events-none">
  <div
    id="header-surface"
    class="pointer-events-auto w-full max-w-[1400px] mx-auto px-3 sm:px-8 py-2 sm:py-3.5 pt-[calc(0.5rem+env(safe-area-inset-top,0px))] sm:pt-3.5 transition-[padding-top,padding-bottom] duration-200 ease-out"
  >
    <div class="w-full flex items-center justify-between gap-3 sm:gap-6">
      <a href="/" class="group flex items-baseline gap-2 shrink-0">
        <span class="text-sm font-bold tracking-tight text-[#e6edf3] group-hover:text-[#10b981] transition-colors">gulo</span>
        <span class="text-[11px] text-[#8b949e] hidden md:inline">Gustav Löfqvist</span>
      </a>

      <nav id="header-nav" class="flex items-center flex-nowrap gap-3 sm:gap-5 text-xs shrink-0 overflow-x-auto no-scrollbar" aria-label="Main navigation">
        <div id="nav-links" class="relative flex items-center gap-3 sm:gap-5 shrink-0">
          <a
            href="/projects"
            class={`nav-link py-1.5 sm:py-1 transition-colors ${isProjects ? 'text-[#e6edf3]' : 'text-[#8b949e] hover:text-[#e6edf3]'}`}
            data-i18n="nav_projects"
            data-nav="projects"
            data-color="#a78bfa"
            aria-current={isProjects ? 'page' : undefined}
          >projects</a>
          <a
            href="/thoughts"
            class={`nav-link py-1.5 sm:py-1 transition-colors ${isThoughts ? 'text-[#e6edf3]' : 'text-[#8b949e] hover:text-[#e6edf3]'}`}
            data-i18n="nav_thoughts"
            data-nav="thoughts"
            data-color="#f59e0b"
            aria-current={isThoughts ? 'page' : undefined}
          >writing</a>
          <a
            href="/files"
            class={`nav-link py-1.5 sm:py-1 transition-colors ${isFiles ? 'text-[#e6edf3]' : 'text-[#8b949e] hover:text-[#e6edf3]'}`}
            data-i18n="nav_files"
            data-nav="files"
            data-color="#38bdf8"
            aria-current={isFiles ? 'page' : undefined}
          >files</a>
          <span id="nav-underline" class="pointer-events-none absolute bottom-0 left-0 h-[2px] rounded-full opacity-0 transition-all duration-300 ease-out" aria-hidden="true"></span>
        </div>
        <a
          href="https://github.com/abbguslof"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-flex items-center gap-1 py-1 text-[#8b949e] hover:text-[#e6edf3] transition-colors"
          aria-label="GitHub profile"
        >github<span class="text-[10px]">↗</span></a>

        <button
          type="button"
          id="header-terminal-toggle"
          class="py-1.5 sm:py-1 text-[#10b981] hover:text-[#e6edf3] transition-colors cursor-pointer flex items-center gap-1.5"
          title="Toggle terminal"
          aria-label="Toggle terminal"
        >
          <span class="font-bold">&gt;_</span>
          <span class="hidden sm:inline" data-i18n="nav_terminal">terminal</span>
        </button>

        <div class="flex items-center gap-1 select-none" id="lang-toggle-container" title="Switch language">
          <button
            type="button"
            id="btn-lang-en"
            class="lang-btn px-1 py-1 text-[10px] font-bold transition-colors cursor-pointer text-[#e6edf3]"
            aria-label="Switch to English"
          >EN</button>
          <span class="text-[#30363d] text-[10px]">/</span>
          <button
            type="button"
            id="btn-lang-sv"
            class="lang-btn px-1 py-1 text-[10px] font-bold transition-colors cursor-pointer text-[#8b949e] hover:text-[#e6edf3]"
            aria-label="Växla till svenska"
          >SV</button>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  #site-header {
    background-color: rgba(13, 17, 23, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(48, 54, 61, 0.25);
  }

  #site-header.is-scrolled {
    background-color: rgba(13, 17, 23, 0.92);
    border-bottom: 1px solid rgba(48, 54, 61, 0.7);
  }

  #header-surface.is-scrolled {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
</style>

<script>
  import { setSiteLang } from '../scripts/i18n-client';

  const siteHeader = document.getElementById('site-header');
  const headerSurface = document.getElementById('header-surface');
  let isScrolled = false;
  let ticking = false;

  function onScroll() {
    const shouldShrink = window.scrollY > 60;
    if (shouldShrink !== isScrolled) {
      isScrolled = shouldShrink;
      siteHeader?.classList.toggle('is-scrolled', isScrolled);
      headerSurface?.classList.toggle('is-scrolled', isScrolled);
    }
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });

  onScroll();

  const navLinksContainer = document.getElementById('nav-links');
  const navUnderline = document.getElementById('nav-underline');
  const navPageLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('#nav-links .nav-link'));
  const activeNavLink = document.querySelector<HTMLAnchorElement>('#nav-links .nav-link[aria-current="page"]');
  let hoveredNavLink: HTMLAnchorElement | null = null;

  function positionNavUnderline(link: HTMLAnchorElement | null, faint = false) {
    if (!navLinksContainer || !navUnderline) return;
    if (!link) {
      navUnderline.style.opacity = '0';
      return;
    }
    const containerRect = navLinksContainer.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    navUnderline.style.left = `${linkRect.left - containerRect.left}px`;
    navUnderline.style.width = `${linkRect.width}px`;
    navUnderline.style.backgroundColor = link.dataset.color || '#10b981';
    navUnderline.style.opacity = faint ? '0.55' : '1';
  }

  navPageLinks.forEach((link) => {
    link.addEventListener('mouseenter', () => {
      hoveredNavLink = link;
      positionNavUnderline(link, true);
    });
    link.addEventListener('focus', () => {
      hoveredNavLink = link;
      positionNavUnderline(link, true);
    });
    link.addEventListener('blur', () => {
      hoveredNavLink = null;
      positionNavUnderline(activeNavLink);
    });
  });

  navLinksContainer?.addEventListener('mouseleave', () => {
    hoveredNavLink = null;
    positionNavUnderline(activeNavLink);
  });

  window.addEventListener('resize', () => {
    positionNavUnderline(hoveredNavLink ?? activeNavLink, Boolean(hoveredNavLink));
  });

  window.addEventListener('lang-change', () => {
    requestAnimationFrame(() => positionNavUnderline(hoveredNavLink ?? activeNavLink, Boolean(hoveredNavLink)));
  });

  if (activeNavLink && navUnderline) {
    navUnderline.style.transition = 'none';
    positionNavUnderline(activeNavLink);
    requestAnimationFrame(() => {
      navUnderline.style.transition = '';
    });
  }

  document.getElementById('header-terminal-toggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-terminal'));
  });

  document.getElementById('btn-lang-en')?.addEventListener('click', () => {
    setSiteLang('en');
  });

  document.getElementById('btn-lang-sv')?.addEventListener('click', () => {
    setSiteLang('sv');
  });
</script>
