---
// Header.astro - Full-width Floating Cockpit Navigation with Active Page Indicators
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isProjects = currentPath.startsWith('/projects');
const isThoughts = currentPath.startsWith('/thoughts');
const isFiles = currentPath.startsWith('/files');
const isHome = currentPath === '/';
---

<!-- Placeholder div in normal document flow to guarantee 0px layout shift -->
<div class="h-16 w-full mb-8 select-none pointer-events-none" aria-hidden="true"></div>

<!-- Full-width Fixed Header: spans 100vw so background never cuts off -->
<header id="site-header" class="fixed top-0 left-0 right-0 w-full z-50 pointer-events-none transition-[background-color,border-color,box-shadow] duration-250 ease-out">
  <div 
    id="header-surface" 
    class="pointer-events-auto w-full max-w-[1400px] mx-auto px-3 sm:px-8 py-3 sm:py-3.5 transition-[padding-top,padding-bottom] duration-250 ease-out"
  >
    <div class="w-full flex items-center justify-between gap-2 sm:gap-6">
      <!-- Brand / Logo (Far left to maximize center reading area) -->
      <div id="header-brand" class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a href="/" class="group flex items-center gap-1.5 sm:gap-2 text-sm font-semibold tracking-tight transition-colors">
          <span class={`px-2 py-0.5 rounded font-mono text-xs font-bold transition-all ${
            isHome 
              ? 'bg-[#161b22] border border-[#10b981] text-[#10b981]' 
              : 'bg-[#161b22] border border-[#30363d] text-[#10b981]'
          }`} id="header-brand-badge">
            GULO
          </span>
          <span class="text-xs font-mono text-[#8b949e] group-hover:text-[#e6edf3] transition-colors hidden md:inline">
            chalmers.d <span class="text-[#30363d]">//</span> playground
          </span>
        </a>

        <span 
          id="header-online-status"
          class="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-[#161b22] border border-[#30363d] text-[#10b981] transition-all"
          title="Station Connected // Online"
        >
          <span id="header-online-dot" class="w-1.5 h-1.5 mr-1 rounded-full bg-[#10b981] animate-pulse"></span>
          <span id="header-online-text" data-i18n="header_status_online">ONLINE</span>
        </span>
      </div>

      <!-- Navigation & Controls (Far right to maximize center reading area) -->
      <nav id="header-nav" class="flex items-center flex-nowrap gap-1 sm:gap-2 text-xs font-mono shrink-0" aria-label="Huvudnavigation">
        <button 
          type="button" 
          id="header-terminal-toggle" 
          class="px-2 sm:px-2.5 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#10b981] hover:text-[#e6edf3] hover:border-[#10b981] transition-all cursor-pointer flex items-center gap-1 sm:gap-1.5 shadow-sm text-xs shrink-0"
          title="Toggle terminal (open/close)"
        >
          <span>&gt;_</span>
          <span class="hidden sm:inline" data-i18n="nav_terminal">terminal</span>
        </button>
        <a 
          href="/projects" 
          class={`nav-link px-1.5 sm:px-2.5 py-1 rounded border transition-all text-xs shrink-0 ${
            isProjects 
              ? 'border-[#a78bfa] text-[#e6edf3] bg-[#a78bfa]/5' 
              : 'bg-[#161b22] border-[#30363d] text-[#8b949e] hover:text-[#e6edf3] hover:border-[#a78bfa]'
          }`}
          data-i18n="nav_projects"
          data-nav="projects"
        >
          projects
        </a>
        <a 
          href="/thoughts" 
          class={`nav-link px-1.5 sm:px-2.5 py-1 rounded border transition-all text-xs shrink-0 ${
            isThoughts 
              ? 'border-[#f59e0b] text-[#e6edf3] bg-[#f59e0b]/5' 
              : 'bg-[#161b22] border-[#30363d] text-[#8b949e] hover:text-[#e6edf3] hover:border-[#f59e0b]'
          }`}
          data-nav="thoughts"
        >
          <span class="hidden sm:inline" data-i18n="nav_thoughts">blog / thoughts</span>
          <span class="sm:hidden" data-i18n="nav_thoughts_short">thoughts</span>
        </a>
        <a 
          href="/files" 
          class={`nav-link px-1.5 sm:px-2.5 py-1 rounded border transition-all text-xs shrink-0 ${
            isFiles 
              ? 'border-[#38bdf8] text-[#e6edf3] bg-[#38bdf8]/5' 
              : 'bg-[#161b22] border-[#30363d] text-[#8b949e] hover:text-[#e6edf3] hover:border-[#38bdf8]'
          }`}
          data-i18n="nav_files"
          data-nav="files"
        >
          files
        </a>
        <a 
          href="https://github.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-1.5 sm:px-2 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#8b949e] hover:text-[#e6edf3] hover:border-[#e6edf3] transition-all hidden md:inline-flex items-center gap-1 shrink-0"
          aria-label="GitHub profil (öppnas i ny flik)"
        >
          <span>gh</span><span class="text-[10px]">↗</span>
        </a>

        <!-- Language Switcher [ EN | SV ] -->
        <div class="flex items-center p-0.5 rounded bg-[#161b22] border border-[#30363d] select-none shrink-0" id="lang-toggle-container" title="Switch language (EN/SV)">
          <button 
            type="button" 
            id="btn-lang-en" 
            class="lang-btn px-1.5 sm:px-2 py-0.5 text-[10px] font-bold rounded transition-all cursor-pointer text-[#10b981] bg-[#0d1117] border border-[#10b981]/40 shadow-sm"
            aria-label="Switch to English"
          >
            EN
          </button>
          <button 
            type="button" 
            id="btn-lang-sv" 
            class="lang-btn px-1.5 sm:px-2 py-0.5 text-[10px] font-bold rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]"
            aria-label="Växla till svenska"
          >
            SV
          </button>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Header spans 100vw so the background and border never cut off */
  #site-header {
    background-color: rgba(13, 17, 23, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(48, 54, 61, 0.35);
    box-shadow: 0 2px 10px -2px rgba(0, 0, 0, 0.25);
  }

  #site-header.is-scrolled {
    background-color: rgba(13, 17, 23, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(48, 54, 61, 0.85);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.55);
  }

  /* Scrolled inner container contracts strictly vertically — zero horizontal shifts or jumping sideways */
  #header-surface.is-scrolled {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  /* Reliable disconnect styling for GULO badge */
  #header-brand-badge.is-offline {
    color: #f85149 !important;
    border-color: #f85149 !important;
  }
  #header-brand-badge.is-online {
    color: #10b981 !important;
  }
</style>

<script>
  import { setSiteLang } from '../scripts/i18n-client';

  const siteHeader = document.getElementById('site-header');
  const headerSurface = document.getElementById('header-surface');
  let isScrolled = false;
  let ticking = false;

  function onScroll() {
    const scrollY = window.scrollY;
    if (scrollY > 60 && !isScrolled) {
      isScrolled = true;
      siteHeader?.classList.add('is-scrolled');
      headerSurface?.classList.add('is-scrolled');
    } else if (scrollY < 20 && isScrolled) {
      isScrolled = false;
      siteHeader?.classList.remove('is-scrolled');
      headerSurface?.classList.remove('is-scrolled');
    }
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });

  // Initial check
  onScroll();

  // Active navigation highlight sync (subtle outline, no aggressive glow)
  function syncActiveNav() {
    const pathname = window.location.pathname.replace(/\/$/, '') || '/';
    const linkProjects = document.querySelector<HTMLAnchorElement>('[data-nav="projects"]');
    const linkThoughts = document.querySelector<HTMLAnchorElement>('[data-nav="thoughts"]');
    const linkFiles = document.querySelector<HTMLAnchorElement>('[data-nav="files"]');
    const brandBadge = document.getElementById('header-brand-badge');

    if (brandBadge) {
      const isHome = pathname === '/';
      const isOnline = typeof (window as any).__siteIsOnline === 'boolean'
        ? (window as any).__siteIsOnline
        : navigator.onLine;
      if (isOnline) {
        brandBadge.classList.remove('is-offline', 'is-offline-border', 'is-offline-text');
        brandBadge.classList.add('is-online', 'is-online-text');
        brandBadge.style.setProperty('color', '#10b981', 'important');
        brandBadge.style.setProperty('border-color', isHome ? '#10b981' : '#30363d', 'important');
      } else {
        brandBadge.classList.remove('is-online', 'is-online-text');
        brandBadge.classList.add('is-offline', 'is-offline-border', 'is-offline-text');
        brandBadge.style.setProperty('color', '#f85149', 'important');
        brandBadge.style.setProperty('border-color', '#f85149', 'important');
      }
    }

    if (linkProjects) {
      const active = pathname.startsWith('/projects');
      linkProjects.classList.toggle('border-[#a78bfa]', active);
      linkProjects.classList.toggle('text-[#e6edf3]', active);
      linkProjects.classList.toggle('bg-[#a78bfa]/5', active);
      linkProjects.classList.toggle('bg-[#161b22]', !active);
      linkProjects.classList.toggle('border-[#30363d]', !active);
      linkProjects.classList.toggle('text-[#8b949e]', !active);
    }

    if (linkThoughts) {
      const active = pathname.startsWith('/thoughts');
      linkThoughts.classList.toggle('border-[#f59e0b]', active);
      linkThoughts.classList.toggle('text-[#e6edf3]', active);
      linkThoughts.classList.toggle('bg-[#f59e0b]/5', active);
      linkThoughts.classList.toggle('bg-[#161b22]', !active);
      linkThoughts.classList.toggle('border-[#30363d]', !active);
      linkThoughts.classList.toggle('text-[#8b949e]', !active);
    }

    if (linkFiles) {
      const active = pathname.startsWith('/files');
      linkFiles.classList.toggle('border-[#38bdf8]', active);
      linkFiles.classList.toggle('text-[#e6edf3]', active);
      linkFiles.classList.toggle('bg-[#38bdf8]/5', active);
      linkFiles.classList.toggle('bg-[#161b22]', !active);
      linkFiles.classList.toggle('border-[#30363d]', !active);
      linkFiles.classList.toggle('text-[#8b949e]', !active);
    }
  }

  syncActiveNav();

  // Terminal button - toggles terminal open or closed
  document.getElementById('header-terminal-toggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-terminal'));
  });

  // Language buttons
  document.getElementById('btn-lang-en')?.addEventListener('click', () => {
    setSiteLang('en');
  });

  document.getElementById('btn-lang-sv')?.addEventListener('click', () => {
    setSiteLang('sv');
  });

  // Live Event-Driven Online/Offline Status Indicator
  const onlineBadge = document.getElementById('header-online-status');
  const onlineDot = document.getElementById('header-online-dot');
  const onlineText = document.getElementById('header-online-text');

  function updateOnlineUI(isOnline: boolean) {
    (window as any).__siteIsOnline = isOnline;

    const brandBadge = document.getElementById('header-brand-badge');
    if (brandBadge) {
      const pathname = window.location.pathname.replace(/\/$/, '') || '/';
      const isHome = pathname === '/';
      if (isOnline) {
        brandBadge.classList.remove('is-offline', 'is-offline-border', 'is-offline-text');
        brandBadge.classList.add('is-online', 'is-online-text');
        brandBadge.style.setProperty('color', '#10b981', 'important');
        brandBadge.style.setProperty('border-color', isHome ? '#10b981' : '#30363d', 'important');
      } else {
        brandBadge.classList.remove('is-online', 'is-online-text');
        brandBadge.classList.add('is-offline', 'is-offline-border', 'is-offline-text');
        brandBadge.style.setProperty('color', '#f85149', 'important');
        brandBadge.style.setProperty('border-color', '#f85149', 'important');
      }
    }

    if (!onlineBadge || !onlineDot || !onlineText) return;

    if (isOnline) {
      onlineBadge.className = 'hidden sm:inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-[#161b22] border border-[#30363d] text-[#10b981] transition-all is-online-text';
      onlineBadge.style.color = '#10b981';
      onlineBadge.style.borderColor = '#30363d';
      onlineDot.className = 'w-1.5 h-1.5 mr-1 rounded-full bg-[#10b981] animate-pulse is-online-bg';
      onlineDot.style.backgroundColor = '#10b981';
      onlineText.textContent = 'ONLINE';
      onlineBadge.title = 'Station Connected // All Systems Operational';
    } else {
      onlineBadge.className = 'hidden sm:inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-[#161b22] border border-[#f85149]/60 text-[#f85149] transition-all is-offline-text is-offline-border';
      onlineBadge.style.color = '#f85149';
      onlineBadge.style.borderColor = '#f85149';
      onlineDot.className = 'w-1.5 h-1.5 mr-1 rounded-full bg-[#f85149] is-offline-bg';
      onlineDot.style.backgroundColor = '#f85149';
      onlineText.textContent = 'OFFLINE';
      onlineBadge.title = 'Station Offline // Disconnected from Network';
    }

    window.dispatchEvent(new CustomEvent('connection-state-change', { detail: { isOnline } }));
  }

  // Lightweight probe to verify true WAN connectivity and measure RTT ping
  let isProbing = false;
  async function checkConnectivity() {
    if (isProbing) return;
    if (!navigator.onLine) {
      updateOnlineUI(false);
      window.dispatchEvent(new CustomEvent('network-ping', { detail: { latency: null, isOnline: false } }));
      return;
    }

    isProbing = true;
    const t0 = performance.now();
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 2500);

      // Probe external 204 endpoint with mode: 'no-cors' for true WAN verification
      // Transmits 0 bytes and immediately fails if WAN/Internet is disconnected
      await fetch('https://www.google.com/generate_204', {
        method: 'GET',
        mode: 'no-cors',
        cache: 'no-store',
        signal: controller.signal,
      });
      clearTimeout(timeoutId);

      const latency = Math.max(1, Math.round(performance.now() - t0));
      updateOnlineUI(true);
      window.dispatchEvent(new CustomEvent('network-ping', { detail: { latency, isOnline: true } }));
    } catch {
      // WAN unreachable or timed out
      updateOnlineUI(false);
      window.dispatchEvent(new CustomEvent('network-ping', { detail: { latency: null, isOnline: false } }));
    } finally {
      isProbing = false;
    }
  }

  window.addEventListener('online', () => {
    checkConnectivity();
  });

  window.addEventListener('offline', () => {
    updateOnlineUI(false);
    window.dispatchEvent(new CustomEvent('network-ping', { detail: { latency: null, isOnline: false } }));
  });

  window.addEventListener('connection-state-change', ((e: CustomEvent) => {
    if (typeof e.detail?.isOnline === 'boolean' && e.detail.isOnline !== (window as any).__siteIsOnline) {
      updateOnlineUI(e.detail.isOnline);
    }
  }) as EventListener);

  // Fast check whenever window regains focus (e.g. user toggled Wi-Fi in OS menu)
  window.addEventListener('focus', () => {
    checkConnectivity();
  });

  // Battery- & bandwidth-friendly connectivity verification:
  // Zero network requests when the tab is hidden or device is offline.
  let probeTimer: number | null = null;

  function scheduleProbe() {
    if (probeTimer !== null) clearInterval(probeTimer);
    if (document.visibilityState === 'visible') {
      probeTimer = window.setInterval(checkConnectivity, 8000);
    }
  }

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      checkConnectivity();
      scheduleProbe();
    } else {
      if (probeTimer !== null) {
        clearInterval(probeTimer);
        probeTimer = null;
      }
    }
  });

  // Initial setup: initial UI state from navigator.onLine, probe immediately
  (window as any).__siteIsOnline = navigator.onLine;
  updateOnlineUI(navigator.onLine);
  setTimeout(checkConnectivity, 100);
  scheduleProbe();
</script>
