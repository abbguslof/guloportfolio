---
// Header.astro - Clean Cockpit Top Navigation
---

<header class="border-b border-[#30363d] pb-4 mb-8">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <!-- Brand / Title -->
    <div class="flex items-center gap-3">
      <a href="/" class="group flex items-center gap-2 text-sm font-semibold tracking-tight transition-colors">
        <span class="px-2 py-0.5 rounded bg-[#161b22] border border-[#30363d] font-mono text-xs font-bold text-[#10b981] group-hover:border-[#10b981] transition-colors">
          GULO
        </span>
        <span class="text-xs font-mono text-[#8b949e] group-hover:text-[#e6edf3] transition-colors">
          chalmers.d <span class="text-[#30363d]">//</span> playground
        </span>
      </a>

      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-[#161b22] border border-[#30363d] text-[#10b981]">
        <span class="w-1.5 h-1.5 mr-1 rounded-full bg-[#10b981] animate-pulse"></span>
        ONLINE
      </span>
    </div>

    <!-- Quick Navigation Links -->
    <nav class="flex items-center flex-wrap gap-2 text-xs font-mono" aria-label="Huvudnavigation">
      <button 
        type="button" 
        id="header-terminal-toggle" 
        class="px-2.5 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#10b981] hover:text-[#e6edf3] hover:border-[#10b981] transition-all cursor-pointer flex items-center gap-1.5"
        title="Fokusera eller öppna terminalen"
      >
        <span>&gt;_</span>
        <span>terminal</span>
      </button>
      <a href="/projects" class="px-2.5 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#8b949e] hover:text-[#e6edf3] hover:border-[#a78bfa] transition-all">
        projekt
      </a>
      <a href="/thoughts" class="px-2.5 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#8b949e] hover:text-[#e6edf3] hover:border-[#f59e0b] transition-all">
        blogg / tankar
      </a>
      <a href="/#files" class="px-2.5 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#8b949e] hover:text-[#e6edf3] hover:border-[#38bdf8] transition-all">
        filer
      </a>
      <a 
        href="https://github.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-2 py-1 rounded bg-[#161b22] border border-[#30363d] text-[#8b949e] hover:text-[#e6edf3] hover:border-[#e6edf3] transition-all inline-flex items-center gap-1"
        aria-label="GitHub profil (öppnas i ny flik)"
      >
        <span>gh</span><span class="text-[10px]">↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  // Terminal button
  document.getElementById('header-terminal-toggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('restore-terminal'));
    const term = document.getElementById('terminal-window') || document.getElementById('terminal-section');
    term?.scrollIntoView({ behavior: 'smooth' });
    document.getElementById('terminal-input')?.focus();
  });
</script>
