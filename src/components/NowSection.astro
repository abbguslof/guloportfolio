---
// NowSection.astro - "Just nu / Skola & Livet"
// Interaktiv dashboard över aktuella studier, simning, homelab och kreativa intressen
---

<section id="now" class="w-full mb-10" aria-labelledby="now-heading">
  <div class="flex items-center justify-between pb-3 mb-5 border-b border-[#30363d]">
    <div class="flex items-center gap-2">
      <span class="text-[#38bdf8] font-bold">#</span>
      <h2 id="now-heading" class="text-sm font-semibold tracking-wider uppercase text-[#e6edf3]">
        Just nu / Status & Skola
      </h2>
    </div>
    <span class="text-xs text-[#8b949e] font-mono">
      Vårtermin 2026
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- Card 1: Chalmers Datateknik (Klickbar: scrollar till skolprojekt) -->
    <a 
      href="#projects" 
      class="group p-4 rounded-lg bg-[#161b22] border border-[#30363d] hover:bg-[#1f242c] hover:border-[#38bdf8] transition-all flex flex-col justify-between cursor-pointer"
    >
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-[#38bdf8] flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#38bdf8]"></span>
            [CHALMERS D] STUDIER
          </span>
          <span class="text-[11px] text-[#8b949e]">Åk 2 / Civilingenjör</span>
        </div>
        <p class="text-xs sm:text-sm text-[#e6edf3] font-medium mb-1.5 group-hover:text-[#38bdf8] transition-colors">
          Operativsystem & Datorarkitektur
        </p>
        <p class="text-xs text-[#8b949e] leading-relaxed mb-3">
          Schemaläggningsalgoritmer, trådhantering i C och RISC-V simuleringar i EDIT-huset.
        </p>
      </div>
      <div class="pt-2 border-t border-[#30363d]/60 flex items-center justify-between text-[11px] font-mono text-[#38bdf8]">
        <span>[Visa skolprojekt</span>
        <span class="group-hover:translate-y-0.5 transition-transform">↓]</span>
      </div>
    </a>

    <!-- Card 2: Simning & Fysik (Klickbar: öppnar simnings-essän) -->
    <a 
      href="/thoughts/chalmers-simning-kod" 
      class="group p-4 rounded-lg bg-[#161b22] border border-[#30363d] hover:bg-[#1f242c] hover:border-[#10b981] transition-all flex flex-col justify-between cursor-pointer"
    >
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-[#10b981] flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
            [SIMNING] TRÄNING
          </span>
          <span class="text-[11px] text-[#8b949e]">Valhallabadet</span>
        </div>
        <p class="text-xs sm:text-sm text-[#e6edf3] font-medium mb-1.5 group-hover:text-[#10b981] transition-colors">
          5-6 pass i veckan // 50m bassäng
        </p>
        <p class="text-xs text-[#8b949e] leading-relaxed mb-3">
          Fokus på uthållighet och frisim. Bästa botemedlet mot minnesläckor och fastkörda algoritmer.
        </p>
      </div>
      <div class="pt-2 border-t border-[#30363d]/60 flex items-center justify-between text-[11px] font-mono text-[#10b981]">
        <span>[Läs texten: Från 50m bassängen...</span>
        <span class="group-hover:translate-x-0.5 transition-transform">↗]</span>
      </div>
    </a>

    <!-- Card 3: Homelab & Minecraft (Klickbar: hoppar till serverprojekt) -->
    <a 
      href="#projects" 
      class="group p-4 rounded-lg bg-[#161b22] border border-[#30363d] hover:bg-[#1f242c] hover:border-[#a78bfa] transition-all flex flex-col justify-between cursor-pointer"
    >
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-[#a78bfa] flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#a78bfa]"></span>
            [HOMELAB] INFRA
          </span>
          <span class="text-[11px] text-[#8b949e]">Debian 12 + Docker</span>
        </div>
        <p class="text-xs sm:text-sm text-[#e6edf3] font-medium mb-1.5 group-hover:text-[#a78bfa] transition-colors">
          PaperMC 1.20 SMP + WireGuard
        </p>
        <p class="text-xs text-[#8b949e] leading-relaxed mb-3">
          Självhostat kluster, automatiserade zstd-backuper och Spark/Grafana-telemetri för stabil TPS.
        </p>
      </div>
      <div class="pt-2 border-t border-[#30363d]/60 flex items-center justify-between text-[11px] font-mono text-[#a78bfa]">
        <span>[Visa PaperMC-projektet</span>
        <span class="group-hover:translate-y-0.5 transition-transform">↓]</span>
      </div>
    </a>

    <!-- Card 4: Fritid, Foto & Gaming (Klickbar: visar filer/scripts) -->
    <a 
      href="#files" 
      class="group p-4 rounded-lg bg-[#161b22] border border-[#30363d] hover:bg-[#1f242c] hover:border-[#f59e0b] transition-all flex flex-col justify-between cursor-pointer"
    >
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-[#f59e0b] flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#f59e0b]"></span>
            [CREATIVE & GAMING]
          </span>
          <span class="text-[11px] text-[#8b949e]">35mm / Dotfiles</span>
        </div>
        <p class="text-xs sm:text-sm text-[#e6edf3] font-medium mb-1.5 group-hover:text-[#f59e0b] transition-colors">
          Analog fotografi & Neovim configs
        </p>
        <p class="text-xs text-[#8b949e] leading-relaxed mb-3">
          Manuell exponering med 35mm film, Lua-konfigurationer i Neovim och delade dotfiles.
        </p>
      </div>
      <div class="pt-2 border-t border-[#30363d]/60 flex items-center justify-between text-[11px] font-mono text-[#f59e0b]">
        <span>[Visa skript & configs</span>
        <span class="group-hover:translate-y-0.5 transition-transform">↓]</span>
      </div>
    </a>
  </div>
</section>
