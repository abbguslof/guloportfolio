---
// ThoughtRow.astro - Rich modern article row with dynamic bilingual category badge & tags
interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  category?: 'tanke' | 'guide' | 'anteckning' | string;
  description?: string;
  tags?: string[];
}

const { title, slug, pubDate, category = 'tanke', description, tags = [] } = Astro.props;

// Format date as YYYY-MM-DD
const formattedDate = pubDate.toISOString().slice(0, 10);
const tagsData = tags.map((t) => t.toLowerCase()).join(',');

let catBadgeClass = 'text-[#f59e0b] border-[#f59e0b]/40 bg-[#f59e0b]/10';
let catBadgeKey = 'thoughts_cat_tanke_badge';
let catDefaultText = '[THOUGHT]';
let catHoverText = 'group-hover:text-[#f59e0b]';
let catHaloClass = 'halo-amber';

if (category === 'guide') {
  catBadgeClass = 'text-[#38bdf8] border-[#38bdf8]/40 bg-[#38bdf8]/10';
  catBadgeKey = 'thoughts_cat_guide_badge';
  catDefaultText = '[GUIDE]';
  catHoverText = 'group-hover:text-[#38bdf8]';
  catHaloClass = 'halo-cyan';
} else if (category === 'anteckning' || category === 'note') {
  catBadgeClass = 'text-[#10b981] border-[#10b981]/40 bg-[#10b981]/10';
  catBadgeKey = 'thoughts_cat_anteckning_badge';
  catDefaultText = '[NOTE]';
  catHoverText = 'group-hover:text-[#10b981]';
  catHaloClass = 'halo-emerald';
} else if (category === 'idea' || category === 'idé') {
  catBadgeClass = 'text-[#a78bfa] border-[#a78bfa]/40 bg-[#a78bfa]/10';
  catBadgeKey = 'thoughts_cat_idea_badge';
  catDefaultText = '[IDEA]';
  catHoverText = 'group-hover:text-[#a78bfa]';
  catHaloClass = 'halo-purple';
}
---

<a 
  href={`/thoughts/${slug}`}
  class={`thought-item ${catHaloClass} group block p-3 sm:p-4 -mx-1 sm:-mx-2 rounded-lg hover:bg-[#1f242c]/90 active:bg-[#1f242c] border-b border-[#30363d]/40 last:border-b-0 transition-all space-y-2 cursor-pointer`}
  data-tags={tagsData}
  data-category={category}
>
  <div class="flex flex-wrap items-center justify-between gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-mono">
    <div class="flex items-center gap-2">
      <span 
        class={`text-[10px] font-bold px-1.5 sm:px-2 py-0.5 rounded border ${catBadgeClass}`}
        data-i18n={catBadgeKey}
      >
        {catDefaultText}
      </span>
      <time datetime={formattedDate} class="text-[11px] sm:text-xs text-[#8b949e]">
        {formattedDate}
      </time>
    </div>

    <!-- Tags -->
    <div class="flex items-center gap-1.5 flex-wrap">
      {tags.slice(0, 3).map((tag) => (
        <span class={`text-[10px] font-mono text-[#8b949e] ${catHoverText} px-1.5 py-0.5 rounded bg-[#0d1117] border border-[#30363d] transition-colors`}>
          #{tag}
        </span>
      ))}
    </div>
  </div>

  <!-- Title -->
  <div class={`text-sm sm:text-base font-semibold text-[#e6edf3] ${catHoverText} transition-colors flex items-start justify-between gap-3`}>
    <span class="flex-1">{title}</span>
    <span class={`text-xs text-[#8b949e] ${catHoverText} group-hover:translate-x-1 transition-transform shrink-0 pt-0.5 pr-1 inline-block font-mono`} aria-hidden="true">→</span>
  </div>

  <!-- Description snippet -->
  {description && (
    <p class="text-xs sm:text-[13px] text-[#8b949e] line-clamp-2 leading-relaxed font-mono">
      {description}
    </p>
  )}
</a>
