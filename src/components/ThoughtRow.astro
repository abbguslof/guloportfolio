---
// ThoughtRow.astro - Writing row
interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  category?: 'tanke' | 'guide' | 'anteckning' | 'note' | 'idea' | 'idé' | string;
  description?: string;
  tags?: string[];
}

const { title, slug, pubDate, category = 'tanke', description, tags = [] } = Astro.props;

const formattedDate = pubDate.toISOString().slice(0, 10);
const tagsData = tags.map((t) => t.toLowerCase()).join(',');

const categoryMap: Record<string, { label: string; labelKey: string; className: string; key: string }> = {
  tanke: { label: '[Thought]', labelKey: 'thoughts_cat_tanke_badge', className: 'cat-thought', key: 'tanke' },
  thought: { label: '[Thought]', labelKey: 'thoughts_cat_tanke_badge', className: 'cat-thought', key: 'tanke' },
  guide: { label: '[Guide]', labelKey: 'thoughts_cat_guide_badge', className: 'cat-guide', key: 'guide' },
  anteckning: { label: '[Note]', labelKey: 'thoughts_cat_anteckning_badge', className: 'cat-note', key: 'anteckning' },
  note: { label: '[Note]', labelKey: 'thoughts_cat_anteckning_badge', className: 'cat-note', key: 'anteckning' },
  idea: { label: '[Idea]', labelKey: 'thoughts_cat_idea_badge', className: 'cat-idea', key: 'idea' },
  'idé': { label: '[Idea]', labelKey: 'thoughts_cat_idea_badge', className: 'cat-idea', key: 'idea' },
};

const cat = categoryMap[category] || categoryMap.tanke;
---

<div
  class={`thought-item ${cat.className} group relative block px-2 py-4 sm:px-3 sm:py-5 border-l-2 transition-colors hover:bg-[#1b212a]`}
  data-tags={tagsData}
  data-category={category}
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-[#8b949e]">
    <a
      href={`/thoughts?category=${cat.key}`}
      class={`${cat.className} cat-label font-semibold hover:underline underline-offset-4 relative z-10`}
      data-i18n={cat.labelKey}
    >{cat.label}</a>
    <time datetime={formattedDate}>{formattedDate}</time>
  </div>

  <a href={`/thoughts/${slug}`} class="thought-title-link group block mt-1.5">
    <span class="absolute inset-0" aria-hidden="true"></span>
    <h3 class="text-sm sm:text-[15px] font-semibold text-[#e6edf3] group-hover:text-[var(--cat)] group-hover:underline underline-offset-4 transition-colors">
      {title}
    </h3>

    {description && (
      <p class="mt-1 max-w-[62ch] font-serif text-[16px] leading-relaxed text-[#b0bac4]">
        {description}
      </p>
    )}
  </a>
</div>
