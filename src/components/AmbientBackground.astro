---
// src/components/AmbientBackground.astro - WebGL Ambient Background Engine
// 6 custom tuned modes: Topo Lines, Riso Dither, ASCII Plasma, Dot Grid Wave, Pixel Grid, Noise Shimmer + Off
// Self-hosted, 0 external network calls, full prefers-reduced-motion support
---

<div id="ambient-bg-container" class="fixed inset-0 pointer-events-none overflow-hidden select-none z-0" aria-hidden="true">
  <!-- Dynamic WebGL effect layer -->
  <div 
    id="active-aifx-layer" 
    class="absolute inset-0 pointer-events-none transition-opacity duration-700 opacity-90"
    aria-hidden="true"
  ></div>
</div>

<!-- Local effect runtime -->
<script src="/vendor/aifx/runtime/v1.js" defer></script>

<!-- Interactive Live Switcher in bottom-right corner -->
<aside 
  id="bg-style-switcher" 
  class="fixed bottom-3 right-3 sm:bottom-4 sm:right-4 z-40 flex items-center gap-1 p-1 rounded-lg bg-[#161b22]/95 border border-[#30363d] backdrop-blur-md text-[11px] font-mono shadow-xl select-none"
  aria-label="Background style picker"
>
  <span class="text-[#8b949e] pl-1.5 pr-1 hidden lg:inline text-[10px] font-bold uppercase tracking-wider">BG:</span>
  <button type="button" data-bg="topo" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    Topo
  </button>
  <button type="button" data-bg="dither" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    Dither
  </button>
  <button type="button" data-bg="ascii" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    ASCII
  </button>
  <button type="button" data-bg="dots" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    Dots
  </button>
  <button type="button" data-bg="blocky" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    Pixel
  </button>
  <button type="button" data-bg="shimmer" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    Shimmer
  </button>
  <button type="button" data-bg="off" class="bg-mode-btn px-1.5 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#f85149]" title="Turn background off">
    Off
  </button>
</aside>

<script>
  (function initAifxEngine() {
    type BgMode = 'topo' | 'dither' | 'ascii' | 'dots' | 'blocky' | 'shimmer' | 'off';

    const layer = document.getElementById('active-aifx-layer');
    const switcher = document.getElementById('bg-style-switcher');
    const buttons = switcher?.querySelectorAll<HTMLButtonElement>('.bg-mode-btn') || [];
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!layer) return;

    // Full custom tuned configs from remix sessions
    const FX_CONFIGS: Record<Exclude<BgMode, 'off'>, Record<string, string>> = {
      topo: {
        'data-aifx': 'topo-lines',
        'data-aifx-colors': '#34d399,#10b981,#047857,#064e3b',
        'data-aifx-ink': '#10b981,#6ee7b7',
        'data-aifx-bg': '#04130c',
        'data-aifx-bg-alpha': '0.75',
        'data-aifx-speed': '0.18',
        'data-aifx-density': '31',
        'data-aifx-index-every': '4',
        'data-aifx-index-weight': '0.8',
        'data-aifx-line-weight': '0.8',
        'data-aifx-scale': '2.51',
        'data-aifx-warp': '0.34',
        'data-aifx-paper': '0.35',
        'data-aifx-mouse': '0.5'
      },
      dither: {
        'data-aifx': 'dither',
        'data-aifx-colors': '#0f2b38,#0d9488,#10b981,#6ee7b7',
        'data-aifx-bg': '#0d1117',
        'data-aifx-bg-alpha': '0.25',
        'data-aifx-speed': '0.18',
        'data-aifx-pixel-size': '3',
        'data-aifx-levels': '7',
        'data-aifx-scale': '1.95',
        'data-aifx-contrast': '1.02',
        'data-aifx-flow-angle': '35',
        'data-aifx-detail': '0.6',
        'data-aifx-glow': '0.49'
      },
      ascii: {
        'data-aifx': 'ascii',
        'data-aifx-colors': '#132e22,#10b981,#6ee7b7',
        'data-aifx-bg-alpha': '0.24',
        'data-aifx-speed': '0.33',
        'data-aifx-cell-size': '29',
        'data-aifx-levels': '10',
        'data-aifx-glow': '1',
        'data-aifx-flicker': '0.05',
        'data-aifx-contrast': '0.57',
        'data-aifx-scanlines': '0.75'
      },
      dots: {
        'data-aifx': 'dot-grid-wave',
        'data-aifx-colors': '#30363d,#10b981',
        'data-aifx-bg': '#04130c',
        'data-aifx-bg-alpha': '0.49',
        'data-aifx-dot-size': '0.46',
        'data-aifx-wave-scale': '0.5',
        'data-aifx-angle': '43',
        'data-aifx-falloff': '0.81',
        'data-aifx-mouse': '0.91'
      },
      blocky: {
        'data-aifx': 'blocky',
        'data-aifx-colors': '#161b22,#30363d,#065f46,#10b981',
        'data-aifx-bg': '#04130c',
        'data-aifx-bg-alpha': '0.45',
        'data-aifx-drift-angle': '358',
        'data-aifx-contrast': '1.06'
      },
      shimmer: {
        'data-aifx': 'noise-shimmer',
        'data-aifx-colors': '#064e3b,#10b981,#1c2826',
        'data-aifx-bg': '#0d1117',
        'data-aifx-bg-alpha': '0.14',
        'data-aifx-scale': '0.88',
        'data-aifx-shimmer': '0.3',
        'data-aifx-intensity': '0.6',
        'data-aifx-speed': '0.55'
      }
    };

    let currentMode: BgMode = (localStorage.getItem('site_bg_mode') as BgMode) || 'topo';

    function applyEffect(mode: BgMode) {
      if (!layer) return;

      // Clean existing attributes
      const existingAttrs = Array.from(layer.attributes).map(a => a.name);
      for (const attr of existingAttrs) {
        if (attr.startsWith('data-aifx')) {
          layer.removeAttribute(attr);
        }
      }

      if (mode === 'off' || motionQuery.matches) {
        layer.style.display = 'none';
        layer.innerHTML = '';
        return;
      }

      layer.style.display = 'block';

      const config = FX_CONFIGS[mode];
      if (config) {
        for (const [key, value] of Object.entries(config)) {
          layer.setAttribute(key, value);
        }
      }

      // Trigger runtime mount if already loaded
      // @ts-ignore
      if (typeof window.AIFX !== 'undefined' && typeof window.AIFX.rescan === 'function') {
        // @ts-ignore
        window.AIFX.rescan();
      }
    }

    function setMode(mode: BgMode) {
      currentMode = mode;
      localStorage.setItem('site_bg_mode', mode);

      // Update switcher buttons UI
      buttons.forEach((btn) => {
        const isActive = btn.getAttribute('data-bg') === mode;
        btn.classList.toggle('bg-[#0d1117]', isActive);
        btn.classList.toggle('border', isActive);
        btn.classList.toggle('border-[#10b981]/50', isActive);
        btn.classList.toggle('text-[#10b981]', isActive);
        btn.classList.toggle('font-bold', isActive);
        btn.classList.toggle('shadow-sm', isActive);
        if (!isActive) {
          btn.classList.remove('bg-[#0d1117]', 'border', 'border-[#10b981]/50', 'text-[#10b981]', 'font-bold', 'shadow-sm');
          btn.classList.add('text-[#8b949e]');
        }
      });

      applyEffect(mode);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-bg') as BgMode;
        if (mode) setMode(mode);
      });
    });

    // Listen for custom terminal command
    window.addEventListener('set-bg-mode', ((e: CustomEvent) => {
      if (e.detail) {
        let target = e.detail.toLowerCase();
        if (target === 'pixel') target = 'blocky';
        if (['topo', 'dither', 'ascii', 'dots', 'blocky', 'shimmer', 'off'].includes(target)) {
          setMode(target as BgMode);
        }
      }
    }) as EventListener);

    // prefers-reduced-motion listener
    motionQuery.addEventListener('change', () => {
      applyEffect(currentMode);
    });

    // Initial setup
    setMode(currentMode);
  })();
</script>

<style>
  #ambient-bg-container {
    background-color: transparent;
  }

  /* Soft blended opacity so effect stays ambient behind cards */
  #active-aifx-layer {
    opacity: 0.88;
  }

  /* Hide any potential watermark elements */
  [data-aifx-wm] {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  /* prefers-reduced-motion: hide canvas, keep calm solid background */
  @media (prefers-reduced-motion: reduce) {
    #active-aifx-layer {
      display: none !important;
    }
  }
</style>
