---
// src/components/AmbientBackground.astro - Cockpit Ambient Background Engine
// Default: "Standard" (our original, smooth, lightweight Canvas 2D elevation contour curves)
// + 6 custom tuned WebGL effects (Topo, Dither, ASCII, Dots, Pixel, Shimmer) + Off
// Preloaded shaders for instant 0ms switching, calibrated subtle opacities, corner HUD with close '×', and terminal integration
---

<div id="ambient-bg-container" class="fixed inset-0 pointer-events-none overflow-hidden select-none z-0" aria-hidden="true">
  <!-- 1. HTML5 Canvas for "Standard" mode (Original smooth topographic contour elevation curves) -->
  <canvas id="standard-canvas" class="absolute inset-0 w-full h-full pointer-events-none transition-opacity duration-700"></canvas>

  <!-- 2. Dynamic WebGL effect layer for the alternative modes -->
  <div 
    id="active-aifx-layer" 
    class="absolute inset-0 pointer-events-none transition-opacity duration-700"
    aria-hidden="true"
  ></div>

  <!-- 3. Cockpit subtle radial vignette for smooth blending into #0d1117 -->
  <div id="bg-vignette-overlay" class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_center,transparent_45%,rgba(13,17,23,0.52)_100%)]"></div>
</div>

<!-- Local unified effect runtime & pre-registered shaders for instant 0ms switching -->
<script is:inline src="/vendor/aifx/bundle.js"></script>

<!-- Interactive Live Switcher in bottom-right corner with close '×' -->
<aside 
  id="bg-style-switcher" 
  class="fixed bottom-3 right-3 sm:bottom-4 sm:right-4 z-40 flex items-center gap-1 p-1 rounded-lg bg-[#161b22]/95 border border-[#30363d] backdrop-blur-md text-[11px] font-mono shadow-xl select-none transition-all duration-300"
  aria-label="Background style picker"
>
  <span class="text-[#8b949e] pl-1.5 pr-1 hidden lg:inline text-[10px] font-bold uppercase tracking-wider">BG:</span>
  <button type="button" data-bg="standard" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]" title="Ursprunglig mjuk topo (Standard)">
    Standard
  </button>
  <button type="button" data-bg="topo" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]" title="WebGL Topo Lines">
    Topo
  </button>
  <button type="button" data-bg="dither" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    Dither
  </button>
  <button type="button" data-bg="ascii" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    ASCII
  </button>
  <button type="button" data-bg="dots" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    Dots
  </button>
  <button type="button" data-bg="blocky" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    Pixel
  </button>
  <button type="button" data-bg="shimmer" class="bg-mode-btn px-2 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#e6edf3]">
    Shimmer
  </button>
  <button type="button" data-bg="off" class="bg-mode-btn px-1.5 py-0.5 rounded transition-all cursor-pointer text-[#8b949e] hover:text-[#f85149]" title="Turn background off">
    Off
  </button>
  <!-- Dismiss / Close button -->
  <button 
    type="button" 
    id="bg-close-btn" 
    class="text-[#8b949e] hover:text-[#f85149] px-1.5 py-0.5 rounded transition-colors ml-0.5 cursor-pointer font-bold text-xs" 
    title="Stäng (skriv 'bg' i terminalen för att öppna igen)"
    aria-label="Close background picker"
  >
    ✕
  </button>
</aside>

<script>
  (function initBgEngine() {
    type BgMode = 'standard' | 'topo' | 'dither' | 'ascii' | 'dots' | 'blocky' | 'shimmer' | 'off';

    const ALL_MODES: BgMode[] = ['standard', 'topo', 'dither', 'ascii', 'dots', 'blocky', 'shimmer', 'off'];

    const stdCanvas = document.getElementById('standard-canvas') as HTMLCanvasElement | null;
    const aifxLayer = document.getElementById('active-aifx-layer');
    const switcher = document.getElementById('bg-style-switcher');
    const closeBtn = document.getElementById('bg-close-btn');
    const buttons = switcher?.querySelectorAll<HTMLButtonElement>('.bg-mode-btn') || [];
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    const stdCtx = stdCanvas?.getContext('2d', { alpha: true });

    // Restored original canvas state
    let stdWidth = 0;
    let stdHeight = 0;
    let stdDpr = 1;
    let stdRafId: number | null = null;

    // Calibrated subtle opacities for the WebGL effects so they blend smoothly into #0d1117 without feeling out of place
    const FX_OPACITIES: Record<string, number> = {
      topo: 0.46,
      dither: 0.42,
      ascii: 0.38,
      dots: 0.44,
      blocky: 0.40,
      shimmer: 0.48
    };

    // Full custom tuned configs from remix sessions
    const FX_CONFIGS: Record<string, Record<string, string>> = {
      topo: {
        'data-aifx': 'topo-lines',
        'data-aifx-colors': '#34d399,#10b981,#047857,#064e3b',
        'data-aifx-ink': '#10b981,#6ee7b7',
        'data-aifx-bg': '#04130c',
        'data-aifx-bg-alpha': '0.75',
        'data-aifx-speed': '0.18',
        'data-aifx-density': '31',
        'data-aifx-index-every': '4',
        'data-aifx-index-weight': '0.8',
        'data-aifx-line-weight': '0.8',
        'data-aifx-scale': '2.51',
        'data-aifx-warp': '0.34',
        'data-aifx-paper': '0.35',
        'data-aifx-mouse': '0.5'
      },
      dither: {
        'data-aifx': 'dither',
        'data-aifx-colors': '#0f2b38,#0d9488,#10b981,#6ee7b7',
        'data-aifx-bg': '#0d1117',
        'data-aifx-bg-alpha': '0.25',
        'data-aifx-speed': '0.18',
        'data-aifx-pixel-size': '3',
        'data-aifx-levels': '7',
        'data-aifx-scale': '1.95',
        'data-aifx-contrast': '1.02',
        'data-aifx-flow-angle': '35',
        'data-aifx-detail': '0.6',
        'data-aifx-glow': '0.49'
      },
      ascii: {
        'data-aifx': 'ascii',
        'data-aifx-colors': '#132e22,#10b981,#6ee7b7',
        'data-aifx-bg': '#0d1117',
        'data-aifx-bg-alpha': '0.24',
        'data-aifx-speed': '0.33',
        'data-aifx-cell-size': '29',
        'data-aifx-levels': '10',
        'data-aifx-glow': '1',
        'data-aifx-flicker': '0.05',
        'data-aifx-contrast': '0.57',
        'data-aifx-scanlines': '0.75'
      },
      dots: {
        'data-aifx': 'dot-grid-wave',
        'data-aifx-colors': '#30363d,#10b981',
        'data-aifx-bg': '#04130c',
        'data-aifx-bg-alpha': '0.49',
        'data-aifx-dot-size': '0.46',
        'data-aifx-wave-scale': '0.5',
        'data-aifx-angle': '43',
        'data-aifx-falloff': '0.81',
        'data-aifx-mouse': '0.91'
      },
      blocky: {
        'data-aifx': 'blocky',
        'data-aifx-colors': '#161b22,#30363d,#065f46,#10b981',
        'data-aifx-bg': '#04130c',
        'data-aifx-bg-alpha': '0.45',
        'data-aifx-drift-angle': '358',
        'data-aifx-contrast': '1.06'
      },
      shimmer: {
        'data-aifx': 'noise-shimmer',
        'data-aifx-colors': '#064e3b,#10b981,#1c2826',
        'data-aifx-bg': '#0d1117',
        'data-aifx-bg-alpha': '0.14',
        'data-aifx-scale': '0.88',
        'data-aifx-shimmer': '0.3',
        'data-aifx-intensity': '0.6',
        'data-aifx-speed': '0.55'
      }
    };

    // Standard mode is the default
    let savedMode = localStorage.getItem('site_bg_mode') as BgMode | null;
    let currentMode: BgMode = (savedMode && ALL_MODES.includes(savedMode)) ? savedMode : 'standard';

    // -------------------------------------------------------------
    // OUR ORIGINAL TOPO (Smooth topographic contour elevation waves)
    // -------------------------------------------------------------
    function renderStandardTopo(time: number) {
      if (!stdCtx) return;
      stdCtx.clearRect(0, 0, stdWidth, stdHeight);

      const lineCount = Math.max(12, Math.floor(stdHeight / 65));
      const spacing = stdHeight / (lineCount - 2);

      for (let i = 0; i < lineCount; i++) {
        const baseY = (i - 1) * spacing;
        stdCtx.beginPath();
        stdCtx.moveTo(-40, baseY);

        const step = 24;
        for (let x = -40; x <= stdWidth + 40; x += step) {
          const wave1 = Math.sin(x * 0.0024 + time * 0.0003 + i * 0.35) * 32;
          const wave2 = Math.cos(x * 0.006 - time * 0.00025 + i * 0.5) * 18;
          const wave3 = Math.sin((x + baseY) * 0.0018 + time * 0.00015) * 22;
          const y = baseY + wave1 + wave2 + wave3;
          stdCtx.lineTo(x, y);
        }

        const ratio = i / lineCount;
        let strokeColor;
        if (ratio < 0.45) {
          strokeColor = `rgba(16, 185, 129, ${0.12 + ratio * 0.16})`; // emerald
        } else if (ratio < 0.8) {
          strokeColor = `rgba(56, 189, 248, ${0.14 + (ratio - 0.45) * 0.16})`; // cyan
        } else {
          strokeColor = `rgba(167, 139, 250, ${0.16 + (ratio - 0.8) * 0.16})`; // purple
        }

        stdCtx.strokeStyle = strokeColor;
        stdCtx.lineWidth = 1.3;
        stdCtx.stroke();
      }
    }

    function stdLoop(time: number) {
      if (currentMode !== 'standard') return;
      if (motionQuery.matches) {
        renderStandardTopo(0);
        return;
      }
      renderStandardTopo(time);
      stdRafId = requestAnimationFrame(stdLoop);
    }

    function resizeStdCanvas() {
      if (!stdCanvas || !stdCtx) return;
      stdDpr = Math.min(window.devicePixelRatio || 1, 2);
      stdWidth = window.innerWidth;
      stdHeight = window.innerHeight;
      stdCanvas.width = Math.round(stdWidth * stdDpr);
      stdCanvas.height = Math.round(stdHeight * stdDpr);
      stdCtx.setTransform(stdDpr, 0, 0, stdDpr, 0, 0);

      if (currentMode === 'standard') {
        renderStandardTopo(0);
      }
    }

    function applyEffect(mode: BgMode) {
      const container = document.getElementById('ambient-bg-container');
      const vignette = document.getElementById('bg-vignette-overlay');
      if (!container) return;

      // 1. Handle Standard Canvas (our original Topo)
      if (mode === 'standard') {
        const oldLayer = document.getElementById('active-aifx-layer');
        if (oldLayer) oldLayer.remove();

        if (stdCanvas) {
          stdCanvas.style.display = 'block';
          stdCanvas.style.opacity = '0.88';
        }
        if (stdRafId) cancelAnimationFrame(stdRafId);
        if (motionQuery.matches) {
          renderStandardTopo(0);
        } else {
          stdRafId = requestAnimationFrame(stdLoop);
        }
        return;
      }

      // Stop standard canvas loop if switching away
      if (stdRafId) {
        cancelAnimationFrame(stdRafId);
        stdRafId = null;
      }
      if (stdCanvas && stdCtx) {
        stdCanvas.style.display = 'none';
        stdCtx.clearRect(0, 0, stdWidth, stdHeight);
      }

      // Remove previous WebGL layer cleanly
      const oldLayer = document.getElementById('active-aifx-layer');
      if (oldLayer) oldLayer.remove();

      // 2. Handle Off or Reduced Motion
      if (mode === 'off' || motionQuery.matches) {
        return;
      }

      // 3. Create fresh new WebGL layer and attach all attributes BEFORE adding to DOM
      // This prevents attribute-mutation thrashing and avoids the 2-second webglcontextlost retry backoff!
      const newLayer = document.createElement('div');
      newLayer.id = 'active-aifx-layer';
      newLayer.className = 'absolute inset-0 pointer-events-none transition-opacity duration-700';
      newLayer.style.opacity = String(FX_OPACITIES[mode] ?? 0.44);

      const config = FX_CONFIGS[mode];
      if (config) {
        for (const [key, value] of Object.entries(config)) {
          newLayer.setAttribute(key, value);
        }
      }

      if (vignette) {
        container.insertBefore(newLayer, vignette);
      } else {
        container.appendChild(newLayer);
      }

      // Synchronously scan and mount right away without waiting for MutationObserver
      // @ts-ignore
      if (typeof window.AIFX !== 'undefined' && typeof window.AIFX.rescan === 'function') {
        // @ts-ignore
        window.AIFX.rescan();
      }
    }

    function setMode(mode: BgMode) {
      currentMode = mode;
      localStorage.setItem('site_bg_mode', mode);

      // Update switcher buttons UI
      buttons.forEach((btn) => {
        const isActive = btn.getAttribute('data-bg') === mode;
        btn.classList.toggle('bg-[#0d1117]', isActive);
        btn.classList.toggle('border', isActive);
        btn.classList.toggle('border-[#10b981]/50', isActive);
        btn.classList.toggle('text-[#10b981]', isActive);
        btn.classList.toggle('font-bold', isActive);
        btn.classList.toggle('shadow-sm', isActive);
        if (!isActive) {
          btn.classList.remove('bg-[#0d1117]', 'border', 'border-[#10b981]/50', 'text-[#10b981]', 'font-bold', 'shadow-sm');
          btn.classList.add('text-[#8b949e]');
        }
      });

      applyEffect(mode);
    }

    function cycleMode() {
      const idx = ALL_MODES.indexOf(currentMode);
      const nextIdx = (idx + 1) % ALL_MODES.length;
      setMode(ALL_MODES[nextIdx]);
    }

    function toggleSwitcher(force?: boolean) {
      if (!switcher) return;
      const isCurrentlyHidden = switcher.classList.contains('hidden');
      const shouldShow = typeof force === 'boolean' ? force : isCurrentlyHidden;
      if (shouldShow) {
        switcher.classList.remove('hidden');
        localStorage.setItem('site_bg_switcher_open', 'true');
      } else {
        switcher.classList.add('hidden');
        localStorage.setItem('site_bg_switcher_open', 'false');
      }
    }

    // Button click listeners
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-bg') as BgMode;
        if (mode) setMode(mode);
      });
    });

    // Close button listener
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleSwitcher(false);
    });

    // Check if user previously closed the switcher
    if (localStorage.getItem('site_bg_switcher_open') === 'false') {
      switcher?.classList.add('hidden');
    }

    // Terminal event listeners
    window.addEventListener('set-bg-mode', ((e: CustomEvent) => {
      if (e.detail) {
        let target = e.detail.toLowerCase().trim();
        if (target === 'default') target = 'standard';
        if (target === 'pixel') target = 'blocky';
        if (target === 'noise') target = 'shimmer';
        if (ALL_MODES.includes(target as BgMode)) {
          setMode(target as BgMode);
        }
      }
    }) as EventListener);

    window.addEventListener('cycle-bg-mode', () => {
      cycleMode();
    });

    window.addEventListener('toggle-bg-switcher', ((e: CustomEvent) => {
      const force = e.detail && typeof e.detail.show === 'boolean' ? e.detail.show : undefined;
      toggleSwitcher(force);
    }) as EventListener);

    // Window resize
    window.addEventListener('resize', resizeStdCanvas, { passive: true });

    // prefers-reduced-motion listener
    motionQuery.addEventListener('change', () => {
      applyEffect(currentMode);
    });

    // Initial setup
    resizeStdCanvas();
    setMode(currentMode);
  })();
</script>

<style>
  #ambient-bg-container {
    background-color: transparent;
  }

  /* Smooth opacity transition so effect blends seamlessly into #0d1117 */
  #active-aifx-layer,
  #standard-canvas {
    transition: opacity 0.6s ease;
  }

  /* Hide any potential watermark elements */
  [data-aifx-wm] {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  /* prefers-reduced-motion: hide WebGL canvas, keep calm resting canvas */
  @media (prefers-reduced-motion: reduce) {
    #active-aifx-layer {
      display: none !important;
    }
  }
</style>
