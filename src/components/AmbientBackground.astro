---
// src/components/AmbientBackground.astro - Ultra-subtle, living developer cockpit ambient atmosphere
---

<div id="ambient-bg-container" class="fixed inset-0 pointer-events-none overflow-hidden select-none z-[-1]" aria-hidden="true">
  <!-- 1. Ambient slow-drifting aurora blobs (living depth, ultra-low opacity) -->
  <div class="ambient-blob blob-1"></div>
  <div class="ambient-blob blob-2"></div>
  <div class="ambient-blob blob-3"></div>

  <!-- 2. Technical dot matrix coordinate plane -->
  <div class="ambient-grid"></div>

  <!-- 3. Interactive mouse spotlight (subtly illuminates grid beneath cursor) -->
  <div id="ambient-spotlight" class="ambient-spotlight"></div>

  <!-- 4. Subtle telemetry radar scanline (gentle sweep every 18s) -->
  <div class="ambient-scanline"></div>
</div>

<script>
  // Mouse spotlight tracker with requestAnimationFrame for 60/120fps buttery performance
  (function initAmbientSpotlight() {
    const spotlight = document.getElementById('ambient-spotlight');
    if (!spotlight) return;

    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight / 2;
    let currentX = targetX;
    let currentY = targetY;
    let rafId: number | null = null;
    let isTracking = false;

    function onMouseMove(e: MouseEvent) {
      targetX = e.clientX;
      targetY = e.clientY;

      if (!isTracking) {
        isTracking = true;
        spotlight?.classList.add('is-active');
        loop();
      }
    }

    function loop() {
      // Smooth lerp (linear interpolation) for organic flashlight lag
      currentX += (targetX - currentX) * 0.12;
      currentY += (targetY - currentY) * 0.12;

      spotlight?.style.setProperty('--mouse-x', `${Math.round(currentX)}px`);
      spotlight?.style.setProperty('--mouse-y', `${Math.round(currentY)}px`);

      if (Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5) {
        rafId = requestAnimationFrame(loop);
      } else {
        isTracking = false;
        rafId = null;
      }
    }

    window.addEventListener('pointermove', onMouseMove, { passive: true });
    
    // Cleanup if page unloads
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('pointermove', onMouseMove);
      if (rafId) cancelAnimationFrame(rafId);
    });
  })();
</script>

<style>
  #ambient-bg-container {
    background-color: #0d1117;
  }

  /* 1. Ambient Drifting Aurora Blobs */
  .ambient-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(140px);
    opacity: 0.055;
    will-change: transform;
    pointer-events: none;
  }

  /* Emerald blob (cockpit primary) */
  .blob-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #10b981 0%, rgba(16, 185, 129, 0) 70%);
    top: -120px;
    left: -100px;
    animation: drift-1 28s ease-in-out infinite alternate;
  }

  /* Cyan blob (secondary tech accent) */
  .blob-2 {
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, #38bdf8 0%, rgba(56, 189, 248, 0) 70%);
    bottom: -150px;
    right: -150px;
    animation: drift-2 34s ease-in-out infinite alternate;
  }

  /* Purple blob (portfolio accent) */
  .blob-3 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #a78bfa 0%, rgba(167, 139, 250, 0) 70%);
    top: 40%;
    left: 45%;
    animation: drift-3 32s ease-in-out infinite alternate;
  }

  @keyframes drift-1 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(140px, 90px, 0) scale(1.15); }
    100% { transform: translate3d(-60px, 160px, 0) scale(0.95); }
  }

  @keyframes drift-2 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(-120px, -100px, 0) scale(1.2); }
    100% { transform: translate3d(90px, -130px, 0) scale(0.9); }
  }

  @keyframes drift-3 {
    0% { transform: translate3d(-50%, -50%, 0) scale(0.9); }
    50% { transform: translate3d(-35%, -65%, 0) scale(1.2); }
    100% { transform: translate3d(-65%, -35%, 0) scale(1); }
  }

  /* 2. Micro Dot Grid: clean, crisp, subtle */
  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(230, 237, 243, 0.08) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: 0.65;
    mask-image: radial-gradient(ellipse 90% 85% at 50% 50%, black 40%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse 90% 85% at 50% 50%, black 40%, transparent 95%);
  }

  /* 3. Interactive Mouse Spotlight */
  .ambient-spotlight {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
    background: radial-gradient(
      550px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(16, 185, 129, 0.06),
      rgba(56, 189, 248, 0.025) 40%,
      transparent 80%
    );
    will-change: background;
  }

  .ambient-spotlight.is-active {
    opacity: 1;
  }

  /* 4. Telemetry Scanline Sweep */
  .ambient-scanline {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      rgba(56, 189, 248, 0.03) 20%, 
      rgba(16, 185, 129, 0.14) 50%, 
      rgba(56, 189, 248, 0.03) 80%, 
      transparent 100%
    );
    box-shadow: 0 0 24px 2px rgba(16, 185, 129, 0.09);
    opacity: 0.65;
    animation: scan-down 18s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    will-change: transform;
  }

  @keyframes scan-down {
    0% {
      transform: translateY(-20px);
      opacity: 0;
    }
    8% {
      opacity: 0.65;
    }
    92% {
      opacity: 0.65;
    }
    100% {
      transform: translateY(105vh);
      opacity: 0;
    }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .ambient-blob,
    .ambient-scanline {
      animation: none !important;
    }
  }
</style>
