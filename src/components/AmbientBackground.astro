---
// src/components/AmbientBackground.astro - Super minimal, calm ambient background
// Pure CSS, ultra-low opacity, zero noise, respects prefers-reduced-motion
---

<div id="ambient-bg-container" class="fixed inset-0 pointer-events-none overflow-hidden select-none z-0" aria-hidden="true">
  <!-- Subtle, calm ambient glow: very soft and slow -->
  <div class="ambient-glow glow-top"></div>
  <div class="ambient-glow glow-bottom"></div>

  <!-- Ultra-subtle, crisp tech dot grid -->
  <div class="ambient-grid"></div>
</div>

<style>
  #ambient-bg-container {
    background-color: transparent;
  }

  /* Super soft, slow, breathing ambient gradients */
  .ambient-glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(120px);
    pointer-events: none;
    will-change: opacity, transform;
  }

  /* Top subtle emerald / cyan aura */
  .glow-top {
    width: 600px;
    height: 320px;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(16, 185, 129, 0.09) 0%, rgba(56, 189, 248, 0.04) 50%, transparent 80%);
    animation: pulse-slow 16s ease-in-out infinite alternate;
  }

  /* Bottom subtle cyan / violet aura */
  .glow-bottom {
    width: 650px;
    height: 350px;
    bottom: -80px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(56, 189, 248, 0.06) 0%, rgba(167, 139, 250, 0.03) 50%, transparent 80%);
    animation: pulse-slow 20s ease-in-out infinite alternate 4s;
  }

  @keyframes pulse-slow {
    0% {
      opacity: 0.45;
      transform: translateX(-50%) scale(0.95);
    }
    100% {
      opacity: 0.85;
      transform: translateX(-50%) scale(1.05);
    }
  }

  /* Ultra-subtle, crisp dot grid */
  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(230, 237, 243, 0.08) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.45;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 20%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 20%, transparent 90%);
  }

  /* Complete prefers-reduced-motion compliance: completely stops breathing pulse */
  @media (prefers-reduced-motion: reduce) {
    .glow-top,
    .glow-bottom {
      animation: none !important;
      opacity: 0.6 !important;
      transform: translateX(-50%) !important;
    }
  }
</style>
