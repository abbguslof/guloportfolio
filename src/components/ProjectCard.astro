---
// ProjectCard.astro - Thumbnail-free TUI Project Card with dynamic bilingual tags & links
interface Props {
  title?: string;
  description?: string;
  titleEn?: string;
  titleSv?: string;
  descEn?: string;
  descSv?: string;
  status: 'ACTIVE' | 'MAINTAINED' | 'COMPLETED' | 'WIP' | 'ARCHIVED';
  category: 'School' | 'Homelab' | 'Minecraft' | 'Web' | 'Other';
  tech: string[];
  repoUrl?: string;
  liveUrl?: string;
  slug: string;
}

const { 
  title, 
  description, 
  titleEn, 
  titleSv, 
  descEn, 
  descSv, 
  status, 
  category, 
  tech, 
  repoUrl, 
  liveUrl, 
  slug 
} = Astro.props;

const tEn = titleEn || title || '';
const tSv = titleSv || title || tEn;
const dEn = descEn || description || '';
const dSv = descSv || description || dEn;

// Status styling mapping
const statusMap: Record<string, { label: string; textClass: string }> = {
  ACTIVE: { label: '[ACTIVE]', textClass: 'text-[#10b981]' },
  COMPLETED: { label: '[✓ COMPLETED]', textClass: 'text-[#38bdf8]' },
  WIP: { label: '[⚡ WIP]', textClass: 'text-[#f59e0b]' },
  MAINTAINED: { label: '[⟳ MAINTAINED]', textClass: 'text-[#a78bfa]' },
  ARCHIVED: { label: '[× ARCHIVED]', textClass: 'text-[#8b949e]' },
};

const currentStatus = statusMap[status] || statusMap.ACTIVE;
const projectUrl = `/projects/${slug}`;
const catKey = `projects_cat_${category.toLowerCase()}`;
---

<div class="project-card group relative flex flex-col justify-between h-full p-4 sm:p-5 rounded-lg bg-[#161b22] border border-[#30363d] hover:bg-[#1f242c] hover:border-[#38bdf8]/70 hover:shadow-lg transition-all">
  <div class="flex flex-col flex-1">
    <!-- Top Metadata: Category & Status -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span 
        class="text-[11px] font-mono font-medium text-[#8b949e] uppercase tracking-wider px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d]"
        data-i18n={catKey}
      >
        {category}
      </span>
      <span class={`text-[11px] font-mono font-bold ${currentStatus.textClass}`}>
        {currentStatus.label}
      </span>
    </div>

    <!-- Title (Primary Click target -> Goes to /projects/[slug]) -->
    <h3 class="text-sm sm:text-base font-semibold text-[#e6edf3] group-hover:text-[#38bdf8] transition-colors mb-2 line-clamp-2">
      <a href={projectUrl} class="focus-visible:outline-none flex items-center justify-between">
        <span class="absolute inset-0 rounded-lg pointer-events-none" aria-hidden="true"></span>
        <span class="lang-en-only">{tEn}</span>
        <span class="lang-sv-only">{tSv}</span>
        <span class="text-xs text-[#8b949e] group-hover:text-[#38bdf8] group-hover:translate-x-0.5 transition-all">→</span>
      </a>
    </h3>

    <!-- Description (Uniform 3-line max with ellipsis truncation) -->
    <p class="text-xs sm:text-sm text-[#8b949e] leading-relaxed mb-4 line-clamp-3 overflow-hidden flex-1">
      <span class="lang-en-only">{dEn}</span>
      <span class="lang-sv-only">{dSv}</span>
    </p>
  </div>

  <div class="relative z-10 mt-auto">
    <!-- Tech stack pills -->
    <div class="flex flex-wrap gap-1.5 pt-3 border-t border-[#30363d]/60 mb-3.5">
      {tech.map((item) => (
        <span class="text-[11px] font-mono text-[#8b949e] bg-[#0d1117] px-2 py-0.5 rounded border border-[#30363d]/80">
          #{item}
        </span>
      ))}
    </div>

    <!-- Secondary external action links -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
      <a 
        href={projectUrl} 
        class="text-xs text-[#38bdf8] hover:underline z-20 flex items-center gap-1 py-1"
        data-i18n="projects_read_more"
      >
        [Read more about project →]
      </a>

      {repoUrl && (
        <a 
          href={repoUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-[#8b949e] hover:text-[#e6edf3] flex items-center gap-1 transition-colors z-20 py-1"
          title="View GitHub repository"
          data-i18n-title="projects_github_title"
        >
          <span data-i18n="projects_github_link">[GitHub ↗]</span>
        </a>
      )}
    </div>
  </div>
</div>
