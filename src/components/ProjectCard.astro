---
// ProjectCard.astro - Project card
interface Props {
  title?: string;
  description?: string;
  titleEn?: string;
  titleSv?: string;
  descEn?: string;
  descSv?: string;
  status: 'ACTIVE' | 'MAINTAINED' | 'COMPLETED' | 'WIP' | 'ARCHIVED';
  category: 'School' | 'Homelab' | 'Minecraft' | 'Web' | 'Other';
  tech: string[];
  repoUrl?: string;
  liveUrl?: string;
  slug: string;
}

const {
  title,
  description,
  titleEn,
  titleSv,
  descEn,
  descSv,
  status,
  category,
  tech,
  repoUrl,
  slug,
} = Astro.props;

const tEn = titleEn || title || '';
const tSv = titleSv || title || tEn;
const dEn = descEn || description || '';
const dSv = descSv || description || dEn;

const statusLabel: Record<string, string> = {
  ACTIVE: 'Active',
  COMPLETED: 'Completed',
  WIP: 'In progress',
  MAINTAINED: 'Maintained',
  ARCHIVED: 'Archived',
};

const projectUrl = `/projects/${slug}`;
const catKey = `projects_cat_${category.toLowerCase()}`;
---

<article class="project-card group relative flex flex-col justify-between h-full p-4 sm:p-5 rounded-md border border-[#30363d] transition-colors hover:border-[#484f58]">
  <div class="flex flex-col flex-1">
    <div class="flex items-center justify-between gap-2 mb-3 text-[11px] text-[#8b949e]">
      <span data-i18n={catKey}>{category}</span>
      <span>{statusLabel[status] || status}</span>
    </div>

    <h3 class="text-sm sm:text-base font-semibold text-[#e6edf3] mb-2">
      <a href={projectUrl} class="focus-visible:outline-none flex items-start justify-between gap-3 group-hover:text-[#e6edf3]">
        <span class="absolute inset-0 rounded-md" aria-hidden="true"></span>
        <span class="line-clamp-2 flex-1">
          <span class="lang-en-only">{tEn}</span>
          <span class="lang-sv-only">{tSv}</span>
        </span>
      </a>
    </h3>

    <p class="font-serif text-[16px] leading-relaxed text-[#b0bac4] line-clamp-3 overflow-hidden flex-1">
      <span class="lang-en-only">{dEn}</span>
      <span class="lang-sv-only">{dSv}</span>
    </p>
  </div>

  <div class="relative z-10 mt-auto pt-4 flex items-end justify-between gap-3 border-t border-[#30363d]/60">
    <div class="flex flex-wrap gap-x-2 gap-y-1 text-[11px] text-[#8b949e]">
      {tech.map((item) => (
        <span>{item}</span>
      ))}
    </div>

    {repoUrl && (
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[11px] text-[#8b949e] hover:text-[#e6edf3] transition-colors z-20 shrink-0"
        title="View repository"
        data-i18n-title="projects_github_title"
      >
        source<span class="text-[9px]">↗</span>
      </a>
    )}
  </div>
</article>
